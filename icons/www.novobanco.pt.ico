<div class="content-injection aem-GridColumn aem-GridColumn--default--12"><script>
  $(function () {
    if (/^\/en(\/|$)/.test(window.location.pathname)) {
        const $link = $('.mobile-menu_item')
            .eq(2)
            .find('a');

        const href = $link.attr('href');

        if (href) {
            const separator = href.includes('?') ? '&' : '?';
            $link.attr('href', href + separator + 'idioma=EN');
        }
    }
});
</script>

  

  

