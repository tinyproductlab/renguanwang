$(function (){
  var useragent = navigator.userAgent
  if (useragent.indexOf('Mac OS') > -1 || useragent.indexOf('iPhone') > -1) {
    $('.privacy_ios').show()
    $('.permission_ios').show()
    $('.version_ios').show()

    $('.privacy_android').hide()
    $('.permission_android').hide()
    $('.version_android').hide()
  } else {
    $('.privacy_android').show()
    $('.permission_android').show()
    $('.version_android').show()

    $('.privacy_ios').hide()
    $('.permission_ios').hide()
    $('.version_ios').hide()
  }
})
</script>
