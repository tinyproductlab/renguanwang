    display: none;
}</style>
            <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-2919d496-bf9d-3068-9610-fe0a3bf4c298'); const fragmentElementId = 'fragment-2919d496-bf9d-3068-9610-fe0a3bf4c298'; const fragmentEntryLinkNamespace = 'zjll'; const fragmentNamespace = 'zjll'; const layoutMode = 'view';;(function () {
    const LOG_PREFIX = '[GOL Chat B2C]';

    const ZENDESK_KEY =
        'ba081092-ad55-4c53-bf4a-b2c8f8a8c698';

    const SCRIPT_ID = 'ze-snippet';

    const SCRIPT_URL =
        'https://static.zdassets.com/ekr/snippet.js?key=' +
        ZENDESK_KEY;

    let active = false;

    function showZendesk() {
        if (
            !active ||
            typeof window.zE !== 'function'
        ) {
            return;
        }

        try {
            window.zE(
                'messenger',
                'show'
            );

            console.log(
                LOG_PREFIX,
                'Messenger B2C exibido.'
            );

            /*
             * Reforço para casos em que o Zendesk
             * termina de montar o launcher depois
             * do primeiro show(), especialmente
             * para usuário Guest/deslogado.
             */
            window.setTimeout(function () {
                if (
                    !active ||
                    typeof window.zE !== 'function'
                ) {
                    return;
                }

                try {
                    window.zE(
                        'messenger',
                        'show'
                    );

                    console.log(
                        LOG_PREFIX,
                        'Messenger B2C reafirmado após 500ms.'
                    );
                }
                catch (error) {
                    console.warn(
                        LOG_PREFIX,
                        'Erro ao reafirmar B2C após 500ms.',
                        error
                    );
                }
            }, 500);

            window.setTimeout(function () {
                if (
                    !active ||
                    typeof window.zE !== 'function'
                ) {
                    return;
                }

                try {
                    window.zE(
                        'messenger',
                        'show'
                    );

                    console.log(
                        LOG_PREFIX,
                        'Messenger B2C reafirmado após 1500ms.'
                    );
                }
                catch (error) {
                    console.warn(
                        LOG_PREFIX,
                        'Erro ao reafirmar B2C após 1500ms.',
                        error
                    );
                }
            }, 1500);
        }
        catch (error) {
            console.warn(
                LOG_PREFIX,
                'Erro ao exibir B2C.',
                error
            );
        }
    }

    function waitForZendesk(attempt) {
        attempt = attempt || 0;

        const MAX_ATTEMPTS = 50;

        if (!active) {
            return;
        }

        if (typeof window.zE === 'function') {
            console.log(
                LOG_PREFIX,
                'Zendesk B2C inicializado.'
            );

            showZendesk();

            return;
        }

        if (attempt >= MAX_ATTEMPTS) {
            console.error(
                LOG_PREFIX,
                'Timeout aguardando Zendesk B2C.'
            );

            return;
        }

        window.setTimeout(function () {
            waitForZendesk(
                attempt + 1
            );
        }, 200);
    }

    function loadChat() {
        if (active) {
            console.log(
                LOG_PREFIX,
                'Chat B2C já está ativo.'
            );

            showZendesk();

            return;
        }

        active = true;

        console.log(
            LOG_PREFIX,
            'Ativando B2C.'
        );

        const existingScript =
            document.getElementById(
                SCRIPT_ID
            );

        if (existingScript) {
            console.log(
                LOG_PREFIX,
                'ze-snippet já existe.'
            );

            waitForZendesk();

            return;
        }

        console.log(
            LOG_PREFIX,
            'Carregando Zendesk B2C.'
        );

        const script =
            document.createElement('script');

        script.id = SCRIPT_ID;
        script.async = true;
        script.src = SCRIPT_URL;

        script.onload = function () {
            console.log(
                LOG_PREFIX,
                'snippet.js B2C carregado.'
            );

            waitForZendesk();
        };

        script.onerror = function (error) {
            console.error(
                LOG_PREFIX,
                'Erro ao carregar Zendesk B2C.',
                error
            );
        };

        document.head.appendChild(script);
    }

    function unloadChat() {
        if (!active) {
            return;
        }

        active = false;

        console.log(
            LOG_PREFIX,
            'Desativando B2C.'
        );

        if (typeof window.zE === 'function') {
            try {
                window.zE(
                    'messenger',
                    'hide'
                );

                console.log(
                    LOG_PREFIX,
                    'Messenger B2C ocultado.'
                );
            }
            catch (error) {
                console.warn(
                    LOG_PREFIX,
                    'Erro ao ocultar B2C.',
                    error
                );
            }
        }
    }

    /*
     * Eventos disparados pelo Controller
     */
    window.addEventListener(
        'gol-chat-b2c-activate',
        loadChat
    );

    window.addEventListener(
        'gol-chat-b2c-deactivate',
        unloadChat
    );

    /*
     * Caso o Controller tenha sido
     * carregado antes deste fragmento.
     */
    if (
        window.GOLChatController &&
        typeof window.GOLChatController
            .getSelectedChat === 'function'
    ) {
        if (
            window.GOLChatController
                .getSelectedChat() === 'b2c'
        ) {
            loadChat();
        }
    }
})();;</script>
