       <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-96ae5760-012e-01fe-7389-9fdf2772aa9e'); const fragmentElementId = 'fragment-96ae5760-012e-01fe-7389-9fdf2772aa9e'; const fragmentEntryLinkNamespace = 'gwzj'; const fragmentNamespace = 'gwzj'; const layoutMode = 'view';// validity period for the cookies (in days)
  var cookieValidity = 30;

  // mediaPartners object
  var mediaPartners = {
   skyscanner_redirectid: "skyscanner",
   voelivre_redirectid: "voelivre",
   id_click: "afilio",
   click_id: "roundler",
   kayakclickid: "kayak",
   gclid: "gads",
   fbclid: "fbads"
 };

  function setCookie(cookieName, cookieValue, daysToExpire) {
   var expirationDate = new Date();
   expirationDate.setDate(expirationDate.getDate() + daysToExpire);
   var cookieString = cookieName + "=" + cookieValue + "; expires=" + expirationDate.toUTCString() + "; path=/";
   document.cookie = cookieString;
 }

  function getQueryParam(paramName) {
   var urlParams = new URLSearchParams(window.location.search);
   return urlParams.get(paramName);
 }

  function checkObjectKeyInURL(objectKey) {
   return getQueryParam(objectKey) !== null;
 }

  for (var key in mediaPartners) {
   if (mediaPartners.hasOwnProperty(key)) {
     if (checkObjectKeyInURL(key)) {
       var objectValue = mediaPartners[key];
       var urlValue = getQueryParam(key);
       setCookie("LastClickCookie", objectValue, cookieValidity);
       setCookie(key, urlValue, cookieValidity);
     }
   }
 }

  if (Object.keys(mediaPartners).every(function(key) { return !checkObjectKeyInURL(key); })) {
   var utmSource = getQueryParam("utm_source");
   if (utmSource !== null) {
     setCookie("LastClickCookie", utmSource, cookieValidity);
   }
 };</script>
