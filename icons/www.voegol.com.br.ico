            text-align: center;
            text-underline-position: from-font;
            text-decoration-skip-ink: none;
        }

        .voegol-header-overlay__navigation {
            margin-bottom: 24px;
        }
    }

    #onetrust-banner-sdk {
        width: 100vw;
        max-width: 1360px;
        margin: 0 auto;
