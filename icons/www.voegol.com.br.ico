           <div class="lfr-layout-structure-item-chat-gal lfr-layout-structure-item-a96f0bb2-090c-c46d-c3ff-72c819a21590 " data-layout-structure-item-id="a96f0bb2-090c-c46d-c3ff-72c819a21590">
            <div id="fragment-f9003b19-4c74-ffba-3170-5b6e8448ede5">
             <div class="gol-chat-gal" data-gol-chat="gal"><span id="chat-hint"> Olá, como posso te ajudar? </span> <button id="chat-launcher" type="button" aria-label="Abrir chat"> <img src="/documents/d/guest/gal" alt=""> </button>
