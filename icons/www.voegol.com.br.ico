       <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-dc675bdf-6ef9-86d8-d6a5-3da58cc3c9ea'); const fragmentElementId = 'fragment-dc675bdf-6ef9-86d8-d6a5-3da58cc3c9ea'; const fragmentEntryLinkNamespace = 'wmbf'; const fragmentNamespace = 'wmbf'; const layoutMode = 'view';(function () {
    const params = new URLSearchParams(window.location.search);

    // cultureCode=AR -> cria/atualiza o cookie
    const cultureCode = params.get('cultureCode');

    if (cultureCode) {
        document.cookie =
            'cultureCode=' + encodeURIComponent(cultureCode.toUpperCase()) +
            '; path=/; max-age=31536000; SameSite=Lax';
    }

    // languageId=fr_FR -> altera o idioma do Liferay
    const languageId = params.get('languageId');

    if (languageId && window.Liferay && Liferay.ThemeDisplay) {
        const pathMain = Liferay.ThemeDisplay.getPathMain();
        const plid = Liferay.ThemeDisplay.getPlid();

        // Remove languageId para evitar loop após o redirect
        params.delete('languageId');

        const queryString = params.toString();

        const redirect =
            window.location.pathname +
            (queryString ? '?' + queryString : '') +
            window.location.hash;

        let url =
            pathMain +
            '/portal/update_language' +
            '?p_l_id=' + encodeURIComponent(plid) +
            '&languageId=' + encodeURIComponent(languageId) +
            '&redirect=' + encodeURIComponent(redirect);

        if (Liferay.authToken) {
            url += '&p_auth=' + encodeURIComponent(Liferay.authToken);
        }

        window.location.href = url;
    }
})();;</script>
