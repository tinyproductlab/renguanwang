            <style>.gol-chat-gal {
    display: none;
}

.gol-chat-gal.is-active {
    display: block;
}

.voegol-chatbot-image {
    width: 80px;
    height: 80px;
}

#chat-hint {
    position: fixed;
    right: 20px;
    bottom: 110px;
    height: 60px;
    cursor: pointer;
    z-index: 999;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    border-radius: 10px;
    font-weight: 700;
    padding: 20px;
    background-color: #ff7020;
}

#chat-launcher {
    position: fixed;
    bottom: 24px;
    right: 20px;
    height: 80px;
    width: 80px;
    cursor: pointer;
    z-index: 999;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    border-radius: 100px;
    background-color: #ff7020;
}

.gil-chat {
    background-color: #fff;
}

#chat-launcher .gal-chat {
    background-color: #ff5e00;
}

#chat-launcher img {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    object-fit: contain !important;
}</style>
            <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-f9003b19-4c74-ffba-3170-5b6e8448ede5'); const fragmentElementId = 'fragment-f9003b19-4c74-ffba-3170-5b6e8448ede5'; const fragmentEntryLinkNamespace = 'uazl'; const fragmentNamespace = 'uazl'; const layoutMode = 'view';;(function () {
    const LOG_PREFIX = '[GOL Chat GAL]';

    const ZENDESK_KEY =
        '4490dccf-94bb-481b-9f2b-3c585d8e7ffd';

    const SCRIPT_ID = 'ze-snippet';

    const SCRIPT_URL =
        'https://static.zdassets.com/ekr/snippet.js?key=' +
        ZENDESK_KEY;

    let active = false;

    const container =
        typeof fragmentElement !== 'undefined'
            ? fragmentElement
            : document;

    const launcher =
        container.querySelector('#chat-launcher');

    const hint =
        container.querySelector('#chat-hint');

    const fragmentRoot =
        container.querySelector('.gol-chat-gal');

    window.openGalTargget =
        window.openGalTargget ||
        function () {
            window.dataLayer =
                window.dataLayer || [];

            window.dataLayer.push({
                event: 'select_content',
                dl_infos: {
                    select_content:
                        'content-iniciar-chat-gal',
                    shelf: 'gal',
                    index: 1
                }
            });
        };

    function showFragment() {
        if (fragmentRoot) {
            fragmentRoot.classList.add('is-active');
        }
    }

    function hideFragment() {
        if (fragmentRoot) {
            fragmentRoot.classList.remove('is-active');
        }
    }

    function zendeskIframeExists() {
        return !!document.querySelector(
            'iframe[title*="Messaging"],' +
            'iframe#webWidget,' +
            'iframe[title*="chat"]'
        );
    }

    function openZendesk() {
        if (!active) {
            return;
        }

        if (typeof window.zE !== 'function') {
            return;
        }

        try {
            window.zE(
                'messenger',
                'show'
            );

            window.setTimeout(function () {
                if (!active) {
                    return;
                }

                window.zE(
                    'messenger',
                    'open'
                );
            }, 150);
        }
        catch (error) {
            console.warn(
                LOG_PREFIX,
                'Erro ao abrir GAL.',
                error
            );
        }
    }

    function waitForZendesk(attempt, callback) {
        attempt = attempt || 0;

        const MAX_ATTEMPTS = 50;

        if (!active) {
            return;
        }

        if (typeof window.zE === 'function') {
            console.log(
                LOG_PREFIX,
                'Zendesk GAL inicializado.'
            );

            if (typeof callback === 'function') {
                callback();
            }

            return;
        }

        if (attempt >= MAX_ATTEMPTS) {
            console.error(
                LOG_PREFIX,
                'Timeout aguardando Zendesk GAL.'
            );

            return;
        }

        window.setTimeout(function () {
            waitForZendesk(
                attempt + 1,
                callback
            );
        }, 200);
    }

    function loadZendesk(callback) {
        if (!active) {
            return;
        }

        const existingScript =
            document.getElementById(
                SCRIPT_ID
            );

        if (existingScript) {
            waitForZendesk(
                0,
                callback
            );

            return;
        }

        console.log(
            LOG_PREFIX,
            'Carregando Zendesk GAL.'
        );

        const script =
            document.createElement('script');

        script.id = SCRIPT_ID;
        script.async = true;
        script.src = SCRIPT_URL;

        script.onload = function () {
            console.log(
                LOG_PREFIX,
                'snippet.js GAL carregado.'
            );

            waitForZendesk(
                0,
                callback
            );
        };

        script.onerror = function (error) {
            console.error(
                LOG_PREFIX,
                'Erro ao carregar Zendesk GAL.',
                error
            );
        };

        document.head.appendChild(script);
    }

    function reloadZendeskAndOpen() {
        console.warn(
            LOG_PREFIX,
            'Iframe não encontrado. Recarregando GAL.'
        );

        const oldScript =
            document.getElementById(
                SCRIPT_ID
            );

        if (oldScript) {
            oldScript.remove();
        }

        loadZendesk(function () {
            window.setTimeout(
                openZendesk,
                500
            );
        });
    }

    function handleChatClick(event) {
        if (event) {
            event.preventDefault();
        }

        if (!active) {
            return;
        }

        window.openGalTargget();

        if (!zendeskIframeExists()) {
            reloadZendeskAndOpen();
            return;
        }

        openZendesk();
    }

    function openSmsChatIfNeeded() {
        if (
            !active ||
            !window.location.search.includes('sms')
        ) {
            return;
        }

        loadZendesk(function () {
            openZendesk();
        });
    }

    function activateGal() {
        if (active) {
            console.log(
                LOG_PREFIX,
                'GAL já está ativo.'
            );

            return;
        }

        active = true;

        console.log(
            LOG_PREFIX,
            'Ativando GAL.'
        );

        showFragment();

        loadZendesk(function () {
            openSmsChatIfNeeded();
        });
    }

    function deactivateGal() {
        if (!active) {
            hideFragment();
            return;
        }

        active = false;

        console.log(
            LOG_PREFIX,
            'Desativando GAL.'
        );

        hideFragment();

        if (typeof window.zE === 'function') {
            try {
                window.zE(
                    'messenger',
                    'hide'
                );
            }
            catch (error) {
            }
        }
    }

    if (launcher) {
        launcher.addEventListener(
            'click',
            handleChatClick
        );
    }

    if (hint) {
        hint.addEventListener(
            'click',
            handleChatClick
        );
    }

    window.addEventListener(
        'gol-chat-gal-activate',
        activateGal
    );

    window.addEventListener(
        'gol-chat-gal-deactivate',
        deactivateGal
    );

    if (
        window.GOLChatController &&
        typeof window.GOLChatController
            .getSelectedChat === 'function'
    ) {
        if (
            window.GOLChatController
                .getSelectedChat() === 'gal'
        ) {
            activateGal();
        }
    }
})();;</script>
