                       <fieldset class="gol-selector-column"><legend> <h3>Selecione a localização e moeda</h3> </legend> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/flag-png" alt="" aria-hidden="true" class="gol-flag"> <span> Argentina </span> </span> <span class="gol-currency" aria-hidden="true"> ARS </span> <span class="sr-only"> Moeda: ARS </span> <input type="radio" name="golCulture" value="AR" data-culture-code="AR" data-currency-code="ARS" data-symbol="ARS"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/bolivia" alt="" aria-hidden="true" class="gol-flag"> <span> Bolívia </span> </span> <span class="gol-currency" aria-hidden="true"> BOB </span> <span class="sr-only"> Moeda: BOB </span> <input type="radio" name="golCulture" value="BO" data-culture-code="BO" data-currency-code="BOB" data-symbol="BOB"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/brasil_flag" alt="" aria-hidden="true" class="gol-flag"> <span> Brasil </span> </span> <span class="gol-currency" aria-hidden="true"> BRL </span> <span class="sr-only"> Moeda: BRL </span> <input type="radio" name="golCulture" value="BR" data-culture-code="BR" data-currency-code="BRL" data-symbol="BRL"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/chile" alt="" aria-hidden="true" class="gol-flag"> <span> Chile </span> </span> <span class="gol-currency" aria-hidden="true"> CLP </span> <span class="sr-only"> Moeda: CLP </span> <input type="radio" name="golCulture" value="CL" data-culture-code="CL" data-currency-code="CLP" data-symbol="CLP"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/colombia" alt="" aria-hidden="true" class="gol-flag"> <span> Colômbia </span> </span> <span class="gol-currency" aria-hidden="true"> COP </span> <span class="sr-only"> Moeda: COP </span> <input type="radio" name="golCulture" value="CO" data-culture-code="CO" data-currency-code="COP" data-symbol="COP"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/ecu" alt="" aria-hidden="true" class="gol-flag"> <span> Equador </span> </span> <span class="gol-currency" aria-hidden="true"> USD </span> <span class="sr-only"> Moeda: USD </span> <input type="radio" name="golCulture" value="EC" data-culture-code="EC" data-currency-code="USD" data-symbol="USD"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/usa_flag" alt="" aria-hidden="true" class="gol-flag"> <span> EUA </span> </span> <span class="gol-currency" aria-hidden="true"> USD </span> <span class="sr-only"> Moeda: USD </span> <input type="radio" name="golCulture" value="US" data-culture-code="US" data-currency-code="USD" data-symbol="USD"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/other-png" alt="" aria-hidden="true" class="gol-flag"> <span> Europa </span> </span> <span class="gol-currency" aria-hidden="true"> EUR </span> <span class="sr-only"> Moeda: EUR </span> <input type="radio" name="golCulture" value="PT" data-culture-code="PT" data-currency-code="EUR" data-symbol="EUR"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/other-png" alt="" aria-hidden="true" class="gol-flag"> <span> Outros </span> </span> <span class="gol-currency" aria-hidden="true"> USD </span> <span class="sr-only"> Moeda: USD </span> <input type="radio" name="golCulture" value="OT" data-culture-code="OT" data-currency-code="USD" data-symbol="USD"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/paraguai" alt="" aria-hidden="true" class="gol-flag"> <span> Paraguai </span> </span> <span class="gol-currency" aria-hidden="true"> PYG </span> <span class="sr-only"> Moeda: PYG </span> <input type="radio" name="golCulture" value="PY" data-culture-code="PY" data-currency-code="PYG" data-symbol="PYG"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/peru" alt="" aria-hidden="true" class="gol-flag"> <span> Peru </span> </span> <span class="gol-currency" aria-hidden="true"> USD </span> <span class="sr-only"> Moeda: USD </span> <input type="radio" name="golCulture" value="PE" data-culture-code="PE" data-currency-code="USD" data-symbol="USD"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/reo_domi" alt="" aria-hidden="true" class="gol-flag"> <span> Rep. Domi. </span> </span> <span class="gol-currency" aria-hidden="true"> DOP </span> <span class="sr-only"> Moeda: DOP </span> <input type="radio" name="golCulture" value="DO" data-culture-code="DO" data-currency-code="DOP" data-symbol="DOP"> </label> <label class="gol-option"> <span class="gol-country-info"> <img src="/documents/d/guest/uruguay" alt="" aria-hidden="true" class="gol-flag"> <span> Uruguai </span> </span> <span class="gol-currency" aria-hidden="true"> USD </span> <span class="sr-only"> Moeda: USD </span> <input type="radio" name="golCulture" value="UY" data-culture-code="UY" data-currency-code="USD" data-symbol="USD"> </label>
                       </fieldset> <!-- AÇÕES -->
                       <div class="gol-selector-actions"><button class="gol-apply-button" type="submit"> Aplicar </button>
                       </div>
                      </div>
                     </form>
                    </div>
                   </nav>
                   <style>

.gol-language-country-selector {
    position: relative;
}


.gol-selector-trigger {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 20px;
    padding: 0;

    display: inline-flex;
    align-items: center;
}


.gol-selector-trigger:focus-visible {
    outline: 2px solid #ff7020;
    outline-offset: 4px;
    border-radius: 4px;
}


.gol-selector-trigger img {
    width: 19px;
    height: 19px;
}


.gol-selector-modal {

    font-family: 'GOL Sans Display';

    display: none;

    position: absolute;

    right: 0;
    top: 40px;

    width: 456px;

    padding: 20px;

    background: #fff;

    border-radius: 22px;

    z-index: 99999;
}


@media (min-width: 992px) {

    .gol-selector-modal {
        top: -28px;
        right: 20px;
    }

}


.gol-language-country-selector.open .gol-selector-modal {
    display: block;
}


.gol-selector-content {

    display: grid;

    grid-template-columns: 1fr 1.4fr;

    gap: 25px;
}


fieldset.gol-selector-column {

    border: none;

    padding: 0;

    margin: 0;
}


fieldset.gol-selector-column legend {

    width: 100%;

    padding: 0;

    display: block;

    float: left;
}


.gol-selector-column h3 {

    font-size: 14px;

    margin: 0 0 10px;
}


.gol-option {

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 8px;

    border-radius: 6px;

    cursor: pointer;

    min-height: 40px;

    font-size: 13px;

    clear: both;
}


.gol-option:hover,
.gol-option.gol-selected {

    background: #f2f5ff;

    border-radius: 4px;
}


.gol-option input[type="radio"]:focus-visible {

    outline: 2px solid #ff7020;

    outline-offset: 2px;
}


.gol-language-info,
.gol-country-info {

    display: flex;

    gap: 8px;

    align-items: center;

    width: 90px;
}


.gol-flag {

    width: 18px;

    height: 18px;

    border-radius: 50%;

    object-fit: cover;
}


.gol-currency {

    font-weight: 500;

    font-size: 14px;
}


.gol-selector-actions {

    grid-column: 1 / -1;

    display: flex;

    justify-content: flex-end;

    margin-top: -23px;
}


.gol-apply-button {

    background: #ff7020;

    color: #fff;

    border: none;

    padding: 12px 24px;

    border-radius: 100px;

    font-weight: bold;

    cursor: pointer;
}


.gol-apply-button:focus-visible {

    outline: 2px solid #000;

    outline-offset: 2px;
}


.gol-language-country-selector input[type="radio"] {

    -webkit-appearance: none;

    appearance: none;

    width: 24px;

    height: 24px;

    border: 1.5px solid var(--unselected-border, #D8D0CB);

    border-radius: 50%;

    position: relative;

    margin: 0;
}


.gol-language-country-selector input[type="radio"]:checked {

    background-color: #FF7020;

    border-color: #FF7020;
}


.gol-language-country-selector input[type="radio"]:checked:after {

    content: "";

    width: 8px;

    height: 8px;

    background-color: #100D0A;

    border-radius: 50%;

    position: absolute;

    top: 50%;

    left: 50%;

    transform: translate(-50%, -50%);
}


/* Classe de acessibilidade para textos invisíveis */

.sr-only {

    position: absolute;

    width: 1px;

    height: 1px;

    padding: 0;

    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);

    white-space: nowrap;

    border-width: 0;
}



@media (max-width: 768px) {

    .gol-language-country-selector.open .gol-selector-modal {

        width: 100vw !important;

        position: fixed;

        top: 50px;

        left: 0;

        right: 0;

        overflow-y: scroll;

        height: calc(100vh - 50px);
    }


    .gol-selector-modal {

        box-shadow: none !important;
    }


    .gol-selector-content {

        display: flex;

        flex-direction: column;
    }


    .gol-option {

        width: 100%;
    }


    .gol-country-info {

        width: 203px;
    }


    .gol-selector-actions {

        justify-content: center;

        margin-top: 0;
    }


    .gol-apply-button {

        width: 312px;

        height: 48px;
    }

}



@font-face {

    font-family: GOL Sans Display;

    src: url("./media/GOLSansDisplay-Bold.ttf") format("truetype");

    font-weight: 700;
}


@font-face {

    font-family: GOL Sans Display;

    src: url("./media/GOLSansDisplay-Medium.ttf") format("truetype");

    font-weight: 500;
}


@font-face {

    font-family: GOL Sans Display;

    src: url("./media/GOLSansDisplay-Regular.ttf") format("truetype");

    font-weight: 400;
}


@font-face {

    font-family: GOL Sans Display;

    src: url("./media/GOLSansDisplay-SemiBold.ttf") format("truetype");

    font-weight: 600;
}

</style>
                   <script>

(function () {

    var selectors =
        document.querySelectorAll(
            ".gol-language-country-selector"
        );

    var root =
        selectors[selectors.length - 1];


    if (!root) {
        return;
    }



    var CULTURE_COOKIE = "cultureCode";

    var CURRENCY_COOKIE = "currencyCode";



    function isVoegolDomain(hostname) {

        return (
            hostname === "voegol.com.br" ||
            hostname.slice(-14) === ".voegol.com.br"
        );

    }



    function getCookieWriteDomain() {

        var hostname =
            window.location.hostname;


        if (
            hostname &&
            isVoegolDomain(hostname)
        ) {

            return ".voegol.com.br";
        }


        return "";
    }



    function getCookieDomainCandidates() {

        var hostname =
            window.location.hostname;


        var domains = [""];


        if (hostname) {

            domains.push(hostname);

            domains.push("." + hostname);


            if (isVoegolDomain(hostname)) {

                domains.push(
                    ".voegol.com.br"
                );
            }
        }


        var uniqueDomains = [];

        var used = {};


        for (
            var i = 0;
            i < domains.length;
            i++
        ) {

            if (!used[domains[i]]) {

                uniqueDomains.push(
                    domains[i]
                );

                used[domains[i]] = true;
            }
        }


        return uniqueDomains;
    }



    function deleteCookie(name) {

        var paths = [
            "/",
            "/pt",
            "/pt/",
            "/en",
            "/en/",
            "/es",
            "/es/",
            window.location.pathname
        ];


        var domains =
            getCookieDomainCandidates();


        var secure =
            window.location.protocol === "https:"
                ? "; Secure"
                : "";


        for (
            var i = 0;
            i < paths.length;
            i++
        ) {

            for (
                var j = 0;
                j < domains.length;
                j++
            ) {

                var domain =
                    domains[j]
                        ? "; domain=" + domains[j]
                        : "";


                document.cookie =
                    name +
                    "=; expires=Thu, 01 Jan 1970 00:00:00 GMT;" +
                    " Max-Age=0;" +
                    " path=" + paths[i] +
                    domain +
                    "; SameSite=Lax" +
                    secure;
            }
        }

    }



    function saveCookie(
        name,
        value,
        days
    ) {

        deleteCookie(name);


        var expiration =
            new Date();


        var maxAge =
            days * 24 * 60 * 60;


        var writeDomain =
            getCookieWriteDomain();


        var domain =
            writeDomain
                ? "; domain=" + writeDomain
                : "";


        var secure =
            window.location.protocol === "https:"
                ? "; Secure"
                : "";


        expiration.setTime(
            expiration.getTime() +
            maxAge * 1000
        );


        document.cookie =
            name +
            "=" +
            encodeURIComponent(value) +
            "; expires=" +
            expiration.toUTCString() +
            "; Max-Age=" +
            maxAge +
            "; path=/" +
            domain +
            "; SameSite=Lax" +
            secure;


        if (!getCookie(name)) {

            document.cookie =
                name +
                "=" +
                encodeURIComponent(value) +
                "; expires=" +
                expiration.toUTCString() +
                "; Max-Age=" +
                maxAge +
                "; path=/" +
                "; SameSite=Lax" +
                secure;
        }

    }



    function getCookie(name) {

        var prefix =
            name + "=";


        var cookies =
            document.cookie
                ? document.cookie.split(";")
                : [];


        var value = null;


        for (
            var i = 0;
            i < cookies.length;
            i++
        ) {

            var cookie =
                cookies[i].trim();


            if (
                cookie.indexOf(prefix) === 0
            ) {

                value =
                    decodeURIComponent(
                        cookie.substring(
                            prefix.length
                        )
                    );
            }
        }


        return value;
    }



    function setLocalValue(
        name,
        value
    ) {

        try {

            window.localStorage.setItem(
                name,
                value
            );

        } catch (e) {}

    }



    function getLocalValue(name) {

        try {

            return window.localStorage.getItem(
                name
            );

        } catch (e) {

            return null;
        }

    }



    function normalizeCode(value) {

        if (!value) {

            return "";
        }


        return String(value)
            .trim()
            .toUpperCase();

    }



    function getCultureCodeFromRadio(
        radio
    ) {

        if (!radio) {

            return "";
        }


        return normalizeCode(
            radio.getAttribute(
                "data-culture-code"
            ) ||
            radio.value
        );

    }



    function getCurrencyCodeFromRadio(
        radio
    ) {

        if (!radio) {

            return "";
        }


        return normalizeCode(
            radio.getAttribute(
                "data-currency-code"
            )
        );

    }



    function findCultureRadio(
        cultureCode
    ) {

        cultureCode =
            normalizeCode(
                cultureCode
            );


        if (!cultureCode) {

            return null;
        }


        var radios =
            root.querySelectorAll(
                'input[name="golCulture"]'
            );


        for (
            var i = 0;
            i < radios.length;
            i++
        ) {

            if (
                getCultureCodeFromRadio(
                    radios[i]
                ) === cultureCode
            ) {

                return radios[i];
            }
        }


        return null;

    }



    function getDefaultCultureRadio() {

        return (
            findCultureRadio("BR") ||
            root.querySelector(
                'input[name="golCulture"]'
            )
        );

    }



    function saveCultureAndCurrency(
        cultureCode,
        currencyCode
    ) {

        cultureCode =
            normalizeCode(
                cultureCode
            );


        currencyCode =
            normalizeCode(
                currencyCode
            );


        if (!cultureCode) {

            cultureCode = "BR";
        }


        if (!currencyCode) {

            currencyCode = "BRL";
        }


        saveCookie(
            CULTURE_COOKIE,
            cultureCode,
            365
        );


        saveCookie(
            CURRENCY_COOKIE,
            currencyCode,
            365
        );


        setLocalValue(
            CULTURE_COOKIE,
            cultureCode
        );


        setLocalValue(
            CURRENCY_COOKIE,
            currencyCode
        );


        return {

            cultureCode:
                cultureCode,

            currencyCode:
                currencyCode
        };

    }



    function getSelectedStoredCultureCode() {

        return (
            normalizeCode(
                getCookie(
                    CULTURE_COOKIE
                )
            ) ||
            normalizeCode(
                getLocalValue(
                    CULTURE_COOKIE
                )
            )
        );

    }



    function getSelectedStoredCurrencyCode() {

        return (
            normalizeCode(
                getCookie(
                    CURRENCY_COOKIE
                )
            ) ||
            normalizeCode(
                getLocalValue(
                    CURRENCY_COOKIE
                )
            )
        );

    }



    function ensureDefaultCultureCode() {

        var cultureCode =
            getSelectedStoredCultureCode();


        if (!cultureCode) {

            var defaultRadio =
                getDefaultCultureRadio();


            var defaultCultureCode =
                defaultRadio
                    ? getCultureCodeFromRadio(
                        defaultRadio
                    )
                    : "BR";


            var defaultCurrencyCode =
                defaultRadio
                    ? getCurrencyCodeFromRadio(
                        defaultRadio
                    )
                    : "BRL";


            var saved =
                saveCultureAndCurrency(
                    defaultCultureCode,
                    defaultCurrencyCode
                );


            cultureCode =
                saved.cultureCode;
        }


        return cultureCode;

    }



    function restoreCultureSelection() {

        var cultureCode =
            ensureDefaultCultureCode();


        var radio =
            findCultureRadio(
                cultureCode
            );


        if (!radio) {

            radio =
                getDefaultCultureRadio();
        }


        if (radio) {

            radio.checked = true;


            var selectedCultureCode =
                getCultureCodeFromRadio(
                    radio
                );


            var selectedCurrencyCode =
                getCurrencyCodeFromRadio(
                    radio
                );


            if (
                selectedCultureCode !==
                    getSelectedStoredCultureCode() ||
                !getSelectedStoredCurrencyCode()
            ) {

                saveCultureAndCurrency(
                    selectedCultureCode,
                    selectedCurrencyCode
                );
            }

        }

    }



    function refreshSelected() {

        var options =
            root.querySelectorAll(
                ".gol-option"
            );


        for (
            var i = 0;
            i < options.length;
            i++
        ) {

            var input =
                options[i].querySelector(
                    "input"
                );


            if (
                input &&
                input.checked
            ) {

                options[i].classList.add(
                    "gol-selected"
                );

            } else {

                options[i].classList.remove(
                    "gol-selected"
                );
            }

        }

    }



    function changeLanguage(
        languageId
    ) {

        if (
            !window.Liferay ||
            !Liferay.ThemeDisplay
        ) {

            window.location.reload();

            return;
        }


        var pathMain =
            Liferay.ThemeDisplay.getPathMain();


        var plid =
            Liferay.ThemeDisplay.getPlid();


        var auth =
            Liferay.authToken || "";


        /*
         * Mantém exatamente o pathname atual.
         *
         * Exemplo:
         *
         * /destinos
         *
         * continua:
         *
         * /destinos
         *
         * Nenhuma "/" é adicionada ao final.
         *
         * O parâmetro "location" não é utilizado.
         * Caso ele já exista na URL atual, é removido
         * antes de montar o redirect.
         */
        var params =
            new URLSearchParams(
                window.location.search
            );


        params.delete(
            "location"
        );


        var queryString =
            params.toString();


        var redirect =
            window.location.pathname +
            (
                queryString
                    ? "?" + queryString
                    : ""
            ) +
            window.location.hash;


        var url =
            pathMain +
            "/portal/update_language" +
            "?p_l_id=" +
            encodeURIComponent(plid) +
            "&languageId=" +
            encodeURIComponent(
                languageId
            ) +
            "&redirect=" +
            encodeURIComponent(
                redirect
            );


        if (auth) {

            url +=
                "&p_auth=" +
                encodeURIComponent(
                    auth
                );
        }


        window.location.href = url;

    }



    /*
     * IMPORTANTE
     *
     * A antiga rotina abaixo foi removida:
     *
     * window.addEventListener("load", function () {
     *     if (!window.location.pathname.endsWith("/")) {
     *         history.replaceState(...);
     *     }
     * });
     *
     * Ela era responsável por transformar:
     *
     * /destinos
     *
     * em:
     *
     * /destinos/
     */



    ensureDefaultCultureCode();

    restoreCultureSelection();

    refreshSelected();



    var trigger =
        root.querySelector(
            ".gol-selector-trigger"
        );


    var form =
        root.querySelector(
            ".gol-settings-form"
        );


    var modalElement =
        root.querySelector(
            ".gol-selector-modal"
        );


    var focusableSelectors =
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';



    function closeModal() {

        root.classList.remove(
            "open"
        );


        if (trigger) {

            trigger.setAttribute(
                "aria-expanded",
                "false"
            );


            trigger.focus();
        }

    }



    if (trigger) {

        trigger.onclick =
            function (event) {

                event.preventDefault();


                var isOpen =
                    root.classList.contains(
                        "open"
                    );


                if (isOpen) {

                    closeModal();

                    return;
                }


                root.classList.add(
                    "open"
                );


                trigger.setAttribute(
                    "aria-expanded",
                    "true"
                );


                restoreCultureSelection();

                refreshSelected();


                if (modalElement) {

                    var focusableElements =
                        modalElement.querySelectorAll(
                            focusableSelectors
                        );


                    if (
                        focusableElements.length > 0
                    ) {

                        setTimeout(
                            function () {

                                focusableElements[0]
                                    .focus();

                            },
                            10
                        );
                    }

                }

            };

    }



    document.addEventListener(
        "click",
        function (event) {

            if (
                !root.classList.contains(
                    "open"
                )
            ) {

                return;
            }


            if (
                !root.contains(
                    event.target
                )
            ) {

                closeModal();
            }

        }
    );



    root.addEventListener(
        "keydown",
        function (event) {

            if (
                !root.classList.contains(
                    "open"
                )
            ) {

                return;
            }


            var isEscPressed =
                event.key === "Escape" ||
                event.key === "Esc" ||
                event.keyCode === 27;


            var isTabPressed =
                event.key === "Tab" ||
                event.keyCode === 9;



            if (isEscPressed) {

                closeModal();

                return;
            }



            if (
                isTabPressed &&
                modalElement
            ) {

                var focusableElements =
                    modalElement.querySelectorAll(
                        focusableSelectors
                    );


                if (
                    focusableElements.length === 0
                ) {

                    return;
                }


                var firstFocusableElement =
                    focusableElements[0];


                var lastFocusableElement =
                    focusableElements[
                        focusableElements.length - 1
                    ];


                if (event.shiftKey) {

                    if (
                        document.activeElement ===
                        firstFocusableElement
                    ) {

                        lastFocusableElement.focus();

                        event.preventDefault();
                    }

                } else {

                    if (
                        document.activeElement ===
                        lastFocusableElement
                    ) {

                        firstFocusableElement.focus();

                        event.preventDefault();
                    }

                }

            }

        }
    );



    root.onchange =
        function () {

            refreshSelected();

        };



    if (form) {

        form.onsubmit =
            function (event) {

                event.preventDefault();


                var selectedLanguage =
                    root.querySelector(
                        'input[name="golLanguage"]:checked'
                    );


                var selectedCulture =
                    root.querySelector(
                        'input[name="golCulture"]:checked'
                    );


                if (!selectedCulture) {

                    selectedCulture =
                        getDefaultCultureRadio();


                    if (selectedCulture) {

                        selectedCulture.checked =
                            true;
                    }

                }


                var cultureCode =
                    selectedCulture
                        ? getCultureCodeFromRadio(
                            selectedCulture
                        )
                        : "BR";


                var currencyCode =
                    selectedCulture
                        ? getCurrencyCodeFromRadio(
                            selectedCulture
                        )
                        : "BRL";


                saveCultureAndCurrency(
                    cultureCode,
                    currencyCode
                );


                /*
                 * Evita erro caso, por algum motivo,
                 * nenhum idioma esteja marcado.
                 */
                if (selectedLanguage) {

                    changeLanguage(
                        selectedLanguage.value
                    );

                } else {

                    window.location.reload();

                }

            };

    }


})();

</script>
