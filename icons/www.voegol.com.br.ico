  <script type="text/javascript">
Liferay.on(
	'ddmFieldBlur', function(event) {
		if (window.Analytics) {
			Analytics.send(
				'fieldBlurred',
				'Form',
				{
					fieldName: event.fieldName,
					focusDuration: event.focusDuration,
					formId: event.formId,
					formPageTitle: event.formPageTitle,
					page: event.page,
					title: event.title
				}
			);
