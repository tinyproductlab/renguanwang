             <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-cf047464-ae20-63e4-bae7-c1b4748d132c'); const fragmentElementId = 'fragment-cf047464-ae20-63e4-bae7-c1b4748d132c'; const fragmentEntryLinkNamespace = 'ixaz'; const fragmentNamespace = 'ixaz'; const layoutMode = 'view';(function () {
    "use strict";

    function getCookie(name) {
        const value = "; " + document.cookie;
        const parts = value.split("; " + name + "=");
        if (parts.length === 2) {
            return parts.pop().split(";").shift();
        }
        return "";
    }

    function getCulture() {
        let language = "";

        if (typeof themeDisplay !== "undefined" && themeDisplay.getLanguageId) {
            language = themeDisplay.getLanguageId();
        } else {
            language = getCookie("GUEST_LANGUAGE_ID");
        }

        switch (language) {
            case "en_US":
                return { accessAccountCulture: "en-us", buttonCulture: "en" };
            case "es_ES":
                return { accessAccountCulture: "es-es", buttonCulture: "es" };
            case "fr_FR":
                return { accessAccountCulture: "fr-fr", buttonCulture: "fr" };
            case "pt_BR":
            default:
                return { accessAccountCulture: "pt-br", buttonCulture: "pt" };
        }
    }

    function updateLinks() {
        const culture = getCulture();

        // ACESSAR CONTA
        const accessAccountBtns = document.querySelectorAll("#voegol-access-account-link, .voegol-access-account-link");
        accessAccountBtns.forEach(function (btn) {
            try {
                const currentHref = btn.getAttribute("data-href");
                if (currentHref && currentHref !== "#") {
                    const url = new URL(currentHref);
                    if (url.searchParams.get("culture") !== culture.accessAccountCulture) {
                        url.searchParams.set("culture", culture.accessAccountCulture);
                        btn.setAttribute("data-href", url.toString());
                    }
                }
            } catch (error) {
                console.error("Erro ao configurar culture do Acessar Conta:", error);
            }
        });

        // CRIAR CONTA
        const createAccountBtns = document.querySelectorAll("#voegol-create-account-link, .voegol-create-account-link");
        createAccountBtns.forEach(function (btn) {
            try {
                const currentHref = btn.getAttribute("data-href");
                if (currentHref && currentHref !== "#") {
                    const url = new URL(currentHref);
                    if (url.searchParams.get("culture") !== culture.buttonCulture) {
                        url.searchParams.set("culture", culture.buttonCulture);
                        btn.setAttribute("data-href", url.toString());
                    }
                }
            } catch (error) {
                console.error("Erro ao configurar culture do Criar Conta:", error);
            }
        });
    }

    // Inicialização
    function initCultureCode() {
        updateLinks();
        setTimeout(updateLinks, 300);
        setTimeout(updateLinks, 1000);
        setTimeout(updateLinks, 2500); 
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCultureCode);
    } else {
        initCultureCode();
    }

    // Liferay SPA
    if (typeof Liferay !== "undefined") {
        Liferay.on("endNavigate", function () {
            initCultureCode();
        });
    }

    // Data Layer global
    window.headerButtonsTargget = function (event, conteudoSelecionado, index) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
            event: "select_content",
            dl_infos: {
                select_content: "content_menu_" + conteudoSelecionado,
                shelf: "Menu",
                index: index,
            },
        });
    };

})();;</script>
