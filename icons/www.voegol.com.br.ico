        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font: inherit;
        color: inherit;
    }

    .sr-only {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }

    .btn-unstyled:focus-visible,
    .voegol-header a:focus-visible,
    .voegol-header button:focus-visible {
        outline: 2px solid #ff7a00;
        outline-offset: 4px;
        border-radius: 4px;
    }

    .has-submenu:hover>.submenu,
    .has-submenu:focus-within>.submenu,
    .voegol-header__navigation li:hover>ul,
    .voegol-header__navigation li:focus-within>ul,
    .voegol-header__navigation li:hover>div,
    .voegol-header__navigation li:focus-within>div {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
    }

    .submenu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: #ffffff;
        list-style: none;
        margin: 0;
        padding: 16px;
        box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.12);
        border-radius: 16px;
        z-index: 1000;
    }

    .voegol-header {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .voegol-header__container {
        display: flex;
        align-items: center;
        width: 1360px;
    }

    .voegol-header__navigation {
        width: 856px;
    }

    .voegol-header__idiomas .portlet {
        margin-bottom: 0;
    }

    .voegol-header__menu {
        display: none;
    }

    .voegol-header__logo__mobile {
        display: none;
    }

    #voegol-header-overlay {
        padding: 16px 24px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #ffffff;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s, visibility 0.5s;
        z-index: 1000;
    }

    @media screen and (max-width: 1260px) {
        .voegol-header__logo__mobile {
            display: block;
            order: 1;
            margin-right: auto;
        }

        .voegol-header__container {
            width: 90vw;
            background: #ffffff;
            display: flex;
            justify-content: space-between;
            z-index: 1000;
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            padding-left: 25px;
            padding-right: 25px;
            height: 56px;
        }

        .voegol-header__navigation {
            width: auto;
        }

        .voegol-header__buttons,
        .voegol-header__idiomas,
        .voegol-header__search,
        .voegol-header__navigation {
            display: none;
            padding: 0;
        }

        .voegol-header__notification {
            order: 2;
            margin-right: 16px;
        }

        .voegol-header__menu.btn-unstyled {
            display: flex;
            order: 3;
        }

        #voegol-header-overlay.active {
            opacity: 1;
            visibility: visible;
            overflow-y: auto;
            width: 100vw;
            padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
            box-sizing: border-box;
        }

        #voegol-header-overlay.active .gol-selector-actions {
            position: sticky;
            bottom: 0;
            background: #ffffff;
            z-index: 1001;
            padding: 16px 0 calc(16px + env(safe-area-inset-bottom, 0px));
        }

        #voegol-header-overlay.active .gol-selector-content {
            padding-bottom: 140px;
