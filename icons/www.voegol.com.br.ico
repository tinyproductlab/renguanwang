          </div>
         </div>
        </div>
       </div>
       <style>.gol-chat-controller {
    display: contents;
}

.gol-chat-slot {
    display: none;
}

.gol-chat-slot.is-active {
    display: block;
}</style>
       <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-d18fa9bb-3f07-6974-2715-43793a4bd618'); const fragmentElementId = 'fragment-d18fa9bb-3f07-6974-2715-43793a4bd618'; const fragmentEntryLinkNamespace = 'qewj'; const fragmentNamespace = 'qewj'; const layoutMode = 'view';;(function () {
    const LOG_PREFIX = '[GOL Chat Controller]';

    function getCookie(name) {
        const cookies = document.cookie.split(';');

        for (let i = 0; i < cookies.length; i++) {
            const cookie = cookies[i].trim();

            if (cookie.indexOf(name + '=') === 0) {
                return decodeURIComponent(
                    cookie.substring(name.length + 1)
                );
            }
        }

        return null;
    }

    function getCultureCode() {
        return (
            getCookie('cultureCode') || 'BR'
        ).toUpperCase();
    }

    function getCurrentPath() {
        let path = window.location.pathname || '/';

        if (path.length > 1) {
            path = path.replace(/\/+$/, '');
        }

        return path.toLowerCase();
    }

    function isAgenciasPage() {
        return /(^|\/)agencias$/.test(
            getCurrentPath()
        );
    }

    function getSelectedChat() {
        const cultureCode = getCultureCode();

        /*
         * Regra atual:
         *
         * cultureCode diferente de BR
         * OU
         * página /agencias
         *
         * => B2C
         *
         * Caso contrário
         *
         * => GAL
         */
        if (
            cultureCode !== 'BR' ||
            isAgenciasPage()
        ) {
            return 'b2c';
        }

        return 'gal';
    }

    function dispatchChatEvent(chat, action) {
        const eventName =
            'gol-chat-' + chat + '-' + action;

        console.log(
            LOG_PREFIX,
            'Disparando evento:',
            eventName
        );

        window.dispatchEvent(
            new CustomEvent(eventName)
        );
    }

    function updateDropzones(selectedChat) {
        const slots =
            document.querySelectorAll(
                '.gol-chat-slot'
            );

        slots.forEach(function (slot) {
            const chat =
                slot.getAttribute(
                    'data-chat-slot'
                );

            if (chat === selectedChat) {
                slot.classList.add('is-active');
            }
            else {
                slot.classList.remove('is-active');
            }
        });
    }

    function evaluateChat() {
        const cultureCode = getCultureCode();
        const path = getCurrentPath();
        const selectedChat = getSelectedChat();

        console.log(
            LOG_PREFIX,
            'Avaliando chat.',
            {
                cultureCode: cultureCode,
                path: path,
                selectedChat: selectedChat
            }
        );

        updateDropzones(selectedChat);

        if (selectedChat === 'b2c') {
            dispatchChatEvent(
                'gal',
                'deactivate'
            );

            dispatchChatEvent(
                'b2c',
                'activate'
            );
        }
        else {
            dispatchChatEvent(
                'b2c',
                'deactivate'
            );

            dispatchChatEvent(
                'gal',
                'activate'
            );
        }
    }

    /*
     * Permite que os fragmentos filhos
     * descubram qual chat deveria estar ativo
     * caso sejam inicializados depois do controller.
     */
    window.GOLChatController = {
        evaluate: evaluateChat,

        getSelectedChat: getSelectedChat
    };

    evaluateChat();

    /*
     * SPA Liferay
     */
    if (
        window.Liferay &&
        typeof window.Liferay.on === 'function'
    ) {
        if (
            window.__golChatNavigationHandler &&
            typeof window.Liferay.detach === 'function'
        ) {
            window.Liferay.detach(
                'endNavigate',
                window.__golChatNavigationHandler
            );
        }

        window.__golChatNavigationHandler =
            function () {
                console.log(
                    LOG_PREFIX,
                    'Navegação SPA detectada.'
                );

                window.setTimeout(
                    evaluateChat,
                    100
                );
            };

        window.Liferay.on(
            'endNavigate',
            window.__golChatNavigationHandler
        );
    }

    /*
     * Quando a página for restaurada pelo browser.
     */
    window.addEventListener(
        'pageshow',
        evaluateChat
    );
})();;</script>
