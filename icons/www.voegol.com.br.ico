             <style>.voegol-header-search-container {
	width: 40px;
	height: 48px;
	position: relative;
	transition: width 0.5s ease-in-out;
}

.voegol-header-search-container.active {
	width: 312px;
}

.voegol-header-search {
	width: 100%;
	height: 100%;
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
}

.voegol-search-input {
	width: 0;
  font-size: 16px;
	border: 1px solid #ccc;
	opacity: 0;
  font-size: 16px;
	font-weight: 400;
	line-height: 16px;
	text-align: left;
	text-underline-position: from-font;
	text-decoration-skip-ink: none;

}

.voegol-header-search.active .voegol-search-input {
	opacity: 1;
	width: 100%;
	height: 100%;
}

.voegol-search-placeholder {
  position: absolute;
  top: 14px;
  font-size: 12px;
  left: 0px;
	height:12px;
  transform: translateY(-50%);
  pointer-events: none;
  transition: all 0.2s ease;
	display:none;
}

.voegol-header-search.active .voegol-search-placeholder {
		display:block;
}

.voegol-header-search i {
	position: absolute;
	cursor: pointer;
	font-size: 16px;
}

.voegol-header-search .icon-search {
	right: 20px;
	top: 50%;
	transform: translateY(-50%);
  transition: all 0.2s ease;
}

.voegol-header-search .icon-remove {
	right: 50px;
	top: 50%;
	transform: translateY(-50%);
  transition: all 0.2s ease;
	display: none;
}

.voegol-header-search.active .icon-remove {
	display: block;
}

.voegol-header-search-dropdown {
	position: absolute;
	display: none;
	height: 0;
	top: 80px;
	right: 0;
	z-index:10;
}

.voegol-header-search-dropdown.active {
	display: block;
}

.veogol-header-search-dropdown-content{
	width: 1220px;
}

.voegol-header-search-container{
	font-size: 14px;
	font-weight: 500;
	line-height: 16px;
	text-align: left;
}

.voegol-fixed-suggestions{
	width: 288px;
	height: 296px;
	background-color:#F3F0ED;

}

.fixed-suggestion-icon{
	width:40px;
	height:40px;
	background-color: white;
}

.voegol-dynamic{
	height: 296px;
	width: 100%;
	background-color:white;
}
.voegol-dynamic-results{
	overflow-y: auto;
	height: 252px;
	display: flex;
	flex-direction: column;
	width:100%;
}

.voegol-dynamic-results span{
	line-height: 18px;
	text-align: left;
}

.voegol-header-search-not-found-items{
	display:none;
}

.not-found-content-text h2{
	font-size: 32px;
	font-weight: 800;
	line-height: 40px;
	letter-spacing: -1px;
	text-align: left;
	text-underline-position: from-font;
	text-decoration-skip-ink: none;
}
.not-found-content-text p{
	font-size: 16px;
	font-weight: 400;
	line-height: 24px;
	text-align: left;
	text-underline-position: from-font;
	text-decoration-skip-ink: none;
}

/* Para navegadores baseados em WebKit (Chrome, Safari) */
.voegol-dynamic-results::-webkit-scrollbar {
	width: 10px;
}

.voegol-dynamic-results::-webkit-scrollbar-track {
	background: lightgray;
	border-radius: 10px;
}

.voegol-dynamic-results::-webkit-scrollbar-thumb {
	background-color: #00000080;
	border-radius: 10px;
	border: 3px solid lightgray;
}

@media screen and (max-width: 1260px){
	.voegol-header-search .voegol-search-input {
		opacity: 1;
		width: 100%;
		height: 100%;
		background: #F3F0ED;
		border:none;
	}
	
	.voegol-header-search-container {
		width: 272px;
		height: 64px;
	}
	
	.voegol-search-input:focus{
      border:1px solid black !important;
	}
	.voegol-search-placeholder {
		top:30px;
		position: absolute;
    font-size: 16px;
    height: 12px;
    display: block;
 }

	.voegol-search-placeholder-foculess{
			top:30px;
      font-size: 16px;   
	}
	
	.voegol-search-placeholder-focus{
			top:14px;
      font-size: 12px;
	}
 .voegol-fixed-suggestions{
		display:none !important;
	}
		.veogol-header-search-dropdown-content{
		 width: 272px !important;
		 box-shadow: none !important;
		 box-shadow: none !important;
		}
	.veogol-header-search-dropdown-content .voegol-dynamic{
	  padding:0 !important;
		border-top-left-radius: 0 !important;
    border-bottom-left-radius: 0 !important;
		padding:16px !important;
	}
	.not-found-content{
	  display:flex;
		flex-direction:column;
		align-items:center;
	}
	.not-found-content-text{
	  padding:0 !important;
		display:flex;
		flex-direction:column;
		align-items:center;
	}
	.not-found-content-image{
	 margin-left:0 !important;
	 margin-bottom: 24px;
	}
	
	.not-found-content-image img{
	  width:79px;
	}
	
	.not-found-content-text h2{
		font-size: 24px;
		font-weight: 600;
		line-height: 32px;
		text-align: center;
		width:184px;
		margin-bottom: 24px;
	}
	.not-found-content-text p{
    width: 230px;
		text-align: center;
		text-underline-position: from-font;
		text-decoration-skip-ink: none;
	}
	.not-found-content-text br {
      display: none;
   }
}</style>
             <script type="module">const configuration = {"itemSelector1":{"statusDate":1728657956933,"descriptionCurrentValue":"","smallImageId":"0","smallImage":false,"groupId":"20117","indexable":true,"description":"","className":"com.liferay.journal.model.JournalArticle","classNameId":"29540","title":"voegol-header-search Nehum Resultado","smallImageSource":1,"uuid":"9acbc230-f167-58dc-d938-bf03f6e1fc7e","scopeExternalReferenceCode":"","content":"<?xml version=\"1.0\"?>\n\n<root available-locales=\"pt_BR\" default-locale=\"pt_BR\" version=\"1.0\">\n\t<dynamic-element field-reference=\"image\" index-type=\"text\" instance-id=\"58s7nOTp\" name=\"Image56989292\" type=\"image\">\n\t\t<dynamic-content language-id=\"pt_BR\"><![CDATA[{\"groupId\":\"20117\",\"alt\":\"lupa\",\"name\":\"Group 55349.png\",\"width\":\"170\",\"description\":\"lupa\",\"title\":\"Group 55349.png\",\"type\":\"document\",\"uuid\":\"06170b1e-0cef-baf6-4a58-202ed9d72eaa\",\"fileEntryId\":\"129650\",\"resourcePrimKey\":537306,\"url\":\"/documents/d/guest/group-55349-png\",\"height\":\"168\"}]]><\/dynamic-content>\n\t<\/dynamic-element>\n\t<dynamic-element field-reference=\"heading\" index-type=\"text\" instance-id=\"cXhsn7nM\" name=\"RichText11909342\" type=\"rich_text\">\n\t\t<dynamic-content language-id=\"pt_BR\"><![CDATA[<h2>Nenhum resultado<br />\npara sua busca...<\/h2>]]><\/dynamic-content>\n\t<\/dynamic-element>\n\t<dynamic-element field-reference=\"supporting_text\" index-type=\"text\" instance-id=\"m3thBfnd\" name=\"RichText91488872\" type=\"rich_text\">\n\t\t<dynamic-content language-id=\"pt_BR\"><![CDATA[<p>Faça uma nova tentativa buscando por outra palavra-chave<br />\nou acesse nossas <strong><u>perguntas frequentes<\/u><\/strong>.<\/p>]]><\/dynamic-content>\n\t<\/dynamic-element>\n<\/root>","externalReferenceCode":"","classPK":"131242","lastPublishDate":null,"reviewDate":null,"layoutUuid":"","ctCollectionId":"0","descriptionMapAsXML":"","id":"131241","createDate":1728657956773,"expirationDate":null,"statusByUserId":"869554","smallImageURL":"","urlTitle":"voegol-header-search-nehum-resultado","articleId":"89766","defaultLanguageId":"pt_BR","userName":"Test Test","userId":"20122","version":1,"folderId":"130250","DDMTemplateKey":"","companyId":"22106540883819","DDMStructureId":"130315","titleMapAsXML":"<?xml version=\"1.0\" ?><root available-locales=\"pt_BR\" default-locale=\"pt_BR\"><Title language-id=\"pt_BR\">voegol-header-search Nehum Resultado<\/Title><\/root>","displayDate":1728657720000,"modifiedDate":1728657956933,"statusByUserName":"Danilo Buzar","mvccVersion":"111","titleCurrentValue":"voegol-header-search Nehum Resultado","resourcePrimKey":"131242","treePath":"/130250/","status":0},"collection":{"classPK":138472,"itemType":"com.liferay.journal.model.JournalArticle","className":"com.liferay.asset.list.model.AssetListEntry","itemSubtype":"89533","classNameId":"29435","title":"Sugestões fixas","type":"com.liferay.item.selector.criteria.InfoListItemSelectorReturnType"}}; const fragmentElement = document.querySelector('#fragment-077dfc8f-5ade-571a-b13f-8e5e4812e572'); const fragmentElementId = 'fragment-077dfc8f-5ade-571a-b13f-8e5e4812e572'; const fragmentEntryLinkNamespace = 'utmo'; const fragmentNamespace = 'utmo'; const layoutMode = 'view';document.addEventListener('DOMContentLoaded', () => {
  const searchButton = document.querySelector('.voegol-header-search .icon-search');
  const closeButton = document.querySelector('.voegol-header-search .icon-remove');
  const searchInput = document.querySelector('.voegol-search-input');
  const searchInputPlaceholder = document.querySelector('.voegol-search-placeholder');
  const searchContent = document.querySelector('.voegol-header-search');
  const searchContainer = document.querySelector('.voegol-header-search-container');
  const searchDropdown = document.querySelector('.voegol-header-search-dropdown');
  const dynamicResults = document.querySelector('.voegol-dynamic-results');
  const notFountResults =  document.querySelector('.voegol-header-search-not-found-items');
  const buttonsClass =  document.querySelector('.voegol-header__buttons__container');
  const buttonsClassMobile =  document.querySelector('.voegol-header-overlay__buttons');
  const navigationMobile =  document.querySelector('.voegol-header-overlay__navigation');
 
	searchInput.addEventListener('focus', () => {
		searchInputPlaceholder.classList.remove('voegol-search-placeholder-foculess');
	  searchInputPlaceholder.classList.add('voegol-search-placeholder-focus');

	});
	
	searchInput.addEventListener('blur', () => {
		searchInputPlaceholder.classList.remove('voegol-search-placeholder-focus');
		searchInputPlaceholder.classList.add('voegol-search-placeholder-foculess');
	});
	
	const toggleActiveClass = (elements) => {
    elements.forEach(element => element.classList.add('active'));
  };
	
	const toggleDesactiveClass = (elements) => {
    elements.forEach(element => element.classList.remove('active'));
  };
	
	const showNotFountResult = () =>{
		dynamicResults.style.display = "none";
		notFountResults.style.display = 'block';
	}
	
	const desableButtons = () =>{
		buttonsClass.style.display = "none";
		buttonsClassMobile.style.display = "none";
		navigationMobile.style.display = "none";
	}
	const activeButtons = () =>{
		buttonsClass.style.display = "block";
		buttonsClassMobile.style.display = "block";
		navigationMobile.style.display = "block";
	}
	
  const clearSearch = () => {
    searchInput.value = '';
    toggleDesactiveClass([searchContent, searchContainer, searchDropdown]);
  };
		
	searchButton.addEventListener('click', () => {
		desableButtons();
    const searchValue = searchInput.value.trim();
		if (searchValue != "" ) {
			toggleActiveClass([searchDropdown]);
			
      fetchSitePages(searchValue);
    } else {
      toggleActiveClass([searchContent, searchContainer, searchDropdown]);
    }
  });
	
	searchInput.addEventListener('keydown', (event) => {
		desableButtons();
		if (event.key === 'Enter') {
			const searchValue = searchInput.value.trim();
			if (searchValue != "") {
				fetchSitePages(searchValue);
			} else {
				toggleActiveClass([searchContent, searchContainer, searchDropdown]);
			}
		}
	});
	
  closeButton.addEventListener('click', clearSearch);
	
  document.addEventListener('click', (event) => {
    if (!searchContent.contains(event.target)) {
			activeButtons();
      clearSearch();
    }
  });

 async function fetchSitePages(keyword) {
  const site_id = themeDisplay.getSiteGroupId();
  const url = '/nh/resultado-busca?q=' + keyword + '&type=com.liferay.portal.kernel.model.Layout';
	const csrfToken = Liferay.authToken;
  try {
    const response = await fetch(url);
    const html = await response.text();
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const searchResults = doc.querySelectorAll('.list-group-title');
    
    if(searchResults.length > 0){
      createLinks(searchResults);
    }else{
      showNotFountResult();
    } 
  } catch (error) {
    console.error('Erro:', error);
  }
}

function createLinks(items) {
  dynamicResults.innerHTML = '';  // Limpa os resultados anteriores
  notFountResults.style.display = "none";  // Esconde a mensagem de "não encontrado"

  items.forEach(result => {
    const anchorElement = result.querySelector('a');

    if (anchorElement) {  // Verifica se o <a> existe
      anchorElement.classList.add("font-weight-normal", "text-reset", "text-decoration-none", "my-2");

      // Verifica se o <span> existe dentro do <a>
      const spanElement = anchorElement.querySelector('span');
      if (spanElement) {
        spanElement.classList.remove('highlight', 'mark');  // Remove as classes do <span>
      }

      // Adiciona o <a> ao container de resultados
      dynamicResults.appendChild(anchorElement);
      dynamicResults.style.display = "flex";  // Exibe o container de resultados
    }
  });

  // Se houver mais de 6 itens, habilita o scroll vertical
  if (items.length > 6) {
    dynamicResults.style.overflowY = 'scroll';
  }
}
});;</script>
