       <script type="module">const configuration = {}; const fragmentElement = document.querySelector('#fragment-b610bf91-05e8-5ee8-b521-1fd3a4cd508c'); const fragmentElementId = 'fragment-b610bf91-05e8-5ee8-b521-1fd3a4cd508c'; const fragmentEntryLinkNamespace = 'pebk'; const fragmentNamespace = 'pebk'; const layoutMode = 'view';const menu = document.querySelector('.voegol-header__menu');
    const back = document.querySelector('.overlay__header__back');
    const idiomas = document.querySelector('.voegol-header__idiomas');
    const search = document.querySelector('.voegol-header__search');
    const navigation = document.querySelector('.voegol-header__navigation');
    const buttons = document.querySelector('.voegol-header__buttons');
    const notification = document.querySelector('.voegol-header__notification');
    const avisos = document.querySelector('.voegol-avisos .voegol-avisos-mobile');
    const overlayElement = document.getElementById('voegol-header-overlay');
    const FOCUSABLE_SELECTORS = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    let previousActiveElement = null;

    const announceToScreenReader = (message) => {
        const announcer = document.getElementById('voegol-sr-announcer');
        if (!announcer) return;

        announcer.textContent = '';
        setTimeout(() => {
            announcer.textContent = message;
        }, 100);
    };

    const setupSubmenusAccessibility = () => {
        const menuItems = document.querySelectorAll('.voegol-header__navigation li, .has-submenu');

        menuItems.forEach((item, index) => {
            const trigger = item.querySelector('a, button');
            const submenuPanel = item.querySelector('ul, div, .submenu');

            if (!trigger || !submenuPanel) return;

            if (!submenuPanel.id) {
                submenuPanel.id = `voegol-submenu-panel-${index}`;
            }

            const menuName = trigger.textContent.trim();

            trigger.setAttribute('aria-haspopup', 'true');
            trigger.setAttribute('aria-controls', submenuPanel.id);

            if (!trigger.hasAttribute('aria-expanded')) {
                trigger.setAttribute('aria-expanded', 'false');
            }

            if (!submenuPanel.hasAttribute('role')) {
                submenuPanel.setAttribute('role', 'region');
                submenuPanel.setAttribute('aria-label', `Submenu ${menuName}`);
            }

            const openSubmenu = () => {
                if (trigger.getAttribute('aria-expanded') !== 'true') {
                    trigger.setAttribute('aria-expanded', 'true');

                    announceToScreenReader(`Submenu ${menuName} exibido com opções disponíveis.`);
                }
            };

            const closeSubmenu = (event) => {
                if (event && event.relatedTarget && item.contains(event.relatedTarget)) {
                    return;
                }
                if (trigger.getAttribute('aria-expanded') === 'true') {
                    trigger.setAttribute('aria-expanded', 'false');
                }
            };

            item.addEventListener('mouseenter', openSubmenu);
            item.addEventListener('mouseleave', closeSubmenu);

            item.addEventListener('focusin', openSubmenu);
            item.addEventListener('focusout', closeSubmenu);
        });
    };

    const handleFocusTrap = (event) => {
        if (event.key !== 'Tab') return;

        const focusableElements = Array.from(overlayElement.querySelectorAll(FOCUSABLE_SELECTORS))
            .filter(el => el.offsetWidth > 0 || el.offsetHeight > 0 || el.getClientRects().length > 0);

        if (focusableElements.length === 0) return;

        const firstFocusable = focusableElements[0];
        const lastFocusable = focusableElements[focusableElements.length - 1];

        if (event.shiftKey) {
            if (document.activeElement === firstFocusable) {
                event.preventDefault();
                lastFocusable.focus();
            }
        } else {
            if (document.activeElement === lastFocusable) {
                event.preventDefault();
                firstFocusable.focus();
            }
        }
    };

    const moveElement = () => {
        const overlayHeader = document.querySelector('.voegol-header-overlay__header');
        const overlaySearch = document.querySelector('.voegol-header-overlay__search');
        const overlayNavigation = document.querySelector('.voegol-header-overlay__navigation');
        const overlayButtons = document.querySelector('.voegol-header-overlay__buttons');
        const overlayAvisos = document.querySelector('.voeogl-header-overlay__avisos');

        if (idiomas && overlayHeader) overlayHeader.appendChild(idiomas);
        if (search && overlaySearch) overlaySearch.appendChild(search);
        if (navigation && overlayNavigation) overlayNavigation.appendChild(navigation);
        if (buttons && overlayButtons) overlayButtons.appendChild(buttons);

        if (avisos !== null && overlayAvisos) {
            overlayAvisos.appendChild(avisos);
        }

        if (buttons) {
            buttons.style.display = "flex";
            buttons.style.justifyContent = 'center';
        }

        if (navigation) {
            navigation.style.display = 'flex';
            navigation.style.justifyContent = 'center';
        }

        if (idiomas) idiomas.style.display = 'block';

        if (search) {
            search.style.display = 'flex';
            search.style.justifyContent = 'center';
        }

        if (avisos !== null) {
            avisos.style.display = 'flex';
        }
    };

    const rollbackElement = () => {
        const target = document.querySelector('.voegol-header');
        if (!target) return;

        if (idiomas) target.appendChild(idiomas);
        if (search) target.appendChild(search);
        if (navigation) target.appendChild(navigation);

        if (avisos !== null) {
            target.appendChild(avisos);
        }

        if (idiomas) idiomas.style.display = 'none';
        if (search) search.style.display = 'none';
        if (navigation) navigation.style.display = 'none';

        if (avisos !== null) {
            avisos.style.display = 'none';
        }
    };

    const showOverview = () => {
        previousActiveElement = document.activeElement;

        overlayElement.classList.add('active');
        overlayElement.setAttribute('aria-hidden', 'false');
        menu.setAttribute('aria-expanded', 'true');

        announceToScreenReader("Menu móvel aberto.");

        document.addEventListener('keydown', handleFocusTrap);

        setTimeout(() => {
            if (back) back.focus();
        }, 100);
    };

    const hideOverview = () => {
        overlayElement.classList.remove('active');
        overlayElement.setAttribute('aria-hidden', 'true');
        menu.setAttribute('aria-expanded', 'false');

        announceToScreenReader("Menu móvel fechado.");

        document.removeEventListener('keydown', handleFocusTrap);

        if (previousActiveElement && typeof previousActiveElement.focus === 'function') {
            previousActiveElement.focus();
        }
    };

    if (menu) {
        menu.addEventListener('click', () => {
            moveElement();
            showOverview();
        });
    }

    if (back) {
        back.addEventListener('click', () => {
            hideOverview();
            rollbackElement();
        });
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlayElement && overlayElement.classList.contains('active')) {
            hideOverview();
            rollbackElement();
        }
    });

    var domain = window.location.origin;
    const baseUrl = domain + "/o/headless-delivery/v1.0/content-structures/130282/structured-contents";

    function formatDateToISO(date) {
        return date.toISOString();
    }

    const toggleNotificationIcon = () => {
        localStorage.setItem('notificationState', 'off');
        changeImageSrc('off');
        localStorage.setItem('notificationClickDate', formatDateToISO(new Date()));
    };

    const changeImageSrc = (state) => {
        const element = document.querySelector('.voegol-header__notification__icon');
        const imgElement = document.querySelector('.voegol-header__notification__icon img');
        const linkElement = document.getElementById('notification-link');

        if (!imgElement) return;

        const imagePath = imgElement.src.replace("notification_inactive", "").replace("notification_active", "");
        const src_inactive = imagePath + "notification_inactive";
        const src_active = imagePath + "notification_active";

        imgElement.src = state === 'off' ? src_inactive : src_active;
        element.style.display = 'block';

        if (linkElement) {
            const alertText = state === 'off' ? 'Notificações' : 'Notificações, você tem novas mensagens';
            linkElement.setAttribute('aria-label', alertText);
        }
    };

    const fetchWithDateFilter = () => {
        let url = baseUrl;

        if (localStorage.getItem('notificationClickDate')) {
            url = url + "?filter=dateCreated ge " + encodeURIComponent(localStorage.getItem('notificationClickDate')) + "&p_auth=" + Liferay.authToken;
        }

        fetch(url)
            .then(response => response.json())
            .then(data => {
                if (data.items && data.items.length > 0) {
                    changeImageSrc('on');
                } else {
                    changeImageSrc('off');
                }
            })
            .catch(error => console.error('Erro na requisição de notificações:', error));
    };

    const removeLastPathSegment = (url) => {
        try {
            const urlObj = new URL(url, domain);
            const pathSegments = urlObj.pathname.split('/');

            if (pathSegments[pathSegments.length - 1] === '') {
                pathSegments.pop();
            }
            pathSegments.pop();

            return "/nh/gol-informa/noticias/gol-informa";
        } catch (error) {
            console.error('URL inválida:', error);
            return null;
        }
    };

    const hideSeventhServiceItem = () => {
        const path = window.location.pathname.toLowerCase();
        const segments = path.split('/').filter(Boolean);
        const firstSegment = segments[0] || '';

        const isLocale = /^[a-z]{2}-[a-z]{2}$/.test(firstSegment);
        const isPtBr = firstSegment === 'pt-br';

        if (isLocale && !isPtBr) {
            document.querySelectorAll('.submenu-voegol-card-desktop, .submenu-voegol-card-mobile')
                .forEach(container => {
                    const items = container.querySelectorAll('.submenu-voegol-cards');
                    if (items.length >= 7) {
                        items[6].style.display = 'none';
                    }
                });
        }
    };

    const updatePacotesLink = () => {
        const path = window.location.pathname.toLowerCase();
        const segments = path.split('/').filter(Boolean);
        const firstSegment = segments[0] || '';

        const isTargetLocale = firstSegment === 'es-ar' || firstSegment === 'es-uy';

        if (!isTargetLocale) return;

        const container = document.querySelector('.voegol-header__navigation__container');
        if (!container) return;

        const links = container.querySelectorAll('a');

        links.forEach(link => {
            const text = link.textContent.toLowerCase();

            if (text.includes('pacote') || text.includes('paquete')) {
                link.href = 'https://www.travelservices.com.ar/smiles/paquetes';
                link.target = '_blank';
            }
        });
    };

    const observeHeaderChanges = () => {
        const target = document.body;

        const observer = new MutationObserver(() => {
            updatePacotesLink();
            hideSeventhServiceItem();
            setupSubmenusAccessibility();
        });

        observer.observe(target, {
            childList: true,
            subtree: true
        });
    };

    document.addEventListener('DOMContentLoaded', () => {
        const anchorNotification = document.querySelector('.voegol-header__notification a');

        if (anchorNotification && typeof themeDisplay !== 'undefined') {
            const layoutRelativePath = themeDisplay.getLayoutRelativeURL();
            anchorNotification.href = removeLastPathSegment(layoutRelativePath);
            anchorNotification.addEventListener('click', toggleNotificationIcon);
        }

        const initialState = localStorage.getItem('notificationState') || 'on';

        if (initialState === 'off') {
            fetchWithDateFilter();
        } else {
            changeImageSrc(initialState);
        }

        hideSeventhServiceItem();
        updatePacotesLink();
        setupSubmenusAccessibility();

        setTimeout(() => {
            hideSeventhServiceItem();
            updatePacotesLink();
            setupSubmenusAccessibility();
        }, 500);

        observeHeaderChanges();
    });;</script>
      </div>
