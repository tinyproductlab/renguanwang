             <style>.voegol-header__navigation__container{
	width: 100%;
	height: 48px;
	display: flex;
	align-items: center;
	position:relative;
	background: #F3F0ED;
	border-radius:100px;
	padding: 14px 24px 14px 24px;
}

.voegol-header__navigation__dropdown__content{
	border-radius:32px;
	visibility: hidden;
	opacity: 0;
	position: absolute;
	top: 60px;
	background: #F3F0ED;
	width: 1360px;
	height: 336px;
	z-index: 99;
	transition: visibility 0s linear 0.3s, opacity 0.3s linear, top 0.3s ease-in-out;
	left:0;
}

.voegol-header__navigation__navItem{
	display:flex;
	align-items:center;
}

.voegol-header__navigation__navItem:hover .voegol-header__navigation__dropdown__content{
	visibility: visible;
	opacity: 1;
	transition-delay: 0s;
	z-index:999;
}

.voegol-header__navigation__navItem:hover {
	border-bottom:solid 2px orange;
}

.navItem_container_title a{
	font-size: 14px;
	font-weight: 600;
	line-height: 24px;
	text-align: left;
	cursor: pointer;
}

.toggle-dropdown{
 display:none;
}
@media screen and (max-width: 1260px){
	.voegol-header__navigation__container{
	   display:flex;
		 flex-direction:column;
		 align-items: flex-start;
		 width:272px;
		 height:auto;
		 background: white;
		 padding:0;
	}
	
	.voegol-header__navigation__logo{
	  display:none;
	}
	.voegol-header__navigation__navItem{
	  margin:0 !important;
		border-bottom:solid 1px #F2F2F2;
    height: auto;
	  width:272px;
    align-items: flex-start;
    flex-direction: column;
		justify-content: center;
	}
	.navItem_container_title{
		width:100%;
		height:54px;
		display:flex;
		align-items: center;
	  justify-content:space-between;
	}
	.voegol-header__navigation__navItem:last-child {
 		border-bottom:none !important;
  }
	.toggle-dropdown{
		display:block;
	}
	.voegol-header__navigation__dropdown__content{
		border-radius:none;
		visibility: visible;
		opacity: 1;
		position: static;
		background: #f3f0ed00;
		width: 272px;
		height:auto;
		z-index: none;
		transition: none;
		left:none;
		display:none;
		padding:0!important;
	}
	.voegol-header__navigation__navItem:hover {
		border-bottom:none;
}
}
@media (min-width: 576px) and (max-width: 992px) {
	.voegol-header__navigation__navItem, .voegol-header__navigation__container{
		width: 90vw;
	}
	
	.voegol-header__navigation__dropdown__content{
	  width:100% !important;
	}
}</style>
