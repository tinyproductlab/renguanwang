<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content="3; url=/" />
    <style>
        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            position: relative;
        }

        .container {
            position: absolute;
            left: 0;
            right: 0;
            padding: 60px;
            top: 50%;
            transform: translateY(-50%);
            text-align: center;
        }

        .button {
            background-color: rgb(239, 73, 68);
            color: white;
            padding: 10px 24px;
            text-decoration: none;
            border-radius: 4px;
            display: inline-block;
        }

        .button:hover {
            background-color: #d32f2f;
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="data:image/png;base64," title="error" style="width:180px;height:180px;" />
        <div id="errorText" style="margin-top: 18px; font-weight: 400; font-size: 18px; ">
            Page not found.
        </div>
        <div style="margin-top: 12px; color: #AAAAAA; font-size: 14px;">
            <span id="currentUrl"></span><br/>
            <span id="redirectingText">You will be redirected shortly.</span>
        </div>
        <div style="margin-top: 12px; font-size: 14px;">
            <a href="/" class="button"><span id="buttonText">Back to Home</span></a>
        </div>

        <script>
            document.getElementById("currentUrl").innerText = window.location.href;
            var userLang = navigator.language || navigator.userLanguage;
            if (userLang.toLowerCase().startsWith('zh')) {
                document.getElementById("errorText").innerText = '页面未找到';
                document.getElementById("redirectingText").innerText = '即将跳转到首页';
                document.getElementById("buttonText").innerText = '回到首页';
            }
        </script>
    </div>
</body>
</html>