<script>

(function () {
  const currentPage = window.location.pathname;
 
  // Stop banner for carbon calculator
  if (currentPage.includes('carbon-calculator.html')) {
    return;
  }

var s = document.createElement('script');
s.src = 'https://cdn-app2.securiti.ai/consent/cookie-consent-sdk-loader.js';
s.setAttribute('data-tenant-uuid', 'c4a6d174-33a2-4d67-9a8b-5c749f59b8b9');
s.setAttribute('data-domain-uuid', '2ceb2327-5850-423b-8265-b1d4da15914e');
s.setAttribute('data-backend-url', 'https://app2.securiti.ai');
s.setAttribute('data-skip-css', 'false');
s.defer = true;
window.SecuritiDataLayer = window.SecuritiDataLayer || [];
SecuritiDataLayer.push([
'beforeLoad',
(configSdk) => {
// Language Setting for HTML trigger
const pathSegment = window.location.pathname
.split('/')
.filter(Boolean)[0];
const languageMap = {
en: 'en',
bm: 'ms',
cn: 'zh'
};
const language = languageMap[pathSegment] || 'en';
configSdk.setLanguage(language);
}
]);
var parent_node = document.head || document.body;
parent_node.appendChild(s);
})();
</script>

<!-- THIS CODE IS FOR MANAGE COOKIE PREFERENCES BUTTON. --> 
<script>
(function () {
  const btn = document.createElement('button');

  btn.classList.add('cmp-revoke-consent', 'relative');
  btn.style.display = 'none';
  btn.textContent = 'Manage Cookie Preferences';

  document.head.appendChild(btn);
})();
</script>


<script>
(function () {
 
  function insertButton(container) {
 
// Checking for buttons
    var button = document.querySelector('.cmp-revoke-consent');
    if (!button) {
      console.log('Button not found. Waiting...');
      return;
    }
 
    // Checking for duplicate buttons
    if (container.contains(button)) {
      console.log('Button already exists in target container. Skip moving.');
      return;
    }
 
    console.log('Moving button into:', container);
 
    // Button Style
    button.style.backgroundColor = '#ffffff';
    button.style.color = '#333739';
    button.style.border = '2px solid #9a9a9b';
    button.style.padding = '0.25rem 0.6rem';
    button.style.borderRadius = '0px';
    button.style.fontWeight = '500';
    button.style.cursor = 'pointer';
    button.style.fontSize = '0.80rem';
    button.style.display = 'inline-block';
 
    if (window.innerWidth <= 768) {
      button.style.marginLeft = '1rem';
    } else {
      button.style.marginLeft = '4rem';
    }
 
    button.style.marginBottom = '1rem';
    button.style.marginTop = '1rem';
 
    button.style.setProperty('bottom', '0', 'important');
    button.style.setProperty('left', '0', 'important');

 
    // MOVE button
    if (container.tagName.toLowerCase() === 'footer') {
      container.insertBefore(button, container.firstChild);
    } else {
      container.appendChild(button);
    }
 
    console.log('Button successfully moved.');
  }
 
  // Waiting footer to move button
  function waitForFooter(timeout = 5000) {
    const start = Date.now();
 
    console.log('Waiting for footer or .footer-top...');
 
    const interval = setInterval(function () {
 
      var footerTop = document.querySelector('.footer-top');
      var footer = document.querySelector('footer');
      var button = document.querySelector('.cmp-revoke-consent');
 
      console.log('Checking availability...', {
        footerTopFound: !!footerTop,
        footerFound: !!footer,
        buttonFound: !!button
      });
 
      var container = footerTop || footer;
 
      if (container && button) {
        clearInterval(interval);
        console.log('Footer and button detected.');
        insertButton(container);
      }
 
      if (Date.now() - start > timeout) {
        clearInterval(interval);
        console.warn('Timeout: Footer or button not found within', timeout, 'ms');
      }
 
    }, 500);
  }
 
  if (document.readyState === 'loading') {
    console.log('DOM still loading...');
    document.addEventListener('DOMContentLoaded', function () {
      console.log('DOM fully loaded.');
      waitForFooter();
    });
  } else {
    console.log('DOM already ready.');
    waitForFooter();
  }
 
  // for conflict class
  var style = document.createElement('style');
  style.textContent = `
    .cmp-accordion {
      margin-bottom: 0px !important;
    }
.cc-window.cc-banner {
    position: fixed !important;
    z-index: 25000 !important;
  }
  .cmp-body,
  .cmp-body.show-modal,
  .cmp-modal,
  #cookiePreferencesDialog {
    position: fixed !important;
    z-index: 25003 !important;
  }
  `;
 
  document.head.appendChild(style);
 
})();

</script>
	
