                <script data-addon-configuration="DCF-10960" data-addon-configuration-type="js">
                    if (renderScript("true" === 'true', "", "")){
                         

  window.addEventListener('load', () => {

  function updateCounter() {
    const filterLabel = document.querySelector('[data-filter-results-label]');
      if (filterLabel) {
        const visibleCounter = document.querySelector('[data-visible-devices-counter]');
        const possibleDevicesCounter = document.querySelector('[data-possible-devices-counter]');
        if (visibleCounter && possibleDevicesCounter) {
          setTimeout(() => {
            filterLabel.textContent = `Showing ${visibleCounter.textContent} of ${possibleDevicesCounter.textContent} items`;
          }, 300);
        }
      }
  }

    const allListeners = ['explore-device-grid-compare', 'closeDropdown', 'updateSelection', 'hideThisConnectivityFilter']
      allListeners.forEach((listener) => {
        document.addEventListener(listener, (event) => {
            updateCounter();
        });
      });

    
    setTimeout(() => {
      updateCounter();
    }, 500);
      
  });

                    }
                </script>
            
        
