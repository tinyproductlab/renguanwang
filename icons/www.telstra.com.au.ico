                <script data-addon-configuration="DCCOE-12345" data-addon-configuration-type="js">
                    if (renderScript("true" === 'true', "", "")){
                        document.addEventListener('DOMContentLoaded', () => {
  const coupons = document.querySelectorAll(
    '.tcom-coupon-code--label, .tcom-coupon-code--shown, .tcom-fixed-plan-card__coupon-code--shown, .tcom-npageheader-content__coupon-code--label, .tcom-explore-plan-card__coupon-code--label, .tcom-pr__header__subheadline, .tcom-device-grid__product-card-heading-wrapper .tcom-able__text-fine-print, .device-product__title__brand, .multi-cart-summary__description__title'
  );
