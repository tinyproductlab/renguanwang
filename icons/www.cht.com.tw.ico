<script type="text/javascript">
    (function () {
        var $srarchbar = $('#search');

        $('#btnQuery').on('click', function () {
            goSearch();
        });

        $srarchbar.on('click', function () {
            if (window.sessionStorage["local"] != undefined)
                $srarchbar.val(window.sessionStorage["local"]);
        });
        var key;
        var favoriteTags = new Array();

        var favoriteTitle = '';
        var JSONfavoriteTags;
        var jsonkword = '';

        if (jsonkword != '') {
            JSONfavoriteTags = JSON.parse((jsonkword).replace(/&quot;/g, '"'));
            $.each(JSONfavoriteTags, function (key, value) {
                favoriteTags.push(value["Word"]);
            });
        }

        var searchStorage = window.sessionStorage["local"];
        if (searchStorage != undefined)
            $srarchbar.val(searchStorage);

        $srarchbar.on('keypress', function (event) {
            if (event.which == 13) {
                goSearch();
            }
        });

        function clickSearch(Value) {
            getValue(Value);
            goSearch();
        }

        function getValue(Value) {
            $srarchbar.val(Value);
        }

        function goSearch() {
            var user;
            var searchurl = 'https://www.cht.com.tw/home/consumer/searchresult';
            var query = $srarchbar.val();
            var homeurl = searchurl.split('/');
            let correctSearchResultId = "{19778477-E7C6-412D-8A14-A7B16927F414}";

            let isRepeatedQuery = checkKeyWordStorage(query);

            saveStorage(query);
            window.location.assign(searchurl + "?text=" + query + "&pageswitch=" + true + "&pagecurrentitem=" + correctSearchResultId + "&repeatedquery=" + isRepeatedQuery);
            showLoading();
        }

        function saveStorage(query) {
            window.sessionStorage["local"] = query;
        }

        $(document).ready(function () {
            if (searchStorage != null) {
                $srarchbar.val(searchStorage);
            }
        });

        $srarchbar.on('keydown', function (event) {
            if (event.keyCode == 8) {
                var ele = document.getElementById("recommend-results-2")
                while (ele.firstChild) {
                    ele.removeChild(ele.firstChild);
                    ele.firstChild = ele.firstChild;
                }
                var li2 = document.createElement("li");
                li2.setAttribute("class", "search-seperator");
                var small = document.createElement("small");
                small.innerHTML = favoriteTitle;
                li2.appendChild(small);
                ele.appendChild(li2);
                if (favoriteTags != null && favoriteTags.length > 0) {
                    favoriteTags.forEach(function (value) {
                        var li = document.createElement("li");
                        var a = document.createElement("a");
                        a.innerHTML = value;
                        a.classList.add("search-word");
                        li.appendChild(a);
                        ele.appendChild(li);
                    });

                    $('.search-word', ele).click(function () {
                        clickSearch(this.innerHTML);
                    });
                }
            }
        });

        var e = jQuery.Event('keydown');
        e.keyCode = 8; // # Some key code value
        $srarchbar.trigger(e);


        function checkKeyWordStorage(query) {
            let localKeyWord = window.sessionStorage["localKeyWord"];
            let arry = localKeyWord ? JSON.parse(localKeyWord) : [];
            let hasKeyWord = arry.indexOf(query) != -1;
            if (!hasKeyWord) {
                arry.push(query);
                window.sessionStorage["localKeyWord"] = JSON.stringify(arry);
            }
            return hasKeyWord;
        }

    })();
</script>
<!-- 倒數轉址-->
<script type='text/javascript'>
    setTimeout('countdown()', 1000);

    function countdown() {
        var s = document.getElementById('timer');
        s.innerHTML = s.innerHTML - 1;
        if (s.innerHTML == 0)
            window.location = 'https://www.cht.com.tw';
        else
            setTimeout('countdown()', 1000);
    }
</script>