ges\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"a43440443b4227fdc279f8667d357df0de70a28c\",\"url\":\"https://img.joyn.de/gn/assets/p10904248_i_h11_ah.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_p4dvq64s9pf\",\"title\":\"Pro und Contra\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"ce4ae88198e2544de311bc02ad0051b96f2c6169\",\"accentColor\":\"#ef262e\",\"darkAccentColor\":\"#8f161b\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/PRIMARY-2437b1fa.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/PRIMARY-2437b1fa.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"5079e7b3a84a366e0643ca27bf566ba1051c46e6\",\"accentColor\":\"#ef262e\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/ART_LOGO-f6a9ba0f.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"f9c91f8e8c9c21014c9bcce6c174a7d9a8731cb1\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/HERO_PORTRAIT-74d1effa.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Talk\",\"type\":\"TALK\",\"__typename\":\"Genre\"}],\"description\":\"Pro und Contra - der PULS 4 Politik Talk. Jede Woche mit spannenden, interessanten und kontroversen Themen.\",\"path\":\"/serien/pro-und-contra-dp4dvq64s9pf\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":null,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"56e6ed991e6d0a1387c4c0fe949954b3bf3f742a\",\"url\":\"https://img.joyn.de/gn/assets/p11138464_i_h10_ah.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p802jnwycud\",\"title\":\"Jagd auf Roter Oktober\",\"__typename\":\"Movie\",\"description\":\"November 1984: Glasnost und Perestroika gehören noch nicht zum allgemeinen Sprachschatz. Der sowjetische U-Boot-Kapitän Marko Ramius gibt den Befehl, Kurs gen Westen zu nehmen. Sein Ziel ist die amerikanische Ostküste. Sowohl die Russen als auch die Amerikaner rätseln, was Ramius vorhat. Plant er einen Angriff auf die USA, will er Selbstmord begehen oder ist er ein Überläufer? Eine gnadenlose Jagd beider Mächte auf das U-Boot beginnt.\",\"primaryImage\":{\"id\":\"8627ab44b24e43269952ceb376acd473b72e4730\",\"accentColor\":\"#05a4bc\",\"darkAccentColor\":\"#036270\",\"url\":\"https://img.joyn.de/ingest/t_001/i_y8me3p802nj4_d147fda6.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_y8me3p802nj4_d147fda6.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"dc46508651c8bdafd678e3275c7660984476072a\",\"accentColor\":\"#05a4bc\",\"url\":\"https://img.joyn.de/ingest/t_001/i_2lolbxiydk78_75d040e8.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"8822fc1ff6622bad5e0f730d5c4c821b4df3ab43\",\"url\":\"https://img.joyn.de/ingest/t_001/i_be2wlgsvncy5_91d94bb6.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Thriller\",\"type\":\"THRILLER\",\"__typename\":\"Genre\"},{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"},{\"name\":\"Abenteuer\",\"type\":\"ADVENTURE\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/jagd-auf-roter-oktober\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"6006564412b6745261d08b86effacd336eb9bb6b\",\"url\":\"https://img.joyn.de/gn/assets/p12153_i_h10_ac.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p3tgmu7hpei\",\"title\":\"Tom Clancy's Gnadenlos\",\"__typename\":\"Movie\",\"description\":\"Die Romanverfilmung des Bestsellerautors Tom Clancy garantiert Hochspannung: Der ehemalige Navy-SEAL-Elitekämpfer John Kelly will den Mord an seiner schwangeren Frau rächen. Er sucht nach dem Drogenboss Baltimores, der die abscheuliche Tat begangen hat und kommt dabei einer weitreichenden Verschwörung auf die Spur.\",\"primaryImage\":{\"id\":\"4265ce15d689d23ff083385330d97ad2c339652c\",\"accentColor\":\"#e49b24\",\"darkAccentColor\":\"#885d15\",\"url\":\"https://img.joyn.de/ingest/t_001/i_r7curut0zo69_f70f6b04.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_r7curut0zo69_f70f6b04.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"da658d259bb55ce99d1718ecf45cc50032e0b871\",\"accentColor\":\"#e49b24\",\"url\":\"https://img.joyn.de/ingest/t_001/i_x1hsrt39shhg_27e91287.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"a7af40f0d38608e375d1783a920603597eee64ff\",\"url\":\"https://img.joyn.de/ingest/t_001/i_0q91lcewuviq_f8bef63c.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"},{\"name\":\"Thriller\",\"type\":\"THRILLER\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"3\",\"title\":\"Kabel Eins\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/Kabel%2BEins/brand-logo-white-Kabel-Eins.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1\",\"title\":\"ProSieben\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/ProSieben/white_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.d