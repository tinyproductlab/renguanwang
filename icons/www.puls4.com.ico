or\":\"#1c849b\",\"darkAccentColor\":\"#104f5d\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ew8aeoec3pb0_e706723d.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_ew8aeoec3pb0_e706723d.jpg/profile:nextgen-web-primary-503x\",\"urlLandscape\":\"https://img.joyn.de/ingest/t_001/i_ew8aeoec3pb0_e706723d.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"3ac5edcbb27b369ef55b2b55d20f3307be809864\",\"accentColor\":\"#1c849b\",\"url\":\"https://img.joyn.de/ingest/t_001/i_qjw67kt1916b_1bc29438.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"bb61451557871cd452600ce8f52bb5548b80a215\",\"url\":\"https://img.joyn.de/ingest/t_001/i_loqzj3inigiv_06740d45.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Ein Arztbesuch, eine Operation oder die Aufnahme in ein Krankenhaus setzt vor allem eines voraus: Vertrauen. Doch was geschieht, wenn Warnsignale übersehen, Diagnosen zu spät gestellt oder Patient:innen mit ihren Beschwerden nicht ernst genommen werden? \\\"Pfusch am Patienten\\\" widmet sich Menschen aus ganz Österreich, deren Leben sich nach einer medizinischen Behandlung für immer verändert hat.\",\"path\":\"/serien/pfusch-am-patienten\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[]},{\"id\":\"d_pmbuvrg8nkc\",\"title\":\"Roadtrip - Drei Spitzenköche auf vier Rädern\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"feb6aa1d3f1b1bb5e989c773e7ce0533a3fbbc6b\",\"accentColor\":\"#fc861d\",\"darkAccentColor\":\"#975011\",\"url\":\"https://img.joyn.de/ingest/t_001/i_l2vk89yaogpk.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_l2vk89yaogpk.jpg/profile:nextgen-web-primary-503x\",\"urlLandscape\":\"https://img.joyn.de/ingest/t_001/i_l2vk89yaogpk.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"5f37677531b6fbe60136808fe911bcea64f40c41\",\"accentColor\":\"#fc861d\",\"url\":\"https://img.joyn.de/ingest/t_001/i_zkpei7wcg7gv.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"7e62ab64fa71b2d28085d3a08d0897a0b513bbad\",\"url\":\"https://img.joyn.de/ingest/t_001/i_p7qgl17a956v.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Reise\",\"type\":\"TRAVEL\",\"__typename\":\"Genre\"},{\"name\":\"Kochen\",\"type\":\"COOKING\",\"__typename\":\"Genre\"}],\"description\":\"Die Sterneköche Alexander Kumptner, Ali Güngörmüs und Frank Rosin brechen zu ihrem vierten kulinarischen Roadtrip auf - ihr Ziel: Australien. Zwischen Küsten, Canyons und endlosen Weiten des Outbacks entdecken sie außergewöhnliche Zutaten, kochen gemeinsam an entlegenen Orten und erleben emotionale Momente an spektakulären Campingplätzen. Neben kulinarischen Highlights wartet jede Menge Action: Floating im Dschungel, Arbeit auf einer Schaffarm und atemberaubender Nervenkitzel.\",\"path\":\"/serien/roadtrip-drei-spitzenkoeche-auf-vier-raedern\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":4,\"languages\":[]},{\"id\":\"d_p1nuv574f82\",\"title\":\"Die Auswanderer - Für immer fort?\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"4f4122221359b518b449cfd724b41b5d3e264ad2\",\"accentColor\":\"#f00e10\",\"darkAccentColor\":\"#900809\",\"url\":\"https://img.joyn.de/ingest/t_001/i_yi82togzvvzh.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_yi82togzvvzh.jpg/profile:nextgen-web-primary-503x\",\"urlLandscape\":\"https://img.joyn.de/ingest/t_001/i_yi82togzvvzh.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"dc0fc5adfa40f899350d9ed02bb750299d6990f5\",\"accentColor\":\"#f00e10\",\"url\":\"https://img.joyn.de/ingest/t_001/i_myh2f7vh6l01.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"8e9f8d710cff74eee0dfb03380bafe3475ce0d35\",\"url\":\"https://img.joyn.de/ingest/t_001/i_74dxsxc4n10g.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"},{\"name\":\"Unterhaltung\",\"type\":\"ENTERTAINMENT\",\"__typename\":\"Genre\"}],\"description\":\"Viele Österreicher:innen wandern aus, um ihr berufliches und privates Glück neu zu definieren. Doch wie sehr stimmen Fantasie und Realität überein?  \",\"path\":\"/serien/die-auswanderer-fuer-immer-fort\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":4,\"languages\":[]},{\"id\":\"d_p4dvq64s9pf\",\"title\":\"Pro und Contra\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"ce4ae88198e2544de311bc02ad0051b96f2c6169\",\"accentColor\":\"#ef262e\",\"darkAccentColor\":\"#8f161b\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/PRIMARY-2437b1fa.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/PRIMARY-2437b1fa.jpeg/profile:nextgen-web-primary-503x\",\"urlLandscape\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/PRIMARY-2437b1fa.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"5079e7b3a84a366e0643ca27bf566ba1051c46e6\",\"accentColor\":\"#ef262e\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_p4dvq64s9pf/AR