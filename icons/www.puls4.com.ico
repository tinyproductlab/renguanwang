\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1002\",\"title\":\"Kabel Eins CLASSICS\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/Plus/Kabel%2BEins%2BCLASSICS/white-kabel1-classics%2B_2.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1\",\"title\":\"ProSieben\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/ProSieben/white_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1000\",\"title\":\"ProSieben FUN\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/Plus/ProSieben%2Bfun/white-Pro7-Fun.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"2\",\"title\":\"SAT.1\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/SAT.1/brand-logo-white-sat-eins%2B%25281%2529.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/mortdecai-der-teilzeitgauner\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":6},\"iconicImage\":{\"id\":\"30a6ee02da911cbe5c272c6a7486c0bc85b21bbf\",\"url\":\"https://img.joyn.de/gn/assets/p10688488_i_h10_af.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_ps1u9k00zly\",\"title\":\"Das Bourne Ultimatum\",\"__typename\":\"Movie\",\"description\":\"Erneut muss Jason Bourne die Beine in die Hand nehmen. Die Leute, die ihn zu dem gemacht haben, was er ist - ein perfekter Attentäter - lassen nichts unversucht, ihn tot zu sehen. Auf der Suche nach seinem verlorenen Gedächtnis und auf der Flucht vor hochtrainierten Killern, hat Jason Bourne nur eine Chance: Er muss vom Jäger zum Gejagten werden und dorthin zurückkehren, wo alles seinen Anfang genommen hat. Nur so wird er vielleicht herausfinden, wer er in Wirklichkeit ist ...\",\"primaryImage\":{\"id\":\"adcf0c74cbfd134a41bf8f3fca6cc5bd5e79e8f1\",\"accentColor\":\"#3cb4db\",\"darkAccentColor\":\"#246c83\",\"url\":\"https://img.joyn.de/ingest/t_001/i_v45gk0ye1hf2.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_v45gk0ye1hf2.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"4e2c5379acc76ba5a327ab7536f9c45d646e90be\",\"accentColor\":\"#3cb4db\",\"url\":\"https://img.joyn.de/ingest/t_001/i_qgsfhcx9yzne.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"b515f9732cd420627813edbab16818f2e2b9cb8d\",\"url\":\"https://img.joyn.de/ingest/t_001/i_xmsvc9vwy3xm.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"},{\"name\":\"Thriller\",\"type\":\"THRILLER\",\"__typename\":\"Genre\"},{\"name\":\"Mystery\",\"type\":\"MYSTERY\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"3\",\"title\":\"Kabel Eins\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/Kabel%2BEins/brand-logo-white-Kabel-Eins.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/das-bourne-ultimatum\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"8bf8d90d1009ec3b0e276c215221e5087261a60d\",\"url\":\"https://img.joyn.de/gn/assets/p166270_i_h10_ag.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_puoja91uj52\",\"title\":\"Road House\",\"__typename\":\"Movie\",\"description\":\"Der Ex-UFC-Kämpfer Elwood Dalton wird als Türsteher in der Bar \\\"Road House\\\" auf den Florida Keys angeheuert und legt sich schon bald mit einem skrupellosen Unternehmer an, der das Grundstück an sich reißen will. Während er sich mit Gangstern, korrupten Cops und einem brutalen Killer misst, entwickelt er Gefühle für die Ärztin Ellie. Als diese jedoch entführt wird, stellt sich Dalton zum finalen Kampf ...\",\"primaryImage\":{\"id\":\"c3409c29f1143dbe7c7597ae13ebe99e9bac0c7d\",\"accentColor\":\"#ae6e45\",\"darkAccentColor\":\"#684229\",\"url\":\"https://img.joyn.de/ingest/t_001/i_5vyjet0f1bac.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_5vyjet0f1bac.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"c404523b2b8b75191f1f6509acb3f2f4cf3d8817\",\"accentColor\":\"#ae6e45\",\"url\":\"https://img.joyn.de/ingest/t_001/i_d59b73edz2nf.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"74add0f66d63de6126a58e5fb1ca240200dfb401\",\"url\":\"https://img.joyn.de/ingest/t_001/i_qxt131zbgdlp.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/road-house\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":18},\"iconicImage\":{\"id\":\"66e30333db7d8e6b192c593912ee9663c6e92605\",\"url\":\"https://img.joyn.de/gn/assets/p26609792_i_h8_ac.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p4ger2bwi9i\",\"title\":\"Gegen jeden Zweifel\",\"__typename\":\"Movie\",\"description\":\"Bezirksstaatsanwalt Mark Hunter fühlt sich zu Höherem berufen. Mit einer starken Verurteilungsrate im Rücken rechnet er sich Chancen auf den Posten des Gouverneurs aus. Doch der junge Reporter C.J. Nicholas glaubt, dass es ein dunkles Geheimnis hinter Hunters Statistiken gibt. Manipuliert der Staatsanwalt Beweise?\",\"primaryImage\":{\"id\":\"6107b9b089b84f59ff33daa8b0f9ec3b882ee741\",\"accentColor\":\"#c46a3c\",\"darkAccentColor\":\"#753f24\",\"url\":\"https://img.joyn.de/ingest/t_001/i_3f77kb5tm32v.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_3f77kb5tm32v.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"f8fbe4899003cca38731b3a439c93cb6d5ca7952\",\"accentColor\":\"#c46a3c\",\"url\":\"https://img.joyn.de/ingest/t_001/i_shxe4v8urji3.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"11386176a096656833c0034a84999e6f06b3361c\",\"url\":\"https://img.joyn.de/ingest/t_001/i_modcmpm38qfi.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Krimi-Drama\",\"type\":\"CRIME DRAMA\",\"__typename\":\"Genre\"},{\"name\":\"Mystery\",\"type\":\"MYSTERY\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"1058\",\"title\":\"ATV 2\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-2/ATV2_logo_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1001\",\"title\":\"SAT.1 emotions\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/Plus/Sat.1%2Bemotions/white-sat1-emotion.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1002\",\"title\":\"Kabel Eins CLASSICS\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/Plus/Kabel%2BEins%2BCLASSICS/white-kabel1-classics%2B_2.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/gegen-jeden-zweifel-bp4ger2bwi9i\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"58b2b73451ad2969c02dda2652351fef25613f8d\",\"url\":\"https://img.joyn.de/gn/assets/p3495408_i_h8_ad.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_pm92h39bao3\",\"title\":\"Play Dirty - Selbst Räuber werden beraubt\",\"__typename\":\"Movie\",\"description\":\"Action-Thriller nach der Roman-Reihe \\\"Parker\\\" von Richard Stark: Dass er als Profidieb ein gefährliches Leben führt, nimmt Parker durchaus in Kauf. Dass er sich bei seinem neuesten Coup allerdings mit der Mafia, einem Milliardär und einem Diktator anlegt, scheint selbst für ihn eine Nummer zu groß. Parkers einzige Chance ist ein Zweckbündnis mit der gerissenen Kriminellen Zen: Doch ausgerechnet sie hat ihn schon einmal hereingelegt.\",\"primaryImage\":{\"id\":\"b6f2b261639da95a3e682784bb6a7a886fc69610\",\"accentColor\":\"#dc0404\",\"darkAccentColor\":\"#840202\",\"url\":\"https://img.joyn.de/ingest/t_001/i_v1bq30a0pqz7_8847b469.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_v1bq30a0pqz7_8847b469.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"db0791ef227ae961f1569ffcf6e2754ea40b69f3\",\"accentColor\":\"#dc0404\",\"url\":\"https://img.joyn.de/ingest/t_001/i_yto2wajw5vfr_f9c8b9cc.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"189beb4655eed832ced2a23f2cac9312f164ad3d\",\"url\":\"https://img.joyn.de/ingest/t_001/i_qjfosr0cv3w9_25a4891a.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"},{\"name\":\"Thriller\",\"type\":\"THRILLER\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1\",\"title\":\"ProSieben\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/ProSieben/white_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/play-dirty-selbst-raeuber-werden-beraubt\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":null},{\"id\":\"b_pti1q6o2jx5\",\"title\":\"Guy Ritchie's Der Pakt\",\"__typename\":\"Movie\",\"description\":\"Packender Action-Thriller mit Jake Gyllenhaal: Sergeant Kinley erleidet während seines letzten Einsatzes in Afghanistan eine schwere Kopfverletzung. Mithilfe seines Dolmetschers Ahmed kann er den feindlichen Truppen knapp entgehen. Kinley ist ihm deshalb zu tiefstem Dank verpflichtet. Weil Ahmed sein Leben gerettet hat, setzt der Soldat alles daran, ihn und seine Familie aus dem Kriegsgebiet zu befreien. Für die Gefährten beginnt ein erbarmungsloser Spießrutenlauf.\",\"primaryImage\":{\"id\":\"a5127e832eb253dae70e17fc94a35321c65b350a\",\"accentColor\":\"#b09454\",\"darkAccentColor\":\"#695832\",\"url\":\"https://img.joyn.de/ingest/t_001/i_uyfiz3cfuhep.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_uyfiz3cfuhep.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"5136fa4bc6390bf0e57da70152efa97df4b57dee\",\"accentColor\":\"#b09454\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ugmo3a74m5rf.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"2f78079e6922af3d280b0512c632b3ca7640ce1a\",\"url\":\"https://img.joyn.de/ingest/t_001/i_q6h5r4uyj58r.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Krieg\",\"type\":\"WAR\",\"__typename\":\"Genre\"},{\"name\":\"Drama\",\"type\":\"DRAMA\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"1\",\"title\":\"ProSieben\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/ProSieben/white_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/guy-ritchies-der-pakt\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"85dc7f59175271fb96b5d747a26a4e6ea3b814e5\",\"url\":\"https://img.joyn.de/gn/assets/p23680547_i_h10_ab.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p25hadtrffs\",\"title\":\"Wickie und die starken Männer\",\"__typename\":\"Movie\",\"description\":\"Als der schreckliche Sven Halvar entführt, muss Wickie als stellvertretender Häuptling die Starken Männer anführen. Unterstützung bekommt er dabei von der furchtlosen Svenja. \",\"primaryImage\":{\"id\":\"32158449c837bbd69913232339eaf33a1846f004\",\"accentColor\":\"#d16534\",\"darkAccentColor\":\"#7d3c1f\",\"url\":\"https://img.joyn.de/cms/var/assets/SharedContent/Movies/Wickie+und+die+starken+Maenner/primary-wickie-und-die-starken-maenner-322982.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/cms/var/assets/SharedContent/Movies/Wickie+und+die+starken+Maenner/primary-wickie-und-die-starken-maenner-322982.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"0886d3f8d929b158ba4b8bd376a14c67e97145d3\",\"accentColor\":\"#d16534\",\"url\":\"https://img.joyn.de/cms/var/assets/SharedContent/Movies/Wickie+und+die+starken+Maenner/artlogo-wickie-und-die-starken-maenner-322982.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"051183187757f2d7f0b13f0804ae604423cf1de8\",\"url\":\"https://img.joyn.de/cms/var/assets/SharedContent/Movies/Wickie+und+die+starken+Maenner/heroportrait-wickie-und-die-starken-maenner-322982.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Kinder\",\"type\":\"CHILDREN\",\"__typename\":\"Genre\"},{\"name\":\"Comedy\",\"type\":\"COMEDY\",\"__typename\":\"Genre\"},{\"name\":\"Abenteuer\",\"type\":\"ADVENTURE\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/wickie-und-die-starken-maenner\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":0},\"iconicImage\":{\"id\":\"b19e5affd16b673190b656d3a93e9b813f20b12c\",\"url\":\"https://img.joyn.de/gn/assets/p11362115_i_h8_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p7rqsoype04\",\"title\":\"Der Patriot\",\"__typename\":\"Movie\",\"description\":\"South Carolina, 1776: Der Witwer Benjamin Martin lebt mit seinen sieben Kindern zurückgezogen auf seiner Farm. Früher hatte er heldenhaft gegen die Franzosen und die Indianer gekämpft - doch diesmal will Benjamin sich aus dem drohenden Krieg gegen die Engländer heraushalten. Als sich sein Sohn Gabriel freiwillig zur Armee meldet, und kurz darauf dessen jüngerer Bruder Thomas von einem englischen Oberst erschossen wird, ändert Benjamin seine Meinung ...\",\"primaryImage\":{\"id\":\"cb236aee225af931e8d20163f8d5e1e9b3fa8851\",\"accentColor\":\"#ec7634\",\"darkAccentColor\":\"#8d461f\",\"url\":\"https://img.joyn.de/mas-prod/assets/b_p7rqsoype04/PRIMARY-92b85beb.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/b_p7rqsoype04/PRIMARY-92b85beb.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"24e33642f047ce8e90a6a852b445ec695c0342d9\",\"accentColor\":\"#ec7634\",\"url\":\"https://img.joyn.de/mas-prod/assets/b_p7rqsoype04/ART_LOGO-8e81781e.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"3c32f1421f70b96bff1a7429d8c3261b2c3e402c\",\"url\":\"https://img.joyn.de/mas-prod/assets/b_p7rqsoype04/HERO_PORTRAIT-4ae92c89.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Krieg\",\"type\":\"WAR\",\"__typename\":\"Genre\"},{\"name\":\"Historisches Drama\",\"type\":\"HISTORICAL DRAMA\",\"__typename\":\"Genre\"},{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/der-patriot\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"f818c366c81391feb84adeb01fd4cd67368e5a46\",\"url\":\"https://img.joyn.de/gn/assets/p25745_i_h8_ac.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p4r603ydg6q\",\"title\":\"The Gentlemen\",\"__typename\":\"Movie\",\"description\":\"Mickey Pearson hat sich ein millionenschweres Marihuana-Imperium aufgebaut, das er verkaufen möchte. Allerdings gibt es eine Menge Gentlemen, die ihm das Geschäft versauen wollen.\",\"primaryImage\":{\"id\":\"f29beb92e2854443dd462631d7a407c166480edc\",\"accentColor\":\"#ac6014\",\"darkAccentColor\":\"#67390c\",\"url\":\"https://img.joyn.de/ingest/t_001/i_thenyww5xqna_da576abc.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_thenyww5xqna_da576abc.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"30346d334d8ecb411598a9d52687bfe0d02f1c2c\",\"accentColor\":\"#ac6014\",\"url\":\"https://img.joyn.de/ingest/t_001/i_029a52ouh6e9_e1a03f5a.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"7647a9c4991063c4d8f80a8762809d0d3886c341\",\"url\":\"https://img.joyn.de/ingest/t_001/i_kzk1lgjhozug_f776d66a.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Krimi-Drama\",\"type\":\"CRIME DRAMA\",\"__typename\":\"Genre\"},{\"name\":\"Schwarze Komödie\",\"type\":\"DARK COMEDY\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1002\",\"title\":\"Kabel Eins CLASSICS\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/Plus/Kabel%2BEins%2BCLASSICS/white-kabel1-classics%2B_2.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/the-gentlemen\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"a0f428651fd103a2ed718509eeba8b3751e97fa1\",\"url\":\"https://img.joyn.de/gn/assets/p17259997_i_h10_ac.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_pdpntpmtm6b\",\"title\":\"Schneemann\",\"__typename\":\"Movie\",\"description\":\"In Oslo wird eine junge Frau brutal ermordet. Kommissar Harry Hole und seine talentierte Kollegin Katrine Bratt werden auf den Fall angesetzt. Hole vermutet hinter der grausamen Tat einen Serienmörder, der stets bei Schneefall zuschlägt. Sein Markenzeichen sind Schneemänner, die er an jedem Tatort hinterlässt. Als es zu weiteren Mordfällen an jungen Müttern kommt, stehen die Ermittler noch stärker unter Druck, denn der nächste Schneefall lässt nicht lange auf sich warten ...\",\"primaryImage\":{\"id\":\"9e944a050f77a0d192cf78ea963b3305818369e3\",\"accentColor\":\"#cc1c12\",\"darkAccentColor\":\"#7a100a\",\"url\":\"https://img.joyn.de/ingest/t_001/i_f503stds3izq_547d7a04.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_f503stds3izq_547d7a04.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"7e81e1083e773920bb2e52bb73f916d7a5e51037\",\"accentColor\":\"#cc1c12\",\"url\":\"https://img.joyn.de/ingest/t_001/i_7tc33nnekh8z_03dacf10.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"dc29572374fcda4c2336a3353dbda6ae874903b3\",\"url\":\"https://img.joyn.de/ingest/t_001/i_pmju2jh9oq06_0a90c8e0.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Krimi\",\"type\":\"CRIME\",\"__typename\":\"Genre\"},{\"name\":\"Thriller\",\"type\":\"THRILLER\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/schneemann\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":null},{\"id\":\"b_p4onaoj2ron\",\"title\":\"Blackhat - Außer Kontrolle\",\"__typename\":\"Movie\",\"description\":\"Chris Hemsworth zeigt in diesem Action-Thriller vollen Körpereinsatz: In einem Atomkraftwerk in Hongkong kommt es zu einer Explosion, und an der Börse geschehen unerklärliche Kursveränderungen. Schnell wird klar: Hier sind kriminelle Hacker am Werk, und sie haben gerade erst angefangen. Das FBI wendet sich an das inhaftierte Computergenie Nick Hathaway und bietet ihm einen Deal an: Seine Freiheit gegen die Auslieferung der Hacker.\",\"primaryImage\":{\"id\":\"ac202cb1254c2f65c099dea77aa2e94d17856017\",\"accentColor\":\"#ec8505\",\"darkAccentColor\":\"#8d4f03\",\"url\":\"https://img.joyn.de/ingest/t_001/i_1g68hwgqwc12.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_1g68hwgqwc12.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"6ddbda588f73a6679c0e36412928e4e992767bfc\",\"accentColor\":\"#ec8505\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ybkbnor7gqba.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"b1e0114422d51d4c5cd12b1219e95dad3bdc797d\",\"url\":\"https://img.joyn.de/ingest/t_001/i_5lb62ct9wobq.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Thriller\",\"type\":\"THRILLER\",\"__typename\":\"Genre\"},{\"name\":\"Action\",\"type\":\"ACTION\",\"__typename\":\"Genre\"},{\"name\":\"Krimi-Drama\",\"type\":\"CRIME DRAMA\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"1\",\"title\":\"ProSieben\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/ProSieben/white_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/blackhat-ausser-kontrolle-bp4onaoj2ron\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"edbc6f25a9c11eb17b7332f001925cab1c8cdbbb\",\"url\":\"https://img.joyn.de/gn/assets/p10981549_i_h10_ae.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"b_p2ctjvaiiyr\",\"title\":\"Kinderfänger 2.0: Im Visier sadistischer Netzwerke\",\"__typename\":\"Movie\",\"description\":\"Ein neues Online-Netzwerk mit dem Namen „The Com“, kurz für „The Community“, bereitet Eltern und Politik Sorgen. Über Social-Media-Kanäle oder Chats in Online-Games werden Kinder und Jugendliche zu Gewalt gegen sich selbst und andere manipuliert. Die Taten reichen von Selbstverletzung bis hin zu Mord. Für die Drahtzieher ist es ein sadistisches Spiel um Klicks und Anerkennung. Und nun ist das COM-Netzwerk auch in Österreich angekommen.\",\"primaryImage\":{\"id\":\"6666464f2e1556542a45467aa02e0206d084e5c7\",\"accentColor\":\"#d42474\",\"darkAccentColor\":\"#7f1545\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ktyqcelnkhxb_2895a70c.png/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_ktyqcelnkhxb_2895a70c.png/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"00abce57fb261a806cc1d6d67825b9787e66dc8e\",\"accentColor\":\"#d42474\",\"url\":\"https://img.joyn.de/ingest/t_001/i_srm3uskq145g_3abc8e33.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"c5899ae7e3b1c304b386c50032c96c56fb04e1e9\",\"url\":\"https://img.joyn.de/ingest/t_001/i_0tczead3v16j_c810ac02.png/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/kinderfaenger-20-im-visier-sadistischer-netzwerke\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":null},{\"id\":\"b_pt6t540weiq\",\"title\":\"Night School\",\"__typename\":\"Movie\",\"description\":\"Der Barbecue-Grill-Verkäufer Teddy Walker verliert seinen Job und beschließt nun, Börsenmakler zu werden. Da er dafür jedoch einen Abschluss benötigt, besucht er fortan die Abendschule. \",\"primaryImage\":{\"id\":\"e59940d6d8be37001335cf8a4220b01e8c9fa0fc\",\"accentColor\":\"#fc741c\",\"darkAccentColor\":\"#974510\",\"url\":\"https://img.joyn.de/ingest/t_001/i_5i6emrk5nh5v_6f43ce4d.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_5i6emrk5nh5v_6f43ce4d.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"4d122738f01e0c63234cd4a3fe1cd22a686ebf4c\",\"accentColor\":\"#fc741c\",\"url\":\"https://img.joyn.de/ingest/t_001/i_uq382k6k0c7i_bb57cec3.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"e7f6a3bac32a86dfcfe26d8288f4e796c275b7bf\",\"url\":\"https://img.joyn.de/ingest/t_001/i_2p2j4sq20l7x_43e18ef9.jpg/profile:nextgen-web-heroportrait-243x365\"},\"genres\":[{\"name\":\"Comedy\",\"type\":\"COMEDY\",\"__typename\":\"Genre\"}],\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}}],\"path\":\"/filme/night-school\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"da708d88f2d7433dfbc5f9ed582e942485d61779\",\"url\":\"https://img.joyn.de/gn/assets/p15354252_i_h10_af.jpg/profile:nextgen-web-livestill-503x283\"}}]},{\"__typename\":\"StandardLane\",\"id\":\"965141:c35b852f80d887f522e35850e73eb42d\",\"anchorId\":null,\"isPersonalized\":false,\"headline\":\"Serien auf PULS 4\",\"targetLink\":null,\"assets\":[{\"id\":\"d_phcfa44bgbt\",\"title\":\"Im Leben der Anderen - Lebenstausch extrem\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"a8b5e47f55d0d001668ab9ea89955017002bb243\",\"accentColor\":\"#2e6c5c\",\"darkAccentColor\":\"#1b4037\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_phcfa44bgbt/PRIMARY-0aa377be.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_phcfa44bgbt/PRIMARY-0aa377be.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"2def13bc09a26d39eb15f6bda878318d384c10a5\",\"accentColor\":\"#2e6c5c\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_phcfa44bgbt/ART_LOGO-ba152b14.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"5f593d46de1f59d7d1f4f024ac6adbad0d634bc8\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_phcfa44bgbt/HERO_PORTRAIT-dec334f5.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Es gibt viele Themen, die die österreichische Gesellschaft spalten. Religion, Sexualität, Wohlstand oder auch Ernährungsweisen sind nur wenige davon. Aber was passiert, wenn genau diese Gegensätze in das für sie konträre Milieu eintauchen? In \\\"Im Leben der Anderen\\\" wagen jeweils zwei Personen mit unterschiedlichen Ansichten das Experiment und erhalten Einblick in eine für sie völlig neue und teils unverständliche Welt.\",\"path\":\"/serien/im-leben-der-anderen-lebenstausch-extrem\",\"licenseTypes\":[\"AVOD\"],\"markings\":[\"PREVIEW\"],\"numberOfSeasons\":2,\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":null},{\"id\":\"d_pgibl8ioyn3\",\"title\":\"How I Met Your Mother\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"7caaf4871c4465c325efe3a9b7f9a5d5d53f6890\",\"accentColor\":\"#ccac54\",\"darkAccentColor\":\"#7a6732\",\"url\":\"https://img.joyn.de/ingest/t_001/i_735hmj772hpx.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_735hmj772hpx.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"e8e8d6df5663fe31a9231cba7f80927485e0b74d\",\"accentColor\":\"#ccac54\",\"url\":\"https://img.joyn.de/ingest/t_001/i_fxe59oenww21.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"e57e577bc1214a791d2cb52974bea2d3ddf22d16\",\"url\":\"https://img.joyn.de/ingest/t_001/i_kn97v8pvidi5.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"1058\",\"title\":\"ATV 2\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-2/ATV2_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Sitcom\",\"type\":\"SITCOM\",\"__typename\":\"Genre\"},{\"name\":\"Romanze\",\"type\":\"ROMANCE\",\"__typename\":\"Genre\"},{\"name\":\"Drama\",\"type\":\"DRAMA\",\"__typename\":\"Genre\"}],\"description\":\"Ted Mosby erzählt im Jahr 2030 seinen Kindern alle Details darüber, wie er seine Frau kennengelernt hat. Seine Erläuterungen beginnen im Jahr 2005, als sich Ted als Architekturstudent eine Wohnung mit seinem Freund Marshall teilt. Kurze Zeit später lernt Ted die Nachrichtensprecherin Robin kennen und lieben. Sie will jedoch von einer festen Beziehung noch gar nichts wissen ... Völlig unklar ist deshalb, welche der Frauen an Teds Seite nun die Mutter seiner Kinder wird.\",\"path\":\"/serien/how-i-met-your-mother\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":3,\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"b5ba8fe976e0cbd778a3e72b595c54d130d7d6e7\",\"url\":\"https://img.joyn.de/gn/assets/p185124_i_h8_ae.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pjdacrffs9s\",\"title\":\"Two and a Half Men\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"e74c030d1c4d061b6923a74f764f9d78ce6435d0\",\"accentColor\":\"#981246\",\"darkAccentColor\":\"#5b0a2a\",\"url\":\"https://img.joyn.de/ingest/t_001/i_4gi5wqn4m0c5.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_4gi5wqn4m0c5.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"ff48bf0990eaee74b137bb93e6a20b9c5d7c52ff\",\"accentColor\":\"#981246\",\"url\":\"https://img.joyn.de/ingest/t_001/i_1qv16qcrlzla.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"d352cd162fc9c4fc747e0791fff047cc914d39c6\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ytrwiz51c8tp.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Sitcom\",\"type\":\"SITCOM\",\"__typename\":\"Genre\"}],\"description\":\"\\\"Two and a Half Men\\\" ist aus der Sitcom-Landschaft nicht mehr wegzudenken. Von Staffel eins bis acht begeistert Charlie Sheen als Frauenheld Charlie Harper seine Fans. Ab Staffel neun übernimmt Internetmilliardär Walden Schmidt alias Ashton Kutcher das Zepter. Immer mit dabei: Chiropraktiker Alan und sein Sohn Jake, die dank Charlie bzw. Walden immer wieder in aberwitzige Situationen geraten und sich regelmäßig geniale verbale Schlagabtäusche liefern.\",\"path\":\"/serien/two-and-a-half-men\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":4,\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"64f9b3c3857445e6c3f1688bca30d339a94789be\",\"url\":\"https://img.joyn.de/gn/assets/p184925_i_h8_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pckkg43ssh6\",\"title\":\"FrühlingsgeBlümel\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"cbe75c1d1062c75e9b7a0f85672d87f6f4f3124d\",\"accentColor\":\"#a41028\",\"darkAccentColor\":\"#620918\",\"url\":\"https://img.joyn.de/ingest/t_001/i_sqxa0frglo8a.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_sqxa0frglo8a.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"dd534136adfb45185d704ac354e6febcdde5882f\",\"accentColor\":\"#a41028\",\"url\":\"https://img.joyn.de/ingest/t_001/i_jpyzev8cuqn5.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"666ecac2e8071a927d5380ff8e9323a99ec7aea1\",\"url\":\"https://img.joyn.de/ingest/t_001/i_b1cwc6uapqoj.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"1102\",\"title\":\"Joyn AT\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/Joyn/Joyn_white-new.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"},{\"name\":\"Talk\",\"type\":\"TALK\",\"__typename\":\"Genre\"}],\"description\":\"Zwei Freundinnen, ein Gläschen Sekt, Null Filter!\\nIn „FrühlingsgeBlümel“ nehmen dich Katharina Frühling und Clivia Blümel mit in ihre Welt: Society-News, Promi-Klatsch und Tratsch, Beauty-Trends, Self-Care-Tipps und ehrliche Einblicke!\\nLocker, persönlich, feel good – und immer mit einer großen Portion guter Laune.\\nJeden Samstag neu – exklusiv als Video-Podcast auf JOYN.\",\"path\":\"/serien/fruehlingsgebluemel\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"2099b274d50290d9dcb0202869a1db4d661aa353\",\"url\":\"https://img.joyn.de/gn/assets/p32873567_i_h11_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_p8t9p4qzb3y\",\"title\":\"Breaking Media - Macht.Medien.Kompetenz.\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"f75d52e4b976023ff0ac6cb0bd3b6e229bf86a2b\",\"accentColor\":\"#141cfc\",\"darkAccentColor\":\"#0c1097\",\"url\":\"https://img.joyn.de/ingest/t_001/i_xnxfh56opph3.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_xnxfh56opph3.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"b7df827d43bcc7fbfc3fb173c94b4bf4d35089f3\",\"accentColor\":\"#141cfc\",\"url\":\"https://img.joyn.de/ingest/t_001/i_2h4h8xgj036w.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"4152b7abb6aa392ab8580599202d04a386da9b81\",\"url\":\"https://img.joyn.de/ingest/t_001/i_z42197i1eo4m.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"134\",\"title\":\"PULS 24\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/Austria%2Bonly/PULS%2B24/PULS24_logo.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Nachrichten\",\"type\":\"NEWS\",\"__typename\":\"Genre\"}],\"description\":\"\\\"Breaking Media\\\" ist das Sender-übergreifende Medienkompetenzmagazin mit dem Ziel, Medienmechanismen spannend aufzuklären und für Fake News zu sensibilisieren.  Moderation: Gundula Geiginger.\",\"path\":\"/serien/breaking-media-machtmedienkompetenz\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":6},\"iconicImage\":null},{\"id\":\"d_punrcd4brai\",\"title\":\"Das große Backen Österreich\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"14ee571fab1ebbba898d760489cf239db4382167\",\"accentColor\":\"#dd3d11\",\"darkAccentColor\":\"#84240a\",\"url\":\"https://img.joyn.de/ingest/t_001/i_h3icbufjza3r_f84bb737.png/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_h3icbufjza3r_f84bb737.png/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"f33f734af9ca89a5fd9e2be8d4978ba3c2427520\",\"accentColor\":\"#dd3d11\",\"url\":\"https://img.joyn.de/ingest/t_001/i_8h0mp6a3krsl_302f92c8.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"16a51b30c86d0f84ce2aebd2f4dd1d7c84ae6726\",\"url\":\"https://img.joyn.de/ingest/t_001/i_mmvr1tga3i1h_0f446af6.png/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Unterhaltung\",\"type\":\"ENTERTAINMENT\",\"__typename\":\"Genre\"}],\"description\":\"Das Erfolgsformat \\\"Das große Backen\\\" kommt nun auch nach Österreich. Aus sechs Bundesländern reisen die acht besten Hobbybäcker:innen des Landes an und versuchen die Jury um Eveline Wild \u0026 Philipp Zauner zu überzeugen.\",\"path\":\"/serien/das-grosse-backen-oesterreich\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":0},\"iconicImage\":null},{\"id\":\"d_plan8jp3i72\",\"title\":\"Die Nussbaums\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"cac5cd0