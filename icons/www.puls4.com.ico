\"darkAccentColor\":\"#7a3755\",\"url\":\"https://img.joyn.de/ingest/t_001/i_59d8nazrqi4l.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_59d8nazrqi4l.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"a3ba7995e81e1a9a5b57f8d7c35a88c28ac6e401\",\"accentColor\":\"#cc5d8f\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ep1i9e4ni0vi.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"c00ae4eb0ee13e70813e52b4a875590207202fa4\",\"url\":\"https://img.joyn.de/ingest/t_001/i_rqgz2pcmfjyy.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"2\",\"title\":\"SAT.1\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/SAT.1/brand-logo-white-sat-eins%2B%25281%2529.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"1001\",\"title\":\"SAT.1 emotions\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/Plus/Sat.1%2Bemotions/white-sat1-emotion.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Soap\",\"type\":\"SOAP\",\"__typename\":\"Genre\"},{\"name\":\"Drama\",\"type\":\"DRAMA\",\"__typename\":\"Genre\"},{\"name\":\"Romanze\",\"type\":\"ROMANCE\",\"__typename\":\"Genre\"}],\"description\":\"Die extrem schüchterne Anna arbeitet in einer Werbeagentur und hat ein Auge auf den Juniorchef geworfen. Doch dieser ist ausgerechnet mit ihrer Halbschwester verlobt.\",\"path\":\"/serien/anna-und-die-liebe\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":5,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"edadc0936c34f9ce9b09b97652c76c244baa334a\",\"url\":\"https://img.joyn.de/gn/assets/p7910953_i_h8_ag.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pgs4ps42r23\",\"title\":\"Pfusch am Bau\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"82e0230bc0050f7b50878df62603a8193e81445a\",\"accentColor\":\"#d48c4c\",\"darkAccentColor\":\"#7f542d\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pgs4ps42r23/PRIMARY-6aac125c.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_pgs4ps42r23/PRIMARY-6aac125c.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"af2488f533ec8e6cae00940d6d63c03acc4fbdf5\",\"accentColor\":\"#d48c4c\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pgs4ps42r23/ART_LOGO-34380381.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"9ab42293068e9c8b57e5fb213ee69afefe7c80c0\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pgs4ps42r23/HERO_PORTRAIT-c922f471.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Wenn die Traumwohnung zum Albtraum wird! Wer Opfer von verpfuschten Bauarbeiten wird, muss hart um sein Recht und sein verlorenes Geld kämpfen. Die Familien sind am Ende und streiten mit den zuständigen Baufirmen. Wird die Gerechtigkeit siegen und das Schicksal der Häuslbauer ein positives Ende finden? \",\"path\":\"/serien/pfusch-am-bau\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":12,\"languages\":[],\"ageRating\":{\"minAge\":6},\"iconicImage\":{\"id\":\"b9eb5b76a72fb7a8e89c53e7090316eb57955a5c\",\"url\":\"https://img.joyn.de/gn/assets/p11133588_i_h11_ae.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_p730z15mwtc\",\"title\":\"Unsere kleine Farm\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"3b4ba7d5fe6f8f207bf1e76b4e1e528e63da05a4\",\"accentColor\":\"#d47c58\",\"darkAccentColor\":\"#7f4a34\",\"url\":\"https://img.joyn.de/ingest/t_001/i_l8dlnq7chvtz.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_l8dlnq7chvtz.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"aec43ae95b2fb8a3101958240a4f29500b363e8d\",\"accentColor\":\"#d47c58\",\"url\":\"https://img.joyn.de/ingest/t_001/i_cg9d9cjr3xsg.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"b4bc200e272d1e8324becf460d2dcdc4bc34c8f1\",\"url\":\"https://img.joyn.de/ingest/t_001/i_rwuk9lckcj6y.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"6\",\"title\":\"SAT.1 GOLD\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/SAT.1%2BGold/brand-logo-white-v2-sat1-gold%2B%25281%2529.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Drama\",\"type\":\"DRAMA\",\"__typename\":\"Genre\"}],\"description\":\"Um 1870 in Walnut Grove, einem kleinen Städtchen im Norden Amerikas: Die Ingalls bewirtschaften eine kleine Farm, die die Familie mal recht, mal schlecht ernährt. Doch auch wenn es wirtschaftlich nicht so gut läuft, lassen sich die Ingalls davon nicht unterkriegen. Auch nicht durch Rückschläge im Privatleben, denn sie wissen: Solange die Familie zusammenhält, kann nichts wirklich schiefgehen. Die Serie basiert auf dem Roman der Schriftstellerin Laura Ingalls Wilder.\",\"path\":\"/serien/unsere-kleine-farm\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":10,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"b128439ea46efccb86c922c1c1d5ef9218a594d5\",\"url\":\"https://img.joyn.de/gn/assets/p184223_i_h10_ag.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pe9hq37befb\",\"title\":\"Sehr witzig!?\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"03eb956fb4984e361684d375a239a332518950da\",\"accentColor\":\"#d60e13\",\"darkAccentColor\":\"#80080b\",\"url\":\"https://img.joyn.de/ingest/t_001/i_lte5aeg5m432.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_lte5aeg5m432.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"ed29ae3fb0a044c5bd08d1af7530ba4e145199f4\",\"accentColor\":\"#d60e13\",\"url\":\"https://img.joyn.de/ingest/t_001/i_y583vw6n709e.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"c0ce3cdea8f871f21084b842ef37c7c61f8826bc\",\"url\":\"https://img.joyn.de/ingest/t_001/i_51l90qn9o3wc.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Comedy\",\"type\":\"COMEDY\",\"__typename\":\"Genre\"}],\"description\":\"\\\"Sehr witzig!? - Der Witze Stammtisch\\\" mit Harry Prünster, Lydia Prenner-Kasper, Angelika Niedetzky und Gerold Rudle bringt österreichischen Witz, Schmäh und Gemütlichkeit direkt in die Wohnzimmer. \",\"path\":\"/serien/sehr-witzig\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":9,\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"75281b26fc3f63d24bd076e3f9880262742494cc\",\"url\":\"https://img.joyn.de/gn/assets/p12539716_i_h8_ae.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_plh8pmz8b8p\",\"title\":\"Lenßen \u0026 Partner\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"1474ce563bdc28e50f63fe44b8242d2e247b9c5f\",\"accentColor\":\"#c1200e\",\"darkAccentColor\":\"#731308\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ea5s0t3cqtdm.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_ea5s0t3cqtdm.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"fb4964b2358f0da486d13f6a81b00ee3081bf5d4\",\"accentColor\":\"#c1200e\",\"url\":\"https://img.joyn.de/ingest/t_001/i_vcgfkdc601oj.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"6844d31673843fdd447696f219d3cef0e430f072\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ids5gmid215c.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"2\",\"title\":\"SAT.1\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/SAT.1/brand-logo-white-sat-eins%2B%25281%2529.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"6\",\"title\":\"SAT.1 GOLD\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/SAT.1%2BGold/brand-logo-white-v2-sat1-gold%2B%25281%2529.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokusoap\",\"type\":\"DOKUSOAP\",\"__typename\":\"Genre\"},{\"name\":\"Recht\",\"type\":\"LAW\",\"__typename\":\"Genre\"},{\"name\":\"Krimi-Drama\",\"type\":\"CRIME DRAMA\",\"__typename\":\"Genre\"}],\"description\":\"Detektivischer Spürsinn, Recherche, Menschenkenntnis und Kombinationsgabe sind die Eigenschaften von \\\"Lenßen \u0026 Partner\\\". Das Format entwickelte das Genre der Court-Shows weiter und zeigt, was außerhalb des Gerichtssaals passiert: \\\"Lenßen \u0026 Partner\\\" ist ein Ermittlungsbüro. Überall dort, wo die Polizei selbst nicht aktiv wird, sind die Detektive gefragt. In jeder Folge wird ein abgeschlossener Fall präsentiert, der sich an den Aufgaben von Rechtsanwalt Ingo Lenßen orientiert.\",\"path\":\"/serien/lenssen-und-partner\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":8,\"languages\":[],\"ageRating\":{\"minAge\":16},\"iconicImage\":{\"id\":\"8653030d7434f785b26ff3bbd25f8753dd43af74\",\"url\":\"https://img.joyn.de/gn/assets/p9019903_i_h11_ae.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pmnq73zas7x\",\"title\":\"Auf Streife\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"c15e4fe9ca63e08168090f892b29edde6f079e13\",\"a