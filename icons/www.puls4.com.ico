arkings\":[],\"numberOfSeasons\":3,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"27974e297ba5bb578698d6f227c5be2508440542\",\"url\":\"https://img.joyn.de/gn/assets/p24415396_i_h10_ac.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pjtms3vfuos\",\"title\":\"Erbstreit - Der letzte Wille ist erst der Anfang\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"15f9e39831cb92755b43341cfe60180382a80d80\",\"accentColor\":\"#c18452\",\"darkAccentColor\":\"#734f31\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pjtms3vfuos/PRIMARY-70f792a4.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_pjtms3vfuos/PRIMARY-70f792a4.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"9f20f312595d9d03f6109215f40ab12985909d49\",\"accentColor\":\"#c18452\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pjtms3vfuos/ART_LOGO-ca6c8021.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"ec805355463d8670e71bcd64e3580fb24d6fc04b\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pjtms3vfuos/HERO_PORTRAIT-690bfc6c.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Die beiden Rechtsanwälte Dr. Hubert Niedermayr und Mag. Martin Baumgartner werden aktiv, wenn Erbstreitigkeiten Familien auseinanderzureißen drohen. ATV zeigt den unermüdlichen Einsatz der Juristen für ihre Mandant:innen.\",\"path\":\"/serien/erbstreit-der-letzte-wille-ist-erst-der-anfang\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":2,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"fd14ab3e72458f2e43eb6258ef902cce08e02763\",\"url\":\"https://img.joyn.de/gn/assets/p20476771_i_h10_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pqbti4xmsmu\",\"title\":\"US Open\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"9361346b9bad6d30f9e07e7287aa83d6a7bbbfda\",\"accentColor\":\"#00288c\",\"darkAccentColor\":\"#001854\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pqbti4xmsmu/PRIMARY-7d61085b.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_pqbti4xmsmu/PRIMARY-7d61085b.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"05fcd98bcf9f4fe49f601402bd9756a8704edb60\",\"accentColor\":\"#00288c\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pqbti4xmsmu/ART_LOGO-fd4ed8df.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"0c0387d825522c1417a787f0105d291eafc46823\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pqbti4xmsmu/HERO_PORTRAIT-a10b18cb.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"1102\",\"title\":\"Joyn AT\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/Joyn/Joyn_white-new.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Sport\",\"type\":\"SPORTS\",\"__typename\":\"Genre\"}],\"description\":\"Ganz großes Tennis: Beim vierten und letzten Grand Slam Turniers des Jahres duellieren sich die besten Tennisspieler:innen um den Titel bei den US Open. Die besten Spiele, die spektakulärsten Ballwechsel, die großen Triumphe und Dramen: All dies und mehr siehst du live auf JOYN. \",\"path\":\"/serien/us-open\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":0},\"iconicImage\":null},{\"id\":\"d_pkuh4ujg32c\",\"title\":\"Fußball: UNIQA ÖFB Cup\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"832572f737618756a988cdcfcc5f8442b58773f1\",\"accentColor\":\"#d70506\",\"darkAccentColor\":\"#810303\",\"url\":\"https://img.joyn.de/ingest/t_001/i_r4mesycoov8a.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_r4mesycoov8a.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"5e19f6ecc0331843cbe096cd17eda200370cbe7d\",\"accentColor\":\"#d70506\",\"url\":\"https://img.joyn.de/ingest/t_001/i_z4j1e5vitivm.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"c038062e2683c51340ce57de99e061d9d453d70d\",\"url\":\"https://img.joyn.de/ingest/t_001/i_ze1oykxqnkd1.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Sport\",\"type\":\"SPORTS\",\"__typename\":\"Genre\"}],\"description\":\"JOYN \u0026 PULS 4 übertragen ab der Cup-Saison 2026/27 ein ausgewähltes Spiel (Zweitwahlrecht) des UNIQA ÖFB Cups von der 1. Runde bis einschließlich des Viertelfinales exklusiv, live und kostenlos auf JOYN sowie im Free-TV auf PULS 4. Die JOYN- und PULS 4-Sport-Crew rund um Florian Knöchl, Phillip Hajszan, Mario Hochgerner, Lukas Kapun und Co. wird die Zuseherinnen und Zuseher kompetent und unterhaltsam durch die Spiele begleiten.\",\"path\":\"/serien/fussball-uniqa-oefb-cup\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":0},\"iconicImage\":null},{\"id\":\"d_p8eor743urb\",\"title\":\"We have to survive - Überleben am Limit\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"b381566d2c920a52bddf430ca7c60eda4e8b2d02\",\"accentColor\":\"#c67453\",\"darkAccentColor\":\"#764531\",\"url\":\"https://img.joyn.de/ingest/t_001/i_vnwrtoungqs7_7bd426cd.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_vnwrtoungqs7_7bd426cd.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"3331427993393d9b1c7fb631ffe9a1d0cd380560\",\"accentColor\":\"#c67453\",\"url\":\"https://img.joyn.de/ingest/t_001/i_bq73wezmyg2w_03707fb6.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"c08a6f83578c54cc1c9d5a3620f17ab58ff569c2\",\"url\":\"https://img.joyn.de/ingest/t_001/i_pbougba6f0yr_9eb4ffbd.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Die Temperaturen steigen und steigen - was können wir nur tun? Diese bildgewaltige Dokumentation begleitet Menschen auf vier Kontinenten, die gegen die Folgen des Klimawandels ankämpfen. Ihnen allen ist bewusst, dass wir nur diese eine Erde haben und für ihren Erhalt kämpfen müssen.\",\"path\":\"/serien/we-have-to-survive-ueberleben-am-limit\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":null},{\"id\":\"d_pvedu7r6pgw\",\"title\":\"Klischee Olé\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"863076e232b6f9edfe3b8f08c1bb6337e14b6c6a\",\"accentColor\":\"#ac4c64\",\"darkAccentColor\":\"#672d3c\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pvedu7r6pgw/PRIMARY-3363fad1.png/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_pvedu7r6pgw/PRIMARY-3363fad1.png/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"d2e820d3be155ac8b2065b3d47c08641140f15b1\",\"accentColor\":\"#ac4c64\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pvedu7r6pgw/ART_LOGO-dc26961a.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"97cc1eddb281f41f03356843015b716aec04c244\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pvedu7r6pgw/HERO_PORTRAIT-f1bedefd.png/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Beamte seien faul, Lehrer würden nur vormittags arbeiten, Wiener wären unfreundlich, Männer litten bei jedem Schnupfen wie Schwerkranke und die Generation Z gelte als empfindlich und arbeitsscheu. Doch was ist tatsächlich dran an diesen Klischees? Und warum denken wir überhaupt in solchen Schubladen? In \\\"Klischee Olé\\\" geht Österreichs bekannteste Influencerin und Dancing-Star Anna Strigl populären Vorurteilen mit Humor, Neugier und einer guten Portion Selbstironie auf den Grund.\",\"path\":\"/serien/klischee-ole\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":6},\"iconicImage\":{\"id\":\"84f5d9c4780dc955bdede2af06d263c88f06b625\",\"url\":\"https://img.joyn.de/gn/assets/p33798352_i_h8_ab.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pgapqlay024\",\"title\":\"Sofatalks\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"a67c65dc33a65f590cac3fa732db8ab0a8e7c9ce\",\"accentColor\":\"#d64c36\",\"darkAccentColor\":\"#802d20\",\"url\":\"https://img.joyn.de/ingest/t_001/i_wlkjlsj9k18j.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_wlkjlsj9k18j.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"4c622c32483e6400018fcdd088243e160512589d\",\"accentColor\":\"#d64c36\",\"url\":\"https://img.joyn.de/ingest/t_001/i_13o5noh0xqr1.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"011070a9b94cd3f126c1f51a23aed8eec2ec750a\",\"url\":\"https://img.joyn.de/ingest/t_001/i_0nqupp6oqvpg.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Talk\",\"type\":\"TALK\",\"__typename\":\"Genre\"}],\"description\":\"TV-Star Lilian Klebow trifft außergewöhnliche Menschen an außergewöhnlichen Orten. In einer Wohnzimmer-Atmosphäre entstehen persönliche Gespräche über Wendepunkte, Erfolge, Rückschläge und die Erfahrungen eines bewegten Lebens. Ob Weltstars, Abenteurer oder Visionäre: \\\"Sofatalks\\\" zeigt die Menschen hinter den öffentlichen Rollen und Geschichten, die man so noch nicht gehört hat.\",\"path\":\"/serien/sofatalks\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":0},\"iconicImage\":{\"id\":\"76e70d7239b868c129fd0cafeb863f4bfea7853c\",\"url\":\"https://img.joyn.de/gn/assets/p33425106_i_h8_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pdnqd8amzh9\",\"title\":\"Team Arnautovic\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"8cc11a8e8382889462d620e98a93b6af9c0b0344\",\"accentColor\":\"#d82d48\",\"darkAccentColor\":\"#811b2b\",\"url\":\"https://img.joyn.de/ingest/t_001/i_2loxdqaatpxu.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_2loxdqaatpxu.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"23778061698ac9fa38408123995a232b00d3c7b6\",\"accentColor\":\"#d82d48\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pdnqd8amzh9/ART_LOGO-f3112e20.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"6c0c92264392f7914d93da28f1893263594983cc\",\"url\":\"https://img.joyn.de/ingest/t_001/i_yqifgy4dz85g.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Nicht nur auf dem Platz begeistert ÖFB-Rekordtorschütze Marko Arnautovic die Fans. Mit Humor und Charme wurde er auch abseits des Stadions zum Publikumsliebling. Privat blieb er bisher zurückhaltend. Nun öffnet Familie Arnautovic erstmals die Türen ihres Zuhauses: Ehefrau Sarah sowie die Töchter Emilia und Alicia zeigen ihr Leben hinter den Kulissen - ungefiltert, authentisch und echt.\",\"path\":\"/serien/team-arnautovic\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":1,\"languages\":[],\"ageRating\":{\"minAge\":6},\"iconicImage\":{\"id\":\"3d51657c3eff58fdabf9b5e6e4a3073a3e985eb3\",\"url\":\"https://img.joyn.de/gn/assets/p33175170_i_h10_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_pfhbjdn7mqf\",\"title\":\"Wirtschaft24\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"1b437b7a09e4f67940e1d43626419a9b0b965956\",\"accentColor\":\"#0b20d9\",\"darkAccentColor\":\"#061382\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pfhbjdn7mqf/PRIMARY-a004d505.jpeg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/mas-prod/assets/d_pfhbjdn7mqf/PRIMARY-a004d505.jpeg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"11a093c5a50d79e3c480eed5858a8b80883a3ed0\",\"accentColor\":\"#0b20d9\",\"url\":\"https://img.joyn.de/ingest/t_001/i_zo2zzr8fagvx.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"e558425d20d0b80f4b243844b86d5dd945bb552e\",\"url\":\"https://img.joyn.de/mas-prod/assets/d_pfhbjdn7mqf/HERO_PORTRAIT-0c0e81ac.jpeg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"134\",\"title\":\"PULS 24\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/Austria%2Bonly/PULS%2B24/PULS24_logo.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Talk\",\"type\":\"TALK\",\"__typename\":\"Genre\"},{\"name\":\"Wirtschaft/Finanzen\",\"type\":\"BUS./FINANCIAL\",\"__typename\":\"Genre\"}],\"description\":\"Moderatorin Isabella Richtar präsentiert in Wirtschaft24 neue Trends und Technologien aus wirtschaftlichen Themenbereichen.\",\"path\":\"/serien/wirtschaft24\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":4,\"languages\":[],\"ageRating\":{\"minAge\":0},\"iconicImage\":{\"id\":\"99b93121f5dbe717b0de510837553ec7775c406a\",\"url\":\"https://img.joyn.de/gn/assets/p24263712_i_h10_aa.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_ppc2dfcjyim\",\"title\":\"Schluss mit Schulden\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"15b14fcf0928fd94fd2f8de28c007770f0524b07\",\"accentColor\":\"#1ca473\",\"darkAccentColor\":\"#106245\",\"url\":\"https://img.joyn.de/ingest/t_001/i_350syw2f6gd9.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_350syw2f6gd9.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"1a941585450a20174689eeac90ad85949455250b\",\"accentColor\":\"#1ca473\",\"url\":\"https://img.joyn.de/ingest/t_001/i_0ou9m2sp1b7s.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"020f2927c6ff4ac763c217752ed43c38485cbd9a\",\"url\":\"https://img.joyn.de/ingest/t_001/i_nyj4rv2zo0si.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"1057\",\"title\":\"ATV\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/atv-1/ATV_logo_2.png/profile:nextgen-web-brand-50x\"}},{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Dokumentation\",\"type\":\"DOCUMENTARY\",\"__typename\":\"Genre\"}],\"description\":\"Nicht wenige Menschen in Österreich tappen in die Schuldenfalle und finden nicht mehr heraus aus ihrem finanziellen Desaster. Der Wiener Ex-Finanzpolizist Franz Kurz hat in seinem Ruhestand beschlossen, den Betroffenen zu helfen und ihnen den Weg aus ihrer Verschuldung zu zeigen.\",\"path\":\"/serien/schluss-mit-schulden\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":3,\"languages\":[],\"ageRating\":{\"minAge\":6},\"iconicImage\":{\"id\":\"ef09f3745ec9f0fdb1496b4725f8a14782f7fcd1\",\"url\":\"https://img.joyn.de/gn/assets/p23049665_i_h8_ac.jpg/profile:nextgen-web-livestill-503x283\"}},{\"id\":\"d_p730z15mwtc\",\"title\":\"Unsere kleine Farm\",\"__typename\":\"Series\",\"primaryImage\":{\"id\":\"3b4ba7d5fe6f8f207bf1e76b4e1e528e63da05a4\",\"accentColor\":\"#d47c58\",\"darkAccentColor\":\"#7f4a34\",\"url\":\"https://img.joyn.de/ingest/t_001/i_l8dlnq7chvtz.jpg/profile:nextgen-web-heroportrait-243x365\",\"defaultIconicImageUrl\":\"https://img.joyn.de/ingest/t_001/i_l8dlnq7chvtz.jpg/profile:nextgen-web-primary-503x\"},\"artLogoImage\":{\"id\":\"aec43ae95b2fb8a3101958240a4f29500b363e8d\",\"accentColor\":\"#d47c58\",\"url\":\"https://img.joyn.de/ingest/t_001/i_cg9d9cjr3xsg.png/profile:nextgen-web-artlogo-210x86\"},\"heroPortrait\":{\"id\":\"b4bc200e272d1e8324becf460d2dcdc4bc34c8f1\",\"url\":\"https://img.joyn.de/ingest/t_001/i_rwuk9lckcj6y.jpg/profile:nextgen-web-heroportrait-243x365\"},\"brands\":[{\"id\":\"6\",\"title\":\"SAT.1 GOLD\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/joyn/Shared/Brand/CMS/SAT.1%2BGold/brand-logo-white-v2-sat1-gold%2B%25281%2529.png/profile:nextgen-web-brand-50x\"}}],\"genres\":[{\"name\":\"Drama\",\"type\":\"DRAMA\",\"__typename\":\"Genre\"}],\"description\":\"Um 1870 in Walnut Grove, einem kleinen Städtchen im Norden Amerikas: Die Ingalls bewirtschaften eine kleine Farm, die die Familie mal recht, mal schlecht ernährt. Doch auch wenn es wirtschaftlich nicht so gut läuft, lassen sich die Ingalls davon nicht unterkriegen. Auch nicht durch Rückschläge im Privatleben, denn sie wissen: Solange die Familie zusammenhält, kann nichts wirklich schiefgehen. Die Serie basiert auf dem Roman der Schriftstellerin Laura Ingalls Wilder.\",\"path\":\"/serien/unsere-kleine-farm\",\"licenseTypes\":[\"AVOD\"],\"markings\":[],\"numberOfSeasons\":10,\"languages\":[],\"ageRating\":{\"minAge\":12},\"iconicImage\":{\"id\":\"b128439ea46efccb86c922c1c1d5ef9218a594d5\",\"url\":\"https://img.joyn.de/gn/assets/p184223_i_h10_ag.jpg/profile:nextgen-web-livestill-503x283\"}}]},{\"__typename\":\"LandscapeLane\",\"id\":\"965141:c47c9fb2c40351bfdd2a43fc1340f250\",\"anchorId\":null,\"isPersonalized\":false,\"headline\":\"Café Puls Beitrag verpasst?\",\"assets\":[{\"id\":\"b_pourd6dbk54\",\"title\":\"Chris gratuliert zum Geburtstag\",\"__typename\":\"CompilationItem\",\"genres\":[{\"name\":\"Nachrichten\",\"type\":\"NEWS\",\"__typename\":\"Genre\"}],\"artLogoImage\":null,\"primaryImage\":{\"id\":\"95096d1195ce037aafe538930dc2f95f3ea261c8\",\"accentColor\":\"#8e8e8eff\",\"darkAccentColor\":\"#707070\",\"url\":\"https://img.joyn.de/ingest/t_001/i_01r2q5icctge_e6b96d7f.png/profile:nextgen-web-heroportrait-243x365\",\"urlLandscape\":\"https://img.joyn.de/ingest/t_001/i_01r2q5icctge_e6b96d7f.png/profile:nextgen-web-primary-503x\"},\"ageRating\":{\"description\":\"Altersfreigabe: 0\",\"minAge\":0},\"description\":\"Chris Stephan auf Gratulations-Mission\",\"path\":\"/compilation/cafe-puls/chris-gratuliert-zum-geburtstag\",\"markings\":[],\"startsAt\":1792134175,\"endsAt\":253402297199,\"licenseTypes\":[\"FVOD\"],\"video\":{\"id\":\"a_pour8rdwi7n\",\"duration\":290},\"compilation\":{\"brands\":[{\"id\":\"101\",\"title\":\"PULS 4\",\"logo\":{\"type\":\"BRAND_LOGO\",\"url\":\"https://img.joyn.de/cms/var/assets/Content/Shared/Brand/CMS/AVOD/PULS%2B4/PULS4_logo_1.png/profile:nextgen-web-brand-150x\"}}]},\"resumePosition\":null},{\"id\":\"b_povpo5qj75o\",\"title\":\"Neues Programm: Streugut\",\"__typename\":\"CompilationItem\",\"genres\":[{\"name\":\"N