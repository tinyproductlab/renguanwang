    <script>
        (function(d, s, c) {
            var cdnUrl = 'https://unpkg.com/@elastic/apm-rum/dist/bundles/elastic-apm-rum.umd.min.js';
            var localUrl = '/CustomViews/Custom/PublicPortalCustomViews/Lfwd/Custom/Service/Monitoring/elastic-apm-rum.umd.min.js';

            function loadScript(url, onLoad, onError) {
                if (!url) {
                    console.warn("Elastic APM RUM script URL is empty.");
                    return;
                }
                var j = d.createElement(s);
                j.src = url;
                j.async = true;
                j.onload = onLoad;
                j.onerror = onError;
                var t = d.getElementsByTagName(s)[0];
                t.parentNode.insertBefore(j, t);
            }

            function initApm() {
                if (typeof elasticApm !== 'undefined' && typeof elasticApm.init === 'function') {
                    try {
                        elasticApm.init(c);
                        console.info("Elastic APM RUM initialized.");
                    } catch (err) {
                        console.error("Error initializing Elastic APM RUM:", err);
                    }
                } else {
                    console.warn("Elastic APM RUM object not found or init method missing.");
                }
            }

            // Load from CDN first, fallback to local if fails
            loadScript(cdnUrl, initApm, function() {
                console.warn("CDN failed, loading local Elastic APM RUM script...");
                loadScript(localUrl, initApm, function() {
                    console.error("Both CDN and local Elastic APM RUM script failed to load.");
                });
            });

        })(document, 'script', {
            serviceName: 'Dnp-www-t-mobile-nl-PublicPortal',
            serverUrl: 'https://da26b69ba06d492da337b32ae28a29b1.apm.eu-central-1.aws.cloud.es.io',
            environment: 'Production',
            session: true
        });
    </script>

        <!-- ✅ ✅ Script to add id/interaction id for buttons -->
    <script>
        (function () {

            // --- config mapping (single source, no repetition) ---
            var UC_BUTTONS = [
                { testid: "uc-accept-all-button", id: "uc-accept-btn", interaction: "accept_all" },
                { testid: "uc-deny-all-button", id: "uc-reject-btn", interaction: "deny_all" },
                { testid: "uc-more-button", id: "uc-more-btn", interaction: "more_info" },
                { testid: "uc-save-button", id: "uc-save-btn", interaction: "save_preferences" }
            ];

            var patchScheduled = false;

            function schedulePatch() {
                if (patchScheduled) return;
                patchScheduled = true;
                setTimeout(function () {
                    patchScheduled = false;
                    patchAll(document);
                }, 50);
            }

            // Patch buttons inside a given root (document or shadowRoot)
            function patchInRoot(root) {
                if (!root || !root.querySelectorAll) return;

                for (var i = 0; i < UC_BUTTONS.length; i++) {
                    var cfg = UC_BUTTONS[i];
                    var nodes = root.querySelectorAll('[data-testid="' + cfg.testid + '"]');
                    for (var j = 0; j < nodes.length; j++) {
                        var btn = nodes[j];
                        // Always apply (UC recreates nodes on re-render)
                        btn.id = cfg.id;
                        btn.setAttribute("data-interaction-id", cfg.interaction);
                    }
                }
            }

            // Observe mutations inside a shadowRoot (this is what you were missing)
            function ensureShadowObserver(shadowRoot) {
                if (!shadowRoot || shadowRoot.__ucObserverAttached) return;

                shadowRoot.__ucObserverAttached = true;

                try {
                    var mo = new MutationObserver(function () {
                        // Any change inside shadow DOM -> re-apply ids
                        schedulePatch();
                    });

                    mo.observe(shadowRoot, { childList: true, subtree: true });
                    shadowRoot.__ucObserver = mo;
                } catch (e) {
                    // ignore
                }
            }

            // Traverse document + all open shadow roots
            function patchAll(root) {
                // Patch in current root
                patchInRoot(root);

                // Traverse children to find shadow hosts
                if (!root || !root.querySelectorAll) return;

                var all = root.querySelectorAll("*");
                for (var i = 0; i < all.length; i++) {
                    var el = all[i];
                    if (el && el.shadowRoot) {
                        ensureShadowObserver(el.shadowRoot);
                        patchAll(el.shadowRoot);
                    }
                }
            }

            // 1) Initial patch
            schedulePatch();

            // 2) Observe DOM (for cases where UC mounts/unmounts host element)
            try {
                var bodyObserver = new MutationObserver(function () {
                    schedulePatch();
                });
                bodyObserver.observe(document.body, { childList: true, subtree: true });
            } catch (e) {
                // ignore
            }

            // 3) Click-capture fallback (handles More/Save re-render timing)
            // This catches clicks even when the target is inside shadow DOM (via composedPath)
            document.addEventListener("click", function (e) {
                try {
                    var path = e.composedPath ? e.composedPath() : null;
                    if (!path) return;

                    for (var i = 0; i < path.length; i++) {
                        var node = path[i];
                        if (!node || !node.getAttribute) continue;

                        var tid = node.getAttribute("data-testid");
                        if (tid === "uc-more-button" || tid === "uc-save-button") {
                            // Re-render happens after click -> patch again shortly after
                            setTimeout(schedulePatch, 0);
                            setTimeout(schedulePatch, 150);
                            setTimeout(schedulePatch, 400);
                            break;
                        }
                    }
                } catch (err) { }
            }, true);

        })();
    </script>

</body>
</html>






<script>
    // Replace the Odido header logo with a custom image
    // Campaign period: 10 August 2026 (WK33) – 27 September 2026 (WK39)
    // Preview outside campaign: add ?previewLogo=true to the URL
    (function replaceOdidoLogo() {
        var campaignStart = new Date('2026-08-10T00:00:00');
        var campaignEnd = new Date('2026-09-27T23:59:59');
        var now = new Date();
        var previewMode = new URLSearchParams(window.location.search).get('previewLogo') === 'true';

        if (!previewMode && (now < campaignStart || now > campaignEnd)) {
            return;
        }

        console.log('Odido logo replace: prijzenslag campaign 10 August t/m 27 September');

        var NEW_LOGO_URL = 'https://assets.odido.nl/300x88/edfb2ac1d9/90s-odido-logo-rgb.svg?cv=1784626802084';
        var NEW_LOGO_HTML = '<img src="' + NEW_LOGO_URL + '" alt="Odido logo" style="width:100%;display:block;">';

        function neutralizeAndReplace(anchor) {
            // Strip the attributes Lottie's initializer looks for,
            // so even if it runs later it won't touch this anchor.
            var maskEl = anchor.querySelector('[data-logo-mask]');
            if (maskEl) {
                maskEl.removeAttribute('data-logo-mask');
                maskEl.removeAttribute('data-logo-mask-path');
                maskEl.removeAttribute('data-motion-logo-mask-autoplay');
            }
            anchor.innerHTML = NEW_LOGO_HTML;
        }

        var currentAnchor = null;

        function tryReplace() {
            var logoAnchor = document.querySelector('a.main-nav-menu-logo');
            if (logoAnchor && logoAnchor !== currentAnchor) {
                currentAnchor = logoAnchor;
                neutralizeAndReplace(logoAnchor);
            }
        }

        tryReplace();

        var bodyObserver = new MutationObserver(tryReplace);
        bodyObserver.observe(document.body, { childList: true, subtree: true });

        document.addEventListener('DOMContentLoaded', tryReplace);
        window.addEventListener('load', tryReplace);
    })();
</script>