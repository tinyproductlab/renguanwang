-Normal\"), url(https://static.standaard.be/Assets/Images_Upload/2020/05/05/Arnhem-Normal.woff) format(\"woff\");\n}\n@font-face {\n  font-family: \"Arnhem\";\n  font-style: bold;\n  font-weight: 600;\n  src: local(\"Arnhem-Black\"), url(https://static.standaard.be/Assets/Images_Upload/2020/05/12/Arnhem-Black.woff) format(\"woff\");\n}\n\n        body {\n            margin: 0;\n            font-family: 'Arnhem', Georgia, serif;\n        }\n\n        .error {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n            padding: 2rem;\n        }\n\n        .title {\n            font-family: 'Libre Franklin', sans-serif;\n            font-size: 26px;\n            font-weight: bold;\n        }\n\n        .error img {\n            width: 100%;\n            max-width: 25rem;\n            margin-bottom: 1rem;\n        }\n\n        .two-column-layout {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            gap: 1rem;\n            max-width: 80%;\n            flex-wrap: wrap;\n        }\n\n        .left-column, .right-column {\n            flex: 1;\n            max-width: 40%;\n            padding: 1rem;\n        }\n\n        .left-column {\n            text-align: left;\n        }\n\n        .right-column {\n            text-align: center;\n        }\n\n        .button-container {\n            margin-top: 1rem;\n        }\n\n        .primary-button, .secondary-button {\n            display: inline-block;\n            font-size: 1rem;\n            font-weight: bold;\n            text-align: center;\n            padding: 1rem 2rem;\n            text-decoration: none;\n            border-radius: 5px;\n            transition: background-color 0.3s ease;\n            font-family: 'Libre Franklin', sans-serif;\n            border: 2px solid transparent;\n        }\n\n        /* Primary button: Black */\