                                                            <figure class="figure m-0">
                                    <img decoding="async" width="1920" height="1080" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%201920%201080'%3E%3C/svg%3E" class="card-img w-100 h-100 wp-post-image" alt="wnętrze placówki pocztowej" data-lazy-srcset="https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02.jpg 1920w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-300x169.jpg 300w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-1024x576.jpg 1024w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-768x432.jpg 768w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-1536x864.jpg 1536w" data-lazy-sizes="(max-width: 1920px) 100vw, 1920px" data-lazy-src="https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02.jpg" /><noscript><img decoding="async" width="1920" height="1080" src="https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02.jpg" class="card-img w-100 h-100 wp-post-image" alt="wnętrze placówki pocztowej" srcset="https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02.jpg 1920w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-300x169.jpg 300w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-1024x576.jpg 1024w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-768x432.jpg 768w, https://www.poczta-polska.pl/wp-content/uploads/2026/03/Oferta-w-placowce-i-nowe-placowki_02-1536x864.jpg 1536w" sizes="(max-width: 1920px) 100vw, 1920px" /></noscript>                                </figure>
