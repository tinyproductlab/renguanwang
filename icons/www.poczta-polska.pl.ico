    function CheckNumeric(event) {

        if ((event.which < 48 || event.which > 57) && event.which != 8 && event.which != 44) {
            event.preventDefault();
            alert('tylko cyfry lub przecinek, np 12,34');
            return false;
        }

    }
</script>


