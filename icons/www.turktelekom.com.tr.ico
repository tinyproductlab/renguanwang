    .blog-ai-disc {
        display: flex;
        gap: 16px;
        flex-direction: column;
    }

    .disc-1,
    .disc-2 {
        display: flex;
        gap: 9px;
        align-items: anchor-center;
        font-weight: 700;
        font-family: Mulish;
        font-weight: 700;
        font-style: Bold;
        font-size: 16px;
        line-height: 22px;
        letter-spacing: 0%;
        vertical-align: middle;
