      });
      notificationTiti.setAttribute('target', '');
      var notificationTitiToP = document.createElement('p');
      Array.from(notificationTiti.attributes).forEach(function (attr) {
        if (attr.name !== 'href') {
          notificationTitiToP.setAttribute(attr.name, attr.value);
        }
      });
      notificationTitiToP.innerHTML = notificationTiti.innerHTML;
      notificationTiti.parentNode.replaceChild(notificationTitiToP, notificationTiti);
      notificationTitiToP.addEventListener('click', function (e) {
          if(innerWidth < 991){
            document.querySelector('.header.nav-active .nav-toggle').click();
          }
        document.querySelector('.cbot-dialog-button-regular').click();
      });
    }
  });
</script></DIV>
