  </style>
  <script>
    document.addEventListener("DOMContentLoaded", function(event) {
        // sliderlarin tabli yapi altina tasima
        document.querySelector('div.container.tabli-kartlar.campaigns .info-box-recipe .tab-content > #bidunyafirsat .collapse').appendChild(document.querySelector('.bi-dunya.box-opportunity'));
        document.querySelector('div.container.tabli-kartlar.campaigns .info-box-recipe .tab-content > #primeayricalik .collapse').appendChild(document.querySelector('.bi-dunya.box-opportunity.prime'));
        document.querySelector('div.container.tabli-kartlar.campaigns .info-box-recipe .tab-content > #selfyayricalik .collapse').appendChild(document.querySelector('.bi-dunya.box-opportunity.selfy'));
  
        // sliderlari birbirinden ayirmak icin class ekleme
        document.querySelectorAll('.box-opportunity-slider').forEach((slider, index) => {
            slider.classList.add(`tns-campaign-${index + 1}`);
        });
        // 2 ve daha fazlasindaki cloned slider itemlerini silme
        document.querySelector('.tns-campaign-2').querySelectorAll('.tns-slide-cloned').forEach(sliderItem=>{
            sliderItem.remove();
        });
        // 2. ve 3. slider yapisini olusturma
        var slider2 = tns({
            container: '.tns-campaign-2',
            mode: "carousel",
          axis: "horizontal",
          items: 1,
          gutter: 0,
          edgePadding: 0,
          fixedWidth: !1,
          autoWidth: !1,
          viewportMax: !1,
          slideBy: 1,
          center: !1,
          controls: !0,
          controlsPosition: "top",
          controlsText: ["prev", "next"],
          controlsContainer: !1,
          prevButton: !1,
          nextButton: !1,
          nav: !0,
          navPosition: "bottom",
          navContainer: !1,
          navAsThumbnails: !1,
          arrowKeys: !1,
          speed: 300,
          autoplay: !1,
          autoplayPosition: "top",
          autoplayTimeout: 5e3,
          autoplayDirection: "forward",
          autoplayText: ["start", "stop"],
          autoplayHoverPause: !1,
          autoplayButton: !1,
          autoplayButtonOutput: !0,
          autoplayResetOnVisibility: !0,
          animateIn: "tns-fadeIn",
          animateOut: "tns-fadeOut",
          animateNormal: "tns-normal",
          animateDelay: !1,
          loop: !0,
          rewind: !1,
          autoHeight: !1,
          responsive: !1,
          lazyload: !1,
          lazyloadSelector: ".tns-lazy-img",
          touch: !0,
          mouseDrag: !1,
          swipeAngle: 15,
          nested: !1,
          preventActionWhenRunning: !1,
          preventScrollOnTouch: !1,
          freezable: !0,
          onInit: !1,
          useLocalStorage: !0,
          nonce: !1,
        });
        var slider3 = tns({
            container: '.tns-campaign-3',
            mode: "carousel",
            axis: "horizontal",
            items: 1,
            gutter: 0,
            edgePadding: 0,
            autoWidth: !1,
            slideBy: 'page',
            center: !1,
            controls: !0,
            controlsPosition: "bottom",
            "controlsText": ['<i class="icon-left-arrow"></i>', '<i class="icon-right-arrow"></i>'],
            controlsContainer: !1,
            prevButton: !1,
            nextButton: !1,
            nav: !0,
            navPosition: "bottom",
            arrowKeys: !1,
            speed: 300,
            autoplay: !1,
            autoplayPosition: "top",
            autoplayTimeout: 5e3,
            autoplayDirection: "forward",
            autoplayText: ["start", "stop"],
            autoplayHoverPause: !1,
            autoplayButton: !1,
            autoplayButtonOutput: !0,
            autoplayResetOnVisibility: !0,
            animateIn: "tns-fadeIn",
            animateOut: "tns-fadeOut",
            animateNormal: "tns-normal",
            animateDelay: !1,
            loop: !0,
            rewind: !1,
            autoHeight: !1,
            responsive: !1,
            lazyload: !1,
            touch: !0,
            mouseDrag: 1,
            swipeAngle: 15,
            nested: !1,
            preventActionWhenRunning: !1,
            preventScrollOnTouch: "auto",
            freezable: !0,
            onInit: !1,
            useLocalStorage: !0,
            nonce: !1, 
        });
  
        setTimeout(() => {
            // .bi-dunya sınıfına sahip .prime ve .selfy elementlerini seçiyoruz
            const biDunyaElements = document.querySelectorAll('.box-opportunity.bi-dunya.prime, .box-opportunity.bi-dunya.selfy');
  
            biDunyaElements.forEach(element => {
                let nextButton = element.querySelector('.container .left-area .tns-controls button[data-controls="next"]');
                let prevButton = element.querySelector('.container .left-area .tns-controls button[data-controls="prev"]');
                let navButtonLast = element.querySelector('.tns-outer .tns-nav button:last-child');
                let navButtonFirst = element.querySelector('.tns-outer .tns-nav button:first-child');
  
                nextButton?.addEventListener('click', function(e) {
                    if (navButtonLast.classList.contains('tns-nav-active')) {
                        e.stopPropagation();
                        navButtonFirst.click();
                    }
                });
  
                prevButton?.addEventListener('click', function(e) {
                    if (navButtonFirst.classList.contains('tns-nav-active')) {
                        e.stopPropagation();
                        navButtonLast.click();
                    }
                });
            });
        }, 2000);
  
    });
  </script>
  
  <script>
    window.addEventListener("DOMContentLoaded", function () {
      const TabliKartlar = document.querySelector("div.container.tabli-kartlar.campaigns");
      const dropdownForm1 = document.querySelector('.form-group-select1');
      const dropdownToggleTittle = document.querySelector('.form-group-select1 .dropdown-toggle');
      const dropdownFormItems = document.querySelectorAll('.form-group-select1 .dropdown .dropdown-item');
      TabliKartlar.classList.add("tk");
  
      let tabs1 = document.querySelectorAll(".tabli-kartlar.campaigns.tk .tab-content .nav .nav-item a");
      const dropbox1 = document.querySelector(".form-group-select1 .dm1");
  
      //   document.querySelector(".tabli-kartlar.tk h3").after(document.querySelector(".form-group-select1"));
      TabliKartlar.insertBefore(dropdownForm1, TabliKartlar.firstChild);
  
      document.querySelector(".dt1").innerText = tabs1[0].innerText;
      tabs1.forEach((tab1, index) => {
        let dropLi1 = document.createElement("li");
        dropLi1.innerText = tab1.innerText;
        index === 0 && dropLi1.classList.add("d-none");
        dropLi1.classList.add("dropdown-item", "di1");
        dropbox1.appendChild(dropLi1);
        tab1.style.display = "none";
  
        dropLi1.addEventListener("click", function () {
          tabs1.forEach(tab1 => tab1.closest(".tab-pane").classList.remove("show", "active"));
          tabs1[index].closest(".tab-pane").classList.add("show", "active");
          document.querySelector(".dt1").innerText = dropLi1.innerText;
          document.querySelectorAll(".di1").forEach(item1 => item1.classList.remove("d-none"))
          dropLi1.classList.add("d-none");
        });
      });
      document.querySelectorAll(".tabli-kartlar.campaigns.tk .info-box-recipe .tab-content .tab-pane >.collapse:not(.show)").forEach(collapse => { collapse.classList.add("show") });
  
    });
  </script>
  <script>
    const dropdownn1 = document.querySelector('.d1');
    const dropdownMenuu1 = document.querySelector('.dm1');
  
    dropdownn1.addEventListener('click', function () {
      dropdownMenuu1.classList.toggle('show');
      document.querySelector(".dt1").classList.toggle("dt");
    dropdownn1.classList.toggle("active");
    });
    let dropdownItems1 = document.querySelectorAll('.di1');
    let dropdownContents1 = document.querySelectorAll('.dropdown-content');
  
    for (let i = 0; i < dropdownItems1.length; i++) {
      dropdownItems1[i].addEventListener('click', function () {
        let target1 = this.getAttribute('data-target');
        for (let j = 0; j < dropdownContents1.length; j++) {
          dropdownContents1[j].style.display = 'none';
        }
        document.querySelector(target1).style.display = 'block';
      });
    }
    const dropdown1 = document.querySelector('.d1');
    const dropdownToggle1 = dropdown1.querySelector('.dt1');
  
    // Her bir dropdown item'ına tıklandığında
    dropdownItems1.forEach(item1 => {
      item1.addEventListener('click', () => {
        // Tüm aktif sınıflarını kaldır
        dropdownItems1.forEach(item1 => item1.classList.remove('active'));
  
        // Tıklanan elemente aktif sınıfını ekle
        item1.classList.add('active');
  
        // Dropdown toggle'ına seçilen elementin değerini yazdır
        dropdownToggle1.textContent = item1.textContent;
      });
    });

    window.addEventListener("DOMContentLoaded", function () {
  
      const TabliKartlar1 = document.querySelector("div.container.tabli-kartlar.campaigns");
      const dropdownForm1 = document.querySelector('.form-group-select1');
      const dropdownToggleTittle = document.querySelector('.form-group-select1 .dropdown-toggle');
      const dropdownFormItems = document.querySelectorAll('.form-group-select1 .dropdown .dropdown-item');
      const navTabsA = document.querySelectorAll('.container.tabli-kartlar.campaigns .nav-tabs .nav-item a');
  
      const dataToggleMap = {
         "Bi' Dünya Fırsat": "Bi' Dünya Fırsat",
         "Prime Ayrıcalıkları": "Prime Ayrıcalıkları",
         "Selfy Kampanyaları": "Selfy Kampanyaları"
       };
 
       function normalizeText(text) {
         return text.replace(/[’‘]/g, "'").trim();
       }
 
       // Dropdown
       dropdownFormItems.forEach(dropdownFormItem => {
         dropdownFormItem.addEventListener('click', function () {
           const clickedText = normalizeText(this.innerText);
           const newToggleValue = dataToggleMap[clickedText];
           if (newToggleValue) {
             TabliKartlar1.setAttribute("data-toggle", newToggleValue);
             dropdownToggleTittle.innerText = this.innerText.trim(); // Görsel başlık
           } else {
             console.warn('Tanımsız dropdown değeri:', clickedText);
           }
         });
       });
 
       // Nav tabs
       navTabsA.forEach(navA => {
         navA.addEventListener('click', function () {
           const clickedNavText = normalizeText(this.innerText);
           const newTabValue = dataToggleMap[clickedNavText];
           if (newTabValue) {
             TabliKartlar1.setAttribute("data-toggle", newTabValue);
           } else {
             console.warn('Tanımsız tab değeri:', clickedNavText);
           }
         });
       });
 
  
      var ucgenInPrice = document.querySelectorAll(".triangle-price");
      ucgenInPrice.forEach(function (ucgenInPriceFor) {
      var icerik = ucgenInPriceFor.innerText.trim();
  
      var sayi = icerik.match(/\d+/);
      var sayiMetni = sayi ? sayi[0] : "";
      var metin = icerik.replace(/\d+/, "").trim();
  
      var wrapper = document.createElement("div");
  
      // KoÅŸula gÃ¶re sayÄ±nÄ±n soluna veya saÄŸÄ±na yazma
      if (metin === "%") {
        wrapper.innerHTML = `<span class="triangle-price-text">${metin}</span><span class="triangle-price-number">${sayiMetni}</span>`;
      } else {
        wrapper.innerHTML = `<span class="triangle-price-number">${sayiMetni}</span><span class="triangle-price-text">${metin}</span>`;
      }
  
      ucgenInPriceFor.innerHTML = wrapper.innerHTML;
  
      if (ucgenInPriceFor.querySelector('.triangle-price-text').innerText === 'Ãœcretsiz') {
        ucgenInPriceFor.style.marginTop = 'unset';
      }
    });
  
    let campaignUcgeni = document.querySelector('main > div > .container > .detail-page > .row .col-xl-4.col-12, main > div > .container > .detail-page > .row .col-xl-5.col-12');
    if (campaignUcgeni?.querySelector('.triangle-container:not(.d-none)')) {
      campaignUcgeni.classList.add('campaign-triangle')
    }
    });
  </script></DIV>
