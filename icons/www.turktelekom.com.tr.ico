  })();
</script>
<script type="module">
  (function() {
    let fbLoaded = false;
    function initFirebase() {
      if (fbLoaded) return;
      fbLoaded = true;

      const evts = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
      evts.forEach(function(e) { window.removeEventListener(e, initFirebase, { passive: true }); });

      Promise.all([
        import("https://www.gstatic.com/firebasejs/9.21.0/firebase-app.js"),
        import("https://www.gstatic.com/firebasejs/9.21.0/firebase-analytics.js")
      ]).then(([appModule, analyticsModule]) => {
        const firebaseConfig = { 
          apiKey: "AIzaSyDcLTbbBT-Oq66sN_i57YXTkX8EwmV4Wp4", 
          authDomain: "anasite-hub.firebaseapp.com", 
          projectId: "anasite-hub", 
          storageBucket: "anasite-hub.appspot.com", 
          messagingSenderId: "485869514747", 
          appId: "1:485869514747:web:1bf0a48e97cd159e0be55e", 
          measurementId: "G-1WCS56RXDL" 
        };
        const app = appModule.initializeApp(firebaseConfig);
        const analytics = analyticsModule.getAnalytics(app);
      }).catch(err => console.error("Firebase load error"));
    }

    const evts = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
    evts.forEach(function(e) { window.addEventListener(e, initFirebase, { passive: true }); });
    setTimeout(initFirebase, 5000);
  })();
</script>

