});
</script>


<script>
// acil SEO duzenlemesi quickfix -od

        document.addEventListener('DOMContentLoaded', function() {
            function fixRedundantAltText(imgElement, descElement, newAltText) {
                if (imgElement && descElement) {
                    if (imgElement.alt === descElement.textContent.trim()) {
                        imgElement.alt = newAltText;
                    }
                }
            }

            fixRedundantAltText(
                document.querySelector('img[aria-describedby="desc-1"]'),
                document.getElementById('desc-1'),
                'Kadın gülümsüyor'
            );
            fixRedundantAltText(
                document.querySelector('img[aria-describedby="desc-2"]'),
                document.getElementById('desc-2'),
                'Bir erkek ve bir kadın cep telefonlarına bakıyor'
            );
            fixRedundantAltText(
                document.querySelector('img[aria-describedby="desc-5"]'),
                document.getElementById('desc-5'),
                'Video oyun karakterleri'
            );

            var imgElementDesc6 = document.querySelector('img[aria-describedby="desc-6"]');
            if (imgElementDesc6 && !imgElementDesc6.alt) {
                imgElementDesc6.alt = 'Türk Telekom Dijital Servisler';
            }

            var xImgElement = document.querySelector('img.x-i');
            var xDescElement = document.querySelector('.x-l .wcag-image-text');

            fixRedundantAltText(xImgElement, xDescElement, 'Türk Telekom X Logo');
        });
    </script>

