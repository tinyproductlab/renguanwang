.blog-card-list .blog-cards-wrapper .blog-cards .main-card .content .dtrt-flex .rtflx {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card .content .dtrt-flex .rtflx img {
    content: url(/PublishingImages/blog-rticon.svg);
    height: 18px;
    width: 18px;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card .content .dtrt-flex .rtflx span {
    font-weight: 600;
    font-size: 14px;
    line-height: 18px;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card .content .dtrt-flex .rtflx::after {
    content: "dinle";
    display: inline-block;
    padding-left: 24px;
    background-image: url("https://www.turktelekom.com.tr/PublishingImages/blog-dinle-icon.svg");
    background-repeat: no-repeat;
    background-size: 20px 20px;
    background-position: left center;
    margin-left: 8px;
    font-weight: 600;
    font-size: 14px;
    line-height: 18px;
    color: var(--tt-color-text-neutral-medEmphasis);
}


#blog-detail .inner-section {
    background-color: var(--tt-color-surface) !important;
}

#main-cards {
    /* padding: 0px !important; */
    padding: 0 12px;
    margin-top: 40px;
}

#main-cards .result-filters,
#main-cards .inner-section .filter-panel,
#main-cards .kategoriler,
#main-cards .blog-cards-wrapper .pager {
    display: none;
}
</style>
<script>
document.querySelectorAll('#main-cards :is(.result-filters, .inner-section .filter-panel, .kategoriler, .blog-cards-wrapper .pager)').forEach(el => el.remove());

document.querySelectorAll('.blog-cards .main-card .content h5').forEach(el => {
    const h3 = document.createElement('h3');
    h3.innerHTML = el.innerHTML;
    [...el.attributes].forEach(attr => h3.setAttribute(attr.name, attr.value));
    el.replaceWith(h3);
});

document.querySelectorAll('.rtflx img').forEach(img => {
    img.alt = 'Okuma Süresi';
});
</script>
