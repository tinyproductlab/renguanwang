<script>
document.addEventListener("DOMContentLoaded", function () {
    var hubContainer = document.querySelector(".hubMySwiper");
    var hubSwiper = new Swiper(hubContainer, {
        slidesPerView: 1,
        spaceBetween: 12,
        navigation: {
            nextEl: hubContainer.querySelector(".swiper-button-next"),
            prevEl: hubContainer.querySelector(".swiper-button-prev"),
            disabledClass: "swiper-button-disabled",
        },
        pagination: {
            el: hubContainer.querySelector(".swiper-pagination"),
            clickable: true,
        },
        breakpoints: {
            0:    { width: 340},
            990:  { width: 310 },
            1140: { width: 160 }
        }
    });
});
</script>

