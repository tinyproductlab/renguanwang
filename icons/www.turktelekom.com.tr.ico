    document.addEventListener("DOMContentLoaded", function () {
        var menuVideos = document.querySelectorAll('.menu-hover-video');

        menuVideos.forEach(function (video) {
            video.parentElement.parentElement.addEventListener('mouseenter', function () {
                video.currentTime = 0; 
                video.play().catch(function (error) {
                    console.log("Video play failed", error);
                });
            });

        });
    });
