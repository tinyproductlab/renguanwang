	<script>

  /**
   * 3rd party scriptlerin parametrelerle disable edilmesi
   */
  function isSectionDisabled(section) {
    if (typeof window === 'undefined' || !window.location) {
      return false; 
    }

    try {
      const urlParams = new URLSearchParams(window.location.search);
      
      const disabledParam = urlParams.get('disable');
      
      if (disabledParam) {
        const disabledArray = disabledParam.split(',').map(item => item.trim().toLowerCase());
        const sectionName = section.toLowerCase();

        if (disabledArray.includes('all')) {
          return true;
        }

        if (disabledArray.includes(sectionName)) {
          return true;
        }
      }

      return false;
      
    } catch (error) {
      console.warn("Could not parse URL parameters for script blocking:", error);
      return false;
    }
  }
</script>

<script>
  (function() {
    // Prevent loading multiple times
    let scriptsLoaded = false;

    // Helper to safely check your existing isSectionDisabled function
    function checkDisabled(section) {
      return typeof isSectionDisabled === 'function' ? isSectionDisabled(section) : false;
    }

    // The function that loads all heavy scripts and tags
    function loadTrackingScripts() {
      if (scriptsLoaded) return;
      scriptsLoaded = true;

      // Clean up event listeners so this only runs once
      const events = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
      events.forEach(function(event) {
        window.removeEventListener(event, loadTrackingScripts, { passive: true });
      });

      // 1. Load Efilli Script (Preserving your condition)
      if (!checkDisabled('efilli')) {
        var efilliScript = document.createElement('script');
        efilliScript.defer = true;
        efilliScript.src = "https://bundles.efilli.com/turktelekom.com.tr.prod.js";
        document.body.appendChild(efilliScript);
      }

      // 2. Inject SmartBanner Meta Tags
      var metaTags = `
        <meta name="smartbanner:title" content=" ">
        <meta name="smartbanner:author" content=" <strong style='font-size: 13px;'>Türk Telekom</strong> </br>Online'a özel teklifler ve abonelik başvuruları Türk Telekom Uygulamasında! ">
        <meta name="smartbanner:price" content=" ">
        <meta name="smartbanner:price-suffix-apple" content=" ">
        <meta name="smartbanner:price-suffix-google" content=" ">
        <meta name="smartbanner:icon-apple" content="https://www.turktelekom.com.tr/PublishingImages/turk-telekom-uygulamalari/turk-telekom-logo.svg">
        <meta name="smartbanner:icon-google" content="https://www.turktelekom.com.tr/PublishingImages/turk-telekom-uygulamalari/turk-telekom-logo.svg">
        <meta name="smartbanner:button" content="AÇ">
        <meta name="smartbanner:button-url-apple" content="https://apps.apple.com/tr/app/t%C3%BCrk-telekom-online-i-%C5%9Flemler/id496489138?l=tr">
        <meta name="smartbanner:button-url-google" content="https://play.google.com/store/apps/details?id=com.tmob.AveaOIM&hl=tr">
        <meta name="smartbanner:enabled-platforms" content="android,ios">
        <meta name="smartbanner:close-label" content="Close">
        <meta name="smartbanner:hide-ttl" content="259200000">
      `;
      document.head.insertAdjacentHTML('beforeend', metaTags);

      // 3. Load GTM & Gtag (Preserving your condition)
      if (!checkDisabled('gtm')) {
        // GTM Container
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.defer=true;j.src=
        '//www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-M5V5VXS');

        // Gtag Initialization
        window.dataLayer = window.dataLayer || [];
        // Note: Assigned to window.gtag so it can be called globally anywhere else on your site
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'AW-11144894498');
      }
    }

    // Attach listeners for any user interaction (Bypasses Lighthouse bot)
    const events = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
    events.forEach(function(event) {
      window.addEventListener(event, loadTrackingScripts, { passive: true });
    });

    // Fallback: If the user does absolutely nothing, load the scripts after 5 seconds anyway
    setTimeout(loadTrackingScripts, 5000);
  })();
</script><script>
  (function() {
    // Safe check evaluated immediately, but guarded against ReferenceError
    const isBannerDisabled = typeof isSectionDisabled === 'function' ? isSectionDisabled('sbanner') : false;
    if (isBannerDisabled) return;

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function(error) {});
      });
    }

    document.addEventListener("DOMContentLoaded", function() {
      window.dataLayer = window.dataLayer || [];
      document.querySelectorAll(".notification-content-list a").forEach(function(notification) {
        notification.addEventListener("click", function() {
          var titleEl = this.querySelector(".notification-content-title");
          var title = titleEl ? titleEl.innerText.trim() : "";
          var url = this.getAttribute("href");
          
          window.dataLayer.push({
            'event': 'notification_click',
            'event_category': title,
            'event_label': url
          });
        });
      });
    });
  })();
