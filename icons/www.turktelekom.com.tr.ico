<style>
.emagaza-entry {
  margin-top: 24px;
  position: relative;
}

.emagaza-desktop {
  display: block;
}

.emagaza-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--tt-color-background);
    border-radius: 12px;
    padding: 0 39px;
    box-shadow: 0 4px 16px rgba(0,0,0,.06);
    height: 147px;
    background-image: url(" https://asset.turktelekom.com.tr/SiteAssets/images/bg-shape.png");
    background-position: right center;
    background-repeat: no-repeat;
    background-size: auto;
}

.emagaza-center p {
    font-size: 14px;
    line-height: 18px;
    color: var(--tt-color-text-neutral-lowEmphasis);
    font-weight: 400;
    width: 456px;
}

.emagaza-left img {
    position: relative;
    width: 189px;
}

.emagaza-center {
  flex: 1;
  padding: 0 54px;
}

.emagaza-title {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 6px;
  display: block;
}

.emagaza-mobile {
  display: none;
  padding: 16px;
}

.emagaza-mobile a:hover, .emagaza-mobile a:visited{
    color: unset;
    text-decoration: none;
}

.mobile-link {
  display: flex;
  align-items: center;
  background: var(--tt-color-background);
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 12px;
  text-decoration: none;
  font-weight: 600;
  box-shadow: 0 2px 10px rgba(0,0,0,.05);
}

.mobile-link img { 
  width: 32px; 
  height: 32px; 
  margin-right: 12px;
  object-fit: contain;
}

.mobile-link span { 
    flex: 1;
    font-size: 14px;
    line-height: 18px;
    display: flex;
    align-items: center;
    font-weight: 700;
    color: var(--tt-color-text-neutral-highEmphasis);
}


@media (max-width: 990px) {
  .emagaza-desktop, .boxes-area.grey .box-wrap{
    display: none;
  }
  .emagaza-mobile {
    display: block;
  }
  .emagaza-entry{
     margin-top:0;
  }
  .boxes-area.grey{
     padding: 0;
   }
.emagaza-mobile .arrow {
  margin-right: 7px;
  display: inline-block;
  width: 13px;
  height: 13px;
  border-right: 2px solid var(--tt-color-text-neutral-highEmphasis);
  border-top: 2px solid var(--tt-color-text-neutral-highEmphasis);
  transform: rotate(45deg);
} 
}

.emagaza-right .btn.btn-primary {
    background-color: var(--tt-color-button-primary-BG) !important;
    border-color: var(--tt-color-base-primary) !important;
    color:var(--tt-color-text-white) !important;
    width: 186px;
}

[data-theme=dark] .emagaza-center p {
  color: var(--tt-color-text-neutral-medEmphasis);
}
[data-theme=dark] .emagaza-card{
    border: 1px solid var(--tt-color-border);
}
</style>
