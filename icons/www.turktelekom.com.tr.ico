<script>
  window.netmera = window.netmera || [];

  (function() {
    let netmeraLoaded = false;
    
    function initNetmera() {
      // Safe check moved inside the delayed execution
      if (typeof isSectionDisabled === 'function' && isSectionDisabled('netmera')) return;

      if (netmeraLoaded) return;
      netmeraLoaded = true;

      const evts = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
      evts.forEach(function(e) { window.removeEventListener(e, initNetmera, { passive: true }); });

      const scriptElement = document.createElement('script');
      scriptElement.defer = true;
      scriptElement.src = '//cdn-netmeraprod.turktelekom.com.tr/wsdkjs/OuhvsX4q6iPmLoKRRTOCGGTZ2qHgvooKE3aHQ3cYAuWjOOv_ue6oH2jZgcFaHlwj';
      document.body.appendChild(scriptElement);

      function generateUUID() { return crypto.randomUUID ? crypto.randomUUID() : 'id-' + Math.random().toString(36).substr(2, 9); }
      function setUserCookie(userIdUn, expirationDays = 365) {
        const d = new Date(); d.setDate(d.getDate() + expirationDays);
        document.cookie = `netmera_user_id=${userIdUn}; expires=${d.toUTCString()}; domain=.turktelekom.com.tr; path=/`;
      }
      function getuserIdUnFromCookie() {
        const cookies = document.cookie.split(';');
        for (let i = 0; i < cookies.length; i++) {
          const c = cookies[i].trim();
          if (c.startsWith('netmera_user_id=')) return c.substring('netmera_user_id='.length, c.length);
        }
        return null;
      }
      function getuserIdUn() {
        let id = getuserIdUnFromCookie();
        if (!id) { id = generateUUID(); setUserCookie(id); }
        return id;
      }

      const userIdUn = getuserIdUn();

      netmera.push(function (api) {
        api.sendEvent({
          code: "n:sv",
          ee: window.location.href,
          ea: document.querySelector('meta[name="description"]') ? document.querySelector('meta[name="description"]').getAttribute('content') : ''
        });
        api.sendEvent({ code: "n:sco", ee: window.location.href });
        try {
          const user = api.getUser();
          user.setCustomId(userIdUn);
          user.save().catch(() => {});
        } catch (err) {}
      });
    }

    const evts = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
    evts.forEach(function(e) { window.addEventListener(e, initNetmera, { passive: true }); });
    setTimeout(initNetmera, 5000);
  })();
</script>
<script>
  (function() {
    let cbotLoaded = false;
    function initChatbot() {
      var urlParams = new URLSearchParams(window.location.search);
      var isUrlDisabled = urlParams.has('cbot') && urlParams.get('cbot') === '0';
      var isFuncDisabled = typeof isSectionDisabled === 'function' ? isSectionDisabled('cbot') : false;
      
      if (isUrlDisabled || isFuncDisabled) return;

      if (cbotLoaded) return;
      cbotLoaded = true;

      const evts = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
      evts.forEach(function(e) { window.removeEventListener(e, initChatbot, { passive: true }); });

      var scriptElement = document.createElement('script');
      scriptElement.defer = true;
      scriptElement.id = 'cbot-widget-script';
      scriptElement.type = 'text/javascript';
      scriptElement.src = 'https://corechatbotai.turktelekom.com.tr/js/widget/cbot-turktelekomllm-generator.min.js';
      scriptElement.setAttribute('data-user', '');
      scriptElement.setAttribute('data-owl', 'true');
      document.body.appendChild(scriptElement);
    }

    const evts = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'wheel'];
    evts.forEach(function(e) { window.addEventListener(e, initChatbot, { passive: true }); });
    setTimeout(initChatbot, 5000);
  })();
</script>
