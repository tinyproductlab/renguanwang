<script>
    document.addEventListener('DOMContentLoaded', function () {
        const titles = document.querySelectorAll('.filter-modal .title');

        titles.forEach(title => {
            title.addEventListener('click', function (e) {
                e.stopPropagation();

                document.querySelectorAll('.filter-modal').forEach(modal => {
                    if (modal !== this.closest('.filter-modal')) {
                        modal.classList.remove('active');
                    }
                });

                this.closest('.filter-modal').classList.toggle('active');
            });
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.filter-modal')) {
                document.querySelectorAll('.filter-modal').forEach(modal => {
                    modal.classList.remove('active');
                });
            }
        });

        document.querySelectorAll('#authorDiv .options input, #authorDiv .options label').forEach(el => {
            el.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        });

        document.querySelectorAll('#authorDiv .options input[type="checkbox"]').forEach(input => {
            input.addEventListener('change', function () {
                const label = this.nextElementSibling;
                label.style.textDecoration = this.checked ? 'line-through' : 'none';
            });
        });
    });
</script>

