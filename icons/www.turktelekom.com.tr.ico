main .blog-card-list .btn-primary {
    display: flex;
    width: 170px;
    height: 44px;
    padding: 10px 8px;
    justify-content: center;
    align-items: center;
    gap: 10px;
}

body form #contentRow main .blog-card-list .btn-secondary {
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
    border: 1px solid var(--tt-color-base-primary) !important;
    background-color: var(--tt-color-accent-neutral-100) !important;
    padding: 10px 8px;
    margin-bottom: 32px;
    color: var(--tt-color-base-primary) !important;
    text-decoration: unset;
    font-weight: 600;
    font-size: 16px;
    line-height: 22px;
}

main .btn-secondary:hover {
    color: #002855;
}

main .btn-secondary.type-01 {
    width: 170px;
    height: 44px;
}

main .blog-card-list .btn-secondary:focus,
main .blog-card-list .btn-secondary:active {
    box-shadow: unset !important;
}

main .btn-link-01 {
    color: rgb(4, 158, 173) !important;
}

main .btn-link-01:hover {
    text-decoration: underline;
}

.blog-card-list {
    gap: clamp(16px, calc(-11.2px + 4vw), 40px);
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--card-border-blog);
    background-color: var(--card-bg-blog) !important;
    padding: clamp(16px, calc(11.4666666667px + 0.6666666667vw), 20px);
    /* box-shadow: 0px 1px 4px 0px rgba(37, 51, 66, 0.12); */
    /* transition: box-shadow 0.2s linear; */
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.active {
    display: flex;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card:hover {
    /* box-shadow: 0px 2px 6px 0px rgba(37, 51, 66, 0.2); */
    text-decoration: unset;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.blog-badge {
    position: relative;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.type-01 {
    flex: 1 1 min(50%, 370px);
    max-width: 570px;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.type-01>.image {
    max-height: 280px;
    /*height: 100%;*/
    width: inherit;
    -o-object-fit: cover;
    object-fit: cover;
    border-radius: 4px;
    overflow: hidden;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.type-01>.image img {
    width: inherit;
    height: inherit;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.type-01 .content .text-line-clamp-2 {
    color: var(--tt-color-text-neutral-medEmphasis) !important;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.type-01 .content .author img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    -o-object-fit: cover;
    object-fit: cover;
    overflow: hidden;
}

.author.flex.gap-8.items-center {
    display: none;
}

@media screen and (max-width: 480px) {
    html:has(.filter-sort .trigger.active) {
        overflow: hidden;
    }

    .filter-panel .filter-sort:has(.trigger.active) {
        max-width: unset;
        border-radius: unset;
        border: unset;
        width: 100vw;
        position: fixed;
        bottom: 0;
        max-height: calc(100vh - 182px);
    }

    .filter-panel .filter-sort:has(.trigger.active) .trigger {
        justify-content: space-between;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .filter-panel .filter-sort:has(.trigger.active) .trigger i {
        content: url(/assets/image/close.svg);
    }

    .filter-panel .filter-sort:has(.trigger.active) .filter-modal {
        overflow-y: auto;
        max-height: calc(100vh - 236px);
    }

    .filter-panel .filter-sort:has(.trigger.active) .filter-modal .btn-clear {
        justify-content: flex-end;
        gap: 8px;
    }

    .filter-panel .filter-sort:has(.trigger.active) .filter-modal fieldset {
        max-height: unset;
    }
}

.blog-card-list .btn-secondary.bg-white.text-main {
    color: #002855;
    text-decoration: unset;
}

.blog-card-list .btn-secondary.bg-white.text-main:hover {
    color: #002855;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card hgroup .desc {
    display: -webkit-box;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
}

.blog-card-list .blog-cards-wrapper .blog-cards .main-card.blog-badge h5.title {

    color: #049EAD !important;
}

[data-theme=light] h2.title.text-3224.text-mB,
[data-theme=light] h2.section-text.text-2418.text-mB.text-main,
[data-theme=light] .comment.flex.flex-col.gap-12 p,
[data-theme=light] .tool-box p,
[data-theme=light] .comment.flex.flex-col.gap-12 h3 {
    color: var(--tt-color-accent-neutral-900);
}

[data-theme="light"] .blog-card-list .blog-cards-wrapper .blog-cards .main-card {
