<meta property="mrf:tags" content="pagetype:ErrorPage404">

<script>
(function (window) {
  function normalizeUrl(url) {
    try {
      let urlObj
      if (url.startsWith('http://') || url.startsWith('https://')) {
        urlObj = new URL(url)
      } else {
        urlObj = new URL(url, window.location.origin)
      }

      let normalized = urlObj.origin + urlObj.pathname

      if (normalized.length > urlObj.origin.length + 1 && normalized.endsWith('/')) {
        normalized = normalized.slice(0, -1)
      }

      return normalized.toLowerCase()
    } catch (e) {
      let normalized = url.split('?')[0].split('#')[0]
      if (normalized.length > 1 && normalized.endsWith('/')) {
        normalized = normalized.slice(0, -1)
      }
      return normalized.toLowerCase()
    }
  }

  function isUrlExcluded(url, exceptions) {
    return exceptions.some(function (exception) {
      if (exception.indexOf('*') !== -1) {
        let prefix = exception.slice(0, exception.indexOf('*'))
        if (prefix.length > 0 && prefix.endsWith('/')) {
          prefix = prefix.slice(0, -1)
        }
        return url === prefix || url.startsWith(prefix + '/')
      }
      return url === exception
    })
  }

  let currentUrl = window.location.origin + window.location.pathname
  const urlExceptions = ["https://www.aztecaaguascalientes.com/*","https://www.tvaztecabajacalifornia.com/*","https://www.aztecabajio.com/*","https://www.aztecachiapas.com/*","https://www.aztecachihuahua.com/*","https://www.aztecaciudadjuarez.com/*","https://www.aztecaguerrero.com/*","https://www.aztecajalisco.com/*","https://www.aztecalaguna.com/*","https://www.aztecamorelos.com/*","https://www.aztecapuebla.com/*","https://www.aztecaqueretaro.com/*","https://www.aztecaquintanaroo.com/*","https://www.aztecasinaloa.com/*","https://www.aztecaveracruz.com/*","https://www.aztecayucatan.com/*","https://www.tvazteca.com/aztecadeportes/mundial-2026"]

  const normalizedCurrentUrl = normalizeUrl(currentUrl)

  const normalizedExceptions = urlExceptions.map(url => normalizeUrl(url))

  if (!isUrlExcluded(normalizedCurrentUrl, normalizedExceptions)) {
    const local = window.localStorage.getItem('aztsession')
    let sessionData = null
    let userStatus = null
    let userIM = null
    let userEmail = null
    if (local) {
      var base64regex = /^([0-9a-zA-Z+/]{4})*(([0-9a-zA-Z+/]{2}==)|([0-9a-zA-Z+/]{3}=))?$/
      if (base64regex.test(local)) {
        try {
          sessionData = JSON.parse(decodeURIComponent(atob(local)))
        } catch (e) {
          sessionData = null
        }
      } else {
        try {
          sessionData = JSON.parse(local)
        } catch (e) {
          sessionData = null
        }
      }
      if (sessionData) {
        userStatus = typeof sessionData?.status !== 'undefined' ? sessionData.status : userStatus
        userIM = typeof sessionData?.user?.im !== 'undefined' ? sessionData.user.im : userIM
        userEmail = typeof sessionData?.user?.email !== 'undefined' ? sessionData.user.email : userEmail
      }
    }

    let pageType = 'ErrorPage404'
    let insiderPageType = null
    switch (pageType) {
      case 'Homepage':
        insiderPageType = 'Home'
        break
      case 'Section':
        insiderPageType = 'Category'
        break
      case 'Video':
      case 'Article':
      case 'EnvivoPage':
      case 'EnvivoConstantPage':
      case 'Gallery':
      case 'SoccerMatchPage':
        insiderPageType = 'Product'
        break
      default:
        insiderPageType = 'Other'
        break
    }

    window.insider_object = window.insider_object || {};
    if (insiderPageType) {
      window.insider_object.page = {
        "type": insiderPageType
      }
    }

    if (insiderPageType === 'Product') {
      let pageId = document.querySelector('meta[name="brightspot.contentId"]') ? document.querySelector('meta[name="brightspot.contentId"]').content : 0
      let pageImage = document.querySelector('meta[name="thumbnail"]') ? document.querySelector('meta[name="thumbnail"]').content : 'https://tv-azteca-brightspot.s3.amazonaws.com/1f/8e/ba02d27c4ed184614d0589695a96/1.%20LogoTVASitioOK.png'
      window.insider_object.product = {
        "id": pageId,
        "name": "Aquí hay fuego extinguido. ",
        "taxonomy": [ "TV Azteca", "", "ErrorPage404" ],
        "product_image_url": pageImage,
        "price": 1,
        "currency": "MXN",
        "custom": {
          "sub_section": "Aquí hay fuego extinguido. ",
          
          "page_keywords": [""],
          
          "publish_date": "27/04/2021",
          "publish_hour": "18:43:41",
          "modification_date": "28/04/2021",
          "modification_hour": "16:22:39",
          
          "user_location": "MX"
        }
      }
    }

    if (userIM || userEmail) {
      window.insider_object.user = {}
      window.insider_object.user.gdpr_optin = true
    }
    if (userEmail && /@/.test(userEmail)) {
      window.insider_object.user.email = userEmail
    }
    if (userIM) window.insider_object.user.uuid = userIM

    if (window.Insider?.track) {
      let date = new Date()
      let insiderEventParams = {
        
        "section": "Aquí hay fuego extinguido. ",
        "pageType": "ErrorPage404",
        "title": "Aquí hay fuego extinguido. ",
        "channel": "TV Azteca",
        "page_keywords": [""],
        "userLocation": "MX"
      }
      if (userIM) insiderEventParams.im = userIM
      window.Insider.track('events', [{
        "event_name": "site_view",
        "timestamp": date.toISOString(),
        "event_params": insiderEventParams
      }])
    }
  }
