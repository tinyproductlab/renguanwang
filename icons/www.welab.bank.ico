ropdown\",\"id\":115,\"title\":\"最新消息\",\"sections\":[{\"id\":225,\"documentId\":\"vepx415h9mn9ihi5x29unv45\",\"heading\":\"最新消息\",\"createdAt\":\"2025-10-22T03:53:41.271Z\",\"updatedAt\":\"2026-09-15T02:41:15.891Z\",\"publishedAt\":\"2026-09-15T02:41:15.946Z\",\"locale\":\"zh\",\"nestedMenu\":null,\"links\":[{\"id\":26,\"title\":\"新聞中心\",\"url\":\"/newsroom\",\"subLinks\":[]},{\"id\":27,\"title\":\"日誌\",\"url\":\"/blog/\",\"subLinks\":[]},{\"id\":28,\"title\":\"獎項及殊榮\",\"url\":\"/awards/\",\"subLinks\":[]},{\"id\":29,\"title\":\"財務概覽\",\"url\":\"/feature/insights\",\"subLinks\":[]},{\"id\":30,\"title\":\"常見問題\",\"url\":\"/support/\",\"subLinks\":[]}]}]},{\"__component\":\"menu.button\",\"id\":1819,\"title\":\"立即下載\",\"url\":\"/feature/download\",\"type\":\"Secondary\"}]},\"meta\":{}},\"noticesData\":[{\"id\":36,\"documentId\":\"l3b47x55sxjqcs7pisuzjod3\",\"content\":\"【提防詐騙】近期手機預訂及網上購物活動增加，騙徒可能趁機利用釣魚短訊、偽冒銀行的來電、短訊、電郵、網站及虛假退款訊息進行詐騙。如有懷疑，請致電 +852 3898 6988 與我們聯絡，或瀏覽我們網站上「保安提示」。你亦可以瀏覽香港金融管理局網站上發布的提防詐騙資訊「智醒錦囊」。\\n\\n\\n\\n\",\"state\":\"Valid\",\"createdAt\":\"2026-01-14T02:07:15.971Z\",\"updatedAt\":\"2026-10-15T08:32:43.787Z\",\"publishedAt\":\"2026-10-15T08:32:43.814Z\",\"locale\":\"zh\",\"localizations\":[{\"id\":38,\"documentId\":\"l3b47x55sxjqcs7pisuzjod3\",\"content\":\"[Fraud Alert] Stay alert when ordering smartphones or shopping online. Beware of phishing messages, bogus calls, fraudulent SMS or emails, fake websites, and refund scams. If you have any concerns, please contact us at +852 3898 6988 or visit our “Security Tips” page. You can also learn some smart tips from the Hong Kong Monetary Authority website on how to prevent fraud.\",\"state\":\"Valid\",\"createdAt\":\"2026-01-14T02:08:19.120Z\",\"updatedAt\":\"2026-10-15T08:32:48.734Z\",\"publishedAt\":\"2026-10-15T08:32:48.757Z\",\"locale\":\"en\"},{\"id\":37,\"documentId\":\"l3b47x55sxjqcs7pisuzjod3\",\"content\":\"【提防诈骗】近期手机预订及网购活动增加，诈骗分子可能趁机利用钓鱼短信、仿冒银行的来电、短信、电子邮件、网站及虚假退款信息进行诈骗。如有疑问，请致电 +852 3898 6988 与