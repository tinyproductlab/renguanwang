                                <div id="wt29_wtLogin_wt4_OutSystemsUIWeb_wtIframeLogin_block_wtIframeWrapper" class="iframe" style="height: 315px; width: 365px; position: relative; margin-right: 40px;">
									<iframe class="OSInline" frameborder="0"  src="/SitePublico_Login/Login_v3.aspx?LOCALE=PT&amp;SEGMENTO=Empresas" title="" style="height:100%; width:100%;" scrolling="no"></iframe>
								</div>
                                <div id="wt29_wtLogin_wt5_OutSystemsUIWeb_wtIframeLogin_block_wtIframeWrapper" class="iframe" style="height: 315px; width: 366px; position: relative;">
									<iframe class="OSInline" frameborder="0" src="/SitePublico_Login/Login_v3.aspx?LOCALE=PT&amp;SEGMENTO=Particulares" title="" style="height:100%; width:100%;" scrolling="no"></iframe>
								</div>								
                                <script>
                                    document.querySelectorAll('iframe').forEach(function(iframe) {
                                        iframe.addEventListener('load', function() {
                                            var parentBody = window.parent.document.body;
                                            if (parentBody.classList.contains('tablet')) {
                                                try { iframe.contentDocument.querySelector('.login').classList.add('tablet'); } catch(e) {}
                                                iframe.parentElement.classList.add('tablet');
                                            }
                                            if (parentBody.classList.contains('phone')) {
                                                try {
                                                    iframe.contentDocument.querySelector('.login').classList.add('phone');
                                                    iframe.contentDocument.querySelector('.ErrorBlock').classList.add('phone');
                                                } catch(e) {}
                                                iframe.parentElement.classList.add('phone');
                                            }
                                        });
                                    });

                                    document.addEventListener('DOMContentLoaded', function() {
                                        var parentBody = window.parent.document.body;
                                        if (parentBody.classList.contains('tablet') || parentBody.classList.contains('phone')) {
                                            document.querySelectorAll('iframe').forEach(function(iframe) {
                                                var sep = iframe.src.indexOf('?') !== -1 ? '&' : '?';
                                                iframe.src = iframe.src + sep + 'DEVICE=phone';
                                            });
                                        }
                                    });
                                </script>
                            </div>
