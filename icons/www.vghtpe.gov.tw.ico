//                     html += " </div>";
//                 }
//                 $("#banner").empty().html(html);
//             }
//         });
//     }
</script>
<style>
.banner-control-area {
    width: 100%;
    text-align: center;
    margin: 12px 0 18px 0;
}

.banner-play-pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 80px;
    height: 28px;
    padding: 5px 16px;

    background: #1f817d;
    color: #ffffff;
    border: 0;
    border-radius: 8px;

    font-size: 1.25rem;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;

    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.25);
}

.banner-play-pause:hover,
.banner-play-pause:focus {
    background: #176f6b;
    color: #ffffff;
    outline: 3px solid #000000;
    outline-offset: 3px;
}

.swiper-button-prev:focus,
.swiper-button-next:focus,
.swiper-pagination-bullet:focus {
    outline: 3px solid #000000;
    outline-offset: 3px;
}
/* pagination 整體位置，可依需要再微調 */
#mainBannerSwiper .swiper-pagination {
    bottom: 12px !important;
    text-align: center;
}

/* 未選取圓點：白色 */
#mainBannerSwiper .swiper-pagination-bullet {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    outline: none;
    padding: 0;
    margin: 0 6px !important;

    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-block;

    background-color: #ffffff;
    opacity: 1;
    cursor: pointer;
    vertical-align: middle;
}

/* 目前選取圓點：藍色 */
#mainBannerSwiper .swiper-pagination-bullet-active {
    background-color: rgba(72, 137, 176, 0.9);
}

/* 鍵盤 focus 時要有可視焦點 */
#mainBannerSwiper .swiper-pagination-bullet:focus {
    outline: 2px solid #000;
    outline-offset: 2px;
}
#mainBannerSwiper .swiper-button-prev.swiper-button-lock,
#mainBannerSwiper .swiper-button-next.swiper-button-lock {
    display: flex !important;
}
</style>
</html>