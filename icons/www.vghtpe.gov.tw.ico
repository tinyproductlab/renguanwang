<script>
$(function () {

    /*
     * 一、主選單漢堡按鈕 aria-expanded 同步
     * 需要漢堡按鈕加上 id="mainMenuToggle"
     * offcanvas 外層 id 為 offcanvas
     */
    var offcanvasEl = document.getElementById('offcanvas');
    var $mainMenuToggle = $('#mainMenuToggle');

    if (offcanvasEl && $mainMenuToggle.length > 0) {

        offcanvasEl.addEventListener('show.bs.offcanvas', function () {
            $mainMenuToggle
                .attr('aria-expanded', 'true')
                .attr('aria-label', '關閉主選單');

            $mainMenuToggle.find('.tw-sr-only').text('關閉主選單');
        });

        offcanvasEl.addEventListener('hidden.bs.offcanvas', function () {
            $mainMenuToggle
                .attr('aria-expanded', 'false')
                .attr('aria-label', '打開主選單');

            $mainMenuToggle.find('.tw-sr-only').text('打開主選單');
        });
    }


    /*
     * 二、offcanvas 內部導覽列箭頭 aria-expanded 同步
     */
    $(document).off('click.offcanvasArrowA11y', '.list_offcanvas .arrow[aria-controls]');

    $(document).on('click.offcanvasArrowA11y', '.list_offcanvas .arrow[aria-controls]', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var $btn = $(this);
        var menuTitle = $btn.attr('data-menu-title') || '';
        var targetId = $btn.attr('aria-controls');
        var $target = $('#' + targetId);

        if ($target.length === 0) {
            console.warn('找不到 aria-controls 對應的子選單：' + targetId);
            return;
        }

        var isExpanded = $btn.attr('aria-expanded') === 'true';
        var nextExpanded = !isExpanded;

        if (nextExpanded) {
            $btn
                .attr('aria-expanded', 'true')
                .attr('aria-label', menuTitle + '選單按鈕，展開');

            $target.removeClass('tw-hidden');

            $btn.find('.fa-angle-right').addClass('tw-hidden');
            $btn.find('.fa-angle-down').removeClass('tw-hidden');

        } else {
            $btn
                .attr('aria-expanded', 'false')
                .attr('aria-label', menuTitle + '選單按鈕，收合');

            $target.addClass('tw-hidden');

            $btn.find('.fa-angle-right').removeClass('tw-hidden');
            $btn.find('.fa-angle-down').addClass('tw-hidden');
        }
    });

});
</script>
<style>
.list_offcanvas button.arrow {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    min-width: 44px;
}

.list_offcanvas button.arrow:focus {
    outline: 2px solid #000;
    outline-offset: 2px;
}
</style>
        <!-- /mainMenuCanvas -->
