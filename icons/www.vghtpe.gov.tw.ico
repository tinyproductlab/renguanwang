	$('#teacherSearch').select2({
		theme: 'bootstrap-5',
		width: '100%',
		data: teacheropt,
		maximumInputLength: 30,
		minimumInputLength: 1,
		tags: true
	});
	// 無障礙修正：Select2 開啟後，將焦點移到搜尋輸入框
	$('#teacherSearch').on('select2:open', function () {
	    setTimeout(function () {
	        var searchField = document.querySelector('.select2-container--open .select2-search__field');
	        if (searchField) {
	            searchField.focus();
	        }
	    }, 0);
	});

	// 無障礙修正：鍵盤焦點在 Select2 元件時，可用 Enter / Space 開啟下拉搜尋
	$(document).on('keydown', '.select2-selection', function (e) {
	    var $select = $(this).closest('.select2-container').prev('select');

	    if ($select.attr('id') === 'teacherSearch') {
	        if (e.key === 'Enter' || e.key === ' ') {
	            e.preventDefault();
	            $('#teacherSearch').select2('open');
	        }
	    }
	});
	// Select2 開啟後，焦點移到搜尋輸入框
	$('#teacherSearch').on('select2:open', function () {
	    setTimeout(function () {
	        var searchField = document.querySelector('.select2-container--open .select2-search__field');
	        if (searchField) {
	            searchField.focus();
	        }
	    }, 0);
	});

	// 無障礙修正：Select2 開啟時按 Tab，關閉下拉並跳到下一個可聚焦元件
	$(document).on('keydown', '.select2-container--open .select2-search__field', function (e) {
	    if (e.key === 'Tab') {
	        e.preventDefault();

	        var isShift = e.shiftKey;
	        var $select = $('#teacherSearch');

	        // 關閉 Select2
	        $select.select2('close');

	        setTimeout(function () {
	            var focusable = $('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')
	                .filter(':visible');

	            var current = $select.next('.select2-container').find('.select2-selection')[0];
	            var index = focusable.index(current);

	            if (isShift) {
	                if (index > 0) {
	                    focusable.eq(index - 1).focus();
	                }
	            } else {
	                if (index > -1 && index < focusable.length - 1) {
	                    focusable.eq(index + 1).focus();
	                }
	            }
	        }, 0);
	    }
	});
	instChange($('#instSelect').val());
	$('#instSelect').change(function(){
		instChange($(this).val());
	});
});
function search_Fs2(val,flag){
	console.info("search_Fs2():"+val);
	if(flag==1){
		var pattDigit = new RegExp("\\d");
		var pattAZ = new RegExp("[a-zA-Z]");
		var href;
		if(pattDigit.test(val)){
			href = 'Teacher.action?tid=' + val;
		} else if(pattAZ.test(teacherSearch)) {
			href = 'Depart.action?depno=' + val +'&q=' + teacherSearch;;
		}
		location.href = href;
	}else if(flag==2){
		location.href = 'Depart.action?q=' + val;
	}
}

function search_Fs(){
	var teacherSearch = $('#teacherSearch :selected').val() || customInput;
	var href;
	if(teacherSearch && teacherSearch != '' && teacherSearch != ''){
		var pattDigit = new RegExp("\\d");
		var pattAZ = new RegExp("[a-zA-Z]");
		if(pattDigit.test(teacherSearch)){
			$('#teacherSearch option').each(function () {
				if($(this).val() == teacherSearch){
					href = 'Teacher.action?tid=' + teacherSearch;
				}
			});
		} else if(pattAZ.test(teacherSearch)) {
			$('#teacherSearch option').each(function () {
				if($(this).val() == teacherSearch){
					href = 'Depart.action?depno=' + teacherSearch+'&q=' + teacherSearch;
				}
			});
		}
		if(href){
			location.href = href;
		}else{
			location.href = 'Depart.action?q=' + teacherSearch;
		}
	} else {
		var deptSelect = $('#deptSelect').val();
		if(deptSelect && deptSelect != ''){
			location.href = 'Depart.action?depno=' + deptSelect;
		}else{
			var instSelect = $('#instSelect').val();
			if(instSelect && instSelect != ''){
				location.href = 'Depart.action?iid=' + instSelect;
			}
		}
	}
}
function instChange(iid){
	$('#deptSelect option').remove();
	$('#deptSelect').append($("<option></option>").attr("value", "").text(teacherselectdep));
	if(iid && iid.length > 0){
		jQuery.post("TeacherAjax!searchDept.action", {
			iid: iid,
		}, function(data){
			if(data.msg && data.msg.indexOf('ok') > -1){
				var deptList = data.deptList;
				for(index in deptList){
					if('zh_TW' == flang){
						$('#deptSelect').append($("<option></option>").attr("value", deptList[index].pcode).text(deptList[index].cname));
					} else {
						$('#deptSelect').append($("<option></option>").attr("value", deptList[index].pcode).text(deptList[index].ename));
					}
				}
// 				$( "#deptSelect" ).change(function() {
// 					  console.info($(this).val());
// 					  location.href = 'Depart.action?depno=' + $(this).val();
// 				});
			}
		});
	}
}

function deptSelectGo() {
    var depno = $('#deptSelect').val();

    console.info(depno);

    if (depno && depno != '') {
        location.href = 'Depart.action?depno=' + encodeURIComponent(depno);
    }
}
</script>

