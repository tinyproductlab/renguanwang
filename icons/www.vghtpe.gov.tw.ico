    outline: none !important;
    box-shadow: none !important;
}

/* 按下跳到主要內容後，才顯示主要內容焦點提示 */
#content.skip-focus-show #contentFocusTarget {
    outline: 4px dashed #1e87f0 !important;
    outline-offset: 4px !important;
    box-shadow: 0 0 .2rem .2rem rgba(30, 135, 240, .25) !important;
}

/* 如果頁面沒有 contentFocusTarget，備用：直接框 content */
#content.skip-focus-show {
    outline: 4px dashed #1e87f0 !important;
    outline-offset: 4px !important;
}

</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var ac = document.getElementById('AC');
    var content = document.getElementById('content');

    if (!ac || !content) {
        return;
    }

    if (!content.hasAttribute('tabindex')) {
        content.setAttribute('tabindex', '-1');
    }

    function focusContent() {
        content.classList.add('skip-focus-show');

        setTimeout(function () {
            content.focus({ preventScroll: true });
            content.scrollIntoView({
                block: 'start',
                behavior: 'auto'
            });
        }, 0);
    }

    ac.addEventListener('click', function (e) {
        e.preventDefault();
        focusContent();
    });

    ac.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.keyCode === 13) {
            e.preventDefault();
            focusContent();
        }
    });

    content.addEventListener('blur', function () {
        content.classList.remove('skip-focus-show');
    });

    document.addEventListener('mousedown', function (e) {
        if (!content.contains(e.target)) {
            content.classList.remove('skip-focus-show');
        }
    });

    if (window.location.hash === '#AC') {
        focusContent();
    }
});

$('.btnFontsize').on('click', function () {
    $('.btnFontsize')
        .removeClass('active')
        .attr('aria-pressed', 'false');

    $(this)
        .addClass('active')
        .attr('aria-pressed', 'true');
});
</script>
</body>
<script>
var bannerLang = {
	    pauseText: "暫停",
	    playText: "播放",
	    pauseLabel: "暫停輪播",
	    playLabel: "播放輪播",
	    openWin: "[另開新視窗]",

	    prevLabel: "切換至上一張輪播內容：",
	    nextLabel: "切換至下一張輪播內容：",
	    goToSlide: "切換至第",
	    currentSlide: "目前為第",
	    slideText: "張輪播內容：",
	    currentStatus: "目前顯示輪播內容："
	};
	
	function getBannerSlides() {
	    return $('#banner .swiper-slide:not(.swiper-slide-duplicate)');
	}
	
	function getBannerTitle(index) {
	    var $slides = getBannerSlides();
	    var $slide = $slides.eq(index);

	    var title = $slide.find('img').attr('alt');

	    if (!title) {
	        title = '第'
	              + (index + 1)
	              + '張輪播內容';
	    }

	    return title;
	}
	
	function updateBannerStatus(swiper) {
	    var $slides = getBannerSlides();
	    var total = $slides.length;

	    if (total === 0) {
	        return;
	    }

	    var currentIndex = swiper.realIndex || 0;
	    var currentTitle = getBannerTitle(currentIndex);

	    $('#bannerStatus').text(bannerLang.currentStatus + currentTitle);
	}
	
	function updateBannerA11y(swiper) {
	    var $slides = getBannerSlides();
	    var total = $slides.length;

	    if (total === 0) {
	        return;
	    }

	    var currentIndex = swiper.realIndex || 0;
	    var prevIndex = (currentIndex - 1 + total) % total;
	    var nextIndex = (currentIndex + 1) % total;

	    var prevTitle = getBannerTitle(prevIndex);
	    var nextTitle = getBannerTitle(nextIndex);

	    $('#mainBannerSwiper .swiper-button-prev')
	        .attr('aria-label', bannerLang.prevLabel + prevTitle)
	        .attr('title', bannerLang.prevLabel + prevTitle);

	    $('#mainBannerSwiper .swiper-button-next')
	        .attr('aria-label', bannerLang.nextLabel + nextTitle)
	        .attr('title', bannerLang.nextLabel + nextTitle);

	    $('#mainBannerSwiper .swiper-pagination button').each(function (index) {
	        var title = getBannerTitle(index);

	        if (index === currentIndex) {
	            $(this)
	                .attr('aria-label', bannerLang.currentSlide + (index + 1) + bannerLang.slideText + title)
	                .attr('aria-current', 'true')
	                .attr('title', bannerLang.currentSlide + (index + 1) + bannerLang.slideText + title);
	        } else {
	            $(this)
	                .attr('aria-label', bannerLang.goToSlide + (index + 1) + bannerLang.slideText + title)
	                .removeAttr('aria-current')
	                .attr('title', bannerLang.goToSlide + (index + 1) + bannerLang.slideText + title);
	        }
	    });

	    updateBannerStatus(swiper);
	}
	
// 	function updateBannerA11y(swiper) {
// 	    var currentIndex = swiper.realIndex;
	
// 	    $('.swiper-button-prev').attr('aria-label', bannerLang.prevLabel);
// 	    $('.swiper-button-next').attr('aria-label', bannerLang.nextLabel);
	
// 	    $('.swiper-pagination button').each(function (index) {
// 	        var title = $('#banner .swiper-slide:not(.swiper-slide-duplicate)')
// 	            .eq(index)
// 	            .find('img')
// 	            .attr('alt');
	
// 	        if (!title) {
// 	            title = '第' + (index + 1) + '張輪播內容';
// 	        }
	
// 	        if (index === currentIndex) {
// 	            $(this)
// 	                .attr('aria-label', bannerLang.currentSlide + title)
// 	                .attr('aria-current', 'true');
// 	        } else {
// 	            $(this)
// 	                .attr('aria-label', bannerLang.goToSlide + title)
// 	                .removeAttr('aria-current');
// 	        }
// 	    });
// 	}

	window.onload = function () {
	    $.ajax({
	        type: "POST",
	        url: 'MainPageAjax!findMainBanner.action'
	    }).done(function (data) {
	        var msg = data['msg'];

	        if (msg === 'ok') {
	            var result = data['queryresult'];
	            var html = '';

	            for (let i in result) {
	                let item = result[i];

	                var hasLink = item[1] !== '';
	                var href = item[1];
	                var title = hasLink ? bannerLang.openWin + item[2] : '';
	                var src = '../manage/upload/banner/' + item[0];

	                html += "<div class='swiper-slide'>";
	                html +=     "<div class='slide'>";

	                if (hasLink) {
	                    html += "<a class='d-block' href='" + href + "' target='_blank' rel='noopener noreferrer' title='" + title + "'>";
	                    html +=     "<img class='img-fluid w-100' src='" + src + "' alt='" + item[2] + "'/>";
	                    html += "</a>";
	                } else {
	                    html += "<img class='img-fluid w-100' src='" + src + "' alt='" + item[2] + "'/>";
	                }

	                html +=     "</div>";
	                html += "</div>";
	            }

	            $("#banner").empty().html(html);

	            console.info('mainBannerSwiper bullets init');
	            
	         // 如果 mainBannerSwiper 已經被初始化過，先銷毀，避免沿用 progressbar 設定
	            var mainBannerEl = document.querySelector('#mainBannerSwiper');

	            if (mainBannerEl && mainBannerEl.swiper) {
	                mainBannerEl.swiper.destroy(true, true);
	            }

	            // 清掉舊 pagination 的 class、style、內容
	            $('#mainBannerSwiper .swiper-pagination')
	                .removeClass('swiper-pagination-progressbar swiper-pagination-horizontal swiper-pagination-bullets swiper-pagination-clickable swiper-pagination-lock')
	                .removeAttr('role aria-label aria-valuemin aria-valuemax aria-valuenow aria-valuetext')
	                .removeAttr('style')
	                .empty();
	            
	            var mainBannerSwiper = new Swiper('#mainBannerSwiper', {
	            	watchOverflow: false,
	                loop: true,
	                autoplay: {
	                    delay: 5000,
	                    disableOnInteraction: false
	                },
	                pagination: {
	                    el: '#mainBannerSwiper .swiper-pagination',
	                    type: 'bullets',
	                    clickable: true,
	                    renderBullet: function (index, className) {
	                        var label = bannerLang.goToSlide + (index + 1) + bannerLang.slideText;
	                        return '<button type="button" class="' + className + '" aria-label="' + label + '"></button>';
	                    }
// 	                    renderBullet: function (index, className) {
// 	                        return '<button type="button" class="' + className + '" aria-label="切換至第' + (index + 1) + '張輪播內容"></button>';
// 	                    }
	                },
	                navigation: {
	                    nextEl: '.swiper-button-next',
	                    prevEl: '.swiper-button-prev'
	                },
	                keyboard: {
	                    enabled: true
	                },
	                on: {
	                    init: function () {
	                        updateBannerA11y(this);
	                        updateBannerStatus(this);
	                    },
	                    slideChange: function () {
	                        updateBannerA11y(this);
	                        updateBannerStatus(this);
	                    },
	                    slideChangeTransitionEnd: function () {
	                        updateBannerA11y(this);
	                        updateBannerStatus(this);
	                    }
	                }
// 	                on: {
// 	                    init: function () {
// 	                        updateBannerA11y(this);
// 	                    },
// 	                    slideChange: function () {
// 	                        updateBannerA11y(this);
// 	                    }
// 	                }
	            });
	            
	            setTimeout(function () {
	                updateBannerA11y(mainBannerSwiper);
	                updateBannerStatus(mainBannerSwiper);
	            }, 0);

	            var userPaused = false;
	            var autoPausedByFocus = false;
	            var keyboardFocus = false;

	            var playPauseBtn = document.getElementById('bannerPlayPause');
	            var swiperEl = document.getElementById('mainBannerSwiper');
	            var bannerArea = document.getElementById('mainBannerArea');

	            function stopBannerAutoplay() {
	                if (mainBannerSwiper && mainBannerSwiper.autoplay) {
	                    mainBannerSwiper.autoplay.stop();
	                }
	            }

	            function startBannerAutoplay() {
	                if (mainBannerSwiper && mainBannerSwiper.autoplay) {
	                    mainBannerSwiper.autoplay.start();
	                }
	            }

	            function showPauseButton() {
	                playPauseBtn.innerText = bannerLang.pauseText;
	                playPauseBtn.setAttribute('aria-label', bannerLang.pauseLabel);
	                playPauseBtn.setAttribute('aria-pressed', 'false');
	            }

	            function showPlayButton() {
	                playPauseBtn.innerText = bannerLang.playText;
	                playPauseBtn.setAttribute('aria-label', bannerLang.playLabel);
	                playPauseBtn.setAttribute('aria-pressed', 'true');
	            }

	            /*
	             * 初始狀態：
	             * 輪播正在自動播放，所以按鈕顯示「暫停」
	             */
	            showPauseButton();

	            /*
	             * 判斷目前是否為鍵盤操作。
	             * Tab 進入輪播區時，才依無障礙要求自動暫停。
	             * 滑鼠點上一張 / 下一張時，不要因此停止自動輪播。
	             */
	            document.addEventListener('keydown', function (event) {
	                if (event.key === 'Tab') {
	                    keyboardFocus = true;
	                }
	            });

	            document.addEventListener('mousedown', function () {
	                keyboardFocus = false;
	            });

	            document.addEventListener('pointerdown', function () {
	                keyboardFocus = false;
	            });

	            /*
	             * 鍵盤焦點進入輪播區時暫停。
	             *
	             * 符合稽核要求：
	             * 1. Tab 到播放 / 暫停鍵時暫停
	             * 2. Tab 到上一張 / 下一張時暫停
	             * 3. Tab 到分頁點時暫停
	             * 4. Tab 到圖片連結時暫停
	             */
	            bannerArea.addEventListener('focusin', function () {
	                if (keyboardFocus && !userPaused) {
	                    stopBannerAutoplay();
	                    autoPausedByFocus = true;
	                    showPauseButton();
	                }
	            });

	            /*
	             * 鍵盤焦點完全離開輪播區後：
	             * 如果只是因為鍵盤焦點進入而自動暫停，則恢復播放。
	             * 如果是使用者手動按「暫停」，則維持暫停。
	             */
	            bannerArea.addEventListener('focusout', function () {
	                setTimeout(function () {
	                    var activeEl = document.activeElement;

	                    if (!bannerArea.contains(activeEl)) {
	                        if (!userPaused && autoPausedByFocus) {
	                            startBannerAutoplay();
	                            autoPausedByFocus = false;
	                            showPauseButton();
	                        }
	                    }
	                }, 0);
	            });

	            /*
	             * 播放 / 暫停按鈕
	             *
	             * button 原生支援：
	             * - 滑鼠 click
	             * - Enter
	             * - Space
	             */
	            playPauseBtn.addEventListener('click', function (event) {
	                event.preventDefault();

	                if (userPaused) {
	                    /*
	                     * 使用者按下「播放」
	                     */
	                    userPaused = false;
	                    autoPausedByFocus = false;
	                    startBannerAutoplay();
	                    showPauseButton();
	                } else {
	                    /*
	                     * 使用者按下「暫停」
	                     */
	                    userPaused = true;
	                    autoPausedByFocus = false;
	                    stopBannerAutoplay();
	                    showPlayButton();
	                }
	            });

	            /*
	             * 左右切換鍵補強鍵盤操作。
	             * div role="button" 在部分瀏覽器不一定會原生支援 Enter / Space，
	             * 所以這裡手動補上。
	             */
	            $('#mainBannerSwiper .swiper-button-prev, #mainBannerSwiper .swiper-button-next').on('keydown', function (event) {
	                if (event.key === 'Enter' || event.key === ' ') {
	                    event.preventDefault();

	                    keyboardFocus = true;

	                    if (!userPaused) {
	                        stopBannerAutoplay();
	                        autoPausedByFocus = true;
	                        showPauseButton();
	                    }

	                    $(this).trigger('click');
	                }
	            });

	            /*
	             * 分頁點如果用鍵盤 Enter / Space 操作，也暫停輪播。
	             */
	            $('#mainBannerSwiper .swiper-pagination').on('keydown', 'button', function (event) {
	                if (event.key === 'Enter' || event.key === ' ') {
	                    keyboardFocus = true;

	                    if (!userPaused) {
	                        stopBannerAutoplay();
	                        autoPausedByFocus = true;
	                        showPauseButton();
	                    }
	                }
	            });

	            /*
	             * 滑鼠點上一張 / 下一張 / 分頁點後，
	             * 如果不是使用者手動暫停狀態，就繼續自動輪播。
	             */
	            $('#mainBannerSwiper .swiper-button-prev, #mainBannerSwiper .swiper-button-next, #mainBannerSwiper .swiper-pagination').on('click', function () {
	                if (!userPaused && !keyboardFocus) {
	                    setTimeout(function () {
	                        startBannerAutoplay();
	                        showPauseButton();
	                    }, 100);
	                }
	            });

	            
	        }
	    });
	};
	
//     window.onload = function () {
//         $.ajax({
//             type: "POST",
//             url: 'MainPageAjax!findMainBanner.action'
//         }).done(function (data) {
//             var msg = data['msg'];
