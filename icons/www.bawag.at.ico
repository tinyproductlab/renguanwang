<script>
function syncAutoplayIcon(button) {
const icon = button.querySelector('i');
if (!icon) return;
const isPressed = button.getAttribute('aria-pressed') === 'false';
icon.classList.toggle('mi-pause', isPressed);
icon.classList.toggle('mi-play', !isPressed);
}
function initAutoplayControls() {
document.querySelectorAll('.carousel-autoplay-control[aria-pressed]').forEach(el => {
syncAutoplayIcon(el);
el.addEventListener('click', () => {
requestAnimationFrame(() => {
syncAutoplayIcon(el);
});
});
});
}
document.addEventListener('DOMContentLoaded', initAutoplayControls);
</script><script src="https://bawag.at/resource/themes/bawag/js/common/renderer.js" async></script><script type="application/ld+json">
