</div><p class="topVisual__apla-badge js-top-visual-apla-badge badge--dark-blue" id="component_3833623_aplas_badge">Promocje</p></div><div class="topVisual__button-area desktop-button-area"><div class="topVisual__button js-top-visual-first-button top_visual_page_button"><a aria-describedby="component_3833623_title component_3833623_aplas_title component_3833623_aplas_badge" class="button button primary" data-utag-link="" href="/klient-indywidualny/konta/konto-smart?portal-camp=default-ki_ks2_1026">Sprawdzam<span class="sr-only"> szczegóły</span></a></div></div></div></div></div><script nonce="2dbfi3O1QFDLY6WtXrh8/Q==">(function() {
            function calculateObjectPosition(offset) {
                return Math.abs(Math.round(((offset * 100) / 600) * 3));
            }

            var updateScheduled = false;

            function updateObjectPosition() {
                var img = document.querySelector('.component_3833623 .js-top-visual-image img');

                if (!img) return;
                var offset;

                if (window.matchMedia('(min-width: 1200px)').matches) {
                    offset = 128;
                } else if (window.matchMedia('(min-width: 992px)').matches) {
                    offset = 127;
                } else if (window.matchMedia('(min-width: 768px)').matches) {
                    offset = 149;
                } else if (window.matchMedia('(min-width: 576px)').matches) {
                    offset = 184;
                } else {
                    offset = 152;
                }

                img.style.objectPosition = calculateObjectPosition(offset) + '% 0%';
                updateScheduled = false;
            }

            function onResize() {
                if (!updateScheduled) {
                    updateScheduled = true;
                    requestAnimationFrame(updateObjectPosition);
                }
            }

            updateObjectPosition();
            window.addEventListener('resize', onResize);
        })();</script><div class="clearFix"></div></div><div class="banner_modal_components"></div></div></div></div></div></div><div class="layout_element layout_section" id="srednie"><div class="layout_element layout_container"><div class="layout_element layout_row row row"><div class="layout_element layout_column  col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xs-12 col-sm-12 col-md-12 col-lg-12"><div class="layout_element component_wrapper wrapped_content  hidden-xl  hidden-sm  hidden-md  hidden-lg" id="component_wrapper_3842525"><div class="component content no-padding-top no-padding-bottom component_3842525" data-component-id="3842525" data-component-type-code="content" data-is-bannerable="false" data-is-ts-component="true" data-js-parameters="{&quot;virtual_path_present&quot;:&quot;false&quot;,&quot;node_url&quot;:&quot;/klient-indywidualny&quot;}" data-utag-set="" data-utag-type="dc_content" id="content_1_18022025"><div class="content_area" id="component_content_3842525"><p>&nbsp;</p><div class="clearFix"></div></div><div class="clearFix"></div></div></div><div class="layout_element component_wrapper wrapped_final_cta" id="component_wrapper_3842526"><div class="component finalCta medium-padding-top v-promotion badge--brand-strong medium-padding-bottom component_3842526" data-component-id="3842526" data-component-type-code="final_cta" data-is-bannerable="true" data-is-ts-component="true" data-js-parameters="{&quot;virtual_path_present&quot;:&quot;false&quot;,&quot;node_url&quot;:&quot;/klient-indywidualny&quot;}" data-utag-set="" data-utag-type="dc_finalCTA" id="final_cta_1_06102026"><script nonce="2dbfi3O1QFDLY6WtXrh8/Q==">var positionCTASettings_3842526 = { xlargeoffset: {'offset':84} , largeoffset: {'offset':84}, mediumoffset: {'offset':57}, smalloffset: {'offset':32}, xsmalloffset: {'offset':20} };</script><div class="finalCta__inner finalCta--img js-final-cta--img finalCta--lead"><div class="finalCta__imgBox js-final-cta-img-box"><picture><source type="imag