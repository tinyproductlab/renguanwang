<!-- CUSTOM CODE TO HANDLE DEALER CODE - new fix (2026-10-15) -->
<!-- Saves dealer params to cookies before any page script can strip the URL, then adds them to links at click time, so CMS-loaded, filtered and dynamic links are covered. Supersedes the footer blocks tagged "CUSTOM CODE TO HANDLE DEALER CODE - LEGACY". -->
<script>
(function () {
  if (window.cdDealerAttribution) return;
  var KEYS = ['DealerCode', 'DealerUserId', 'plan_sku', 'plan_category', 'journey_type', 'order_type'];
  var secure = location.protocol === 'https:' ? '; Secure' : '';

  function readCookie(name) {
    var parts = document.cookie ? document.cookie.split('; ') : [];
    for (var i = 0; i < parts.length; i++) {
      var eq = parts[i].indexOf('=');
      if (eq > -1 && parts[i].slice(0, eq) === name) {
        var raw = parts[i].slice(eq + 1);
        try { return decodeURIComponent(raw); } catch (e) { return raw; }
      }
    }
    return null;
  }

  function writeCookie(name, value) {
    document.cookie = name + '=' + encodeURIComponent(value) + '; max-age=86400; path=/; SameSite=Lax' + secure;
  }

  // 1. Capture the landing query string before any page script rewrites the URL.
  var landing = null;
  try { landing = new URLSearchParams(window.location.search); } catch (e) {}
  window._cdLandingQuery = window.location.search;

  // 2. Dealer values in the URL always replace older cookies (last touch wins), 1-day expiry.
  if (landing) {
    KEYS.forEach(function (k) {
      var v = landing.get(k);
      if (v) writeCookie(k, v);
    });
  }

  function storeHostSwap(href) {
    var here = window.location.href;
    if (here.indexOf('preprod.digi.com.my') > -1) return href.replace('store.digi.com.my', 'store-preprod.digi.com.my');
    if (here.indexOf('staging.digi.com.my') > -1) return href.replace('store.digi.com.my', 'store-dev.digi.com.my');
    return href;
  }

  // 3. Add landing params + dealer cookies to one link. Safe to call repeatedly.
  function tagLink(a) {
    if (!a || a.nodeName !== 'A') return;
    if (a.classList && a.classList.contains('toggle-popup')) return;
    var raw = a.getAttribute('href');
    if (!raw || raw.charAt(0) === '#') return;
    var swapped = storeHostSwap(raw);
    var url;
    try { url = new URL(swapped, window.location.href); } catch (e) { return; }
    if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
    // Leave same-page anchor links alone so they still scroll instead of reloading.
    if (url.origin === location.origin && url.pathname === location.pathname && url.hash) return;

    var before = url.href;
    if (landing) {
      landing.forEach(function (v, k) {
        if (KEYS.indexOf(k) === -1 && !url.searchParams.has(k)) url.searchParams.set(k, v);
      });
    }
    KEYS.forEach(function (k) {
      var v = readCookie(k);
      if (v) url.searchParams.set(k, v);
    });
    if (url.href !== before || swapped !== raw) a.setAttribute('href', url.href);
  }

  function tagAll() {
    var links = document.querySelectorAll('a[href]');
    for (var i = 0; i < links.length; i++) tagLink(links[i]);
  }

  function onInteract(e) {
    var t = e.target;
    if (t && t.nodeType !== 1) t = t.parentElement;
    var a = t && t.closest ? t.closest('a[href]') : null;
    if (a) tagLink(a);
  }

  // Tag at interaction time: covers links added after load (Finsweet CMS Load/Filter, popups, sliders).
  ['mousedown', 'touchstart', 'keydown', 'focusin', 'click', 'auxclick', 'contextmenu'].forEach(function (type) {
    document.addEventListener(type, onInteract, { capture: true, passive: true });
  });

  // Also tag links present at load, as the old script did.
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tagAll);
  else tagAll();

  window.cdDealerAttribution = { tagLink: tagLink, tagAll: tagAll, keys: KEYS };
})();
</script>
<!-- END CUSTOM CODE TO HANDLE DEALER CODE - new fix -->
