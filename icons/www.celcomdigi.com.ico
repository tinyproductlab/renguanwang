<script>
$(document).ready(function() {
   $('.search-input, .search-results-input').on('input', function() {
       let searchVal = $(this).val().trim();
       let $searchBtn = $(this).parent().find('.search-button, .search-results-button');
       $searchBtn.prop('disabled', searchVal.length === 0);
   });

   $('.search-button, .search-results-button').on('click', function(e) {
       e.preventDefault();
       let $searchInput = $(this).parent().find('.search-input, .search-results-input');
       let searchVal = encodeURI($searchInput.val()).toLowerCase();

       if (searchVal.length > 0) {
            let path = window.location.pathname;
            let queryParams = '?query=' + searchVal;
            if (path && path.includes('/ms')) {
                queryParams += '&lang=ms';
            }            
            window.location.href = 'https://cdlink.net/' + searchVal + queryParams;
        }
   });
});
</script>


