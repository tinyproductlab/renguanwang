<!-- CUSTOM CODE TO HANDLE DEALER CODE - LEGACY -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/js-cookie/2.2.0/js.cookie.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function(event) { 
    var dealerParams = {};
    window.location.search.slice(1).split('&').forEach(function(item) {
        var s = item.split("="),k = s[0],v = s[1] && decodeURIComponent(s[1]);
        if(k) dealerParams[k] = v;
    })
    var DealerCode = Cookies.get('DealerCode');
	var DealerUserId = Cookies.get('DealerUserId');
    var plan_sku = Cookies.get('plan_sku');
    var plan_category = Cookies.get('plan_category');
    var journey_type = Cookies.get('journey_type');
    var order_type = Cookies.get('order_type');
    if(dealerParams['DealerCode'] !== undefined) { Cookies.set('DealerCode', dealerParams['DealerCode'], { expires: 1 }); }
    if(dealerParams['DealerUserId'] !== undefined) { Cookies.set('DealerUserId', dealerParams['DealerUserId'], { expires: 1 }); }
    if(dealerParams['plan_sku'] !== undefined) { Cookies.set('plan_sku', dealerParams['plan_sku'], { expires: 1 }); }
    if(dealerParams['plan_category'] !== undefined) { Cookies.set('plan_category', dealerParams['plan_category'], { expires: 1 }); }
    if(dealerParams['journey_type'] !== undefined) { Cookies.set('journey_type', dealerParams['journey_type'], { expires: 1 }); }
    if(dealerParams['order_type'] !== undefined) { Cookies.set('order_type', dealerParams['order_type'], { expires: 1 }); }
});
</script>
<!-- CUSTOM CODE TO EMBED QUERY STRING IN URL - LEGACY -->
<script>
var DealerCode = Cookies.get('DealerCode');
var DealerUserId = Cookies.get('DealerUserId');
var plan_sku = Cookies.get('plan_sku');
var plan_category = Cookies.get('plan_category');
var journey_type = Cookies.get('journey_type');
var order_type = Cookies.get('order_type');
 
$('a').not(".toggle-popup").each(function() {
    var href = $(this).attr('href');
    if (href && href != '#') {
      	try {
            // Replace preprod store if true
            if (window.location.href.indexOf("preprod.digi.com.my") > -1) { 
              href = href.replace("store.digi.com.my", "store-preprod.digi.com.my");
            }
            // Replace staging store if true
            if (window.location.href.indexOf("staging.digi.com.my") > -1) { 
              href = href.replace("store.digi.com.my", "store-dev.digi.com.my");
            }
        	var url = new URL(href);
        	window.location.search.slice(1).split('&').forEach(function(item) {
            	var s = item.split("="),k = s[0],v = s[1] && decodeURIComponent(s[1]);
            	if(k) url.searchParams.set(k, v);
        	})
 
			// Add DealerCode & DealerUserId if exists
            if(DealerCode!== undefined) url.searchParams.set('DealerCode', DealerCode);
        	if(DealerUserId!== undefined) url.searchParams.set('DealerUserId', DealerUserId);
            if(plan_sku!== undefined) url.searchParams.set('plan_sku', plan_sku);
            if(plan_category!== undefined) url.searchParams.set('plan_category', plan_category);
            if(journey_type!== undefined) url.searchParams.set('journey_type', journey_type);
            if(order_type!== undefined) url.searchParams.set('order_type', order_type);
        	$(this).attr('href', url.href);
        }
        catch(err) {}
    }
});
</script>


