<!-- Login popup - Man Icon Changes Started -WEB-9619 -->

<div class="web-component modal fade slide-panel" id="login" role="dialog" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="login-action-reset px-24 pb-0 pt-24 md:px-40 md:pt-40 h-20" data-bs-dismiss="modal">
        <div class="w-4 h-4 cursor-pointer absolute right-4 top-6">
          <svg class="fill-current" fill="" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <g fill-rule="evenodd">
              <path d="M2.435 19.59 10 12.022l7.557 7.56c.287.287.65.416 1.012.416.374 0 .729-.145 1.005-.408l.008-.008a1.425 1.425 0 0 0 0-2.016l-7.557-7.56 7.557-7.56A1.425 1.425 0 1 0 17.566.43L10 7.99 2.443.42A1.425 1.425 0 1 0 .427 2.436l7.557 7.57-7.566 7.56a1.425 1.425 0 0 0 1.013 2.432c.373 0 .728-.145 1.004-.408Z"></path>
            </g>
          </svg>
        </div>
      </div>
      <div class="modal-body px-24 md:px-40 py-16 md:py-40 flex-1">
        <div class="xs:px-0 md:px-40 m-1 pt-10">
          <div class="scrollable">
            <div class="pb-0 xl:pb-[3.75rem]">
              <!-- Login with Email -->
              <div class="login-with-email">
                
                  <img src="/content/dam/M1/icons/logo.png" alt="M1" class="w-16 h-16 block mx-auto"/>
                
                <h4 class="text-center mt-20 font-dinBold text-28 mb-0">
                  Login
                </h4>
                <p class="pt-25 pb-10 text-center px-20 text-16 mb-0">
                  Enter your email address (M1 ID) that is registered with us
                </p>
                <div>
                  <div>
                    <label for="emailid" class="font-bold mb-1 text-gray-700 block"></label>
                    <input name="emailid" id="emailid" control="input" type="text" placeholder="username@youremail.com" class="bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 rounded-lg block w-full px-16 py-12 leading-6 dark:placeholder-gray-400 h-14" value=""/>
                    <div class="email-error text-dangerHover error text-14"></div>
                  </div>
                  <div class="text-center py-40">
                    <button type="submit" class="email-login text-16 px-24 py-16 leading-4 w-full lg:w-40 mb-32 min-w-160 bg-primary-orange text-white hover:bg-accent-deepOrange rounded-button font-dinBold" id="">
                      <span class="">Login</span>
                    </button>
                    <div class="text-16 font-dinBold pb-12 text-primary-orange cursor-pointer forgot-m1-id">
                      Forgot your M1 ID?
                    </div>
                  </div>
                </div>
              </div>
              <!-- Login with Email END -->

              <!-- Login with M1 ID -->
              <div class="m1-id-field">
                
                  <img src="/content/dam/M1/icons/logo.png" alt="M1" class="w-16 h-16 block mx-auto"/>
                
                <h4 class="text-center mt-20 font-dinBold text-28 mb-0">
                  Forgot your M1 ID?
                </h4>
                <p class="py-25 text-center px-20 text-16 mb-0">
                  Let us help you recall back your M1 ID <br/>
                  (registered email address).
                </p>
                <div>
                  <div>
                    <label for="nricid" class="font-bold mb-1 text-gray-700 block">NRIC / FIN Number</label>
                    <input name="nricid" id="nricid" control="input" type="text" maxlength="9" class="bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 rounded-lg block w-full px-16 py-12 leading-6 h-11 lg:h-12 dark:placeholder-gray-400 h-14"/>
                    <div class="email-error-nric text-dangerHover error text-14"></div>
                  </div>
                  <p class="pt-1 text-16 pb-0">
                    Key in full NRIC/FIN Number (e.g. S857xxxxA, G217xxxxN)
                  </p>
                  <div class="flex justify-center py-40">
                    <button class="m1-id-login text-16 px-24 py-16 leading-4 w-full lg:w-40 min-w-160 bg-primary-orange text-white hover:bg-accent-deepOrange rounded-button font-dinBold">
                      <span class="">Submit</span>
                    </button>
                  </div>
                </div>
              </div>
              <!-- Login with M1 ID End -->

              <!-- OTP -->
              <div class="otp-field text-center">
                
                  <img src="/content/dam/M1/icons/logo.png" alt="M1" class="w-16 h-16 block mx-auto"/>
                
                <h4 class="text-center mt-20 font-dinBold text-28 mb-0">
                  Enter one-time PIN
                </h4>
                <p class="pt-25 pb-12 text-center px-20 pb-0 text-16 mb-0">
                  A one-time PIN has been sent to
                </p>
                <p class="otp-email font-dinBold pb-0 text-16 mb-0"></p>
                <p class="pt-20 pb-10 text-16 mb-0">
                  Simply key in the 6-digit OTP below.
                </p>
                <div id="otp" class="flex flex-row justify-center text-center mt-4">
                  <div class="pincode-input-container">
                    <input class="pincode-input-text bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 w-11 lg:w-12 h-11 lg:h-12 rounded-lg text-center" placeholder="" aria-label="" maxlength="1" autocomplete="off" type="tel" inputmode="number" pattern="[0-9]*" value=""/>
                    <input class="pincode-input-text bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 w-11 lg:w-12 h-11 lg:h-12 rounded-lg text-center" placeholder="" aria-label="" maxlength="1" autocomplete="off" type="tel" inputmode="number" pattern="[0-9]*" value=""/>
                    <input class="pincode-input-text bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 w-11 lg:w-12 h-11 lg:h-12 rounded-lg text-center" placeholder="" aria-label="" maxlength="1" autocomplete="off" type="tel" inputmode="number" pattern="[0-9]*" value=""/>
                    <input class="pincode-input-text bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 w-11 lg:w-12 h-11 lg:h-12 rounded-lg text-center" placeholder="" aria-label="" maxlength="1" autocomplete="off" type="tel" inputmode="number" pattern="[0-9]*" value=""/>
                    <input class="pincode-input-text bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 w-11 lg:w-12 h-11 lg:h-12 rounded-lg text-center" placeholder="" aria-label="" maxlength="1" autocomplete="off" type="tel" inputmode="number" pattern="[0-9]*" value=""/>
                    <input class="pincode-input-text bg-white border border-neutral-mediumGray text-primary-black text-16 lg:text-16 w-11 lg:w-12 h-11 lg:h-12 rounded-lg text-center" placeholder="" aria-label="" maxlength="1" autocomplete="off" type="tel" inputmode="number" pattern="[0-9]*" value=""/>
                  </div>
                </div>
                <div class="m-auto pt-20 px-6 text-14 md:w-3/4">
                  <div class="flex justify-between">
                    <p class="pb-0 text-16 mb-0">
                      PIN expires in
                      <span class="font-dinBold" id="countdown">00:00</span>
                    </p>
                    <p class="resend-otp pb-0 font-dinBold text-neutral-gray pointer-events-none text-16 mb-0">
                      Resend OTP
                    </p>
                  </div>
                  <p class="otp-error text-14 text-dangerHover pb-10 text-left mb-0"></p>
                </div>
                <div class="flex justify-center my-40">
                  <button class="submit-otp text-16 px-24 py-16 leading-4 min-w-160 bg-primary-orange text-white hover:bg-accent-deepOrange rounded-button font-dinBold" id="">
                    <span class="">Continue with OTP</span>
                  </button>
                </div>
              </div>
              <!-- OTP End -->

              <!-- M1 ID not found content -->
              <div class="m1-id-not-found">
                <svg class="fill-current w-16 h-16 block mx-auto text-primary-orange" fill="" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" xlink="http://www.w3.org/1999/xlink">
