<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@300&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300&display=swap');

        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
        }

        .tkheader {
            background-color: #232b38;
            border-color: #0f1319;
            position: fixed;
            right: 0;
            left: 0;
            padding: 12px 6px;
        }

        .container-fluid {
            position: relative;
            padding-left: 15px;
            padding-right: 15px;
        }

        .wrapper--notfound {
            width: 100%;
            height: 550px;
			padding-top: 50px;
            background-image: url(https://cdn.turkishairlines.com/m/3e42b84f717c2111/original/1400x550-jpg.jpg);
            background-size: cover;
            display: flex;
            align-items: center;
            color: white;
        }

        .main--notfound {
            width: 750px;
            padding: 0 100px;
        }

        .title {
            font-size: 32px;
            padding-bottom: 18px;
        }

        .description {  
            line-height: 1.5;
            font-size: 26px;
        }
			
		.refcode {
			font-size: 14px;
		}

        @media screen and (max-width:767px) and (min-width:320px) {
            .wrapper--notfound {
                width: 100%;
                height: 100vh;
                background-size: contain;
                display: flex;
                color: white;
                justify-content: center;
                align-items: center;
            }

            .main--notfound {
                width: 240px;
                background: #00000038;
                padding: 40px;
            }

            .title {
                font-size: 24px;
                padding-bottom: 12px;
            }

            .description {
                font-size: 18px;
            }
			
            .refcode {
                font-size: 11px;
            }
        }
    </style>
</head>

<body>
    <header style="position: relative;">
        <div class="tkheader" role="navigation">
            <div class="container-fluid">
                <div class="navbar-header">
                        <div class="navbar-brand">                               
                                    <img src="https://cdn.turkishairlines.com/m/2190da9e53a70e4e/original/THY-LOGO.png" height="40px" alt="THY LOGO">                         
                        </div>                
                </div>
            </div>
        </div>
    </header>
    <div class="wrapper--notfound">
        <div class="main--notfound">
            <div class="title">
                <span>Take a short break from your passion for travel!</span>
            </div>
			<br/><br/>
            <div class="description">
                <span>We share your excitement about the discovery, but you are not able to access our site right now. 
                      You can try again on another device or network, and if the problem persists, you can contact our call center.
                </span>
            </div>
			<br/><br/><br/><br/>
		   <div class="refcode">
                <span>Reference Code: 0.8dc82c17.1792234164.749346a</span>
            </div>
    
        </div>
	

    </div>
</body>

</html>