<script type="text/javascript">
window.onload = function() {
const dateValue = new Date();
const todayDate = dateValue.getFullYear() + "년 "+ (dateValue.getMonth()+1) + "월 " + dateValue.getDate() + "일";
document.getElementById("dateId").innerHTML += todayDate;
}
</script>
<link rel="stylesheet" href="https://img.megabox.co.kr/sErr/css/import.css" media="all" />
