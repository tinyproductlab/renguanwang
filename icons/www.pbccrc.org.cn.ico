<style>
    .img404{
        width: 300px;
    margin: 0px auto 0px;
    display: block;
    }
    .logo{
        width: 200px;
        margin: 30px;
    }
    p{
        text-align: center;
    font-size: 18px;
    }
    .red-color{
        color: #d20105;
