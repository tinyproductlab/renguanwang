<body class="bg-color">
    <div id="accessNull"></div>
    <div id="container">
      <img src="/assets/img/logo.png"  class="logo" />
      <p class="red-color">很抱歉，您访问的页面地址有误，或者该页面不存在。</p>
     <img src="/assets/img/404.png"  class="img404" />
   
     <p><span class="red-color"></span>秒后跳转到首页</p>
    </div>
    <!--Main JS-->
    <script src="/assets/js/ETUI/jquery.min.js"></script>
    <script>
        $(function(){
            var seconds = 5; 
        
    $("span").html(seconds);
    setInterval(function () {
      seconds--;
      $("span").html(seconds);
      if (seconds == 0) {
       
        window.location = "/";
      }
    }, 1000);
  }, )
     
    </script>
<!-- Code injected by live-server -->

