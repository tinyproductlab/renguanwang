							</video>
					
				</div>
			</div>
			<div id="videoList">
				<div id="currentProfile">
					<div class="cover"></div>
					<div class="name"></div>
				</div>
				<div id="player_list" class="moduleList">
				</div>
			</div>
		</div>

	</div>






