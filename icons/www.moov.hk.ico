	<div id="contentArea" >


	</div>
	<div class="container clearfix">
		<div class="h_c">
			<div id="header" class="header clearfix">
				<div class="left"></div>
				<div class="right">	</div>

					<div id="searchIcon"><img src="images/nav_search.png" /></div>
			</div>
		</div>
		<div id="menu-c">
			<div class="logo">
				<a href="#/"><img src="images/logo.svg" ></a>
			</div>
			<div id="menu"></div>
		</div>
	</div>
	<div id="player_wrapper">
		<div id="player_bg"></div>
		<div class="shadow"></div>
		<div id="player_info">

			<img id="close" src="images/icon/close.png" />
			<div class="left">
				<div class="cover" ><img src="images/default_cover.png" width="100%"></div>
				<div class="song"></div>
				<div class="artist"></div>
				<div class="btn">
					<div id="player_add" ><img src="images/icon/player_add.png"/></div>
					<div id="player_shuffle" class="off"></div>
					<div id="player_repeat" class="off"></div>
					<div id="player_share" ><img src="images/icon/player_share.png"  /></div>
				</div>
			</div>
			<div class="right">
				<div id="currentProfile">
					<div class="cover"></div>
					<div class="name"></div>
				</div>
				<div id="player_list" class="moduleList">
				</div>
				<div id="lyric"></div>
			</div>

		</div>
		<div id="player">
			<div id="player_ext"></div>
			<div id="lyrics" class="btn off"><img src="images/icon/lyrics_chi.png"/></div>
			<div id="prev" class="btn" onclick="playPrev();"><img src="images/icon/back_off.png"  width="30"/></div>
			<div id="pause" class="btn"><img src="images/icon/play_off.png"  onclick="playItem();" width="30"/></div>
			<div id="next" class="btn" onclick="playNext();"><img src="images/icon/next_off.png" width="30" /></div>
			<div id="thumbnail"><img src="images/default_cover.png" /></div>
			<div id="mute" class="btn" onclick="mute();"><img src="images/icon/volume_off.png" width="25" /></div>
			<div id="volume"><input type="text" data-slider="true" value="0.5" data-slider-highlight="true" style="display: none;"></div>
			<div id="timer">00:00</div>
			<div id="progressBar">
				<div id="title"></div>
				<input type="text" data-slider="true" value="0" data-slider-highlight="true" style="display: none;">
			</div>
			<div id="duration">00:00</div>
		</div>
	</div>


	<div id="videoplayer_wrapper" >
		<div id="videoplayer">
			<img id="close" src="images/icon/close.png" />
			<div class ="left">
				<div id="playingItem">
					<div class="name">
						<span class="title"></span><br />
						<span class="artist"></span>
					</div>

					<div class="fnc">
						<div class="share"></div>	<div class="add"></div>
					</div>

				</div>
				<div id="MOOVVideoPlayer">

					
							<video id="videoHLSPlayer" width="672" height="397" class="video-js" controls >
