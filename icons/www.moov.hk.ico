	<div id="searchLayer">

		<input id="search_box" class="_input" name="search" type="text"  onkeyup="predictiveSearch(this.value)" >
		<div id="searchBox"></div>

	</div>

	<div id="loading"></div>
	<div id="bg"></div>

	<div id="top">
		<div class="banner" ></div>
		<div id="info"></div>

	<div id="submenu" class="submenu">
		<div>
			<ul class="list"></ul>
		</div>
	</div>
	</div>
	<div id="submenu2" class="submenu">
		<div>
