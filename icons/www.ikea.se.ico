ue" class="hri-svg-icon hri-btn__icon"><path fill-rule="evenodd" clip-rule="evenodd" d="m20.0008 12.0001-8-8.001-1.4143 1.414L16.1727 11H4v2h12.1723l-5.5868 5.5866 1.4141 1.4142 8.0012-8.0007z"></path></svg></span></button></div></div></div></div></div><button type="button" data-skapa="button@19.0.24" id="hri--carousel__hri-services-carousel-next-btn" aria-controls="hri-carousel__hri-services-carousel" aria-label="Se nästa objekt" class="hri-btn hri-btn--small hri-btn--icon-primary hri-carousel__button hri-carousel__button--right"><span class="hri-typography-label-s hri-btn__inner"><svg viewBox="0 0 24 24" focusable="false" width="24" height="24" data-skapa="ssr-icon@11.10.0" aria-hidden="true" class="hri-svg-icon hri-btn__icon"><path fill-rule="evenodd" clip-rule="evenodd" d="m16.415 12.0011-8.0012 8.0007-1.4141-1.4143 6.587-6.5866-6.586-6.5868L8.415 4l8 8.0011z"></path></svg></span></button></div><div class="hri-carousel__counter--wrapper"><div aria-hidden="true" class="hri-scroll-indicator"></div></div><span id="hri--carousel__hri-services-carousel-skip-btn" tabindex="-1" class="hri-skip-content__target"></span></div></div><a href="https://www.ikea.com/se/sv/customer-service/" class="hri-teaser__bottom-button hri-chunky-header hri-chunky-header--small"><span class="hri-chunky-header__title-wrapper"><span class="hri-chunky-header__title">Se alla servicetjänster</span></span><svg viewBox="0 0 24 24" focusable="false" width="24" height="24" data-skapa="ssr-icon@11.10.0" aria-hidden="true" class="hri-svg-icon hri-chunky-header__icon"><path fill-rule="evenodd" clip-rule="evenodd" d="m15.5996 12.0007-5.785 5.7857-1.4143-1.4141 4.3711-4.3716L8.4003 7.629l1.4143-1.4142 5.785 5.7859z"></path></svg></a></div></div></div><!--/fika-45tw0f:1--><script type="text/hydrate" data-fika-hydration-id="13933a7c-74e6-40cd-a326-4cb812d5e515">{"0":{"loaderData":{"url":"/se/sv/hri/fragments/long-feed-imc/?title=Inspiration+och+inredningsid%C3%A9er&gridType=grid3"}},"1":{"loaderData":{"siteFolder":"se/sv","data":[{"title":"Kontakta oss","description":"Vår kundtjänst nås via telefon, mejl eller chatt beroende på vilken fråga du har. Du kan också få hjälp genom självservice eller sociala medier!","url":"https://www.ikea.com/se/sv/customer-service/contact-us/","image":{"title":"","url":"https://www.ikea.com/images/21/47/2147264a5df204c784439daaff401109.jpg"}},{"title":"Appar","description":"Upptäck ett enklare sätt att handla på, få heminredningsinspiration, få veta hur du får ut så mycket som möjligt av smarta produkter","url":"https://www.ikea.com/se/sv/customer-service/mobile-apps/","image":{"title":"Närbild av en hand som håller i en smartphone med IKEA appen öppen.","url":"https://www.ikea.com/ext/ingkadam/m/5467e1ba1d86c577/original/PH188779.jpg"}},{"title":"Betalsätt","description":"På IKEA kan du betala med bank- och kreditkort, Klarna faktura, Swish, mobila plånböcker (Apple Pay & Google Pay), presentkort eller IKEA Finansiering Lån.","url":"https://www.ikea.com/se/sv/customer-service/payment-options/","image":{"title":"En kvinna handlar på IKEA.se via sin mobil.","url":"https://www.ikea.com/ext/ingkadam/m/5452a1af43063195/original/PH188795-crop001.jpg"}},{"title":"Produkthjälp","description":"Behöver du hjälp med din IKEA-produkt? Här hittar du steg-för-steg-guider, felsökningstips och vanliga frågor om smarta hem och hushållsapparater.","url":"https://www.ikea.com/se/sv/customer-service/product-support/","image":{"title":"Hitta support för populära produkter från IKEA","url":"https://www.ikea.com/images/hitta-support-foer-populaera-produkter-fran-ikea-7d00b799b9b8f321901477e4143cd3b5.jpg"}},{"title":"Retur och reklamation","description":"All information du behöver om att returnera produkter till IKEA – från vår returpolicy, 365-dagars öppet köp till att reklamera enligt garantin. Läs mer här.","url":"https://www.ikea.com/se/sv/customer-service/returns-claims/","image":{"title":"En IKEA medarbetare från kundserviceteamet arbetar vid sitt skrivbord.","url":"https://www.ikea.com/ext/ingkadam/m/4e6f1b816b3e92ce/original/PH186301-crop002.jpg"}},{"title":"Handla på IKEA","description":"Från shopping online, i appen eller i varuhuset, till våra planeringsverktyg – hitta alla sätt som IKEA kan hjälpa dig på. Information för både privatkunder och företagskunder.","url":"https://www.ikea.com/se/sv/customer-service/shopping-at-ikea/","image":{"title":"En blå IKEA kasse fylld med köp från IKEA på en sidoskåp bredvid IKEA-produkter.","url":"https://www.ikea.com/ext/ingkadam/m/e08e02426458eac/original/PH188794.jpg"}},{"title":"Lagersaldo","description":"Du kan själv kolla lagerstatus på IKEA.se eller i IKEA appen. All tillgänglig information om lagerstatusen finns på IKEA.se. Våra lagersaldon uppdateras flera gånger i timmen. Vi hjälper dig gärna att hitta ett alternativ om din produkt är slut.","url":"https://www.ikea.com/se/sv/customer-service/stock-availability/","image":{"title":"How to check product availability tool","url":"https://www.ikea.com/images/how-to-check-product-availability-tool-47708c27548fc939ec969f3394bf973f.png"}},{"title":"Hantera beställning","description":"Här kan du se status på din order, ändra leveransdatum eller avboka din beställning. Om du har gjort din beställning i ett IKEA varuhus eller via en säljare kan du betala din order här. ","url":"https://www.ikea.com/se/sv/customer-service/track-manage-order/","image":{"title":"En stilren vit byrå mot en ljusblå vägg, dekorerad med en mörkblå bordslampa, vikta kökshanddukar, en stapel vita tallrikar, en vattenflaska med gul kork, ett paket batterier, samt en blå IKEA kasse fylld med olika föremål, inklusive en grön växt och en gul badboll.","url":"https://www.ikea.com/ext/ingkadam/m/5cd5430e8f0872e5/original/PH188794-crop002.jpg"}}],"translations":{"T_ARIA_PAUSE_VIDEO":"Pausa video","T_ARIA_PLAY_VIDEO":"Spela upp video ","T_CAROUSEL_ARIA_LABEL_LEFT_BUTTON":"Se tidigare artiklar","T_CAROUSEL_ARIA_LABEL_RIGHT_BUTTON":"Se nästa objekt","T_COMMERCIAL_MESSAGE_FAMILY":"IKEA Family pris","T_COMMERCIAL_MESSAGE_IN_STORE_ONLY_PRICE":"Pris endast i varuhus","T_COMMERCIAL_MESSAGE_NEW":"Nytt","T_COMMERCIAL_MESSAGE_NLP":"Nytt lägre pris","T_PRODUCT_DOT_ARIA_LABEL":"Visa produktinformation","T_PRODUCT_LIST_ARIA_LABEL":"Produktlista","T_SKIP_LISTING":"Hoppa över listning","T_TERMS_CONDITIONS_TITLE":"Villkor","T_VALID_THRU":"Giltig till {date}","T_VIDEO_TRANSCRIPT_BUTTON_TEXT":"Visa transkription","T_VIDEO_TRANSCRIPT_BUTTON_TEXT_ARIA_LABEL":"Visa transkription","T_VIDEO_TRANSCRIPT_MODAL_HEADER":"Transkription","T_VIDEO_TRANSCRIPT_MODAL_HIDE_BUTTON_TEXT":"Dölj transkription","T_HEADER_TITLE":"Kundservice och support","T_SEE_ALL_LINK":"Se alla servicetjänster","T_SERVICE_DESCRIPTION_CONTACT_US":"Hitta svar på vanliga frågor och sätt att komma i kontakt med oss.","T_SERVICE_DESCRIPTION_MOBILE_APPS":"Skapa nya rum och njut av smartare shopping med IKEA appar.","T_SERVICE_DESCRIPTION_PAYMENT_OPTIONS":"Se alla sätt du kan betala på när du handlar online eller i butik.","T_SERVICE_DESCRIPTION_PRIVACY_SECURITY":"Läs vår policy och förstå hur vi håller dina uppgifter säkra.","T_SERVICE_DESCRIPTION_PRODUCT_SUPPORT":"Få den hjälp du behöver, från monteringsanvisningar till support för smarta hem.","T_SERVICE_DESCRIPTION_RETURNS_CLAIMS":"Hur du gör en retur eller reklamation.","T_SERVICE_DESCRIPTION_SHOPPING_AT_IKEA":"Besök oss i varuhuset eller handla bekvämt från ditt eget hem.","T_SERVICE_DESCRIPTION_STOCK_AVAILABILITY":"Kolla lagerstatus och plockplats online, är något tillfälligt slut kan du få ett meddelande när produkten finns i lager igen.","T_SERVICE_DESCRIPTION_TRACK_MANAGE_ORDER":"Här kan du spåra, ändra eller avbeställa din order"}}}}</script><script type="module" src="/global/assets/dwf/hri/root-hhwWkk-x.js"></script></div></div></section><section data-bg="neutral-2" data-testid="4wmVJGUXf8gD4Og7MVWDWC" class="hri-section"><div><link rel="modulepreload" href="/global/assets/dwf/hri/preact-ZqMgF4Tg.js"/><link rel="modu