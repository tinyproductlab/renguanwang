    <!--[if gt IE]>
<script type="text/JavaScript" src="../js/PIE.js"></script>
<script type="text/javascript">
    (function ($) {
        $.pie = function (name, v) {
            // 如果没有加载 PIE 则直接终止
            if (!PIE) return false;
            // 是否 jQuery 对象或者选择器名称
            var obj = typeof name == 'object' ? name : $(name);
            // 指定运行插件的 IE 浏览器版本
            var version = 9;
            // 未指定则默认使用 ie10 以下全兼容模式
            if (typeof v != 'number' && v < 9) {
                version = v;
            }
            obj.each(function () {
                PIE.attach(this);
            });
        }
    })(jQuery);
    $(function () {
        var objs = $('.pagination li .page-btn, .pagination li a, .pagination li span,.pagination  .page-input');
        $.pie(objs, 8);
    })
</script>
<![endif]-->
<script>
        $(function () {
            $('.company-showmessage-box').each(function () {
			var tab = $(this).find('.tab-title li');
			var content = $(this).find(".result-tabs .result-tab");
			//			var more = $(this).find(".more li");
			tab.click(function () {
				$(this).addClass("cur").siblings().removeClass("cur");
				content.eq($(this).index()).show().siblings().hide();
				//			more.eq($(this).index()).show().siblings().hide();
			});
		});
        
    
        });
        
    </script>
</body>

