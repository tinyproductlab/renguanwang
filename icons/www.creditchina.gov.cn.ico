<style>
.nodata{
text-align: center;
    padding: 100px 0;}
.pagination{
margin: 30px auto;
font-size:12px;
}
.company-showmessage-box .result-tab h3:before{
background:none;}
</style>
</head>

<body>
    <div class="wrapper">
        <div class="main_header">
            <!-- 头部搜索模块嵌套 -->
          <script src="../js/headersearch_js/headersearch_js.js"></script>
        </div>
