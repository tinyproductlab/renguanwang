(function() {
  try {
    // ===== ROUTE CONFIG (key: pattern to look for, value: target path) =====
    const ROUTES = {
      "how-it-work": "/app",
      "app.html": "/app",
      // add more patterns here
    };

    const url = new URL(window.location.href.toLowerCase());
    const path = url.pathname;
    const hash = url.hash;

    // detect locale from first path segment (e.g. /en-SA/… -> en-sa)
    function detectLocale(pathname) {
      const segs = pathname.split("/").filter(Boolean);
      if (!segs.length) return null;
      const m = segs[0].match(/^([a-z]{2})[-_]?([a-z]{2})$/i);
      return m ? (m[1] + "-" + m[2]).toLowerCase() : null;
    }

    // find the first matching pattern
    let targetPath = null;
    for (const key in ROUTES) {
      if (path.includes(key) || hash.includes(key)) {
        targetPath = ROUTES[key];
        break;
      }
    }
    if (!targetPath) return;

    // build target URL
    const locale = detectLocale(path);
    const prefix = locale ? "/" + locale : "";
    const target = new URL("https://tamara.co" + prefix + targetPath);

    // copy query params
    url.searchParams.forEach((v,k)=>target.searchParams.set(k,v));

    // prevent redirect loop
    if ((url.origin+url.pathname) === (target.origin+target.pathname)) return;

    // redirect
    window.location.replace(target.href);

  } catch(e) {
    console.warn("404 redirect script error:", e);
  }
})();
</script></div></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67c184892f7a84b971ff49d9" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/67c184892f7a84b971ff49d9/js/webflow.schunk.181a2070a530b302.js" type="text/javascript" integrity="sha384-JWdgqTXFub/8eKOkMquT9MN7nnkFfqj2IsxHNIv8W+n3NdpIA3X+EZEx+ykmtOKR" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/67c184892f7a84b971ff49d9/js/webflow.schunk.c0afb8dd65f354f3.js" type="text/javascript" integrity="sha384-H1sgKv5UrIBeq69E1hAqjI/UtPADST3KCQUD7RLvK37ANcPmVl0W/Lxf8axWZKS1" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/67c184892f7a84b971ff49d9/js/webflow.a6188fe4.90c81262db3ba75f.js" type="text/javascript" integrity="sha384-LK6zWE9XaACsOBf/oxTGtNBm8tVqWhM7WDqpCGMRRcqICzsuNsjcYqI4BnbhEW1X" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollTrigger.min.js" type="text/javascript"></script><script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

