  window.addEventListener('load', function () {
    document.querySelectorAll('.wait-load').forEach((el) => {
      el.classList.add('show');
    });
  });
</script>

<script>
  /**
   * Persist & Enforce UTM across pages in Webflow (SESSION ONLY)
   * - Captures UTM params on first visit of the SESSION and stores them in sessionStorage
   * - Internal links: always overwrite UTM with stored session UTMs
   * - Outbound links (to defined domains): remove all original UTMs and replace with session UTMs
   * - Non-UTM query params and hash fragments are preserved
   *
   * IMPORTANT: UTMs DO NOT persist across browser restarts (sessionStorage).
   * Legacy cleanup: removes any old localStorage key to avoid reviving stale UTMs.
   *
   * Opt-out: add data-utm-keep="false" to <a> tag if you don’t want UTM appended
   */

  (function () {
    // ---- Config ----
    var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];

    // Session-scoped storage key
    var SESSION_STORAGE_KEY = 'utm_params_session';

    // Optional: remove legacy localStorage value left by previous version
    var CLEAR_LEGACY_LOCALSTORAGE = true;

    // Outbound domains to enforce UTMs on (extend as needed)
    var OUTBOUND_DOMAINS = ['https://business.tamara.co', 'https://partners.tamara.co'];

    var DEBUG = false;
    function log() {
      if (DEBUG) {
        try {
          console.log.apply(console, arguments);
        } catch (e) {}
      }
    }

    // --- Storage helpers (SESSION ONLY) ---
    function loadSessionUtm() {
      try {
        var raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw) return {};
        return JSON.parse(raw) || {};
      } catch (e) {
        return {};
      }
    }
    function saveSessionUtm(obj) {
      try {
        sessionStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(obj || {}));
      } catch (e) {}
    }

    // Legacy cleanup (one-way)
    (function cleanupLegacy() {
      if (!CLEAR_LEGACY_LOCALSTORAGE) return;
      try {
        localStorage.removeItem('utm_params');
      } catch (e) {}
    })();

    // Read UTM from current URL (whitelist keys)
    function readUtmFromLocation() {
      var params = new URLSearchParams(window.location.search);
      var out = {};
      UTM_KEYS.forEach(function (k) {
        var v = params.get(k);
        if (v) out[k] = v;
      });
      return out;
    }

    // Merge: new overrides old (for mid-session updates)
    function mergeUtm(oldUtm, newUtm) {
      var merged = Object.assign({}, oldUtm);
      Object.keys(newUtm || {}).forEach(function (k) {
        if (newUtm[k]) merged[k] = newUtm[k];
      });
      return merged;
    }

    // Internal link check
    function isInternalLink(a) {
      var href = a.getAttribute('href');
      if (!href) return false;
      if (href.startsWith('#')) return false;
      if (href.startsWith('mailto:')) return false;
      if (href.startsWith('tel:')) return false;
      if (href.startsWith('javascript:')) return false;
      if (href.startsWith('/')) return true;
      try {
        var url = new URL(href, window.location.origin);
        return url.origin === window.location.origin;
      } catch (e) {
        return false;
      }
    }

    // Internal links: overwrite UTM params with session UTMs
    function withUtmOverwriteInternal(href, utmObj) {
      if (!utmObj || Object.keys(utmObj).length === 0) return href;

      var base = new URL(href, window.location.origin);
      var qs = new URLSearchParams(base.search);

      UTM_KEYS.forEach(function (k) {
        if (utmObj[k]) qs.set(k, utmObj[k]);
        else qs.delete(k); // optional: remove empty UTMs if present
      });

      base.search = qs.toString() ? '?' + qs.toString() : '';
      return base.pathname + base.search + base.hash;
    }

    // Outbound links: replace ALL UTMs with the session set (preserve non-UTM params)
    function withUtmReplaceAllOutbound(href, utmObj) {
      if (!utmObj || Object.keys(utmObj).length === 0) return href;

      var base = new URL(href);
      var qs = new URLSearchParams(base.search);

      // Remove all existing UTM keys
      UTM_KEYS.forEach(function (k) {
        qs.delete(k);
      });

      // Add stored session UTMs
      Object.keys(utmObj).forEach(function (k) {
        qs.set(k, utmObj[k]);
      });

      base.search = qs.toString() ? '?' + qs.toString() : '';
      return base.origin + base.pathname + base.search + base.hash;
    }

    // Apply UTMs to all links on the page
    function applyUtmToLinks(utmObj) {
      if (!utmObj || Object.keys(utmObj).length === 0) return;

      var links = document.querySelectorAll('a[href]');
      links.forEach(function (a) {
        var keep = a.getAttribute('data-utm-keep');
        if (keep && keep.toLowerCase() === 'false') return;

        var orig = a.getAttribute('href');

        // Outbound domains
        var outboundMatch = OUTBOUND_DOMAINS.find(function (d) {
          return orig.startsWith(d);
        });

        if (outboundMatch) {
          var newHref = withUtmReplaceAllOutbound(orig, utmObj);
          if (newHref !== orig) {
            a.setAttribute('href', newHref);
            log('UTM outbound (session):', { from: orig, to: newHref });
          }
          return;
        }

        // Internal
        if (isInternalLink(a)) {
          var newHref = withUtmOverwriteInternal(orig, utmObj);
          if (newHref !== orig) {
            a.setAttribute('href', newHref);
            log('UTM internal (session):', { from: orig, to: newHref });
          }
        }
      });
    }

    // Capture & persist UTMs FOR THIS SESSION ONLY
    function captureAndPersistSession() {
      var current = readUtmFromLocation();
      if (Object.keys(current).length === 0) return; // no UTM on this page => do NOT create or revive any
      var stored = loadSessionUtm();
      var merged = mergeUtm(stored, current); // current overrides stored
      saveSessionUtm(merged);
      log('UTM stored in session:', merged);
    }

    // Observe DOM (Webflow dynamic injections)
    function setupObserver(utmObj) {
      if (!window.MutationObserver) return;
      var obs = new MutationObserver(function () {
        applyUtmToLinks(utmObj);
      });
      obs.observe(document.documentElement, { childList: true, subtree: true });
    }

    function init() {
      // 1) Only store UTMs if present in CURRENT URL (session-scoped)
      captureAndPersistSession();

      // 2) Load session UTMs (if any) and apply to links
      var sessionUtm = loadSessionUtm();
      applyUtmToLinks(sessionUtm);

      // 3) Keep applying on DOM changes (for late-added links)
      setupObserver(sessionUtm);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<script>
  /* ==========================================================
   CONFIGURATION
   ========================================================== */
  const GATE_ID = 'merchant_onboarding_revamp_enabled';

  // --- Environments ---
  const HOSTS = { STAGING: 'tamara-staging.webflow.io', PRODUCTION: 'tamara.co' };

  // --- Statsig client keys ---
  const STATSIG_KEYS = {
    STAGING: 'client-sIzx8pV1Is7zOXxtOhu2weVOlPXjMl76xoNN7t3grsd',
    PRODUCTION: 'client-akNI7HhIA8Q84t2LCfJ091LVSX5c4zK8YHlhTu3gWNM',
  };

  // --- Locales: only KSA (en-sa / ar-sa) applies Statsig logic ---
  const ALLOWED_LOCALES = ['en-sa', 'ar-sa', 'en-ae', 'ar-ae'];

  // --- CTA URLs to check and replace ---
  const MATCH_LINKS = ['https://business.tamara.co', 'https://business.tamara.co/', 'https://business.tamara.co/signup', 'https://partners.tamara.co/onboarding'];

  // --- Target URLs by environment ---
  const TARGET_URLS = {
    STAGING: {
      ON: 'https://business-staging.tamara.co',
      OFF: 'https://partners-staging.tamara.co/onboarding',
    },
    PRODUCTION: {
      ON: 'https://business.tamara.co/signup',
      OFF: 'https://partners.tamara.co/onboarding',
    },
  };

  /* ==========================================================
   USER ID MANAGEMENT
   ========================================================== */
  // ✅ Step 0: Generate or reuse a unique userID per session
  function getOrCreateUserID() {
    const key = 'statsig_webflow_user_id';
    let uid = sessionStorage.getItem(key);
    if (!uid) {
      uid = 'anon_' + Math.random().toString(36).substring(2, 10);
      sessionStorage.setItem(key, uid);
      console.log('[Statsig] New userID created:', uid);
    } else {
      console.log('[Statsig] Existing userID reused:', uid);
    }
    return uid;
  }

  /* ==========================================================
   HELPER FUNCTIONS
   ========================================================== */

  // ✅ Step 1. Detect environment (staging or production)
  function getEnvironment() {
    const h = location.hostname.toLowerCase();

    if (h.includes(HOSTS.STAGING)) {
      return 'STAGING';
    }

    if (h.includes(HOSTS.PRODUCTION)) {
      return 'PRODUCTION';
    }

    // Default fallback
    return 'PRODUCTION';
  }

  // ✅ Step 2. Detect locale (en-sa, ar-sa, etc.)
  function getLocaleSlug() {
    const match = location.pathname.match(/^\/([^\/]+)/);
    const slug = ((match && match[1]) || '').toLowerCase();
    const queryLocale = new URL(location.href).searchParams.get('locale') || '';
    const qpSlug = queryLocale.replace('_', '-').toLowerCase();
    return slug || qpSlug;
  }

  // ✅ Step 3. Check if locale is allowed
  function isAllowedLocales() {
    return ALLOWED_LOCALES.includes(getLocaleSlug());
  }

  // ✅ Step 3b. Map locale → country (sa, ae, kw, bh)
  function getCountryCode() {
    const slug = getLocaleSlug(); // e.g., "en-sa", "ar-ae"
    if (!slug) return null;
    const parts = slug.split('-');
    const country = (parts[1] || '').toLowerCase(); // sa, ae, kw, bh

    if (['sa', 'ae', 'kw', 'bh'].includes(country)) {
      return country;
    }
    return null;
  }

  // ✅ Step 4. Merge query parameters (keep UTM & existing params)
  function mergeQueries(targetUrl, originalHref) {
    try {
      const target = new URL(targetUrl);
      const current = new URL(location.href);
      if (originalHref) {
        const original = new URL(originalHref, location.origin);
        original.searchParams.forEach((value, key) => {
          if (!target.searchParams.has(key)) target.searchParams.set(key, value);
        });
      }
      current.searchParams.forEach((value, key) => {
        if (!target.searchParams.has(key)) target.searchParams.set(key, value);
      });
      return target.toString();
    } catch {
      return targetUrl;
    }
  }

  // ✅ Step 5. Check if a link matches our CTA patterns
  function isTargetCTA(href) {
    return MATCH_LINKS.some((pattern) => (href || '').includes(pattern));
  }

  // ✅ Step 6. Rewrite CTA URLs based on gate ON/OFF
  function rewriteCTAs(isGateOn) {
    const env = getEnvironment();
    const targetUrl = isGateOn ? TARGET_URLS[env].ON : TARGET_URLS[env].OFF;
    document.querySelectorAll('a[href]').forEach((a) => {
      const href = a.getAttribute('href') || '';
      if (isTargetCTA(href)) {
        const finalUrl = mergeQueries(targetUrl, href);
        a.setAttribute('href', finalUrl);
        if (a.target === '_blank' && !a.rel) a.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  /* ==========================================================
   MAIN LOGIC
   ========================================================== */
  (async function main() {
    // 🟢 Step 1: Skip all logic if not KSA locale
    if (!isAllowedLocales()) {
      console.log('[Statsig] Skipped – Non-KSA locale:', getLocaleSlug());
      return;
    }

    // 🟢 Step 2: Wait for Statsig SDK to load
    let tries = 0;
    while ((!window.Statsig || !window.Statsig.StatsigClient) && tries++ < 50) {
      await new Promise((r) => setTimeout(r, 100));
    }
    if (!window.Statsig || !window.Statsig.StatsigClient) {
      console.warn('[Statsig] SDK not loaded → fallback to existing links');
      return;
    }

    // 🟢 Step 3: Prepare Statsig client environment and userID
    const { StatsigClient } = window.Statsig;
    const env = getEnvironment();
    const sdkKey = STATSIG_KEYS[env];
    const tier = env.toLowerCase(); // 'staging' | 'production'
    const userID = getOrCreateUserID();
    const country = getCountryCode(); // sa | ae | kw | bh | null

    const user = {
      userID,
      statsigEnvironment: { tier },
    };

    // 👉 Add country param right after statsigEnvironment
    if (country) {
      user.country = country;
    }

    let client;
    try {
      client = new StatsigClient(sdkKey, user);
      await client.initializeAsync();
    } catch (e) {
      console.warn('[Statsig] Initialization failed → fallback to existing links:', e);
      return;
    }

    // 🟢 Step 4: Check feature gate (ON/OFF)
    let isGateOn = false;
    try {
      isGateOn = client.checkGate(GATE_ID);
      console.log(`[Statsig] (${tier}) ${GATE_ID} →`, isGateOn ? 'ON ✅' : 'OFF ❌', '| Locale:', getLocaleSlug(), '| Country:', country || 'n/a', '| UserID:', userID);
    } catch (e) {
      console.warn('[Statsig] Gate check failed → fallback to existing links:', e);
      return;
    }

    // 🟢 Step 5: Apply CTA rewrite logic or fallback
    if (typeof isGateOn === 'boolean') {
      if (isGateOn === true) return;

      rewriteCTAs(isGateOn);

      // 🟢 Step 6: Observe DOM for dynamic changes (Webflow animations)
      const observer = new MutationObserver(() => rewriteCTAs(isGateOn));
      observer.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(() => observer.disconnect(), 8000);
    } else {
      console.warn('[Statsig] Gate result invalid → fallback to existing links');
    }
  })();
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const isMobile = window.matchMedia('(max-width: 767px)').matches;

    // Single shared observer for all items
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            showItem(entry.target);
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0,
        rootMargin: '0px 0px -10% 0px',
      },
    );

    // Set initial hidden state for each item
    const initItem = (item, delay = 0) => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(24px)';
      item.style.willChange = 'opacity, transform';
      item.style.transition = 'opacity 1.2s ease, transform 1s cubic-bezier(0.22, 1, 0.36, 1)';
      item.style.transitionDelay = isMobile ? '0ms' : `${delay}ms`;
    };

    // Trigger fade-up animation and free GPU memory after transition
    const showItem = (item) => {
      item.style.opacity = '1';
      item.style.transform = 'translateY(0)';
      item.addEventListener(
        'transitionend',
        () => {
          item.style.willChange = 'auto';
        },
        { once: true },
      );
    };

    // Auto-apply fade-up classes to FAQ section
    document.querySelectorAll('.la-component_faq').forEach((faq) => {
      faq.classList.add('fade-up-group');
      faq.querySelectorAll('.la-faq-dropdown-item').forEach((item) => {
        item.classList.add('fade-up-item');
      });
    });

    // Items inside .fade-up-group — apply stagger delay on desktop, capped at 400ms
    document.querySelectorAll('.fade-up-group').forEach((group) => {
      group.querySelectorAll('.fade-up-item').forEach((item, index) => {
        initItem(item, Math.min(index * 150, 400));
        observer.observe(item);
      });
    });

    // Items outside .fade-up-group — observe individually with no stagger
    document.querySelectorAll('.fade-up-item').forEach((item) => {
      if (!item.closest('.fade-up-group')) {
        initItem(item);
        observer.observe(item);
      }
    });
  });

  // Auto-apply fade-up classes to FAQ section
  document.querySelectorAll('.la-component_faq').forEach((faq) => {
    faq.classList.add('fade-up-group');
    faq.querySelectorAll('.la-wrapper-heading-faq').forEach((heading) => {
      heading.classList.add('fade-up-item');
    });
    faq.querySelectorAll('.la-faq-dropdown-item').forEach((item) => {
      item.classList.add('fade-up-item');
    });
  });
</script></body></html>