  <script>
    const handleOnClicklSelector = () => {
      const elem = document.getElementById('lSelectOpts');
      if (elem.hasAttribute('hidden')) {
        elem.removeAttribute("hidden");
      } else {
        elem.setAttribute("hidden", "true");
      }
    }
    const handleKeyDownlSelector = () => {
      if (event.key === 'Enter' || event.key === ' ') {
        const elem = document.getElementById('lSelectOpts');
        const elemUl = document.querySelector('#lSelectOpts ul');
        const lSelectCurrent = document.getElementById('lSelectCaption');
        if (elem.hasAttribute('hidden')) {
          elem.removeAttribute("hidden");
          elemUl.focus();
        } else {
          elem.setAttribute("hidden", "true");
          lSelectCurrent.focus();
        }
      }
    }
  </script>
