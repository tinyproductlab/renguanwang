    window.getParameterByName = function(name) {
        name = name.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
            results = regex.exec(window.location.href);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, ' '));
    };

    function getTcValue(value) {
      if(value === 'true') {
        return 'oui';
      } else if(value === 'false') {
        return  'non';
      } else {
        return '';
      }
    }

    let tc_is_not_selfcare = "";
    var is_selfcare = 'oui';
    if(tc_is_not_selfcare === 'true') {
      is_selfcare = 'non';
    }

    var env = "prod";
    var tagCommanderIframeSrc = "https://cdn.tagcommander.com/4589/tc_MireMonCompte_20.js";
    var xiti_xtsite = env === 'prod' ? '581211' : '581209';
    var tc_vars = {
        client_id: getParameterByName('client_id'),
              accostant: 'La Poste',
        xiti_xtsite: xiti_xtsite,
        env_channel: mobilecheck() ? "web_mobile" : "web",
        env_work: env,
        partenaire: '',
        contexte_accostant: "",
        version_utilisee: "V3",
        site: "lpfr_part",
        is_marchand: "non",
        xiti_xtn2: 'connexion',
        user_id: '',
        is_selfcare: is_selfcare,
        type_creation_compte: "",
        entreprise_identifiant: "",
        is_company_available: getTcValue(""),
        is_company_diffusible: getTcValue(""),
        is_phone_available: getTcValue(""),
        is_birthdate_available: getTcValue(""),
        phone_requested_type: "",
        is_email_entered: getTcValue(""),
        is_new_device: getTcValue(""),
        is_remember_me_checked: "",
        is_address_deliverable: getTcValue(""),
        is_address_available: getTcValue(""),
        address_requested_type: "",
        is_address_correct: getTcValue(""),
        is_phone_ko: getTcValue(""),
        is_phone_verified: getTcValue(""),
        is_address_requested: getTcValue(""),
        is_email_validation_requested: getTcValue(""),
        device: window.innerWidth >= 992 ? "desktop" : "mobile",
        optin_group_mail: getTcValue(""),
        optin_group_sms: getTcValue(""),
        optin_partners_mail: getTcValue(""),
        optin_partners_sms: getTcValue(""),
        is_email_ko: getTcValue(""),
        is_2fa_activated: getTcValue(""),
        '2fa_active_method': "",
        '2fa_journey_type': "",
        '2fa_journey_method': "",
        is_2fa_push_enabled: getTcValue(""),
        is_push_reachable: getTcValue(""),
        is_device_trusted: getTcValue(""),
        info_check_todo: "",
        info_check_editing: "",
        info_check_done: "",
        is_email_to_be_verified:getTcValue("")
    };

    tc_vars = foreign_tc_vars !== undefined ? Object.assign({}, tc_vars, foreign_tc_vars) : tc_vars;
    if(tc_vars.chapter2 != undefined) {
      tc_vars.xiti_xtn2 = tc_vars.chapter2;
    } 
    const frame_tc = document.getElementById('frame-tc');
    frame_tc.onload = function() { frame_tc.contentWindow.postMessage({tc_vars, tagCommanderIframeSrc}, "*"); };

    window.tcSendClickEvent = function(htmlElement, event) {
      const frame_tc = document.getElementById('frame-tc');
      if (!frame_tc || !htmlElement) return;
      
      const elementData = {
        tagName: htmlElement.tagName,
        id: htmlElement.id,
        className: htmlElement.className,
        href: htmlElement.href,
        textContent: htmlElement.textContent,
        dataset: {...(htmlElement.dataset || {})},
        // Additional properties that might be needed:
        type: htmlElement.type,
        name: htmlElement.name,
        value: htmlElement.value
      };

      frame_tc.contentWindow.postMessage({htmlElement: elementData, event}, "*");
    };

    window.tcSendErrorEvent = function(htmlElement, error) {
      const frame_tc = document.getElementById('frame-tc');
      if (!frame_tc || !htmlElement) return;
      
      const elementData = {
        tagName: htmlElement.tagName,
        id: htmlElement.id,
        className: htmlElement.className,
        href: htmlElement.href,
        textContent: htmlElement.textContent,
        dataset: {...(htmlElement.dataset || {})},
        type: htmlElement.type,
        name: htmlElement.name,
        value: htmlElement.value
      };
      frame_tc.contentWindow.postMessage({htmlElement: elementData, error}, "*");
    };
</script>
