    <script>
    (function () {

        if (new URLSearchParams(window.location.search).get("source") === "map") {

            document.documentElement.classList.add("source-map");

            var swapped = false;

            function swapTabs() {

                if (swapped) return;

                var tabList = document.querySelector('.cmp-tabs__tablist');
                var tabs = tabList ? tabList.querySelectorAll('.cmp-tabs__tab') : [];
                var tabPanels = document.querySelectorAll('.cmp-tabs__tabpanel');

                if (tabList && tabs.length > 1 && tabPanels.length > 1) {

                    swapped = true;

                    tabList.insertBefore(tabs[1], tabs[0]);
                    tabPanels[0].parentNode.insertBefore(tabPanels[1], tabPanels[0]);

                    var firstTab = tabList.querySelector('.cmp-tabs__tab');
                    var panels = document.querySelectorAll('.cmp-tabs__tabpanel');

                    tabs.forEach(function (tab) {
                        tab.classList.remove('cmp-tabs__tab--active');
                        tab.setAttribute('aria-selected', 'false');
                        tab.setAttribute('tabindex', '-1');
                    });

                    panels.forEach(function (panel) {
                        panel.classList.remove('cmp-tabs__tabpanel--active');
                    });

                    if (firstTab && panels.length > 0) {

                        firstTab.classList.add('cmp-tabs__tab--active');
                        firstTab.setAttribute('aria-selected', 'true');
                        firstTab.setAttribute('tabindex', '0');

                        panels[0].classList.add('cmp-tabs__tabpanel--active');
                    }
                }
            }

            swapTabs();

            if (!swapped) {

                var observer = new MutationObserver(function (mutations, obs) {

                    swapTabs();

                    if (swapped) obs.disconnect();

                });

                observer.observe(document.documentElement, {
                    childList: true,
                    subtree: true
                });
            }

            function hideChatbotAndQualtrics() {

                var el = document.getElementById("botdistrikt-chatbot-widget");
                if (el) el.style.display = "none";

                el = document.getElementById("QSIFeedbackButton-shadowbox");
                if (el) el.style.display = "none";

                el = document.querySelector(".QSIFeedbackButton");
                if (el) el.style.display = "none";
            }

            document.addEventListener("DOMContentLoaded", hideChatbotAndQualtrics);

            setTimeout(hideChatbotAndQualtrics, 2000);
        }

    })();
</script>

<style>
    html.source-map header,
    html.source-map .global-footer,
    html.source-map #botdistrikt-chatbot-widget,
    html.source-map #QSIFeedbackButton-shadowbox,
    html.source-map .QSIFeedbackButton {
        display: none !important;
    }
</style>




    
