            $(document).ready(function () {
                var submitIcon = $('.searchbox-icon');
                var inputBox = submitIcon.parent().find('.searchbox-input');
                var searchBox = $('.searchbox');
                var isOpen = false;
                //var inputVal = inputBox.val();

                inputBox.keypress(function (e) {
                    var key = e.which;
                    if (key == 13)  // the enter key code
                    {
                        submitIcon.trigger("click");
                        console.log(key);
                    }
                });


                $('.searchbox-icon').click(function () {
                    inputBox = $(this).parent().find('.searchbox-input');
                    if (!inputBox.length)         // use this if you are using id to check
                    {
                        inputBox = $(this).parent().parent().find('.searchbox-input');
                    }

                    inputVal = $.trim(inputBox.val()).length;
                    if (isOpen == false) {
                        searchBox.show('slow');
                        inputBox.focus();
                        isOpen = true;
                    } else {
                        searchBox.hide('slow');
                        inputBox.focusout();
                        isOpen = false;
                    }
                    console.log(inputVal);
                    if (inputVal !== 0) {
                        let url = "https://gate.ahram.org.eg/UI/Front/Search.aspx?Text=" + inputBox.val();
                        //console.log(url);
                        window.location.href = url;

                    }
                });


                submitIcon.mouseup(function () {
                    return false;
                });
                searchBox.mouseup(function () {
                    return false;
                });
                $(document).mouseup(function () {
                    if (isOpen == true) {
                        $('.searchbox-icon').css('display', 'block');
                        submitIcon.click();
                    }
                });
            });

            function buttonUp() {
                var inputVal = $('.searchbox-input').val();
                inputVal = $.trim(inputVal).length;
                if (inputVal !== 0) {
                    //$('.searchbox-icon').css('display','none');
                } else {
                    $('.searchbox-input').val('');
                    //$('.searchbox-icon').css('display','block');
                }
            }

