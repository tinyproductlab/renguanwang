ppLinks":[{"id":"1","url":"https://play.google.com/store/apps/details?id=pl.mbank","mobileAppIcon":"googlePlay","alt":"pobierz aplikację mBanku z Google Play","target":"self"},{"id":"2","url":"https://itunes.apple.com/pl/app/mbank-pl/id454987093?mt=8","mobileAppIcon":"appStore","alt":"pobierz aplikację mBanku z Apple AppStore","target":"self"}]}}}}}}}}},"megaMenu":{"data":null},"segment":{"data":{"id":"1","attributes":{"name":"indywidualny","homeUrl":"/indywidualny","homeAlt":"klienci indywidualni","megaMenu":{"data":{"attributes":{"globalNavigation":{"data":{"attributes":{"naviLinks":[{"__typename":"ComponentMegaMenuSegmentLinksList","segmentLinks":[{"id":"2","link":{"id":"281","label":"klient indywidualny","url":"/indywidualny/","alt":null},"icon":{"data":{"attributes":{"url":"https://assets.mbank.pl/assets/logo/mass/mbank_square_mass.svg"}}},"name":"indywidualny","segment":{"data":{"id":"1","attributes":{"name":"indywidualny","homeUrl":"/indywidualny","type":null}}}},{"id":"3","link":{"id":"282","label":"private banking","url":"/private-banking/","alt":null},"icon":{"data":{"attributes":{"url":"https://assets.mbank.pl/assets/logo/private/mbank_square_private.svg"}}},"name":"private banking","segment":{"data":{"id":"2","attributes":{"name":"private-banking","homeUrl":"/private-banking","type":null}}}},{"id":"4","link":{"id":"283","label":"firmy","url":"/firmy/","alt":null},"icon":{"data":{"attributes":{"url":"https://assets.mbank.pl/assets/logo/sme/mbank_square_sme.svg"}}},"name":"firmy","segment":{"data":{"id":"4","attributes":{"name":"firmy","homeUrl":"/firmy","type":null}}}},{"id":"1","link":{"id":"280","label":"msp i korporacje","url":"/msp-korporacje/","alt":null},"icon":{"data":{"attributes":{"url":"https://assets.mbank.pl/assets/logo/corporate/mbank_square_corporate.svg"}}},"name":"korporacje","segment":{"data":{"id":"3","attributes":{"name":"msp-korporacje","homeUrl":"/msp-korporacje","type":null}}}}]}]}}},"actionLinks":{"data":{"id":"1","attributes":{"customLinks":[{"id":"2","link":{"id":"284","label":"bezpieczeństwo","url":"/bezpieczenstwo/","alt":null},"icon":{"iconName":"ShieldTick"}},{"id":"3","link":{"id":"291","label":"kontakt","url":"/kontakt/oferta-indywidualna/","alt":null},"icon":{"iconName":"SpeechBubble"}},{"id":"17","link":{"id":"922","label":"załóż konto","url":"/indywidualny/konta/konta-osobiste/ekonto-do-uslug/?kampania=hp_przy_zaloguj_nowy_kl","alt":null},"icon":{"iconName":"PlusRound"}}]}}},"primaryButton":{"id":"1955","url":"https://online.mbank.pl/","text":"zaloguj się","alt":null},"sections":[{"id":"297","title":"plany","sectionUrl":"/plany/","sectionAlt":null,"columns":[],"promoBox":{"data":null}},{"id":"16","title":"konta i karty","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"konta","links":[{"label":"konta osobiste","url":"/indywidualny/konta/konta-osobiste/","alt":null},{"label":"konta oszczędnościowe ","url":"/indywidualny/inwestycje-i-oszczednosci/regularne-odkladanie/","alt":null},{"label":"konta walutowe","url":"/indywidualny/konta/ekonto-walutowe/","alt":null},{"label":"konta firmowe","url":"/firmy/konta-firmowe/konto-podstawowe/","alt":null},{"label":"wszystkie konta","url":"/indywidualny/konta/","alt":null},{"label":"polecamBank","url":"/indywidualny/dla-klienta/polecambank/","alt":null},{"label":"strefa korzyści","url":"/indywidualny/dla-klienta/strefa-korzysci/","alt":null},{"label":"pytania i odpowiedzi","url":"/indywidualny/konta/pytania-i-odpowiedzi/","alt":null}]},{"title":"karty","links":[{"label":"karty do konta","url":"/indywidualny/karty/karty-debetowe/","alt":null},{"label":"karty kredytowe","url":"/indywidualny/karty/karty-kredytowe/","alt":null},{"label":"karty do mKonta intensive","url":"/indywidualny/karty/karty-do-mkonta-intensive/","alt":null},{"label":"gadżety płatnicze","url":"/indywidualny/karty/karty-debetowe/?filter=gadżety+płatnicze","alt":null},{"label":"pytania i odpowiedzi","url":"/indywidualny/karty/pytania-i-odpowiedzi/","alt":null}]}],"promoBox":{"data":{"id":"1","attributes":{"header":"konto osobiste - eKonto do usług","ctaButton":{"text":"sprawdź","url":"/indywidualny/konta/konta-osobiste/ekonto-do-uslug/?kampania=kafel_menu","alt":"informacje o koncie do usług","target":"self"},"isPromoted":true,"description":"\u003cul\u003e\n\u003cli\u003enawet \u003cstrong\u003e1000 zł\u003c/strong\u003e oraz \u003cstrong\u003e5,3%\u003c/strong\u003e w skali roku na oszczędnościach do 100 000 zł\u0026nbsp;\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e0 zł\u003c/strong\u003e za wypłaty z bankomat\u0026oacute;w za granicą\u0026nbsp;\u003c/li\u003e\n\u003c/ul\u003e","tooltip":{"triggerText":"nota prawna","content":"\u003cp\u003e\u003cstrong\u003eNota prawna\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTo nie jest oferta.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eeKonto do usług\u003c/strong\u003e to: 0 zł za otwarcie i prowadzenie konta, 0 zł za kartę przy 350 zł transakcji nią w miesiącu (lub 9 zł przy braku spełnienia tego warunku), 0 zł za wypłaty kartą oraz wypłaty BLIK od 300 zł z bankomat\u0026oacute;w w Polsce (prowizja za wypłaty poniżej 300 zł wynosi 2,50 zł), 0 zł za przelewy internetowe w złot\u0026oacute;wkach, 0 zł za wypłaty z bankomat\u0026oacute;w za granicą. Szczeg\u0026oacute;łowe informacje, w tym warunki naliczania opłat, są określone w Taryfie prowizji i opłat bankowych dla os\u0026oacute;b fizycznych w ramach bankowości detalicznej mBanku S.A. oraz Regulaminie rachunk\u0026oacute;w dla os\u0026oacute;b fizycznych i klient\u0026oacute;w Private Banking w ramach bankowości detalicznej mBanku S.A.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePromocja \u0026bdquo;Cała naprz\u0026oacute;d \u0026ndash; zyskuj z kontem w mBanku \u0026ndash; edycja II\u0026rdquo;\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTo nie jest oferta. Promocja \u0026bdquo;Cała naprz\u0026oacute;d \u0026ndash; zyskaj z kontem w mBanku \u0026ndash; II edycja\u0026rdquo;. Do promocji możesz przystąpić od 1.09.2026 r. do 30.11.2026 r. Promocja trwa od 1.09.2026 r. do 31.07.2027 r. i jest to ostatni dzień, w kt\u0026oacute;rym możemy wypłacić Ci premię. Promocja jest skierowana do pełnoletnich os\u0026oacute;b fizycznych, mających pełną zdolność do czynności prawnych, będących nowymi klientami banku. Definicja nowego klienta banku znajduje się w regulaminie promocji. Aby skorzystać z promocji: w czasie, w kt\u0026oacute;rym możesz przystąpić do promocji, zł\u0026oacute;ż wniosek o otwarcie eKonta do usług (dalej rachunek) z wnioskiem o wydanie karty, na wniosku zaakceptuj oświadczenia o treści przedstawionej w części MOJE OŚWIADCZENIA oraz regulamin promocji, na wniosku zaznacz opcję związaną z otwarciem rachunku do regularnego oszczędzania moje cele, najp\u0026oacute;źniej do 7.12.2026 r. zawrzyj indywidualną umowę o prowadzenie bankowych rachunk\u0026oacute;w dla os\u0026oacute;b fizycznych - eKonta do usług. Nagrodami w promocji są: premia I \u0026ndash; 100 zł, premia II \u0026ndash; 400 zł, bonus I \u0026ndash; 100 zł, bonus II \u0026ndash; 300 zł, bonus III \u0026ndash; 100 zł. Premię I \u0026ndash; 100 zł otrzymasz, jeśli łącznie spełnisz warunki: zrobisz jednorazowy wpływ na rachunek w ciągu 7 dni kalendarzowych od jego otwarcia w wysokości min. 2 000 zł, zrobisz transakcje kartą na łączną kwotę min. 350 zł najp\u0026oacute;źniej do końca pierwszego pełnego miesiąca po otwarciu rachunku, zapewnisz łączne saldo min. 100 zł na rachunku moje cele powiązanym z rachunkiem otwartym w promocji. W przypadku otwarcia więcej niż jednego celu w trakcie obowiązywania promocji, będziemy brali pod uwagę łączne saldo na wszystkich otwartych przez Ciebie celach oszczędnościowych powiązanych z rachunkiem. Łączne saldo min. 100 zł musisz zapewnić na ostatni dzień roboczy pierwszego pełnego miesiąca po otwarciu rachunku. Premię II \u0026ndash; 400 zł otrzymasz, jeśli łącznie spełnisz warunki w każdym z pięciu kolejnych pełnych miesięcy kalendarzowych \u0026ndash; od drugiego do sz\u0026oacute;stego pełnego miesiąca po otwarciu rachunku: zrobisz jednorazowy wpływ na rachunek w wysokości min. 2 000 zł, zrobisz transakcje kartą na łączną kwotę min. 350 zł, Twoje saldo na rachunku moje cele musi wzrosnąć o min. 100 zł w por\u0026oacute;wnaniu do salda z ostatniego dnia roboczego z poprzedniego miesiąca. W przypadku otwarcia więcej niż jednego celu w trakcie obowiązywania promocji, będziemy brali pod uwagę łączne saldo na wszystkich otwartych przez Ciebie celach oszczędnościowych powiązanych z rachunkiem. Łączne saldo będziemy por\u0026oacute;wnywali do łącznego salda, kt\u0026oacute;re miałeś na ostatni dzień roboczy w poprzednim miesiącu. Warunek ten musisz spełnić ostatniego dnia roboczego danego miesiąca, np. jeśli ostatniego dnia roboczego września 2026 r. Twoje łączne saldo wynosiło 100 zł, to aby spełnić warunek w październiku 2026 r., Twoje łączne saldo na rachunku moje cele ostatniego dnia roboczego w października 2026 r. powinno wynosić min. 200 zł. Bonus I - 100 zł otrzymasz, jeśli łącznie spełnisz warunki: otworzysz eKonto do usług z kartą przez selfie lub przez e-dow\u0026oacute;d lub aplikację mObywatel oraz spełnisz łącznie wszystkie warunki do otrzymania premii I oraz premii II. Bonus II- 300 zł otrzymasz, jeśli w minimum czterech z sześciu pełnych miesięcy kalendarzowych od otwarcia rachunku Tw\u0026oacute;j jednorazowy wpływ będzie pochodził z tytułu wynagrodzenia w wysokości min. 2 000 zł. Bonus III \u0026ndash; 100 zł otrzymasz, jeśli łącznie spełnisz warunki: otworzysz dla siebie eKonto do usług z kartą, a następnie otworzysz eKonto Junior lub eKonto możliwości (od 13 do 17 lat) dla dziecka do końca pierwszego pełnego miesiąca po otwarciu swojego rachunku. Premie oraz bonusy wypłacimy w postaci przelewu premii pieniężnej na Tw\u0026oacute;j rachunek otwarty w promocji. Terminy i zasady wypłaty premii i bonus\u0026oacute;w określa regulamin promocji. Do dnia, w kt\u0026oacute;rym wypłacimy Ci premię i/lub bonus musisz być posiadaczem rachunku i karty. Nie otrzymasz przelewu premii pieniężnej, jeśli zamkniesz rachunek przed jej wypłatą. Łączna wartość premii i bonus\u0026oacute;w przy otwarciu eKonta do usług wynosi maksymalnie 1000 zł. Możesz otrzymać jedną z premii i/lub jeden z bonus\u0026oacute;w, w zależności od tego jaki otworzyłeś rachunek oraz jakie i kiedy spełniłeś warunki. Wypłatę danej premii i/lub bonusu możesz otrzymać tylko raz, jeśli spełniłeś wymagane warunki określone w regulaminie promocji. To oznacza, że nie możesz otrzymać, np. dw\u0026oacute;ch wypłat premii II czy np. dw\u0026oacute;ch wypłat bonusu III. Jeśli na wniosku o otwarcie rachunku zawnioskujesz o moje cele możesz otrzymać promocyjne oprocentowanie, pod warunkiem spełnienia warunk\u0026oacute;w promocyjnych: 5,3% w skali roku do kwoty 100 000 zł dla klient\u0026oacute;w, kt\u0026oacute;rzy otworzą eKonto do usług. Promocyjne oprocentowanie dotyczy wyłącznie rachunku moje cele otwartego wraz z rachunkiem w ramach promocji. Inne rachunki moje cele, kt\u0026oacute;re otworzysz p\u0026oacute;źniej, nie są objęte promocyjnym oprocentowaniem. Promocyjne oprocentowanie będzie trwać przez\u0026nbsp; dni od dnia otwarcia rachunku do regularnego oszczędzania moje cele. Będziemy je wypłacać w ostatnim dniu roboczym każdego miesiąca, w kt\u0026oacute;rym oprocentowanie promocyjne obowiązuje. Po upływie 180 dni środki na rachunku do regularnego oszczędzania moje cele będą oprocentowane zgodnie z aktualnie obowiązującymi w banku Tabelami st\u0026oacute;p procentowych dla os\u0026oacute;b fizycznych w ramach bankowości detalicznej mBanku S.A. Oprocentowanie środk\u0026oacute;w przewyższających kwotę 100 000 zł dla eKonta do usług, na rachunku umożliwiającym regularne oszczędzanie moje cele w pierwszych 180 dniach od otwarcia wyniesie 0,1% w skali roku. Promocyjne oprocentowanie na rachunku moje cele naliczane jest, gdy suma wpływ\u0026oacute;w w bieżącym miesiącu jest wyższa co najmniej o 100 zł od sumy obciążeń na wszystkich Twoich celach. Warunek jest sprawdzany ostatniego dnia roboczego miesiąca, w odniesieniu do wszystkich rachunk\u0026oacute;w umożliwiających regularne oszczędzanie, powiązanych z tym samym rachunkiem oszczędnościowo-rozliczeniowym. Jeżeli masz rachunek, do kt\u0026oacute;rego podpięte są rachunki do regularnego oszczędzania moje cele i ostatniego dnia roboczego września 2026 r. miałeś na nich 300 zł, aby mieć promocyjne oprocentowanie na koniec października 2026 r., na tych rachunkach musisz mieć co najmniej o 100 zł więcej niż ostatniego dnia roboczego września 2026 r., z uwzględnieniem wyjątku dla miesiąca, w kt\u0026oacute;rym kończy się promocja \u0026ndash; w takim przypadku warunek wzrostu salda o co najmniej 100 zł sprawdzamy w dniu zakończenia promocji. Jeżeli zmienisz rachunek indywidualny na rachunek wsp\u0026oacute;lny, z dniem zmiany rachunku, przestaniesz uczestniczyć w promocji. Jeżeli zmienisz rachunek otwarty w tej promocji na inny rodzaj rachunku dostępny w ofercie mBanku, to z dniem tej zmiany przestaniesz uczestniczyć w promocji. Szczeg\u0026oacute;łowe warunki uczestnictwa w promocji oraz warunki otrzymania premii i bonus\u0026oacute;w opisaliśmy w regulaminie promocji \u0026bdquo;Cała naprz\u0026oacute;d \u0026ndash; zyskuj z kontem w mBanku \u0026ndash; edycja II\u0026rdquo; zamieszczonym na stronie: \u003ca href=\"http://www.mbank.pl/pdf/promocje/konta/regulamin-promocji-cala-naprzod-zyskuj-z-kontem-w-mbanku-edycja-ii.pdf\"\u003ewww.mbank.pl/pdf/promocje/konta/regulamin-promocji-cala-naprzod-zyskuj-z-kontem-w-mbanku-edycja-ii.pdf\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eAplikacja \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePamiętaj, że mBank udostępnia swoją aplikację tylko w autoryzowanych sklepach -\u0026nbsp;App Store\u0026nbsp;(iOS - Apple),\u0026nbsp;Google Play\u0026nbsp;(Android). Pobieraj, instaluj i aktualizuj aplikację tylko w tych sklepach, ponieważ znajdujące się tam aplikacje są cyfrowo podpisane i przechodzą proces weryfikacji pod kątem ich bezpieczeństwa. Nigdy nie pobieraj aplikacji z innych miejsc niż oficjalne sklepy (np. z linka otrzymanego sms-em czy przez komunikator) \u0026ndash; narazisz się na pobranie złośliwej aplikacji, przez kt\u0026oacute;rą oszuści mogą wyłudzać Twoje dane czy przejmować sms-y i wysyłać je bez Twojej zgody. Nową aplikację możesz pobrać, jeśli Twoje urządzenie ma system operacyjny w wersji minimum\u0026nbsp;Android\u0026nbsp;10.0 lub iOS 18.0 (lub nowsze). Zapoznaj się z polityką prywatności aplikacji mobilnych, kt\u0026oacute;rą znajdziesz na stronie:\u0026nbsp;\u003ca href=\"https://www.mbank.pl/o-nas/o-mbanku/polityka-prywatnosci-mobile/\"\u003ehttps://www.mbank.pl/o-nas/o-mbanku/polityka-prywatnosci-mobile/\u003c/a\u003e\u003c/p\u003e"},"productLabel":{"data":null}}}}},{"id":"19","title":"kredyty","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"kredyty","links":[{"label":"kredyty gotówkowe","url":"/indywidualny/kredyty/kredyty-gotowkowe/","alt":null},{"label":"kredyt konsolidacyjny","url":"/indywidualny/kredyty/kredyty-gotowkowe/kredyt-konsolidacyjny/","alt":null},{"label":"kredyty odnawialne","url":"/indywidualny/kredyty/kredyt-odnawialny/","alt":null},{"label":"kredyty firmowe","url":"/firmy/kredyty/kredyty-i-pozyczki/","alt":null},{"label":"płacę później","url":"/indywidualny/kredyty/place-pozniej/","alt":null},{"label":"mPożyczka","url":"/indywidualny/kredyty/kredyty-gotowkowe/mraty/","alt":null},{"label":"pytania i odpowiedzi","url":"/indywidualny/kredyty/pytania-i-odpowiedzi/","alt":null}]},{"title":"kredyty hipoteczne","links":[{"label":"zakup i finansowanie nieruchomości","url":"/indywidualny/kredyty/zakup-nieruchomosci/","alt":null},{"label":"kredyt hipoteczny","url":"/indywidualny/kredyty/kredyty-hipoteczne/chce-kredyt-hipoteczny/","alt":null},{"label":"refinansowanie kredytu hipotecznego","url":"/indywidualny/kredyty/kredyty-hipoteczne/przenosze-kredyt-online/","alt":null},{"label":"pożyczka hipoteczna na dowolny cel","url":"/indywidualny/kredyty/kredyty-hipoteczne/chce-pozyczke-hipoteczna/","alt":null},{"label":"mam kredyt hipoteczny","url":"/indywidualny/kredyty/kredyty-hipoteczne/mam-kredyt-hipoteczny/","alt":null},{"label":"pytania i odpowiedzi","url":"/indywidualny/kredyty/pytania-i-odpowiedzi/","alt":null}]}],"promoBox":{"data":null}},{"id":"28","title":"inwestycje i oszczędności","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"emerytura","links":[{"label":"kalkulator emerytalny","url":"/indywidualny/inwestycje-i-oszczednosci/emerytura/","alt":null},{"label":"IKZE i IKE fundusze","url":"/indywidualny/inwestycje-i-oszczednosci/emerytura/pakiet/","alt":null},{"label":"IKZE i IKE maklerskie","url":"/indywidualny/inwestycje-i-oszczednosci/ike-ikze/","alt":null},{"label":"plan na emeryturę","url":"/indywidualny/inwestycje-i-oszczednosci/planowanie-finansowe/","alt":null}]},{"title":"oszczędności","links":[{"label":"konta oszczędnościowe","url":"/indywidualny/inwestycje-i-oszczednosci/regularne-odkladanie/","alt":null},{"label":"lokaty","url":"/indywidualny/inwestycje-i-oszczednosci/lokaty","alt":null},{"label":"cele oszczędnościowe","url":"/indywidualny/inwestycje-i-oszczednosci/regularne-odkladanie/cele-standard","alt":null}]},{"title":"inwestycje","links":[{"label":" lokata z funduszem","url":"/indywidualny/inwestycje-i-oszczednosci/fundusze/lokata-z-funduszem/","alt":null},{"label":"fundusze inwestycyjne","url":"/indywidualny/inwestycje-i-oszczednosci/fundusze","alt":null},{"label":"giełda","url":"/indywidualny/inwestycje-i-oszczednosci/gielda","alt":null},{"label":"ETF","url":"/indywidualny/inwestycje-i-oszczednosci/gielda/fundusze-etf/","alt":null},{"label":"jak zacząć inwestować","url":"/indywidualny/inwestycje-i-oszczednosci/jak-zaczac-inwestowac/","alt":null}]}],"promoBox":{"data":{"id":"79","attributes":{"header":"lokata z funduszem","ctaButton":{"text":"sprawdź","url":"/indywidualny/inwestycje-i-oszczednosci/fundusze/lokata-z-funduszem/?kampania=menu_kafel","alt":"lokatę z funduszem","target":"self"},"isPromoted":true,"description":"\u003cul\u003e\n\u003cli\u003edo\u003cstrong\u003e 7% na lokacie z funduszem\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003epołącz atrakcyjne oprocentowanie lokaty na 12 miesięcy z możliwościami inwestycji\u003c/li\u003e\n\u003c/ul\u003e","tooltip":{"triggerText":"nota prawna","content":"\u003cp\u003eTo nie jest oferta.\u003c/p\u003e\n\u003cp\u003ePromocja \u0026bdquo;Nowa lokata z\u0026nbsp;funduszem edycja 2\u0026rdquo; (zwana dalej: \u0026bdquo;promocją\u0026rdquo;) trwa od 14.07.2026\u0026nbsp;r. do dnia zakończenia ostatniej lokaty założonej w\u0026nbsp;ramach promocji, nie dłużej niż do 17.11.2027\u0026nbsp;r. Do promocji można przystąpić od 14.07.2026\u0026nbsp;r. do 17.11.2026\u0026nbsp;r. lub do wyczerpania kwoty pakiet\u0026oacute;w dostępnych w\u0026nbsp;promocji.\u003c/p\u003e\n\u003cp\u003eW\u0026nbsp;promocji mogą uczestniczyć osoby fizyczne, konsumenci \u0026ndash; klienci indywidualni mBanku, kt\u0026oacute;rzy: a) mają w\u0026nbsp;mBanku jeden z\u0026nbsp;rachunk\u0026oacute;w powiązany z\u0026nbsp;usługą przyjmowania i\u0026nbsp;przekazywania zleceń nabycia lub odkupienia jednostek uczestnictwa w\u0026nbsp;funduszach inwestycyjnych (zwaną dalej: \u0026bdquo;usługą SFI\u0026rdquo;); b) mają aktywną usługę SFI; c) złożyli oświadczenie w\u0026nbsp;plac\u0026oacute;wce mBanku, kt\u0026oacute;re zaakceptowali i\u0026nbsp;podpisali albo zaakceptowali treść oświadczenia ustnie podczas nagrywanej rozmowy z\u0026nbsp;BOT albo zaakceptowali treść oświadczenia elektronicznie, tj. zaznaczyli odpowiednie pole we wniosku w\u0026nbsp;serwisie transakcyjnym; d) wypełnili ankietę MiFID, a\u0026nbsp;jej wynik wskazuje na to, że usługa SFI jest dla nich odpowiednia; e) zamierzają zainwestować w\u0026nbsp;ramach promocji nowe środki oraz spełniają pozostałe warunki regulaminu promocji.\u003c/p\u003e\n\u003cp\u003eAby skorzystać z\u0026nbsp;promocji, na wniosku promocyjnym trzeba złożyć i\u0026nbsp;opłacić dyspozycję pierwszego nabycia jednostek uczestnictwa wybranego funduszu, zgodnego z\u0026nbsp;wynikiem ankiety MiFID, otworzyć lokatę i\u0026nbsp;złożyć zlecenie stałe (regularnego inwestowania). Kwota regularnego inwestowania nie może być mniejsza niż 100 zł przez okres minimum 10 miesięcy. W\u0026nbsp;czasie 300\u0026nbsp;dni od dnia założenia lokaty klient nie może złożyć zlecenia odkupienia lub konwersji jednostek uczestnictwa nabytych w\u0026nbsp;pakiecie w\u0026nbsp;ramach promocji. Lista funduszy dostępnych w\u0026nbsp;promocji znajduje się w\u0026nbsp;załączniku numer 1\u0026nbsp;do regulaminu promocji. Kwota przeznaczona na promocję musi być podzielona między fundusz i\u0026nbsp;lokatę zgodnie z\u0026nbsp;wybraną przez klienta proporcją:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e20% lokata, 80% fundusz,\u003c/li\u003e\n\u003cli\u003e50% lokata, 50% fundusz,\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eŁączna minimalna kwota przystąpienia do promocji (nabycia jednostek uczestnictwa funduszu i\u0026nbsp;założenia lokaty) wynosi 10\u0026nbsp;000 zł. Wysokość promocyjnego oprocentowania lokaty wynosi:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e7% w\u0026nbsp;skali roku dla wariantu 20% lokata / 80% fundusz\u003c/li\u003e\n\u003cli\u003e5,2% w\u0026nbsp;skali roku dla wariantu 50% lokata / 50% fundusz\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eLokatę otwieramy z\u0026nbsp;oprocentowaniem promocyjnym. Jeśli klient spełni warunki promocji, oprocentowanie promocyjne utrzymamy do zakończenia lokaty. Oprocentowanie to naliczymy za cały okres trwania lokaty.\u003c/p\u003e\n\u003cp\u003eKwota pakiet\u0026oacute;w dostępnych w\u0026nbsp;ramach promocji wynosi łącznie 1\u0026nbsp;mld zł dla wszystkich uczestnik\u0026oacute;w promocji. Gdy kwota pakiet\u0026oacute;w dostępnych w\u0026nbsp;ramach promocji osiągnie poziom niższy niż 20\u0026nbsp;mln zł i\u0026nbsp;ulegnie wyczerpaniu, przekażemy o\u0026nbsp;tym informację na stronie:\u0026nbsp;\u003ca href=\"https://www.mbank.pl/indywidualny/inwestycje/fundusze/lokata-z-funduszem\"\u003ehttps://www.mbank.pl/indywidualny/inwestycje/fundusze/lokata-z-funduszem\u003c/a\u003e. Saldo uczestnika promocji na SFI w\u0026nbsp;dniu złożenia wniosku promocyjnego nie może być mniejsze niż na dzień 14.07.2026\u0026nbsp;r. Szczeg\u0026oacute;łowe warunki lokaty oraz szczeg\u0026oacute;łowe zasady nabywania funduszu w\u0026nbsp;ramach promocji określa regulamin promocji \u0026bdquo;Nowa lokata z\u0026nbsp;funduszem edycja 2\u0026rdquo; dostępny na:\u0026nbsp;\u003ca href=\"https://www.mbank.pl/pdf/promocje/lokaty/regulamin-promocji-nowa-lokata-z-funduszem-edycja-2.pdf\"\u003ehttps://www.mbank.pl/pdf/promocje/lokaty/regulamin-promocji-nowa-lokata-z-funduszem-edycja-2.pdf\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003ePromocja \u0026bdquo;Nowa lokata z\u0026nbsp;funduszem edycja 2\u0026rdquo; jest sprzedażą krzyżową. Sprzedaż jednostek funduszu i\u0026nbsp;lokaty w\u0026nbsp;ramach sprzedaży krzyżowej nie wpływa na ryzyko i\u0026nbsp;opłaty związane z\u0026nbsp;tymi usługami traktowanymi odrębnie.\u003c/p\u003e\n\u003cp\u003eUsługa przyjmowania i\u0026nbsp;przekazywania zleceń nabycia lub odkupienia jednostek uczestnictwa w\u0026nbsp;funduszach inwestycyjnych jest świadczona przez mBank tylko dla klient\u0026oacute;w mBanku. Szczeg\u0026oacute;łowe warunki i\u0026nbsp;opłaty z\u0026nbsp;nią związane, a\u0026nbsp;także informacje o\u0026nbsp;ryzykach inwestycyjnych są określone w\u0026nbsp;Regulaminie Supermarketu Funduszy Inwestycyjnych dla os\u0026oacute;b fizycznych i\u0026nbsp;klient\u0026oacute;w Private Banking w\u0026nbsp;ramach bankowości detalicznej mBanku S.A., w\u0026nbsp;Taryfie prowizji i\u0026nbsp;opłat bankowych dla os\u0026oacute;b fizycznych w\u0026nbsp;ramach bankowości detalicznej mBanku S.A.: Produkty inwestycyjne oraz w\u0026nbsp;statucie, prospekcie informacyjnym lub KID danego funduszu, znajdujących się na:\u0026nbsp;\u003ca href=\"https://www.mbank.pl/pomoc/dokumenty/oferta-indywidualna/inwestycje/supermarket-funduszy-inwestycyjnych/regulamin/\"\u003ehttps://www.mbank.pl/pomoc/dokumenty/oferta-indywidualna/inwestycje/supermarket-funduszy-inwestycyjnych/regulamin/\u003c/a\u003e,\u0026nbsp;\u003ca href=\"https://www.mbank.pl/pomoc/oplaty/interaktywna/ind/\"\u003ehttps://www.mbank.pl/pomoc/oplaty/interaktywna/ind/\u003c/a\u003e,\u0026nbsp;\u003ca href=\"https://www.mbank.pl/serwis-ekonomiczny/notowania-funduszy/\"\u003ehttps://www.mbank.pl/serwis-ekonomiczny/notowania-funduszy/\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eInwestowanie wiąże się z\u0026nbsp;ryzykiem i\u0026nbsp;nie gwarantuje realizacji założonego celu inwestycyjnego, ani uzyskania określonego wyniku inwestycyjnego. Należy liczyć się z\u0026nbsp;możliwością utraty przynajmniej części zainwestowanych środk\u0026oacute;w. Szczeg\u0026oacute;łowy opis czynnik\u0026oacute;w ryzyka znajduje się w\u0026nbsp;prospekcie informacyjnym.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBank nie ponosi odpowiedzialności za decyzje klient\u0026oacute;w związane z\u0026nbsp;inwestowaniem w\u0026nbsp;fundusze inwestycyjne.\u003c/strong\u003e\u0026nbsp;Fundusze inwestycyjne nie są depozytem bankowym. Dotychczasowe wyniki funduszy oraz innych emitent\u0026oacute;w nie stanowią gwarancji przyszłych wynik\u0026oacute;w. Wartość zakupionych jednostek/tytuł\u0026oacute;w uczestnictwa funduszy inwestycyjnych może się zmieniać wraz ze zmianą sytuacji na rynkach finansowych. W\u0026nbsp;konsekwencji, ewentualny doch\u0026oacute;d z\u0026nbsp;zainwestowanych środk\u0026oacute;w może ulec zwiększeniu lub zmniejszeniu. Ponadto potencjalne korzyści z\u0026nbsp;inwestowania w\u0026nbsp;fundusze inwestycyjne mogą zostać zmniejszone o\u0026nbsp;pobierane podatki i\u0026nbsp;opłaty wynikające z\u0026nbsp;przepis\u0026oacute;w prawa, taryf prowizji i\u0026nbsp;opłat oraz regulamin\u0026oacute;w.\u003c/p\u003e\n\u003cp\u003emBank S.A. oświadcza, że:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eposiada zezwolenie Komisji Papier\u0026oacute;w Wartościowych i\u0026nbsp;Giełd z\u0026nbsp;30.06.2005 r., zmienione decyzją Komisji Nadzoru Finansowego z\u0026nbsp;20.03.2012 r., zezwolenie Komisji Nadzoru Finansowego z\u0026nbsp;20.03.2012\u0026nbsp;r. oraz zezwolenie Komisji Nadzoru Finansowego z\u0026nbsp;17.11.2015\u0026nbsp;r. na prowadzenie działalności maklerskiej,\u003c/li\u003e\n\u003cli\u003eposiada zezwolenie Komisji Papier\u0026oacute;w Wartościowych i\u0026nbsp;Giełd z\u0026nbsp;23.11.1995\u0026nbsp;r. na świadczenie usług powierniczych, prowadzenie rachunk\u0026oacute;w papier\u0026oacute;w wartościowych, rejestrowanie stanu posiadania papier\u0026oacute;w wartościowych i\u0026nbsp;zmian tego posiadania,\u003c/li\u003e\n\u003cli\u003eorganem nadzorującym mBank S.A. w\u0026nbsp;zakresie działalności, o\u0026nbsp;kt\u0026oacute;rej mowa w\u0026nbsp;pkt. 1-2, jest Komisja Nadzoru Finansowego, ul. Piękna 20,\u0026nbsp;00-549 Warszawa.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003ePamiętaj, że mBank udostępnia swoją aplikację tylko w\u0026nbsp;autoryzowanych sklepach - App Store (iOS - Apple), Google Play (Android). Pobieraj, instaluj i\u0026nbsp;aktualizuj aplikacją tylko w\u0026nbsp;tych sklepach ponieważ znajdujące się tam aplikacje są cyfrowo podpisane i\u0026nbsp;przechodzą proces weryfikacji, pod kątem ich bezpieczeństwa. Nigdy nie pobieraj aplikacji z\u0026nbsp;innych miejsc niż oficjalne sklepy (np. z\u0026nbsp;linka otrzymanego sms-em czy przez komunikator) \u0026ndash; narazisz się na pobranie złośliwej aplikacji, przez kt\u0026oacute;rą oszuści mogą wyłudzać Twoje dane, czy przejmować sms-y i\u0026nbsp;wysyłać je bez Twojej zgody. Nową aplikację możesz pobrać jeśli Twoje urządzenie ma system operacyjny w\u0026nbsp;wersji minimum Android 10.0\u0026nbsp;lub iOS 18.0 (lub nowsze). Zapoznaj się z\u0026nbsp;polityką prywatności aplikacji mobilnych, kt\u0026oacute;rą znajdziesz na stronie:\u0026nbsp;\u003ca href=\"https://www.mbank.pl/o-nas/o-mbanku/polityka-prywatnosci-mobile.html\"\u003ehttps://www.mbank.pl/o-nas/o-mbanku/polityka-prywatnosci-mobile.html\u003c/a\u003e\u003c/p\u003e"},"productLabel":{"data":null}}}}},{"id":"38","title":"ubezpieczenia","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"ubezpieczenia","links":[{"label":"auta","url":"/indywidualny/ubezpieczenia/ubezpieczenia-samochodowe/oc-ac","alt":null},{"label":"podróży","url":"/indywidualny/ubezpieczenia/ubezpieczenia-turystyczne/ubezpieczenie-turystyczne-podrozne","alt":null},{"label":"życia i zdrowia","url":"/indywidualny/ubezpieczenia/ubezpieczenia-ochronne","alt":null},{"label":"karty debetowej","url":"/indywidualny/ubezpieczenia/ubezpieczenia-inne/concierge-intensive","alt":null}]},{"title":null,"links":[{"label":"nieruchomości","url":"/indywidualny/ubezpieczenia/ubezpieczenia-nieruchomosci/nieruchomosci","alt":null},{"label":"ubezpieczenia produktów kredytowych","url":"/indywidualny/ubezpieczenia/ubezpieczenia-kredytow","alt":null},{"label":"pytania i odpowiedzi ","url":"/indywidualny/ubezpieczenia/pytania-i-odpowiedzi/","alt":null}]}],"promoBox":{"data":{"id":"80","attributes":{"header":"ubezpieczenie NNW dla dziecka","ctaButton":{"text":"sprawdź","url":"/indywidualny/ubezpieczenia/ubezpieczenia-ochronne/ubezpieczenie-nnw-dziecko/?kampania=kafel_menu","alt":"informacje o ubezpieczeniu NNW dla dziecka","target":"self"},"isPromoted":true,"description":"\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003e40% zniżki\u003c/strong\u003e na ubezpieczenie NNW dla swojego dziecka\u003c/li\u003e\n\u003cli\u003ewsparcie finansowe, gdy dziecko trafi do szpitala, w następstwie choroby lub nieszczęśliwego wypadku\u003c/li\u003e\n\u003c/ul\u003e","tooltip":{"triggerText":"nota prawna","content":"\u003cp\u003eTo nie jest oferta. Ubezpieczycielem i organizatorem promocji jest UNIQA TU S.A z siedzibą w Warszawie, przy ul. Chłodnej 51. mBank S.A. jest agentem ubezpieczeniowym wpisanym do Rejestru Pośrednik\u0026oacute;w Ubezpieczeniowych pod numerem 11124813/A.\u003c/p\u003e\n\u003cp\u003ePromocja \u0026bdquo;Ochrona dla dzieci ze zniżką\u0026rdquo; obowiązuje od 12.08.2026 r. do 30.09.2026 r.\u003c/p\u003e\n\u003cp\u003ePromocja skierowana jest do Klient\u0026oacute;w mBanku S.A. posiadających rachunek rozliczeniowo-oszczędnościowy w mBanku S.A., kt\u0026oacute;rzy w okresie trwania promocji złożą wniosek o zawarcie Ubezpieczenia NNW dla dziecka.\u003c/p\u003e\n\u003cp\u003ePromocja polega na udzieleniu klientowi 40% Zniżki w składce.\u003c/p\u003e\n\u003cp\u003eZniżka przysługuje pod warunkiem wpisania na wniosku o zawarcie umowy ubezpieczenia w polu \u0026bdquo;Wybierz promo\u0026shy;cję\u0026rdquo; Kodu zniżkowego o treści \u0026bdquo;DZWONEK\u0026rdquo; lub podania tego kodu doradcy w przypadku składania wniosku o zawar\u0026shy;cie um\u0026oacute;w ubezpieczenia za pośrednictwem Call Center.\u003c/p\u003e\n\u003cp\u003e8,40 zł to miesięczna składka w wariacie podstawowym, przy sumie ubezpieczenia do 9 000 zł, po uwzględnieniu zniżki 40%. .\u003c/p\u003e\n\u003cp\u003eRegulamin promocji \u0026bdquo;Ochrona dla dzieci ze zniżką\u0026rdquo; w szczeg\u0026oacute;lności warunki promocji oraz wszystkie szczeg\u0026oacute;ły promocji i informacje o ubezpieczeniu w tym og\u0026oacute;lne warunki ubezpieczenia, znajdziesz na\u0026nbsp;\u0026nbsp;\u003ca href=\"https://www.mbank.pl/indywidualny/ubezpieczenia/ubezpieczenia-ochronne/strona-glowna/\"\u003ehttps://www.mbank.pl/indywidualny/ubezpieczenia/ubezpieczenia-ochronne/strona-glowna/\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eMaksymalna Suma Ubezpieczenia 300 tys. zł wynika z Og\u0026oacute;lnych Warunk\u0026oacute;w Ubezpieczenia na Życie \u0026ndash; indeks L/2025/06 w wariancie premium w przypadku śmierci. Maksymalna Suma Ubezpieczenia 150 tys. zł wynika z Og\u0026oacute;lnych Warunk\u0026oacute;w Ubezpieczenia następstw nieszczęśliwych wypadk\u0026oacute;w dla Ciebie i Partnera \u0026ndash; indeks NNW/2025/06 w wariancie premium w przypadku śmierci w następstwie nieszczęśliwego wypadku. Maksymalny limit świadczeń zwrotu koszt\u0026oacute;w lek\u0026oacute;w 2 razy, maks. 300 zł za zdarzenie, wynika z Og\u0026oacute;lnych Warunk\u0026oacute;w Ubezpieczenia następstw nieszczęśliwych wypadk\u0026oacute;w dla dziecka \u0026ndash; indeks NNWD/2025/06 w wariancie premium. Twoja indywidualna suma ubezpieczenia i składka może r\u0026oacute;żnić się od podanej w reklamie.\u003c/p\u003e\n\u003cp\u003eWyjaśnienia pojęć dotyczących usług reprezentatywnych powiązanych z rachunkiem płatniczym objętych tym materiałem znajdziesz na\u0026nbsp;\u003ca href=\"https://www.mbank.pl/slowniczek/\"\u003ehttps://www.mbank.pl/slowniczek\u003c/a\u003e\u003c/p\u003e"},"productLabel":{"data":null}}}}},{"id":"39","title":"usługi","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"usługi i e-urząd","links":[{"label":"świadczenia dla rodziców","url":"/indywidualny/uslugi/swiadczenia-dla-rodzicow/","alt":null},{"label":"e-urząd","url":"/indywidualny/uslugi/eurzad","alt":null},{"label":"tożsamość","url":"/indywidualny/uslugi/uslugi/tozsamosc/","alt":null},{"label":"usługi","url":"/indywidualny/uslugi/","alt":null},{"label":"płatności","url":"/indywidualny/uslugi/uslugi/platnosci/","alt":null},{"label":"pytania i odpowiedzi","url":"/indywidualny/uslugi/pytania-i-odpowiedzi/","alt":null}]},{"title":"okazje zakupowe","links":[{"label":"mOkazje ","url":"/indywidualny/uslugi/mokazje/mokazje/","alt":null},{"label":"mZakupy","url":"/indywidualny/uslugi/mokazje/mokazje-zakupy/","alt":null}]}],"promoBox":{"data":{"id":"5","attributes":{"header":"mZakupy","ctaButton":{"text":"sprawdź","url":"/indywidualny/uslugi/mokazje/mokazje-zakupy/?kampania=rkzmOz_2_promobox","alt":"informacje o mokazje zakupy","target":"self"},"isPromoted":false,"description":"\u003cul\u003e\n\u003cli\u003eprzeglądaj i zamawiaj produkty w aplikacji mBanku\u003c/li\u003e\n\u003cli\u003epłać bezpiecznie za zam\u0026oacute;wienia przelewem z konta lub karty kredytowej\u003c/li\u003e\n\u003c/ul\u003e","tooltip":{"triggerText":"nota prawna","content":"To nie jest oferta.  \n \nW ramach mOkazji zakupy (zwanych także mZakupami) zamówisz w aplikacji mobilnej produkty od Morele.net lub przedsiębiorców współpracujących z Morele.net oraz zapłacisz za nie produktami mBanku, które oferujemy w naszej aplikacji. mZakupy dostępne są w ramach Programu mOkazje. Program prowadzi mBank S.A. Szczegółowe informacje dotyczące mZakupów określa Regulamin programu mOkazje dostępny na: https://www.mbank.pl/pomoc/dokumenty/oferta-indywidualna/konta/mokazje/.   \n \nZa sprzedaż produktów i usług w ramach mZakupów oraz obsługę posprzedażową odpowiada Morele.net. Sp. z o.o. lub przedsiębiorca współpracujący z Morele.net. \nZgodnie z Regulaminem Sklepu Internetowego Morele.net dla Uczestników Programu mOkazje dostępnym na: https://www.morele.net/pokaz_pomoc/1375/   \n \nPamiętaj, że mBank udostępnia swoją aplikację tylko w autoryzowanych sklepach - App Store (iOS - Apple), Google Play (Android). Pobieraj, instaluj i aktualizuj aplikacją tylko w tych sklepach, ponieważ znajdujące się tam aplikacje są cyfrowo podpisane i przechodzą proces weryfikacji, pod kątem ich bezpieczeństwa. Nigdy nie pobieraj aplikacji z innych miejsc niż oficjalne sklepy (np. z linka otrzymanego sms-em czy przez komunikator) – narazisz się na pobranie złośliwej aplikacji, przez którą oszuści mogą wyłudzać Twoje dane, czy przejmować sms-y i wysyłać je bez Twojej zgody. Nową aplikację możesz pobrać jeśli Twoje urządzenie ma system operacyjny w wersji minimum Android 9.0 lub iOS 16.0 (lub nowsze). Zapoznaj się z polityką prywatności aplikacji mobilnych, którą znajdziesz na stronie: https://www.mbank.pl/o-nas/o-mbanku/polityka-prywatnosci-mobile/   \n \nWyjaśnienia pojęć dotyczących usług reprezentatywnych powiązanych z rachunkiem płatniczym objętych tym materiałem znajdziesz na https://www.mbank.pl/indywidualny/uslugi/uslugi/slowniczek-pojec/  "},"productLabel":{"data":null}}}}},{"id":"18","title":"aplikacja i serwis","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"aplikacja i serwis","links":[{"label":"pierwsze kroki","url":"/indywidualny/aplikacja-i-serwis/pierwsze-kroki","alt":null},{"label":"funkcje bezpieczeństwa","url":"/indywidualny/aplikacja-i-serwis/funkcje-bezpieczenstwa","alt":null},{"label":"płatności","url":"/indywidualny/aplikacja-i-serwis/platnosci/","alt":null},{"label":"finanse","url":"/indywidualny/aplikacja-i-serwis/finanse/","alt":null},{"label":"produkty","url":"/indywidualny/aplikacja-i-serwis/produkty/","alt":null},{"label":"usługi","url":"/indywidualny/aplikacja-i-serwis/dodatkowe-uslugi/","alt":null},{"label":"pytania i odpowiedzi","url":"/indywidualny/aplikacja-i-serwis/pytania-i-odpowiedzi","alt":null}]}],"promoBox":{"data":{"id":"6","attributes":{"header":"pobierz aplikację","ctaButton":{"text":"sprawdź","url":"/indywidualny/aplikacja-i-serwis/o-aplikacji/","alt":"informacje o aplikacji","target":"self"},"isPromoted":false,"description":"\u003cp\u003ePoznaj możliwości i funkcje naszej aplikacji mobilnej.\u003c/p\u003e","tooltip":null,"productLabel":{"data":null}}}}},{"id":"40","title":"zdrowe finanse","sectionUrl":null,"sectionAlt":null,"columns":[{"title":"zdrowe finanse","links":[{"label":"zdrowe finanse","url":"/indywidualny/zdrowe-finanse/","alt":null},{"label":"porwani przez ekonomię","url":"/lp/porwani-przez-ekonomie/","alt":null}]}],"promoBox":{"data":null}}]}}},"footer":{"__typename":"FooterEntityResponse","data":{"attributes":{"name":"mass-sme-private","topFooter":[{"id":"7","icon":{"iconName":"MobilePhone"},"label":"aplikacja mobilna","url":"/indywidualny/aplikacja-i-serwis/o-aplikacji","target":"self","alt":null},{"id":"9","icon":{"iconName":"ShieldTick"},"label":"bezpieczeństwo","url":"/bezpieczenstwo","target":"self","alt":null},{"id":"8","icon":{"iconName":"NewsPaper"},"label":"blog","url":"/artykuly/","target":"self","alt":null},{"id":"10","icon":{"icon