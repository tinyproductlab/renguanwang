			<style>
		* {
			box-sizing: border-box;
		}
		html {
			height: 100%;
			line-height: 1.15;
			text-size-adjust: 100%;
			font-family: 'SourceSansPro', Arial, sans-serif;
		}
		body {
			height: 100%;
			margin: 0;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}
		#root {
			height: 100%;
		}
		main {
			display: block;
		}
		h1 {
			font-size: 2em;
			margin: 0.67em 0;
		}
		hr {
			box-sizing: content-box;
			height: 0;
			overflow: visible;
		}
		pre {
			font-family: monospace;
			font-size: 1em;
		}
		a {
			background-color: transparent;
		}
		abbr[title] {
			border-bottom: none;
			text-decoration: underline;
			text-decoration: underline dotted;
		}
		b,
		strong {
			font-weight: bolder;
		}
		code,
		kbd,
		samp {
			font-family: monospace;
			font-size: 1em;
		}
		small {
			font-size: 80%;
		}
		sub,
		sup {
			font-size: 75%;
			line-height: 0;
			position: relative;
			vertical-align: baseline;
		}
		sub {
			bottom: -0.25em;
		}
		sup {
			top: -0.5em;
		}
		img {
			border-style: none;
		}
		button,
		input,
		optgroup,
		select,
		textarea {
			font-family: inherit;
			font-size: 100%;
			line-height: 1.15;
			margin: 0;
		}
		button,
		input {
			overflow: visible;
		}
		button,
		select {
			text-transform: none;
		}
		button,
		[type='button'],
		[type='reset'],
		[type='submit'] {
			appearance: button;
		}
		button::-moz-focus-inner,
		[type='button']::-moz-focus-inner,
		[type='reset']::-moz-focus-inner,
		[type='submit']::-moz-focus-inner {
			border-style: none;
			padding: 0;
		}
		button:-moz-focusring,
		[type='button']:-moz-focusring,
		[type='reset']:-moz-focusring,
		[type='submit']:-moz-focusring {
			outline: 1px dotted ButtonText;
		}
		fieldset {
			padding: 0.35em 0.75em 0.625em;
		}
		legend {
			box-sizing: border-box;
			color: inherit;
			display: table;
			max-width: 100%;
			padding: 0;
			white-space: normal;
		}
		progress {
			vertical-align: baseline;
		}
		textarea {
			overflow: auto;
		}
		[type='checkbox'],
		[type='radio'] {
			box-sizing: border-box;
			padding: 0;
		}
		[type='number']::-webkit-inner-spin-button,
		[type='number']::-webkit-outer-spin-button {
			height: auto;
		}
		[type='search'] {
			appearance: textfield;
			outline-offset: -2px;
		}
		[type='search']::-webkit-search-decoration {
			appearance: none;
		}
		::-webkit-file-upload-button {
			appearance: button;
			font: inherit;
		}
		details {
			display: block;
		}
		summary {
			display: list-item;
		}
		template {
			display: none;
		}
		[hidden] {
			display: none;
		}
	
		/* Regular - 400 */
		@font-face {
			font-family: SourceSansPro;
			font-weight: 400;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/SourceSansPro-Regular.woff2*/ url(data:font/woff2;base64,) format('woff2'),
				/*savepage-url=/public/fonts/SourceSansPro-Regular.woff*/ url(data:font/woff;base64,) format('woff');
		}
	
		/* Semibold - 600 */
		@font-face {
			font-family: SourceSansPro;
			font-weight: 600;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/SourceSansPro-Semibold.woff2*/ url(data:font/woff2;base64,) format('woff2'),
				/*savepage-url=/public/fonts/SourceSansPro-Semibold.woff*/ url(data:font/woff;base64,) format('woff');
		}
	
		/* Bold - 700 */
		@font-face {
			font-family: SourceSansPro;
			font-weight: 700;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/SourceSansPro-Bold.woff2*/ url(data:font/woff2;base64,) format('woff2'),
				/*savepage-url=/public/fonts/SourceSansPro-Bold.woff*/ url(data:font/woff;base64,) format('woff');
		}
	
		/* Regular - 400 */
		@font-face {
			font-family: MMHeadline;
			font-weight: 400;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/MMHeadlineProWebTT-Regular_subset.woff2*/ url(data:font/woff2;base64,) format('woff2'),
				/*savepage-url=/public/fonts/MMHeadlineProWebTT-Regular_subset.woff*/ url(data:font/woff;base64,) format('woff');
		}
	
		@font-face {
			font-family: SEHeadline;
			font-weight: 400;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/EurostileNextLTPro-Bold.woff2*/ url() format('woff2'),
				/*savepage-url=/public/fonts/EurostileNextLTPro-Bold.woff*/ url() format('woff');
		}
	
		/* Regular - 400 */
		@font-face {
			font-family: MMPrice;
			font-weight: 400;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/MediaMarktPreise.woff2*/ url() format('woff2'),
				/*savepage-url=/public/fonts/MediaMarktPreise.woff*/ url() format('woff');
		}
	
		@font-face {
			font-family: Calibri;
			font-weight: bold;
			font-style: normal;
			/*savepage-font-display=swap*/
			src:
				/*savepage-url=/public/fonts/Calibri-Bold-subset.woff2*/ url() format('woff2'),
				/*savepage-url=/public/fonts/Calibri-Bold-subset.woff*/ url() format('woff');
		}
	
