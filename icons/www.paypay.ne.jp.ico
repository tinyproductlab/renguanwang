<div class="contents">
  <div class="mainVisual">
    <div class="mainVisual__background">
      <img src="/wp-content/uploads/top/img_top_mv_18.png" alt="" class="mainVisual__image">
    </div>
    <div class="mainVisual__inner">
      <h1 class="mainVisual__title">スマホひとつで<br>かんたんに<br>お支払いはPayPayで</h1>

    </div>
  </div>
  <!-- /mainVisual -->

  <div class="download appView--hide">
    <div class="download__container">
      <div class="download__wrapper">
        <p class="download__text">いますぐ<span class="download__text--emphasis">PayPayアプリ</span>をダウンロード<span class="download__text--emphasis switch__display--pc"> ＞＞</span></p>
        <div class="download__contents">
          <p class="download__device userDevice--ios">
            <a class="download__link" href="https://apps.apple.com/jp/app/id1435783608?mt=8" data-eventcategory="website" data-eventaction="appbanner_ios_clicked" data-eventlabel="download">
              <img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/common/images/btn_appstore_01.png" alt="App Store からダウンロード" class="download__image lazyload">
            </a>
          </p>
          <p class="download__device userDevice--android">
            <a class="download__link" href="https://play.google.com/store/apps/details?id=jp.ne.paypay.android.app" data-eventcategory="website" data-eventaction="appbanner_android_clicked" data-eventlabel="download">
              <img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/common/images/img_googleplay_01.png" alt="Google Play で手に入れよう" class="download__image lazyload">
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
  <!-- /download -->

  
    <section class="campaign--top">
    <div class="campaign__inner">
      <div class="campaign__banner campaignBanner--top">
        <ul class="campaignBanner__list--center">
                              <li class="campaignBanner__item">
            <a href="https://paypay.ne.jp/guide/coupon/" data-eventcategory="website" data-eventaction="guide_coupon_clicked" data-eventlabel="campaignBanner"  class="campaignBanner__link">
              <img src="https://paypay.ne.jp/uploads/2023/04/bnr_top_paypay-coupon_02.png" alt="有名店やお近くのお店で使える！毎週更新 おトク！PayPayクーポン" class="campaignBanner__image">            </a>
          </li>
                              <li class="campaignBanner__item">
            <a href="https://paypay.ne.jp/event/youth-20260303/" data-eventcategory="website" data-eventaction="event_youth-20260303_clicked" data-eventlabel="campaignBanner"  class="campaignBanner__link">
              <img src="https://paypay.ne.jp/uploads/top/bnr_top_youth-20260303_01.png" alt="12〜18歳対象！おトクなキャンペーン開催中 ※条件・上限あり" class="campaignBanner__image">            </a>
          </li>
                              <li class="campaignBanner__item">
            <a href="https://paypay.ne.jp/event/referral/" data-eventcategory="website" data-eventaction="event_referral_clicked" data-eventlabel="campaignBanner"  class="campaignBanner__link">
              <img src="https://paypay.ne.jp/uploads/top/bnr_top_referral-program_20260529_01.png" alt="家族や知り合いにPayPayを紹介しよう！紹介した人紹介された人どちらも最大300ptもらえる※条件・上限あり" class="campaignBanner__image">            </a>
          </li>
                              <li class="campaignBanner__item">
            <a href="/start/" data-eventcategory="website" data-eventaction="start_clicked" data-eventlabel="campaignBanner"  class="campaignBanner__link">
              <img src="https://paypay.ne.jp/uploads/cp-banner/bnr_top_start_01.png" alt="アカウント登録・お金のチャージ方法・お店での支払い方などを紹介します。" class="campaignBanner__image">            </a>
          </li>
                  </ul>
      </div>
    </div><!-- /campaign__inner -->
  </section>
  <!-- /campaign -->
  
	<section id="service" class="foreword">
		<div class="foreword__inner">
			<h2 class="foreword__title switch"><span class="foreword__title--highlight">PayPay</span>って<br class="switch__display--sp">どんなサービス？</h2>
			<!-- アニメーション-->
			<div class="foreword__animation animation--scale">
				<!-- 吹き出し -->
				<div class="animation__circle--balloon forewordAnimation--balloon">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_forewordIllust_04.png" alt="" class="animation__image lazyload">
				</div>
				<!-- 人物イラスト -->
				<div class="animation__circle--illust forewordAnimation--illust">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_forewordIllust_03.png" alt="" class="animation__image lazyload">
				</div>
				<!-- 左側 -->
				<div class="animation__circle--pink forewordAnimation--pinkLeft"></div>
				<div class="animation__circle--solid forewordAnimation--solid"></div>
				<div class="animation__circle--yellow forewordAnimation--yellow"></div>
				<div class="animation__circle--dots forewordAnimation--dotsLeft">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_dots_02.png" alt="" class="animation__image--rotate lazyload">
				</div>
				<!-- 右側 -->
				<div class="animation__circle--dots forewordAnimation--dotsRight">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_dots_02.png" alt="" class="animation__image--rotate lazyload">
				</div>
				<div class="animation__circle--orange forewordAnimation--orange"></div>
				<div class="animation__circle--pink forewordAnimation--pinkRight"></div>
				<div class="animation__circle--red forewordAnimation--red"></div>
			</div>
			<!-- /アニメーション-->
		</div>
		<div class="foreword__scroll">
			<p class="foreword__text">SCROLL</p>
			<div class="foreword__arrow">
				<a href="#about" class="foreword__button" data-eventcategory="website" data-eventaction="scroll_clicked" data-eventlabel="service">
					<span class="foreword__text--hide">SCROLL</span>
					<span class="foreword__icon animationTarget--float">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/ico_arrow_02.png" alt="" class="foreword__image lazyload">
					</span>
				</a>
			</div>
		</div>
	</section>
	<!-- /foreword -->

	<section id="about" class="about">
		<div class="about__inner">
			<h2 class="about__title switch">スマホひとつで<br class="switch__display--sp">お支払い</h2>
			<p class="about__text switch">おサイフを持ち歩かなくても、<br class="switch__display--sp">スマホひとつで<br class="switch__display--sp">簡単・スマートにお支払いができます</p>
			<ul class="about__list animation--fadein">
				<li class="about__item">
					<div class="about__canvas">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_about_03.png" alt="" class="about__image lazyload">
					</div>
					<p class="about__caption">バーコードを見せる</p>
				</li>
				<li class="about__item">
					<div class="about__canvas">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_about_04.png" alt="" class="about__image lazyload">
					</div>
					<p class="about__caption">QRコードを読み取る</p>
				</li>
			</ul>
			<!-- <p class="about__transition mainButton">
				<a href="https://paypay.ne.jp/start/" class="mainButton__button" data-eventcategory="website" data-eventaction="start_btn_upper_clicked" data-eventlabel="about">PayPayの始め方</a>
			</p> -->
			<div class="about__noteContents noteContents">
				<p class="noteContents__note">ご利用の際に、お支払い情報の登録が必要です。</p>
				<p class="noteContents__note">ご利用の際に、通信量に応じたパケット通信料金が発生します。</p>
			</div>
		</div><!-- /about__inner -->
	</section>
	<!-- /about -->

	<section class="charge">
		<div class="charge__inner switch">
			<!-- PCのみ：アニメーション-->
			<div class="charge__animation animation--scale switch__display--pc">
				<div class="animation__circle--border chargeAnimation--border"></div>
				<div class="animation__circle--large chargeAnimation--large"></div>
				<!-- 上部 -->
				<div class="animation__circle--solid chargeAnimation--solid"></div>
				<div class="animation__circle--pink chargeAnimation--pinkTop"></div>
				<div class="animation__circle--dots chargeAnimation--dotsTop">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_dots_02.png" alt="" class="animation__image--rotate lazyload">
				</div>
				<!-- 下部 -->
				<div class="animation__circle--dots chargeAnimation--dotsBottom">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_dots_02.png" alt="" class="animation__image--rotate lazyload">
				</div>
				<div class="animation__circle--pink chargeAnimation--pinkBottom"></div>
				<!-- 人物イラスト -->
				<div class="animation__circle--woman chargeAnimation--woman">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_chargeIllust_03.png" alt="" class="animation__image lazyload">
				</div>
				<div class="animation__circle--man chargeAnimation--man">
					<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_chargeIllust_04.png" alt="" class="animation__image lazyload">
				</div>
			</div>
			<!-- /PCのみ：アニメーション-->
			<div class="charge__contents">
				<h2 class="charge__title"><span class="charge__lead">登録は無料！最短1分</span>お支払い方法も<br class="switch__display--sp">選べます</h2>
				<p class="charge__text">ご利用の登録は簡単な操作で<br class="switch__display--sp">最短1分で完了！<br>お支払い、チャージ方法も豊富です</p>
				<!-- SPのみ：アニメーション-->
				<div class="charge__animation animation--scale switch__display--sp">
					<div class="animation__circle--border chargeAnimation--border"></div>
					<div class="animation__circle--large chargeAnimation--large"></div>
					<!-- 上部 -->
					<div class="animation__circle--solid chargeAnimation--solid"></div>
					<div class="animation__circle--pink chargeAnimation--pinkTop"></div>
					<div class="animation__circle--dots chargeAnimation--dotsTop">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_dots_02.png" alt="" class="animation__image--rotate lazyload">
					</div>
					<!-- 下部 -->
					<div class="animation__circle--dots chargeAnimation--dotsBottom">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_dots_02.png" alt="" class="animation__image--rotate lazyload">
					</div>
					<div class="animation__circle--pink chargeAnimation--pinkBottom"></div>
					<!-- 人物イラスト -->
					<div class="animation__circle--woman chargeAnimation--woman">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_chargeIllust_03.png" alt="" class="animation__image lazyload">
					</div>
					<div class="animation__circle--man chargeAnimation--man">
						<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_chargeIllust_04.png" alt="" class="animation__image lazyload">
					</div>
				</div>
				<!-- /SPのみ：アニメーション-->
				<ul class="charge__list animation--fadein">
					<li class="charge__item">
						<a href="https://paypay.ne.jp/guide/bank/" class="charge__link" data-eventcategory="website" data-eventaction="guide_bank_clicked" data-eventlabel="charge">
							<div class="charge__canvas">
								<img src="https://image.paypay.ne.jp/page/s.gif" data-original="https://image.paypay.ne.jp/page/top/images/img_charge_01.png" alt="" class="charge__image lazyload">
							</div>
							<p class="charge__caption">銀行口座</p>
						</a>
					</li>
					<li class="charge__item">
						<a href="https://paypay.ne.jp/guide/paypay-card/" class="charge__link" data-eventcategory="website" data-eventaction="guide_paypay-card_clicked" data-eventlabel="charge">
							<div class="charge__canvas--credit">
								<img src="https://image.paypay.ne.jp/page/s.gif" data-original="/wp-content/uploads/top/img_paypay-card_01.png" alt="" class="charge__image lazyload">
							</div>
