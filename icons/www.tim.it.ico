<!--Modal Search-->




<div class="to-overlaysearch" id="searchOverlay">

    <div class="to-overlaysearch__wrapper">

        <div class="to-overlaysearch__header">
            <div class="tm-overlayheader tm-overlayheader--theme-light">

                <div class="tm-overlayheader__logo">
                    <a href="https://www.tim.it" target="_self"><img class="ta-image -logo" src="//risorsec.tim.it/content/dam/flytoco-areapubblica-aemfe/tim_it/img/temi/2025/logo-white.svg" alt="TIM"/></a>
                </div>

                <div class="tm-overlayheader__close">
                    <button onclick="SearchController.searchClose()" type="button" class="tm-overlayheader__closebtt" aria-label="Close"><svg class="ta-icon-svg ta-icon-svg__close-big" viewBox="0 0 24 24"><use xlink:href="#close-big"></use></svg></button>
                </div>

            </div>
            <div class="to-overlaysearch__search tl-col-6">
                <form action="javascript:void(0)" class="tm-search-form" autocomplete="off" onsubmit="SearchController.search(); return false;">

                    <input type="search" placeholder="Cosa stai cercando?" class="tm-search-form__input hide-placeholder-onfocus" id="_search-box_"/>

                    <div class="tm-search-form__reset" onclick="SearchController.search()">
                        <button type="reset" class="tm-search-form__resetbtt" aria-label="Reset search">
                            <svg class="ta-icon-svg ta-icon-svg__search" viewBox="0 0 24 24"><use xlink:href="#search"></use></svg>
                            <svg class="ta-icon-svg ta-icon-svg__close-search" viewBox="0 0 24 24"><use xlink:href="#close-search"></use></svg>
                        </button>
                    </div>
                    <div class="tm-search-form__submit">
                        <button id="_submit-search_" type="submit" class="tm-search-form__submitbtt" aria-label="Submit search">
                            CERCA
                            <svg class="ta-icon-svg ta-icon-svg__search" viewBox="0 0 24 24"><use xlink:href="#search"></use></svg>
                        </button>
                    </div>

                    <button class="ta-button -annulla" type="button">

                        <span class="ta-button__txt">Annulla</span>


                    </button>

                </form>

                


                <p class="to-overlaysearch__noresults" id="_no-result_">
                    <b>Nessun risultato trovato</b><br/> Controlla il testo inserito o utilizza i suggerimenti che trovi qui in basso
                </p>
            </div>
        </div>
        <div class="tm-search-autocomplete" id="_search-autocomplete_">
            <!-- _search-autocomplete_ -->
        </div>

        <div class="to-overlaysearch__body -first-search" id="to-overlaysearch-top">

            <div class="to-overlaysearch__result tl-col-8" id="_vai-alla-sezione_">
                <a class="ta-link -sectionlink" href="#" target="_self" id="">
                    <span class="ta-link__label">Ricerche suggerite</span>
                    <span class="ta-link__icon"><svg class="ta-icon-svg ta-icon-svg__chevron-right" viewBox="0 0 24 24"><use xlink:href="#chevron-right"></use></svg></span>
                </a>
            </div>
            <div class="to-overlaysearch__result tl-col-8" id="_search-ricerche-suggerite_">
                <h3 class="to-overlaysearch__subtitle">RICERCHE SUGGERITE</h3>
                <ul class="to-overlaysearch__list">
                    <li>
                        <a class="ta-link -blue -icon_search -underline-hover" href="#" target="_self">
                            <span class="ta-link__icon">
                                <svg class="ta-icon-svg ta-icon-svg__search" viewBox="0 0 24 24"><use xlink:href="#search"></use></svg>
                            </span>
                            <span class="ta-link__label">Link testuale</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="to-overlaysearch__result tl-col-8" style="padding-bottom: 0" id="_search-results-suggeriti_">
                <h3 class="to-overlaysearch__subtitle">RISULTATI SUGGERITI</h3>
            </div>
            <div class="to-overlaysearch__result tl-col-8" id="_search-results_">

            </div>
            <p class="to-overlaysearch__moreresult" id="_ulteriori_risultati_">
                <a href="javascript:void(0)" class="ta-link -black" target="_self" onclick="SearchController.nextPage()">
                    Mostra altri risultati
                </a>
            </p>
        </div>

        <p class="to-overlaysearch__backtotop" id="_back-to-top_">
            <a class="ta-button -primary -backtotop" href="#to-overlaysearch-top" target="_self" aria-label="Back to top">
    <span class="ta-button__icon">
      <svg class="ta-icon-svg ta-icon-svg__back-to-top" viewBox="0 0 24 24"><use xlink:href="#back-to-top"></use></svg>
    </span>
</a>

        </p>
    </div>
</div>
<script id="_search-result_" type="text/x-handlebars-template">
    <div class="tm-search-result">

        {{#if searchEngineMetadata_thumbnail_s}}
            <div class="tm-search-result__image">
                <img src="{{cdnBaseUrl}}{{searchEngineMetadata_thumbnail_s}}" alt="{{searchEngineMetadata_titolo_s}}" />
            </div>
        {{/if}}

        <div class="tm-search-result__content">
            <div class="tm-search-result__tags">
            </div>
            <h2 class="tm-search-result__title">
                {{searchEngineMetadata_titolo_s}}
            </h2>

            <p class="tm-search-result__paragraph">
                {{searchEngineMetadata_descrizione_s}}
            </p>

