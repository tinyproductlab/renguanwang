    <!-- Adform Tracking Code BEGIN -->
    



    <script type="text/javascript">
        var pm = parseInt("307530");
    </script>

    <script type="text/javascript" src="https://track.adform.net/serving/scripts/trackpoint/" onload="window.onAdFormLoad ? onAdFormLoad() : ''"></script>

    <script type="text/javascript">
        window.disableGetAdFormParameters = false;
        window.enableAdFormTrackForHash = '';
    </script>



    <script type="text/javascript">
        var sessionExpirationTime = 1440;
    </script>


<script>
    window.disableGetAdFormParametersCDP = false;
</script>

    




    <script type="text/javascript">
        var isAdformDisabled = false || false || false || false;

        function trueHashFooter() {
            if(window.location.hash){
                if(window.location.hash.indexOf('#/') == 0 || window.location.hash.indexOf("=") > -1) {
                    return '';
                }else{
                    return window.location.hash;
                }
            }else{
                return '';
            }
        }

        function setOmnitureUser(sv5,tiid) {
            var versionRegex = new RegExp("\\/v(\\d+)\\/");
            var version = window.getAdFormParametersVersion.match(versionRegex);
            if(version && version[1] && parseInt(version[1])> 1 && window.digitalData){
                console.log("ADFORM PARAMETERS VERSION", version[1]);
                if(!digitalData.user){
                    digitalData["user"]={}
                }

                if(sv5 && sv5 != ''){
                    digitalData.user["cli"] = sv5;
                }

                if(tiid && tiid != ''){
                    digitalData.user["tiid"] = tiid;
                }
            }
        }

        function setDataLayerCDP(response) {
            if (!window.zeoTapDataLayer) {
                window.zeoTapDataLayer = {};
            }
            window.zeoTapDataLayer.pageName = window.currentPageTitle;

            if(response){
                if(response.sv58){
                    window.zeoTapDataLayer.ip = response.sv58;
                }
                if(response.navigationLineCDP){
                    window.zeoTapDataLayer.navigationLineCDP = response.navigationLineCDP;
                }
            }
        }

        if ((!window.disableGetAdFormParameters && window.disableGetAdFormParameters == false) || (!window.disableGetAdFormParametersCDP && window.disableGetAdFormParametersCDP == false)) {
            var orderForAdFormFooter = {};
            var dateNew = window.performance.now();

            var diffMs = Math.abs(dateNew - window.sessionStorage.getItem('dateForAdFormParameters'));
            var minutes = Math.floor(((diffMs % 86400000) %  3600000) / 60000);
            var diffMinutesTime = minutes ? minutes : 0;

            if (!window.sessionStorage.getItem('dateForAdFormParameters') || diffMinutesTime >= sessionExpirationTime) {
                getOrderIp2CliFooter(dateNew);
            } else {
                getAdFormSessionStorageItemFooter();
            }

        } else {
            if(!isAdformDisabled){
                if(window.getAdFormLocation){
                    trackPage(pm, getAdFormLocation(window.enableAdFormTrackForHash) );
                }else{
                    console.warn("getAdFormLocation not found");
                }
            }
        }

        function getAdFormLocation(hashParameter) {
            var adFormLocation = window.location.protocol + '//' + window.location.hostname + (window.location.port ? ":" + window.location.port : "") + window.location.pathname;
            if(hashParameter && hashParameter !== '' && window.location.hash.indexOf("#"+hashParameter) === 0){
                return adFormLocation = encodeURIComponent(adFormLocation + window.location.hash);
            }
            return adFormLocation;
        }

        function trackPage(pm, location, order) {
            window._adftrack = Array.isArray(window._adftrack) ? window._adftrack : (window._adftrack ? [window._adftrack] : []);
            if (order) {
                window._adftrack.push({
                    pm: pm,
                    divider: encodeURIComponent('|'),
                    pagename: encodeURIComponent(location),
                    order: order
                });
            } else {
                window._adftrack.push({
                    pm: pm,
                    divider: encodeURIComponent('|'),
                    pagename: encodeURIComponent(location)
                });
            }
            (function () { var s = document.createElement('script'); s.type = 'text/javascript'; s.async = true; s.src = 'https://track.adform.net/serving/scripts/trackpoint/async/'; var x = document.getElementsByTagName('script')[0]; x.parentNode.insertBefore(s, x); })();
            console.log("AdForm Tracciamento pagina: ", getAdFormLocation(window.enableAdFormTrackForHash) )
        }

        function getAdFormSessionStorageItemFooter () {
            var adFormParameters = window.sessionStorage.getItem('AdFormParameters');
            if(window.getAdFormLocation) {
                if (adFormParameters) {
                    adFormParameters = JSON.parse(adFormParameters);
                    if(!isAdformDisabled){
                        setOmnitureUser(adFormParameters.sv5, adFormParameters.tiid);
                        trackPage(pm, getAdFormLocation(window.enableAdFormTrackForHash), adFormParameters);
                    }

                    if(!window.disableGetAdFormParametersCDP){
                        setDataLayerCDP(adFormParameters);
                        trackZeoTapPage();
                    }
                } else {
                    if(!isAdformDisabled){
                        trackPage(pm, getAdFormLocation(window.enableAdFormTrackForHash));
                    }
                }
            }else{
                console.warn("getAdFormLocation not found");
            }
        }

        
        
        function whenSatelliteReady(callback, timeoutMs, intervalMs) {
            const start = Date.now();
            let attempts = 0;
            let maxAttempts = Math.ceil(timeoutMs / intervalMs);
            (function check() {
                if (window._satellite && typeof window._satellite.track === "function") {
                    callback(window._satellite);
                    return;
                }

                attempts++;
                console.log("ZeoTapPageLoad - Waiting for _satellite to be ready... Attempt number", attempts);
                const timedOut = (Date.now() - start) >= timeoutMs;
                const attemptsExceeded = attempts >= maxAttempts;

                if (timedOut || attemptsExceeded) {
                    console.warn(`ZeoTapPageLoad - Launch non available - Skip`);
                    return;
                }

                setTimeout(check, intervalMs);
            })();
        }


        function trackZeoTapPage() {
            whenSatelliteReady(function (_satellite) {               
                _satellite.track("zeotap_pageLoad");    
                console.log("ZeoTapPageLoad track with zeoTapDataLayer pagename: ", window.zeoTapDataLayer.pageName);         
            }, 1000, 200 );
        }

        function getOrderIp2CliFooter (dateNew) {
            var responseObservable = Ip2CliService.getAdFormParameters();
            responseObservable.subscribe({
                next:function(response){
                    if(response){
                        window.sessionStorage.setItem('dateForAdFormParameters', dateNew);
                        orderForAdFormFooter = getMappedParameters(response.response);

                        window.sessionStorage.setItem('AdFormParameters', JSON.stringify(orderForAdFormFooter));
                        if(!isAdformDisabled){
                            setOmnitureUser(orderForAdFormFooter.sv5, orderForAdFormFooter.tiid);
                            if(window.getAdFormLocation) {
                                trackPage(pm, getAdFormLocation(window.enableAdFormTrackForHash), orderForAdFormFooter);
                            }else{
                                console.warn("getAdFormLocation not found");
                            }
                        }

                        if(!window.disableGetAdFormParametersCDP){
                            setDataLayerCDP(orderForAdFormFooter);
                            trackZeoTapPage();
                        }
                    }
                },error: function(response) {
                    console.log('Error Ip2CliService');

                    if(!window.disableGetAdFormParametersCDP){
                        setDataLayerCDP();
                        trackZeoTapPage();                          
                    }
                    if(!isAdformDisabled){
                        if(window.getAdFormLocation){
                            trackPage(pm, getAdFormLocation(window.enableAdFormTrackForHash));
                        }else{
                            console.warn("getAdFormLocation not found");
                        }
                    }
                }
            });
        }

    </script>
    <noscript>
        <p style="margin:0;padding:0;border:0;">
            <img id="noScriptTAG" src="https://track.adform.net/Serving/TrackPoint/?pm=307530&ADFPageName=WebsiteName|SectionName|SubSection|PageName&ADFdivider=|" width="1" height="1" alt=""/>
        </p>
    </noscript>
    <script>
        if(document.getElementById("noScriptTAG")){
            document.getElementById("noScriptTAG").src = "https://track.adform.net/Serving/TrackPoint/?pm="+pm+"&ADFPageName="+getAdFormLocation(window.enableAdFormTrackForHash) +"&ADFdivider=|";
        }
    </script>




