<main id="main" class="main">
    <section class="m06 module-padding">
        <style>
            .m06__search-facility {
                background: #008755 url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M11.9576 11.0171L15.8041 14.8637C16.0653 15.1216 16.0653 15.5461 15.8041 15.8041C15.5429 16.0653 15.1216 16.0653 14.8604 15.8041L11.0139 11.9608C9.85143 12.9143 8.36572 13.4857 6.74286 13.4857C3.01714 13.4857 0 10.4653 0 6.74286C0 3.02041 3.01714 0 6.74286 0C10.4653 0 13.4857 3.02041 13.4857 6.74286C13.4857 8.36572 12.911 9.8547 11.9576 11.0171ZM1.33876 6.74295C1.33876 9.72091 3.76162 12.1438 6.74284 12.1438C9.7208 12.1438 12.1469 9.72091 12.1469 6.74295C12.1469 3.76499 9.7208 1.33887 6.74284 1.33887C3.76162 1.33887 1.33876 3.76499 1.33876 6.74295Z' fill='white'/%3E%3C/svg%3E%0A") no-repeat center center;
                position: absolute;
                right: 2rem;
                top: 50%;
                transform: translateY(-50%);
                width: 3.6rem;
                height: 3.6rem;
                border-radius: 5px;
                transition: background-color 0.5s;
            }
            .m06__search-error {
                color: #D22630;
                margin-top: 0.25rem; 
                display: block; 
                min-height:25px;
            }
            .m06__card__img-exempt {
                width: 100%;
                aspect-ratio: 69 / 43;
                
            }
            @media only screen and (min-width: 768px) {
                .m06__card__img-exempt {
                    max-width: calc(50% - 2rem);
                    width: 100%;
                    aspect-ratio: 565 / 352;
                }
            }
        </style>
        <div class="m06__card m06__card--right">
            <img class="m06__card__img-exempt" src="/fe-build/images/errors/404.jpg" alt="404 not found" />
            <div class="m06__card__text">
                <h1 class="m06__card__heading">Ooops 404</h1>
                <p class="m06__card__para">
                    We couldn't find the page you were looking for but our <a href="/Search">site search</a>&nbsp;may help you find it.
                </p>
                <div class="form__group js-slideup search-form form__group__focused">
                    <div id="searchError" 
                        class="m06__search-error"
                        tabindex="-1">
                    </div>
                    <div class="form__group__wrapper">
                        <label for="searchInput">Search anpost.com</label>
                        <input type="text" 
                            id="searchInput" 
                            name="search"
                            data-required-message="This field is required"
                            value="">
                        <button type="submit" 
                            id="searchButton"
                            class="m06__search-facility" 
                            aria-label="Search">
                        </button>
                    </div>
                    

                </div>
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const button = document.getElementById('searchButton');
                        const input = document.getElementById('searchInput');
                        const error = document.getElementById('searchError');

                        const performSearch = event => {
                            event.preventDefault();
                            const value = input.value.trim();

                            if (!value) {
                                error.textContent = input.dataset.requiredMessage || 'This field is required';
                                input.setAttribute('aria-invalid', 'true');

                                input.focus();
                                return;
                            }

                            // Clear error if any
                            error.textContent = '';
                            error.style.visibility = 'hidden';

                            const targetUrl = `/Search?searchtext=${encodeURIComponent(value)}`;
                            window.location.href = targetUrl;
                        };

                        button.addEventListener('click', (event) => performSearch(event));
                        input.addEventListener('keydown', (event) => {
                            if (event.key === 'Enter') {
                                performSearch(event);
                            }
                        });

                        input.addEventListener('input', () => {
                            if (error.textContent !== '') {
                                error.textContent = '';
                                input.removeAttribute('aria-invalid');
                            }
                        });
                    });
                </script>
            </div>
        </div>
    </section>
    <div>
        <section class="m05 grid-container module-padding ">

            <div class="m05__cards-container cards-container">
                <div data-aos="fade-up" data-aos-once="false" data-aos-delay="600" class="m05__card aos-init aos-animate">
                    <div class="m05__card-inner">
                        <div  class="m05__card__img-wrapper">
                            <img class="m05__card__img" alt="An Post logo" data-img-path="/fe-build/images/errors/M05-anpost.jpg" data-img-alt-text="An Post logo" src="/fe-build/images/errors/M05-anpost.jpg">
                        </div>
                        <div class="m05__card__text">
                            <h2 class="m05__card__title underline h5">An Post Personal</h2>
                            <p class="m05__card__para">Our purpose is simple - to act for the common good and to improve the quality of life in Ireland, now and for generations to come.</p>
                            <div class="m05__card__cta cta-link">Visit An Post Personal</div>
                        </div>
                        <a href="/" class="gtm-linkclick m05__card__link">Visit An Post Personal</a>
                    </div>
                </div>

                <div id="Col2" data-aos="fade-up" data-aos-once="false" data-aos-delay="700" class="m05__card aos-init aos-animate">
                    <div class="m05__card-inner">
                        <div class="m05__card__img-wrapper">
                            <img class="m05__card__img" alt="An Post Commerce logo" data-img-path="/fe-build/images/errors/M05-commerce.jpg" data-img-alt-text="An Post Commerce logo" src="/fe-build/images/errors/M05-commerce.jpg">
                        </div>
                        <div class="m05__card__text">
                            <h2 class="m05__card__title underline h5">An Post Commerce</h2>
                            <p class="m05__card__para">An Post Commerce is your essential and expert business partner. Find out more about our expert solutions for your business.</p>
                            <div class="m05__card__cta cta-link">Visit An Post Commerce</div>
                        </div>
                        <a href="/Commerce" class="gtm-linkclick m05__card__link">Visit An Post Commerce</a>
                    </div>
                </div>

                <div id="Col3" data-aos="fade-up" data-aos-once="false" data-aos-delay="800" class="m05__card aos-init aos-animate">
                    <div class="m05__card-inner">
                        <div class="m05__card__img-wrapper">
                            <img class="m05__card__img" alt="An Post Money logo" data-img-path="/fe-build/images/errors/M05-money.jpg" data-img-alt-text="An Post Money logo" src="/fe-build/images/errors/M05-money.jpg">
                        </div>
                        <div class="m05__card__text">
                            <h2 class="m05__card__title underline h5">An Post Money</h2>
                            <p class="m05__card__para">At An Post Money, we know it’s not our money, it’s yours. So we’ll be there, helping you take control and making things simple and easy.</p>
                            <div class="m05__card__cta cta-link">Visit An Post Money</div>
                        </div>
                        <a href="/Money" class="gtm-linkclick m05__card__link">Visit An Post Money</a>
                    </div>
                </div>
            </div>

