const darkModeMediaMatcher = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
if (!darkModeMediaMatcher) {
    console.warn("Your browser does not support prefers-color-scheme media query.");
} else {
    /* Expose the media matcher to the global window object to be able to remove event listener from settings menu */
    window.darkModeMediaMatcher = darkModeMediaMatcher;
    window.onDarkModeChange = (event) => {
        document.documentElement.dataset.chameleonColorMode = event.matches ? "dark" : "light";
        document.documentElement.dataset.colorMode = event.matches ? "dark" : "light";
    }
}

(function() {
    const searchParamsColorMode = window.location.search.match(/colorMode=(light|dark|auto)/)?.pop() || "";
    if (isValidColorMode(searchParamsColorMode)) {
        delete document.documentElement.dataset.autoColorMode;
        window.darkModeMediaMatcher.removeEventListener('change', window.onDarkModeChange);
        document.documentElement.dataset.chameleonColorMode = searchParamsColorMode;
        document.documentElement.dataset.colorMode = searchParamsColorMode;
        return;
    } else if(isAutoColorMode(searchParamsColorMode)) {
        watchColorModeChanges();
        return;
    }
    
    const DEFAULT_COLOR_MODE = "auto";
    const dsyColorModeCookieOrDefault = document.cookie.match(/(^|;)\s*dsy-color-mode\s*=\s*([^;]+)/)?.pop() || DEFAULT_COLOR_MODE;
    
    if (isValidColorMode(dsyColorModeCookieOrDefault)) {
        delete document.documentElement.dataset.autoColorMode;
        window.darkModeMediaMatcher.removeEventListener('change', window.onDarkModeChange);
        document.documentElement.dataset.chameleonColorMode = dsyColorModeCookieOrDefault;
        document.documentElement.dataset.colorMode = dsyColorModeCookieOrDefault;   
    } else if (isAutoColorMode(dsyColorModeCookieOrDefault)) {
        watchColorModeChanges();
        return;
    }
})();

function watchColorModeChanges() {
    document.documentElement.dataset.autoColorMode = "";
       
    const prefersDarkMode = window.darkModeMediaMatcher.matches;
    document.documentElement.dataset.chameleonColorMode = prefersDarkMode ? "dark" : "light";
    document.documentElement.dataset.colorMode = prefersDarkMode ? "dark" : "light";
    window.darkModeMediaMatcher.addEventListener('change', window.onDarkModeChange);
}

function isAutoColorMode(colorMode) {
    return colorMode === "auto";
}

function isValidColorMode(colorMode) {
    return colorMode === "dark" || colorMode === "light";
}
//# sourceURL=inline-color-mode-set.js
</script><div id="didomi-host"></div><header class="header_header__pEfmi"><div class="header_headerDesktop__DDaKL" data-testid="header-desktop"><div class="header_services__FLOth" data-testid="header-desktop-services"><div class="header_servicesContent__oV11e center_center__c5xTZ" style="max-inline-size:min(var(--grid-wrap-fluid), var(--max-content-width))"><div class="header_servicesLeft__zKwYT"><button class="Button_button__L3J4Q Button_button--sm__RARl2 Button_button--default___pm7N navigation-menu_navigationMenuButton__eddhU" data-testid="navigation-menu"><svg class="Icon_icon__6Efqd Icon_icon--sm__sLixk Icon_icon--sprite__Beuw9" viewBox="0 0 24 24" aria-hidden="true"><use href="/api/icons/tel/sprite.svg#menu-search"></use></svg><span class="Button_button__content__kQJ_1">Menu</span></button><span class="header_logoContainer__Zheow"><div class="header_divider__ATMzF"></div><a data-testid="navigation-logo" style="height:24px" class="navigation-link_navigationLink__d6Syv" href="/" target="_self"><img class="Logo_logo__CRsrQ navigation-logo_navigationLogo__XOQJY logo-with-color-mode_lightLogo___9rY2" src="https://focus.telegraaf.nl/raw/prod-mh-design-system/8.3.2-colormode.1/tel/logos/logo-main-inverse.svg" alt=""/><img class="Logo_logo__CRsrQ navigation-logo_navigationLogo__XOQJY logo-with-color-mode_darkLogo__1508q" src="https://focus.telegraaf.nl/raw/prod-mh-design-system/8.3.2-colormode.1/tel/logos/logo-main-inverse.svg" alt=""/></a></span></div><div class="header_servicesRight__z6ryO" data-testid="header-desktop-services-right"><nav class="header_itemsContainer__TjcTK"><a class="navigation-link_navigationLink__d6Syv header_serviceNavLink___D96u" href="https://www.telegraaf.nl/abonnement/abonnement-bestellen/?utm_internal=menu-www-navigation-header-services" target="_blank">Abonneren</a><a class="navigation-link_navigationLink__d6Syv header_serviceNavLink___D96u" href="https://www.telegraaf.nl/digitalekrant">De krant</a><a class="navigation-link_navigationLink_