    <h1 class="nyk-not-found__body__title">Siden findes ikke</h1>

    <div class="nyk-not-found__body__404-graphic">
        <svg
            role="presentation"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 966 380">
            <path
                fill="#0F1E82"
                d="M174.52 372v-86.84H.32v-60.32L123.56 8h74.88L66.88 233.16h107.64v-79.04h68.12v79.04h57.2v40.56l-57.2 11.44V372h-68.12Zm305.492 7.8c-85.28 0-145.6-62.4-145.6-188.76 0-126.36 60.32-190.32 145.6-190.32s145.6 63.96 145.6 190.32c0 126.36-60.32 188.76-145.6 188.76Zm-74.88-188.76c0 106.08 31.72 142.48 74.88 142.48s74.88-36.4 74.88-142.48c0-106.08-31.72-143.52-74.88-143.52s-74.88 37.44-74.88 143.52ZM840.262 372v-86.84h-174.2v-60.32L789.302 8h74.88l-131.56 225.16h107.64v-79.04h68.12v79.04h57.2v40.56l-57.2 11.44V372h-68.12Z"/>
