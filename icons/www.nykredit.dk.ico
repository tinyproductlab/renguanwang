                    class="nyk-js--menu-item nyk-js--burgermenu nyk-menu__top-menu__bottom__container__actions__burgermenu"
                    :class="burgermenuUpdatedState"
                    :aria-expanded="submenuOpen"
                    aria-controls="submenu"
                    :aria-label="submenuOpen ? '' : ''">
