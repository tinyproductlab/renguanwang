                        @keydown.tab.prevent="navigateForwardInSubmenu"
                        @keydown.tab.shift.prevent="navigateBackInSubmenu"
                        @keydown.down.prevent="navigateForwardInSubmenu"
                        @keydown.up.prevent="navigateBackInSubmenu"
