px) 7952px, 100vw" decoding="async" loading="lazy" data-src="/static/663dde0e8d76ca566b21fd7cd50efb1d/173cb/cancel_modification.png" data-srcset="/static/663dde0e8d76ca566b21fd7cd50efb1d/ada72/cancel_modification.png 1988w,/static/663dde0e8d76ca566b21fd7cd50efb1d/f9777/cancel_modification.png 3976w,/static/663dde0e8d76ca566b21fd7cd50efb1d/173cb/cancel_modification.png 7952w" alt=""/></picture><noscript><picture><source type="image/webp" srcSet="/static/663dde0e8d76ca566b21fd7cd50efb1d/057c2/cancel_modification.webp 1988w,/static/663dde0e8d76ca566b21fd7cd50efb1d/48d87/cancel_modification.webp 3976w,/static/663dde0e8d76ca566b21fd7cd50efb1d/89d92/cancel_modification.webp 7952w" sizes="(min-width: 7952px) 7952px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7952px) 7952px, 100vw" decoding="async" loading="lazy" src="/static/663dde0e8d76ca566b21fd7cd50efb1d/173cb/cancel_modification.png" srcSet="/static/663dde0e8d76ca566b21fd7cd50efb1d/ada72/cancel_modification.png 1988w,/static/663dde0e8d76ca566b21fd7cd50efb1d/f9777/cancel_modification.png 3976w,/static/663dde0e8d76ca566b21fd7cd50efb1d/173cb/cancel_modification.png 7952w" alt=""/></picture></noscript><script type="module">const t="undefined"!=typeof HTMLImageElement&&"loading"in HTMLImageElement.prototype;if(t){const t=document.querySelectorAll("img[data-main-image]");for(let e of t){e.dataset.src&&(e.setAttribute("src",e.dataset.src),e.removeAttribute("data-src")),e.dataset.srcset&&(e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset"));const t=e.parentNode.querySelectorAll("source[data-srcset]");for(let e of t)e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset");e.complete&&(e.style.opacity=1,e.parentNode.parentNode.querySelector("[data-placeholder-image]").style.opacity=0)}}</script></div><h1 class="text-blue text-3xl font-medium mt-10  max-sm:ms-5 mb-2  rtl:ms-7  max-sm:w-4/6">Cancellations &amp; Modifications</h1><p class="me-3 max-sm:w-4/6  max-sm:ms-5  rtl:ms-7">If you change your mind or events prevent you from using your ticket for travel with SAR, then you may be entitled to a full or partial refund depending on the ticket type you have.</p></a></div></div><div><div class="flex w-full overflow-scroll scroll-smooth focus:scroll-auto no-scrollbar"><a class="flex-none w-[32rem] me-4 ltr:text-left rtl:text-right" href="/northern-train/flightschedule/"><div data-gatsby-image-wrapper="" class="gatsby-image-wrapper gatsby-image-wrapper-constrained"><div style="max-width:6488px;display:block"><img alt="" role="presentation" aria-hidden="true" src="data:image/svg+xml;charset=utf-8,%3Csvg%20height=&#x27;4325&#x27;%20width=&#x27;6488&#x27;%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20version=&#x27;1.1&#x27;%3E%3C/svg%3E" style="max-width:100%;display:block;position:static"/></div><div aria-hidden="true" data-placeholder-image="" style="opacity:1;transition:opacity 500ms linear;background-color:#98a8a8;position:absolute;top:0;left:0;bottom:0;right:0"></div><picture><source type="image/webp" data-srcset="/static/5525209caa54632e0027135c0f6d2c4c/92a34/north_schedule.webp 1622w,/static/5525209caa54632e0027135c0f6d2c4c/a2fbe/north_schedule.webp 3244w,/static/5525209caa54632e0027135c0f6d2c4c/39c3c/north_schedule.webp 6488w" sizes="(min-width: 6488px) 6488px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 6488px) 6488px, 100vw" decoding="async" loading="lazy" data-src="/static/5525209caa54632e0027135c0f6d2c4c/6b747/north_schedule.jpg" data-srcset="/static/5525209caa54632e0027135c0f6d2c4c/9b0a5/north_schedule.jpg 1622w,/static/5525209caa54632e0027135c0f6d2c4c/5d9e3/north_schedule.jpg 3244w,/static/5525209caa54632e0027135c0f6d2c4c/6b747/north_schedule.jpg 6488w" alt=""/></picture><noscript><picture><source type="image/webp" srcSet="/static/5525209caa54632e0027135c0f6d2c4c/92a34/north_schedule.webp 1622w,/static/5525209caa54632e0027135c0f6d2c4c/a2fbe/