="module">const t="undefined"!=typeof HTMLImageElement&&"loading"in HTMLImageElement.prototype;if(t){const t=document.querySelectorAll("img[data-main-image]");for(let e of t){e.dataset.src&&(e.setAttribute("src",e.dataset.src),e.removeAttribute("data-src")),e.dataset.srcset&&(e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset"));const t=e.parentNode.querySelectorAll("source[data-srcset]");for(let e of t)e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset");e.complete&&(e.style.opacity=1,e.parentNode.parentNode.querySelector("[data-placeholder-image]").style.opacity=0)}}</script></div><h1 class="text-blue text-3xl font-medium mt-10  max-sm:ms-5 mb-2  rtl:ms-7">Car Parking</h1><p class="me-3 max-sm:w-4/6  max-sm:ms-5  rtl:ms-7">We offer ample car parking spaces right outside the station entrance, making your journey smooth and convenient from the moment you arrive.</p></a></div></div><div><div class="flex w-full overflow-scroll scroll-smooth focus:scroll-auto no-scrollbar"><a class="flex-none w-[32rem] me-4 ltr:text-left rtl:text-right" href="/northern-train/stationlounges/"><div data-gatsby-image-wrapper="" class="gatsby-image-wrapper gatsby-image-wrapper-constrained"><div style="max-width:7952px;display:block"><img alt="" role="presentation" aria-hidden="true" src="data:image/svg+xml;charset=utf-8,%3Csvg%20height=&#x27;5304&#x27;%20width=&#x27;7952&#x27;%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20version=&#x27;1.1&#x27;%3E%3C/svg%3E" style="max-width:100%;display:block;position:static"/></div><div aria-hidden="true" data-placeholder-image="" style="opacity:1;transition:opacity 500ms linear;background-color:#f8f8f8;position:absolute;top:0;left:0;bottom:0;right:0"></div><picture><source type="image/webp" data-srcset="/static/f6ef59423ad0471a6fbbb8b83bb81ad0/057c2/station-lounges.webp 1988w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/48d87/station-lounges.webp 3976w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/89d92/station-lounges.webp 7952w" sizes="(min-width: 7952px) 7952px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7952px) 7952px, 100vw" decoding="async" loading="lazy" data-src="/static/f6ef59423ad0471a6fbbb8b83bb81ad0/4725d/station-lounges.jpg" data-srcset="/static/f6ef59423ad0471a6fbbb8b83bb81ad0/04334/station-lounges.jpg 1988w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/31f83/station-lounges.jpg 3976w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/4725d/station-lounges.jpg 7952w" alt=""/></picture><noscript><picture><source type="image/webp" srcSet="/static/f6ef59423ad0471a6fbbb8b83bb81ad0/057c2/station-lounges.webp 1988w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/48d87/station-lounges.webp 3976w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/89d92/station-lounges.webp 7952w" sizes="(min-width: 7952px) 7952px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7952px) 7952px, 100vw" decoding="async" loading="lazy" src="/static/f6ef59423ad0471a6fbbb8b83bb81ad0/4725d/station-lounges.jpg" srcSet="/static/f6ef59423ad0471a6fbbb8b83bb81ad0/04334/station-lounges.jpg 1988w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/31f83/station-lounges.jpg 3976w,/static/f6ef59423ad0471a6fbbb8b83bb81ad0/4725d/station-lounges.jpg 7952w" alt=""/></picture></noscript><script type="module">const t="undefined"!=typeof HTMLImageElement&&"loading"in HTMLImageElement.prototype;if(t){const t=document.querySelectorAll("img[data-main-image]");for(let e of t){e.dataset.src&&(e.setAttribute("src",e.dataset.src),e.removeAttribute("data-src")),e.dataset.srcset&&(e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset"));const t=e.parentNode.querySelectorAll("source[data-srcset]");for(let e of t)e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset");e.complete&&(e.style.opacity=1,e.parentNode.parentNode.querySelector("[data-placeholder-image]").style.opacity=0)}}</script></div><h1 class="text-blue text-3xl font-medium mt-10  max-sm:ms-5 mb-2  rtl:ms-7"> Station Lounges </h1><p class="me-3 max-sm:w-4/6  max-sm:ms-5  rtl:ms-7">Your journey with SAR starts well before you board our trains, which is why we have Lounges available at most of our stations, where you can relax in comfort and style before you travel.</p></a><a class="flex-none w-[32rem] me-4 ltr:text-left rtl:text-right" href="/northern-train/foodanddrinks/"><div data-gatsby-image-wrapper="" class="gatsby-image-wrapper gatsby-image-wrapper-constrained"><div style="max-width:7422px;display:block"><img alt="" role="presentation" aria-hidden="true" src="data:image/svg+xml;charset=utf-8,%3Csvg%20height=&#x27;4951&#x27;%20width=&#x27;7422&#x27;%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20version=&#x27;1.1&#x27;%3E%3C/svg%3E" style="max-width:100%;display:block;position:static"/></div><div aria-hidden="true" data-placeholder-image="" style="opacity:1;transition:opacity 500ms linear;background-color:#989898;position:absolute;top:0;left:0;bottom:0;right:0"></div><picture><source type="image/webp" data-srcset="/static/97f603c068b2f355f54c2e1580d03bbe/78346/food-drinks.webp 1856w,/static/97f603c068b2f355f54c2e1580d03bbe/8a847/food-drinks.webp 3711w,/static/97f603c068b2f355f54c2e1580d03bbe/53f68/food-drinks.webp 7422w" sizes="(min-width: 7422px) 7422px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7422px) 7422px, 100vw" decoding="async" loading="lazy" data-src="/static/97f603c068b2f355f54c2e1580d03bbe/c5d07/food-drinks.jpg" data-srcset="/static/97f603c068b2f355f54c2e1580d03bbe/bec5f/food-drinks.jpg 1856w,/static/97f603c068b2f355f54c2e1580d03bbe/b310b/food-drinks.jpg 3711w,/static/97f603c068b2f355f54c2e1580d03bbe/c5d07/food-drinks.jpg 7422w" alt=""/></picture><noscript><picture><source type="image/webp" srcSet="/static/97f603c068b2f355f54c2e1580d03bbe/78346/food-drinks.webp 1856w,/static/97f603c068b2f355f54c2e1580d03bbe/8a847/food-drinks.webp 3711w,/static/97f603c068b2f355