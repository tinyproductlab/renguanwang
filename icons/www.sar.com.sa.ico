h:100%;display:block;position:static"/></div><div aria-hidden="true" data-placeholder-image="" style="opacity:1;transition:opacity 500ms linear;background-color:#080808;position:absolute;top:0;left:0;bottom:0;right:0"></div><picture><source type="image/webp" data-srcset="/static/d8bc4e488233dddd69fabff7144d43f3/96d1f/seat_main.webp 1978w,/static/d8bc4e488233dddd69fabff7144d43f3/9b5d0/seat_main.webp 3955w,/static/d8bc4e488233dddd69fabff7144d43f3/9e047/seat_main.webp 7910w" sizes="(min-width: 7910px) 7910px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7910px) 7910px, 100vw" decoding="async" loading="lazy" data-src="/static/d8bc4e488233dddd69fabff7144d43f3/1446f/seat_main.jpg" data-srcset="/static/d8bc4e488233dddd69fabff7144d43f3/9b89a/seat_main.jpg 1978w,/static/d8bc4e488233dddd69fabff7144d43f3/8fb1f/seat_main.jpg 3955w,/static/d8bc4e488233dddd69fabff7144d43f3/1446f/seat_main.jpg 7910w" alt=""/></picture><noscript><picture><source type="image/webp" srcSet="/static/d8bc4e488233dddd69fabff7144d43f3/96d1f/seat_main.webp 1978w,/static/d8bc4e488233dddd69fabff7144d43f3/9b5d0/seat_main.webp 3955w,/static/d8bc4e488233dddd69fabff7144d43f3/9e047/seat_main.webp 7910w" sizes="(min-width: 7910px) 7910px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7910px) 7910px, 100vw" decoding="async" loading="lazy" src="/static/d8bc4e488233dddd69fabff7144d43f3/1446f/seat_main.jpg" srcSet="/static/d8bc4e488233dddd69fabff7144d43f3/9b89a/seat_main.jpg 1978w,/static/d8bc4e488233dddd69fabff7144d43f3/8fb1f/seat_main.jpg 3955w,/static/d8bc4e488233dddd69fabff7144d43f3/1446f/seat_main.jpg 7910w" alt=""/></picture></noscript><script type="module">const t="undefined"!=typeof HTMLImageElement&&"loading"in HTMLImageElement.prototype;if(t){const t=document.querySelectorAll("img[data-main-image]");for(let e of t){e.dataset.src&&(e.setAttribute("src",e.dataset.src),e.removeAttribute("data-src")),e.dataset.srcset&&(e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset"));const t=e.parentNode.querySelectorAll("source[data-srcset]");for(let e of t)e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset");e.complete&&(e.style.opacity=1,e.parentNode.parentNode.querySelector("[data-placeholder-image]").style.opacity=0)}}</script></div><h1 class="text-blue text-3xl font-medium mt-10  max-sm:ms-5 mb-2  rtl:ms-7">Seat Selection</h1><p class="me-3 max-sm:w-4/6  max-sm:ms-5  rtl:ms-7">Window gazer or table chatter? Whatever your travel style, you’re in charge with SAR.</p></a><a class="flex-none w-[32rem] me-4 ltr:text-left rtl:text-right" href="/northern-train/baggageguide/"><div data-gatsby-image-wrapper="" class="gatsby-image-wrapper gatsby-image-wrapper-constrained"><div style="max-width:7422px;display:block"><img alt="" role="presentation" aria-hidden="true" src="data:image/svg+xml;charset=utf-8,%3Csvg%20height=&#x27;4951&#x27;%20width=&#x27;7422&#x27;%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20version=&#x27;1.1&#x27;%3E%3C/svg%3E" style="max-width:100%;display:block;position:static"/></div><div aria-hidden="true" data-placeholder-image="" style="opacity:1;transition:opacity 500ms linear;background-color:#987848;position:absolute;top:0;left:0;bottom:0;right:0"></div><picture><source type="image/webp" data-srcset="/static/967400992629e347e540e3971592cbb4/78346/extra-baggage.webp 1856w,/static/967400992629e347e540e3971592cbb4/8a847/extra-baggage.webp 3711w,/static/967400992629e347e540e3971592cbb4/53f68/extra-baggage.webp 7422w" sizes="(min-width: 7422px) 7422px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7422px) 7422px, 100vw" decoding="async" loading="lazy" data-src="/static/967400992629e347e540e3971592cbb4/c5d07/extra-baggage.jpg" data-srcset="/static/967400992629e347e540e3971592cbb4/bec5f/extra-baggage.jpg 1856w,/static/967400992629e347e540e3971592cbb4/b310b/extra-baggage.jpg 3711w,/static/967400992629e347e540e3971592cbb4/c5d07/extra-baggage.jpg 7422w" alt=""/></picture><noscript><picture><source type="image/webp" srcSet="/static/967400992629e347e540e3971592cbb4/78346/extra-baggage.webp 1856w,/static/967400992629e347e540e3971592cbb4/8a847/extra-baggage.webp 3711w,/static/967400992629e347e540e3971592cbb4/53f68/extra-baggage.webp 7422w" sizes="(min-width: 7422px) 7422px, 100vw"/><img data-gatsby-image-ssr="" data-main-image="" style="opacity:0" sizes="(min-width: 7422px) 7422px, 100vw" decoding="async" loading="lazy" src="/static/967400992629e347e540e3971592cbb4/c5d07/extra-baggage.jpg" srcSet="/static/967400992629e347e540e3971592cbb4/bec5f/extra-baggage.jpg 1856w,/static/967400992629e347e540e3971592cbb4/b310b/extra-baggage.jpg 3711w,/static/967400992629e347e540e3971592cbb4/c5d07/extra-baggage.jpg 7422w" alt=""/></picture></noscript><script type="module">const t="undefined"!=typeof HTMLImageElement&&"loading"in HTMLImageElement.prototype;if(t){const t=document.querySelectorAll("img[data-main-image]");for(let e of t){e.dataset.src&&(e.setAttribute("src",e.dataset.src),e.removeAttribute("data-src")),e.dataset.srcset&&(e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset"));const t=e.parentNode.querySelectorAll("source[data-srcset]");for(let e of t)e.setAttribute("srcset",e.dataset.srcset),e.removeAttribute("data-srcset");e.complete&&(e.style.opacity=1,e.parentNode.parentNode.querySelector("[data-placeholder-image]").style.opacity=0)}}</script></div><h1 class="text-blue text-3xl font-medium mt-10  max-sm:ms-5 mb-2  rtl:ms-7">Extra Baggage</h1><p class="me-3 max-sm:w-4/6  max-sm:ms-5  rtl:ms-7">Need to carry a bit extra? Additional checked baggage can be added to your booking online or via our app. Save up to 29% on station prices by purchasing in advance.</p></a></div></div></section><section class="mt-24 xl:mx-8 lg:mx-2 xxs:mx-2 sm:mx-0  grid grid-cols-2 max-lg:grid-cols-1 gap-5  text-start"><div class="bg-sar-grey-100 grid grid-co