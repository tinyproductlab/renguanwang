<div class="magezon-builder magezon-builder-preload"><div class="peux02n mgz-element mgz-element-row full_width_row_content_no_paddings"><div class="mgz-element-inner peux02n-s"><div class="inner-content "><div class="rvm0drl mgz-element mgz-element-column mgz-col-xs-12"><div class="mgz-element-inner rvm0drl-s"><div class="ns35bsw mgz-element mgz-child mgz-element-raw_html container_max_1200"><div class="mgz-element-inner ns35bsw-s"><script>
    require(['jquery', 'jquery/ui'], function($){
        jQuery(document).ready(function($){
            const pathnamedata = window.location.pathname;
            var emailunsubscribe1 = window.location.pathname.split("/")[1];
            var emailunsubscribe2 = window.location.pathname.split("/")[2];

            if (emailunsubscribe1 =='email-unsubscribe' || emailunsubscribe2 =='email-unsubscribe'){
                $('#unsubscribe_form').show();
                document.title = "Ola Email Unsubscribe";
            } else if (emailunsubscribe1 =='sms-unsubscribe' || emailunsubscribe2 =='sms-unsubscribe'){
                $('#unsubscribe_form').show();
                $('.unsub_massage').html('is subscribed to our message list(s).');
                document.title = "Ola SMS Unsubscribe";
            } else {
                window.location.href = "/";
            }
        });
    });
</script><div class="unsubscribe_main" id="unsubscribe_form" style="display:none"><div class="unsubscribe_header"><span id="unsubscribeMessage" style="display:none"> unsubscribeMessage -- Your message would be removed from the message list within 24 hrs.</span> <h2 id="emailLabel" class="unsub_label"></h2><h2 class="unsub_label" style="display:none">test.email@gm****com</h2><p class="unsub_massage">is subscribed to our mailing list(s).</p></div><div class="unsubscribe_body" id ="emailunsubscribe_body" style="display:none"><h2 class="unsub_highlighted_title">Unsubscribe from our mailing list</h2><p class="unsub_highlighted_description">To help us improve our services, we would be grateful if you could tell us why </p><div class="unsub_select"><select name="pets" id="unsub_reason"><option value="">Please select one reason</option><option value="Your emails are not relevant to me">Your emails are not relevant to me</option><option value="Your emails are too frequent">Your emails are too frequent</option><option value="I don't remember signing up for this">I don't remember signing up for this</option><option value="I no longer want to receive these emails">I no longer want to receive these emails</option><option value="The emails are spam and should be reported">The emails are spam and should be reported</option><option value="Others">Others</option></select> </div><div id="error-msg-show" style="color: red; display: none;">Please select an option</div><div class="unsub_action"><button type="button" class="unsubscribe_btn" id="unsubscribeButton">Unsubscribe</button> </div><p class="note_msg"><span id="unsub_head_note">Note</span> <span class="unsub_colon">:</span> <span id="unsub_head_note_massge">Your email address would be removed from the mailing list within 3 hrs.</span> </p></div><div class="unsubscribe_body" id ="smsunsubscribe_body" style="display:none"><h2 class="unsub_highlighted_title">Unsubscribe from our message list</h2><p class="unsub_highlighted_description">To help us improve our services, we would be grateful if you could tell us why </p><div class="unsub_select"><select name="pets" id="smsunsub_reason"><option value="">Please select one reason</option><option value="Your sms are not relevant to me">Your sms are not relevant to me</option><option value="Your sms are too frequent">Your sms are too frequent</option><option value="I don't remember signing up for this">I don't remember signing up for this</option><option value="I no longer want to receive these sms">I no longer want to receive these sms</option><option value="The sms are spam and should be reported">The sms are spam and should be reported</option><option value="Others">Others</option></select> </div><div id="error-msg-show" style="color: red; display: none;">Please select an option</div><div class="unsub_action"><button type="button" class="unsubscribe_btn" id="smsunsubscribeButton">Unsubscribe</button> </div><p class="note_msg"><span id="unsub_head_note">Note</span> <span class="unsub_colon">:</span> <span id="unsub_head_note_massge">Your message would be removed from the message list within 24 hrs.</span> </p></div><div class="unsub_msg" id="successmsg" style="display: none;"> You've successfully unsubscribed. Your phone number will be removed from the message list within 24 hrs. </div><div class="unsub_msg" id="errormsg"></div></div><script>
    require(['jquery', 'jquery/ui'], function($){
        jQuery(document).ready(function($){
            const emailunsubscribe = window.location.pathname.split("/")[1];
            const queryString = window.location.pathname.split("/")[2];

            
            if (window.location.pathname.indexOf('sms-unsubscribe') !== -1) {
                if(queryString){
                    var emaildata = '';
                    var encodedSms = window.location.pathname.replace('/sms-unsubscribe/','');
                    var datashow = null;
                    $.ajax({
                        type: "POST",
                        data: { url: encodedSms },
                        dataType: 'json',
                        url: '/olacabs/api/usersms/',
                        success: function(data) {
                            GlobalPricingInfo = data;
                            var datashow = GlobalPricingInfo.data;
                            if(datashow === null){
                                setTimeout(function() { $("#smsunsubscribe_body").hide();}, 100);
                                setTimeout(function() { $("#emailLabel").hide();}, 100);
                                $('.unsub_massage').html('Something went wrong. Please try after some time..');
                            }else{
                                var emaildata = datashow.phone;
                                $('#emailLabel').html(datashow.phone);
                                setTimeout(function() { $("#smsunsubscribe_body").show();}, 100);
                            }             
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            $('#smsunsubscribe_body').hide();
                            console.log(xhr.statusText);
                            console.log(xhr.status);
                        }
                    });

                    $('#smsunsubscribeButton').click(function () {
                        var selectedValue = $('#smsunsub_reason').val();
                        var selectedText = $('#smsunsub_reason option:selected').text();
                        if (selectedValue === '') {
                            alert('Please select at least one reason');
                            return false; 
                        } else {
                            console.log('Selected Value:', selectedValue);
                            console.log('Selected Text:', selectedText);
                            smsunsubscribe(selectedValue);
                        }
                    });

                    function smsunsubscribe(selectedValue) {
                        var token = "";
                        var emailVendor = "amazonses";
                        var currentDate = Math.round((new Date()).getTime() / 1000);
                        var emailData = {
                            "TRANSID": token,
                            "PROVIDER": emailVendor,
                            "URL": encodedSms,
                            "TIMESTAMP": currentDate.toString(),
                            "REASON": selectedValue
                        }
                        $.ajax({
                            type: 'POST',
                            url: '/olacabs/api/smsunsubscribedata/',
                            data: emailData,
                            dataType: 'json',
                            success: function (data) {
                                GlobalPricingInfo = data;
                                var datashow = GlobalPricingInfo.data;
                                if(datashow === null){
                                }else{
                                    var accepted = datashow.accepted;
                                    console.log('return data:', data);
                                    if(accepted == true){
                                        window.location ="/unsubscribe-sms-success";
                                    }
                                }
                            },
                            error: function (xhr, status, error) {
                                
                                $('#successMsg').html('Something went wrong. Please try after some time.');
                                console.log(xhr.statusText);
                                console.log(xhr.status);
                            }

                        });
                    }
                }
            }
            
            if (window.location.pathname.indexOf('email-unsubscribe') !== -1) {
                if(queryString){
                    var emaildata = '';
                    var encodedEmail = window.location.pathname.replace('/email-unsubscribe/','');
                    var datashow = null;
                    $.ajax({
                        type: "GET",
                        data: { url: encodedEmail },
                        dataType: 'json',
                        url: '/olacabs/api/useremail/',
                        success: function(data) {
                            GlobalPricingInfo = data;
                            var datashow = GlobalPricingInfo.data;
                            if(datashow === null){
                                setTimeout(function() { $("#unsubscribe_body").hide();}, 100);
                                setTimeout(function() { $("#emailLabel").hide();}, 100);
                                $('.unsub_massage').html('Something went wrong. Please try after some time..');
                            }else{
                                var emaildata = datashow.email;
                                $('#emailLabel').html(datashow.email);
                                setTimeout(function() { $("#emailunsubscribe_body").show();}, 100);
                            }             
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            $('#unsubscribe_body').hide();
                            $('#successMsg').html('Something went wrong. Please try after some time.');
                            console.log(xhr.statusText);
                            console.log(xhr.status);
                        }
                    });
                    

                    $('#unsubscribeButton').click(function() {
                        var selectedValue = $('#unsub_reason').val();
                        var selectedText = $('#unsub_reason option:selected').text();
                        if (selectedValue === '') {
                            alert('Please select at least one reason');
                            return false;
                        }else {
                            unsubscribe(selectedValue);
                        }
                    });

                    function unsubscribe(selectedValue) {
                        var token = ""; 
                        var emailVendor = "amazonses"; 
                        var currentDate = Math.round((new Date()).getTime() / 1000);
                        var emailData = {
                            "TRANSID": token,
                            "PROVIDER": emailVendor,
                            "URL": encodedEmail,
                            "TIMESTAMP": currentDate.toString(),
                            "REASON" : selectedValue
                        }
                        $.ajax({
                            type: 'POST',
                            url: '/olacabs/api/emailunsubscribedata/',
                            data: emailData,
                            dataType: 'json',
                            success: function(data){
                                GlobalPricingInfo = data;
                                var datashow = GlobalPricingInfo.data;
                                if(datashow === null){
                                }else{
                                    var accepted = datashow.accepted;
                                    console.log('return data:', data);
                                    if(accepted == true){
                                        window.location ="/unsubscribe-success";
                                    }
                                }
                            },
                            error: function(xhr, status, error){
                                
                                $('#successMsg').html('Something went wrong. Please try after some time.');
                                console.log(xhr.statusText);
                                console.log(xhr.status);
                            }
                        });
                    };
                }
            }

        });
    });
