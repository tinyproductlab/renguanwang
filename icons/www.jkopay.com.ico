e":"paragraph","data":{},"content":[{"nodeType":"text","value":"RCBC 帳戶：匯款將於 10 分鐘內入帳","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"非 RCBC 帳戶：5萬新台幣以下的匯款將於 10 分鐘內入帳","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"現金領取：當您收到簡訊通知後，即可前往領取現金","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:手續費多少？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"手續費如下：","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"到帳戶：新台幣 100 元","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"現金領取：新台幣 150 元","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"相關費用及優惠活動以 App 實際顯示頁面為準。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:付款方式有哪些？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"我們提供兩種付款方式：","marks":[],"data":{}}]},{"nodeType":"ordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"使用街口帳戶餘額付款，付款時請選擇 [街口帳戶付款]。","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"超商付款：請在 3 小時內完成付款，超過時間交易會自動取消，需要重新建立訂單。\n超商付款會使用條碼掃碼，條碼有效時間為 10 分鐘，請在條碼過期前完成付款，超過十分鐘會自動產生新的條碼，請使用新的條碼。","marks":[],"data":{}}]}]}]}]},"payment.contentful_rt":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:街口繳費可以使用哪些支付工具？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"繳費項目所支援付款方式如下：","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"信用卡","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"僅支援綁定台新全卡、玉山全卡","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"銀行帳戶","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"及","marks":[],"data":{}},{"nodeType":"text","value":"街口帳戶","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"付款可接受多間銀行綁定","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"除學雜費、全民健保費、交通罰鍰、違反強制險罰鍰 ，需使用","marks":[],"data":{}},{"nodeType":"text","value":"「街口帳戶」","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"付款","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"詳細說明請參閱：","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://mkt.jkopay.com/event/richartjkobill"},"content":[{"nodeType":"text","value":"繳費付款方式與回饋說明","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:如何解除車號綁定？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作：\n街口 App 首頁 \u003e 「繳費」 \u003e 「路邊停車費」 \u003e 車號綁定/解綁的「繳費提醒服務」\u003e 車號綁定資料點選查看 \u003e 各縣市綁定狀態，點選「解除綁定」，即可完成解綁。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:繳停車費可以打統編嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"路邊停車及公有停車場停車費屬政府規費免開立發票。您可於街口 App 交易紀錄截圖作為繳費證明。或聯繫該縣市停管處諮詢。\n目前部分停管處官網有提供補印繳費收據功能，如：","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://parkingfee.pma.gov.taipei/"},"content":[{"nodeType":"text","value":"臺北市停管處","marks":[],"data":{}}]},{"nodeType":"text","value":"、","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://parkweb.traffic.ntpc.gov.tw/receipt.aspx"},"content":[{"nodeType":"text","value":"新北市停管處","marks":[],"data":{}}]},{"nodeType":"text","value":"，若有需要也可至停管處官網查詢列印。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:不小心重複繳費，該怎麼辦？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"重複繳費時，停管處會於確認帳款後，自動進行退款，但因各縣市作業時間不同，建議您可持超商繳費收據，聯繫停管處諮詢退款事宜。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"\n＊因超商繳費會有代收資料傳輸至停管處 1-2 天的銷帳時間差，如果在銷帳完成前又透過其他管道繳費，就會產生重複繳費情形。","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:繳費成功後發現選錯付款方式，可以取消交易嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"當繳費成功後，我們即會將繳費資料傳給機關進行銷帳，無法取消交易，如有退款需求，請洽機關或帳單業者諮詢。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:繳費退款時會一併退還手續費嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若全額退款，繳費手續費也會一併退還給您。若部分退款，繳費手續費恕不退還。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:繳費手續費如何計算？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"繳費手續費依照繳費項目不同，一次繳納多筆帳單僅收取一次繳費手續費，詳細說明請見","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://mkt.jkopay.com/event/chargeliset"},"content":[{"nodeType":"text","value":"各項手續費收費標準","marks":[],"data":{}}]},{"nodeType":"text","value":"。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:如何折抵繳費手續費？","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"繳費手續費恕無法以「街口幣」折抵","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"尊爵用戶獨享街口券折抵帳單，享繳費免手續費","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:繳費手續費會開發票嗎？可以綁載具嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"會的，雲端發票將於交易完成後的 48 小時內寄送至您於街口註冊的電子郵件信箱，並自動歸戶至您於交易前已綁定於街口的手機條碼載具。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何使用停車自動扣？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作： 街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 同意服務條款並完成授權扣款 \u003e 綁定車號，即可開始使用。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何搜尋可用停車場？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作： 街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「查看停車場清單」，即可查詢可使用停車自動扣的停車場。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】停車自動扣適用什麼回饋？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"綁定停車自動扣，享繳費回饋，且免收手續費。\n台新街口聯名卡優惠，請查看","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://mkt.jkopay.com/event/richartjkobill"},"content":[{"nodeType":"text","value":"繳費活動資訊","marks":[],"data":{}}]},{"nodeType":"text","value":"：街口 APP 首頁 \u003e 等級權益 \u003e 帳單繳費，即可查看適用項目。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何查詢授權扣款紀錄？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作： 街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「管理車號與付款方式」 \u003e 「授權扣款紀錄／變更扣款設定」 \u003e 點選 「查詢變更歷程」， 即可查詢授權扣款紀錄。\n或者從街口 APP 首頁 \u003e 「我的」 \u003e 「授權扣款項目」 \u003e 「綁定扣款」 \u003e 「進行中」 \u003e  「Autopass 快速通（街口繳費專區）」 \u003e點選 「查詢變更歷程」， 即可查詢授權扣款紀錄。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何變更扣款設定？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作： 街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「管理車號與付款方式」 \u003e 點選「授權扣款紀錄／變更扣款設定」 \u003e 「變更扣款設定」，調整後點選「儲存」，即可完成變更。\n或者從街口 APP 首頁 \u003e 「我的」 \u003e 「授權扣款項目」 \u003e 「綁定扣款」 \u003e 「進行中」 \u003e  「Autopass 快速通（街口繳費專區）」 \u003e點選「授權扣款紀錄／變更扣款設定」 \u003e 「變更扣款設定」，調整後點選「儲存」，即可完成變更。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何解除車號綁定？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作： 街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「管理車號與付款方式」 \u003e 找到欲刪除的車號 \u003e 點選「刪除」，即可完成解綁。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何終止服務？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下流程進行操作： 街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「管理車號與付款方式」 \u003e 點選「終止授權」，即可停用停車自動扣服務。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何確認停車自動扣是否開通成功？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"完成授權後，可依以下步驟確認是否開通成功：\n進入街口 App 首頁，點選「繳費」\u003e「停車自動扣」\u003e 「管理車號與付款方式」 \u003e 找到服務商「Autopass 快速通」，若已顯示車號，代表綁定成功，可正常使用自動扣款。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】停車後多久會扣款？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"進入停車場開始計費，出場時將依您的付款設定自動扣款。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】停車自動扣未成功，該怎麼辦？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若停車後未成功扣款，請先確認以下事項：","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"確認車號是否正確綁定。","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"確認綁定的付款方式是否有效，建議查看帳戶餘額或信用卡是否過期。","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"確認停車場是否支援停車自動扣，可至「查看停車場清單」確認。","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"確認前次停車費是否尚有餘額欠款。如有，請將款項結清便可再次使用本服務。","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若問題仍未解決，可聯繫街口支付客服協助處理。","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】我可以綁定多個車號嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"一個街口帳戶可以綁定多個車號，請依以下步驟操作：\n進入街口 App 首頁，點選「繳費」\u003e「停車自動扣」\u003e 「管理車號與付款方式」 \u003e 「新增車號」，即可綁定多個車號。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】現金付款後又被扣款，可以退款嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若有重複扣款疑問，請持發票或收據聯繫該停車場確認。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】可以開立統一編號嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"停車自動扣無法開立統一編號。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】車號已賣出但忘記解除綁定，可以退款嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請聯繫新的車主索取相關文件，並直接聯繫停車場確認，街口支付無法直接處理退款。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】第一次付款失敗導致無法出場，重複扣款可以退款嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若有重複扣款疑問，請持發票或收據聯繫該停車場確認。\n如重複扣款都為街口APP進行扣款，再請聯繫街口客服協助處理。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】持有身障證件，現場人員告知免繳費，但仍被扣款？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"停車自動扣包含公有及私有停車場，部分私有停車場可能未提供身障優惠，若有疑問請直接聯繫停車場確認。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】我要繳款臺北市公有停車月費，但付款失敗，怎麼辦？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若您收到「付款失敗」的通知，您依然仍可透過「街口支付」手動繳費，保障月租權益。\n\n您可查看街口 App「訊息匣」 \u003e 點擊「看詳情」，前往","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://monthtkt.pma.gov.tw/park/applyQuery.jsp"},"content":[{"nodeType":"text","value":"臺北市路外月票抽籤網站","marks":[],"data":{}}]},{"nodeType":"text","value":"的「登記查詢頁」，依照以下流程操作：\n\n● 點擊「看詳情」，前往臺北市路外月票抽籤網站「登記查詢頁」。\n● 勾選「抽籤公告查詢」→ 輸入車牌資訊 → 點擊查詢 → 確認抽籤紀錄 → 點擊「重送付款簡訊」→ 簡訊發送完成。\n● 收到簡訊後，即可透過街口完成付款。\n\n＊付款前請確認扣款工具有足夠餘額；每小時僅能申請一次繳費簡訊。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】我要繳款臺北市公有停車月費，但收到「無法透過街口支付完成扣款」的通知，怎麼辦？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若您收到「無法透過街口支付完成扣款」的通知，請您先至臺北市路外月票抽籤網站「登記查詢頁」，確認月租費繳費狀態及後續辦法。\n\n● 繳費成功：\n費用可能已透過您綁定的其他付款工具繳清。\n建議您聯繫臺北市停管處(02)2759-0666，確認是哪家業者完成繳費。\n\n● 繳費失敗：\n請盡速前往您選擇的月租停車場「臨櫃繳費」，以免逾期影響月租權益。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】我要繳納臺北市公有停車月費，但交易失敗。依照街口的流程重新點擊臺北市路外月票付款簡訊連結後，仍收到扣款失敗通知，怎麼辦？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若您過去已綁定「臺北市政府智慧支付平台」，請在付款前確認扣款工具餘額充足。\n您可依以下步驟查詢並修改設定：街口 APP 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「管理車號與付款方式」 \u003e 找到服務商「臺北市政府智慧支付平台」 \u003e 「預設付款方式」進行修改。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】如何查詢車號綁定的服務商？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請依照以下步驟查詢：街口 App 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 「管理車號與付款方式」，即可確認車號綁定中的服務商。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:【停車自動扣】臺北市公有停車場用戶，如何開通私人停車場服務？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"目前僅有使用臺北市公有停車場的用戶（車號綁定於臺北市政府智慧支付平台），若想使用更全面的 Autopass 私人停車場服務，請依照以下流程進行操作：\n街口 APP 首頁 \u003e 「繳費」 \u003e 「停車自動扣」 \u003e 輸入車號（若為過去已綁定的車號，請再次輸入相同車號） \u003e 勾選同意服務條款與隱私權政策，並點選「申請綁定」即可完成設定！","marks":[],"data":{}}]}]},"shopee.contentful_rt":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:為什麼我的交易紀錄裡有蝦皮的交易紀錄？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"依政府《電子支付機構業務管理規則》規定，網路上境外商店平台需與電支帳戶合作，以作為後續退款使用，因此只要您在蝦皮購買境外商店商品，不論選用的支付方式是什麼，蝦皮都會將此筆交易傳輸至街口紀錄，作為該筆交易如後續有退款所使用。\n該筆交易實際扣款仍是依您當時選用的支付方式，請您放心！\n\n相關說明請參閱：","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"hyperlink","data":{"uri":"https://help.shopee.tw/portal/4/article/79877?previousPage=other+articles"},"content":[{"nodeType":"text","value":"為什麼要街口實名認證？","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"hyperlink","data":{"uri":"https://help.shopee.tw/portal/4/article/80090"},"content":[{"nodeType":"text","value":"[海外訂單] 為什麼會顯示退款至街口支付？該如何提領呢？","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:申請退款後多久可收到蝦皮退款呢？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"購買海外賣場商品原付款方式為貨到付款或街口支付時，退款將透過街口支付退還給您。\n款項預計於訂單不成立或訂單完成退款申請的 7~14 個工作天（不包含假日）退至街口支付帳戶蝦皮退款，如尚於此退款期間內， 還請您耐心等候。\n\n＊若已超過退款時間仍未確認到款項，請至街口App客服中心與我們聯繫並提供您的蝦皮訂單資料，我們會盡快協助您查詢。\n\n相關說明可參閱：","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://help.shopee.tw/portal/4/article/80090"},"content":[{"nodeType":"text","value":"[海外訂單] 為什麼會顯示退款至街口支付？該如何提領呢？","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:蝦皮境外商品退款為何一定要退到街口，不能退回我的蝦皮嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"蝦皮境外交易退款只能退至交易當下所綁定的街口帳戶，依政府《電子支付機構業務管理規則》規定，網路上境外商店平台需與電支帳戶合作，以作為後續退款使用，因此無法將款項退至您的蝦皮帳號。\n\n2024/01/29 起，街口支付提供購買「海外訂單」退款提領免手續費的額度。額度將於款項進入帳戶當下立即給予，當月有 n 筆退款即有 n 次提領免手續費次數，效期至次月月底。\n\n相關說明請參閱：","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"hyperlink","data":{"uri":"https://help.shopee.tw/portal/4/article/79877?previousPage=other+articles"},"content":[{"nodeType":"text","value":"為什麼要街口實名認證？","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"hyperlink","data":{"uri":"https://help.shopee.tw/portal/4/article/80090"},"content":[{"nodeType":"text","value":"[海外訂單] 為什麼會顯示退款至街口支付？該如何提領呢？","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:我沒有綁定銀行帳戶，蝦皮退款要怎麼使用？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"您可於","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://mkt.jkopay.com/brandlist?_gl=1*1bgayfe*_gcl_au*MTMwODg0NjA5MC4xNzE2NjE1OTUz*_ga*MTE1NzM5MTczMS4xNzE2NjE1OTUz*_ga_FR3CVYZLYQ*MTcxNjYyMTE4OC4yLjAuMTcxNjYyMTE5MC41OC4wLjA."},"content":[{"nodeType":"text","value":"街口合作店家","marks":[],"data":{}}]},{"nodeType":"text","value":"，如四大超商或於貼有街口支付的店家購物時，使用街口帳戶付款即可。","marks":[],"data":{}}]}]},"transaction.contentful_rt":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:使用街口交易後卻沒有收到街口幣回饋？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"若您購買的商品中包含菸品、酒類、垃圾袋、儲值卡、遊戲卡及其他繳稅繳費等代收服務、行動支付加值金等政府法令規定為不得促銷折抵之商品或商店自訂不適用回饋之商品時，","marks":[],"data":{}},{"nodeType":"text","value":"本次消費將扣除此部分商品金額不予列入街口幣回饋","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"。（可查看交易備註確認不可折抵金額）\n\n＊適用品項規範依店家規定為準，如有疑問請洽各店家查詢。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:交易後為何沒有成功折抵街口幣？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"請您確認交易時，是否有開啟使用街口幣按鈕。\n另外，若您購買的商品中包含菸品、酒類、垃圾袋、儲值卡、遊戲卡及其他繳稅繳費等代收服務、行動支付加值金等政府法令規定為不得促銷折抵之商品，或商店自訂不適用回饋與折抵之商品時，","marks":[],"data":{}},{"nodeType":"text","value":"本次消費將整筆無法抵用街口幣","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"。\n\n＊適用品項規範依店家規定為準，如有疑問請洽店家查詢。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:發票可以打統編嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"透過街口支付之交易，發票或收據是由店家所開立，如需打統編，還請您於交易時與店家告知。","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:請問可以提高付款使用額度嗎？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"依據《電子支付機構身分確認機制及交易限額管理辦法》規定，各類帳戶付款額度已是最高上限，無法再做調整。","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"第三類電子支付帳戶：3 萬/每月","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"第二類電子支付帳戶：30 萬/每月","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:要如何在日本使用街口付款 (PayPay)？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"街口支援綁定街利存帳戶、街口帳戶、銀行帳戶等方式進行 PayPay 交易。","marks":[],"data":{}},{"nodeType":"text","value":"（僅支援台幣帳戶，不支援外幣帳戶）","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"\n您可於日本設有 PayPay 標誌的店家，告知要使用 PayPay 付款，並依店家指示","marks":[],"data":{}},{"nodeType":"text","value":"出示街口付款碼","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"或","marks":[],"data":{}},{"nodeType":"text","value":"掃描店家立牌QR CODE","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"。\n付款時請輸入日圓金額，會根據當天的匯率（付款頁下方會顯示目前匯率），折算成台幣金額再進行扣款。","marks":[],"data":{}},{"nodeType":"text","value":"\n\n＊若交易失敗請確認您付款的帳戶，是否有足夠餘額","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"\n\n相關操作說明請參閱：","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://mkt.jkopay.com/event/japan202401"},"content":[{"nodeType":"text","value":"[PayPay] 三種店家付款方式一次搞懂！","marks":[],"data":{}}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:在日本使用街口交易的匯率是多少呢？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"交易兌換匯率係參考台新銀行牌告匯率，台灣時間每日早上 9 點「外幣即期匯率資訊賣出價」計算之（如遇銀行非營業日，則以前一營業日之匯率為準），實際交易之匯率依交易當下 App 顯示為主","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Q:信用卡交易退款成功後什麼時候會返還額度？","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"當您收到街口發送的退款成功的通知，代表商家已操作取消交易。但是後續還需經過","marks":[],"data":{}},{"nodeType":"text","value":"收單銀行及發卡銀行","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"處理，因此發卡銀行無法即時看到取消紀錄，信用卡額度及簽帳金融卡帳戶餘額也無法即時歸還，","marks":[],"data":{}},{"nodeType":"text","value":"一般約 7 至 10 個工作日（實際時程依發卡銀行處理為準）","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"，請耐心等候。此為信用卡交易退款所需流程，非街口及店家的問題，不會因為急用、使用付款的卡片有高額回饋等而有特例。\n\n＊若取消的交易紀錄因結帳日無法在當期帳單抵銷，是否仍需繳費以發卡銀行規定為準。\n＊消費前請務必考量自身需求及信用卡額度/簽帳金融卡帳戶餘額，避免因申請退款無法即時釋出額度/歸還帳戶餘額，導致該筆額度/帳戶餘額無法移至其他用途。","marks":[],"data":{}}]}]},"translation":{"img_logo":"https://img.jkos.com.tw/mofang/m-729ac332-27fed.png","img_banner":"https://img.jkos.com.tw/official-site/img_store_staff_scan_code.png","banner-title-line1":"讓街口成為","banner-title-line2":"最為你著想的經營夥伴","banner-description-line1":"功能一應俱全的經營平台，輕鬆與百萬用戶建立連結，開創無限商機。","banner-button-text":"立即成為街口合作夥伴","banner-arrow-text":"幫助你拓展生意","module1_subTitle":"街口合作店家獨享 4 大特點","module1_mainTitle":" 帶給你更聰明的經營方式","module1_card1_title":"1、便利收款系統","module1_card1_contentTitle":"一眼確認付款金額，免計算、免找零","module1_card1_icon":"https://img.jkos.com.tw/official-site/img_coin_60.png","module1_card1_img":"https://img.jkos.com.tw/official-site/img_screen_resoult_1000_757_2.png","module1_card1_contentDetail":"依據你的店鋪經營方式導入最適合的收款系統，顧客10秒內完成付款，店家一眼即可確認訂單金額，不需計算亦不需找零，省時又便利。同時，一份對帳報表即可查看所有交易，一目了然的帳款管理讓你輕鬆無負擔。","module1_card2_title":"2、百萬潛在用戶","module1_card2_icon":"https://img.jkos.com.tw/official-site/img_crowd_60.png","module1_card2_img":"images/img_crowd.png","module1_card2_contentTitle":"共享平台百萬流量，輕鬆開拓市場！","module1_card2_contentDetail":"你知道嗎，全台灣平均每4人就有1人是街口支付的用戶！加入街口支付，在600萬名用戶中挖掘你的忠實顧客。你需要的人，都在街口等你！","module1_card3_title":"3、最友善的管理平台","module1_card3_icon":"https://img.jkos.com.tw/official-site/img_jko_merchent_60.png","module1_card3_img":"https://img.jkos.com.tw/official-site/img_screen_resoult_1000_757 (2).png","module1_card3_contentTitle":"業界最友善的操作系統，手機就是你的店家管理工具！","module1_card3_contentDetail":"手機下載店家App，不需要額外租借任何機器設備；最簡單直覺的App操作介面，一次滿足你所有的收款、管理、對帳需求，節省寶貴時間不必再學習多個不同系統。馬上駕輕就熟，從容自如地管理你的店鋪！","module1_card4_title":"4、免費申辦加入","module1_card4_icon":"https://img.jkos.com.tw/official-site/img_free_6.png","module1_card4_img":"https://img.jkos.com.tw/official-site/iStock-1455170702 1.png","module1_card4_contentTitle":"免費申辦加入，無痛實現數位轉型！","module1_card4_contentDetail":"體驗方便的電子支付收款與強大的商家經營系統，除基本交易手續費外，不額外收取費用——免申辦費、免⽉租、免年費！ 還有專業團隊的導⼊與諮詢服務， 全力支持你實現數位轉型。","module2_subTitle":"行銷宣傳工具及方案","module2_mainTitle":"導客神助攻，讓用戶看到你！","module2_tab1_title":"專屬店舖頁面","module2_tab1_description":"擁有街口專屬店舖頁面，隨時隨地自主編輯資訊，打造專業形象人人看得到。","module2_tab1_list1":"用戶搜尋附近店家立即出現，提高有效曝光","module2_tab1_list2":"用戶一鍵收藏店家，從此成為忠實顧客","module2_tab1_img":"https://img.jkos.com.tw/official-site/img_screen_store_page_750_1.png","module2_tab1_tag":"#品牌形象","module2_tab2_title":"精準行銷工具","module2_tab2_description":"利用街口券/街口幣作為店家的行銷利器，依據消費習慣自由設定對象—想鎖定回流用戶、還是觸及新客，或是加上離店距離、年齡等條件，由你決定。","module2_tab2_list1":"針對行銷目標，把錢花在對的客群、提高轉換率","module2_tab2_list2":"數據追蹤一目了然，高效把控預算","module2_tab2_list3":"自動折抵及發送回饋，顧客消費有感、店家輕鬆管理","module2_tab2_img":"https://img.jkos.com.tw/official-site/img_screen_jko_coupon_750_1.png","module2_tab2_tag":"#精準導客","module2_tab2_btnText":"了解更多","module2_tab3_title":"官方合作推廣活動","module2_tab3_description":"街口每年不定期舉辦各式主題活動幫助店家推廣，有機會與官方聯手打造獨一無二的話題活動，由官方助你強強聯手、潛能全開！","module2_tab3_list1":"依據店家屬性或地點商圈，量身打造讓消費者動心的活動主題","module2_tab3_list2":"街口 App 版位百萬流量曝光推廣，話題性 UP 交易額 UP","module2_tab3_img":"https://img.jkos.com.tw/official-site/img_screen_customer_homepage_focus_event_750_1.png","module2_tab3_tag":"#話題曝光","img_dot_bg":"https://img.jkos.com.tw/official-site/img_operation_description_dot_bg (1).png","img_quote":"https://img.jkos.com.tw/official-site/quote.png","img_quote_left":"https://img.jkos.com.tw/official-site/img_left_quotes.png","img_quote_right":"https://img.jkos.com.tw/official-site/Vector.png","join_text":"加入","jko_text":"街口","join_text2":"，由專業的營運團隊為你提供專屬行銷方案","img_join_avatar":"https://img.jkos.com.tw/official-site/COO_60_1.png","join_avatar_name":"Ken Chang","join_avatar_title":" 街口電子支付商務發展部總監","module3_subTitle":"個人戶店家限定全新撥款服務","module3_mainTitle":"全業界⾸創 – 店家款項當日入帳街口帳戶","module3_content_title":"當日營收撥款至街口帳戶，最大化資金運用，經營不受限。","module3_content_desc_line1":"只要以個人戶名義申辦成為合作店家，即可設定將每日營收⾦流撥⼊你的個人街口帳戶。","module3_content_desc_line2":"真正實現日結日領，還能省去每次撥款的手續費，靈活運用資金！","module3_img":"https://img.jkos.com.tw/official-site/img_price_table.png","module4_title1":"這些品牌也都選擇","module4_title2":"街口支付","module4_desc_line1":"從網路購物 、大型商場、連鎖品牌到夜市攤販都選擇加入街口。不論經營規模、地點、產業，都能透過街口擴大商機。快速點選街口支付店家列表，認識我們的合作夥伴！","module4_desc_btnText":"查看街口支付合作店家列表","img_arrow_right":"https://img.jkos.com.tw/official-site/arrow_right_blue500_24.svg","module5_mainTitle_line1":"專業營運團隊，","module5_mainTitle_line2_2":"神隊友","module5_mainTitle_period":"。","img_line_brand500":"https://img.jkos.com.tw/official-site/img_line_brand500%20(1).svg","module5_content_desc_line1":"不論是遇到系統串接、後台設定等技術問題，還是行銷推廣活動無從下手，都有來自街口專業營運團隊的專人支持，讓你隨時隨地得到最好的幫助。","module5_content_desc_line2":"有任何問題嗎？","module5_content_btn1Text":"查看街口店家操作指南","module5_content_btn1_desc":"專為已合作店家解答","module5_content_btn2Text":"聯絡街口店家營運信箱","module5_content_btn2_desc1":"serviceop@jkos.com","module5_content_btn2_desc2":"服務時間:週一至週五 10:00 ~ 18:00","module5_content_btn1_link":"https://sites.google.com/jkos.com/jkofaq","module6_mainTitle":"金流收費方案說明","module6_table_title1":"店家經營形式","module6_table_title2":"交易手續費率","module6_table_1_body1_title":"實體商店","module6_table_1_body1_desc":"透過實體的店面門市與顧客進行直接的面對面付款交易","module6_table_2_body1_title":"2.5%","module6_table_1_body2_title":"網路平台","module6_table_1_body2_desc":"透過網路購物網頁/App、線上商城平台或線上點餐等網路方式進行交易","module6_table_2_body2_title":"2.5%","module6_table_desc":"＊部分店家費率略有浮動","module7_mainTitle":"加入街口合作店家","module7_subTitle":"只需要一支手機就能齊聚所有經營需求，各就各位，大展身手","module7_btnText":"我要成為合作店家","module7_btn_link":"https://docs.google.com/forms/d/e/1FAIpQLScvKczT-YLNQp1yxjIPyPMy8_KUjw9DR0T5onIYtJ6K0t4nEQ/viewform","module7_listItem1_title":"百萬用戶流量","module7_listItem1_icon":"https://img.jkos.com.tw/official-site/crowd_of_people.png","module7_listItem2_title":"電子支付收款","module7_listItem2_icon":"https://img.jkos.com.tw/official-site/scan_qrcode.png","module7_listItem3_title":"帳務管理系統","module7_listItem3_icon":"https://img.jkos.com.tw/official-site/bill.png","module7_listItem4_title":"自主行銷工具","module7_listItem4_icon":"https://img.jkos.com.tw/official-site/target.png","module7_listItem5_title":"線上點餐系統","module7_listItem5_icon":"https://img.jkos.com.tw/official-site/meal.png","module7_listItem6_title":"當日撥款服務","module7_listItem6_icon":"https